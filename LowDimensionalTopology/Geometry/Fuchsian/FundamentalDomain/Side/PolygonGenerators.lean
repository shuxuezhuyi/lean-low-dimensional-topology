/-- The original finite disc is homeomorphic to the actual complex plane. -/
def discPlaneHomeomorph : Complex.UnitDisc ≃ₜ ℂ := (Homeomorph.unitBall (E := ℂ)).symm

/-- A topological coordinate only: no replacement of the original hyperbolic metric. -/
def UnitDiscFuchsianGroup.planeHomeomorph
    {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) : P.domain.carrier ≃ₜ ℂ :=
  P.finiteCoordinate.trans discPlaneHomeomorph

/-- Removing any countable set from the original disc leaves a dense preconnected set. -/
theorem UnitDiscFuchsianGroup.countable_complement
    {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) {Z : Set P.domain.carrier} (hZ : Z.Countable) :
    Dense Zᶜ ∧ IsPreconnected Zᶜ := by
  let E := P.planeHomeomorph
  have hm : (E '' Z).Countable := hZ.image E
  have hd := hm.dense_compl ℝ
  have hp := hm.isPathConnected_compl_of_one_lt_rank (by rw [Complex.rank_real_complex]; norm_num)
  have he : E ⁻¹' (E '' Z)ᶜ = Zᶜ := by rw [preimage_compl, preimage_image_eq _ E.injective]
  rw [← he]
  exact ⟨hd.preimage E.isOpenMap, E.isPreconnected_preimage.mpr hp.isConnected.isPreconnected⟩

/-- In a space where deleting countably many points preserves dense connectedness, locally finite
closed tiles are generated by their nondegenerate intersections. -/
theorem nontrivial_closed_tiles_generate {G X : Type*} [Group G] [Countable G] [TopologicalSpace X]
    [MulAction G X] [ContinuousConstSMul G X]
    (D : Set X) (ho : IsOpen D) (hn : D.Nonempty)
    (hlf : LocallyFinite (fun g : G => g • closure D))
    (hcov : (⋃ g : G, g • closure D) = univ)
    (hremove : ∀ Z : Set X, Z.Countable → Dense Zᶜ ∧ IsPreconnected Zᶜ) :
    Subgroup.closure {g : G | (closure D ∩ g • closure D).Nontrivial} = ⊤ := by
  classical
  let S : Set G := {g : G | (closure D ∩ g • closure D).Nontrivial}
  let L := Subgroup.closure S
  let U : Set X := ⋃ g : L, g.val • closure D
  let V : Set X := ⋃ g : {g : G // g ∉ L}, g.val • closure D
  have hUc : IsClosed U :=
    (hlf.comp_injective (Subtype.val_injective (p := fun g => g ∈ L))).isClosed_iUnion
      (fun g => (Homeomorph.smul g.val).isClosedMap _ isClosed_closure)
  have hVc : IsClosed V :=
    (hlf.comp_injective (Subtype.val_injective (p := fun g => g ∉ L))).isClosed_iUnion
      (fun g => (Homeomorph.smul g.val).isClosedMap _ isClosed_closure)
  have hsmall (g : L) (h : {g : G // g ∉ L}) :
      (g.val • closure D ∩ h.val • closure D).Subsingleton := by
    intro x hx y hy
    by_contra hxy
    have ht : (g.val • closure D ∩ h.val • closure D).Nontrivial := ⟨x, hx, y, hy, hxy⟩
    have hi := ht.image (Homeomorph.smul g.val⁻¹).injective
    have hs : g.val⁻¹ * h.val ∈ S := by
      change (closure D ∩ (g.val⁻¹ * h.val) • closure D).Nontrivial
      change (g.val⁻¹ • (g.val • closure D ∩ h.val • closure D)).Nontrivial at hi
      rw [smul_set_inter, inv_smul_smul, ← mul_smul] at hi
      exact hi
    have hh : h.val ∈ L := by
      have hm := L.mul_mem g.property (Subgroup.subset_closure hs)
      simpa only [mul_inv_cancel_left] using hm
    exact h.property hh
  have hZ : (U ∩ V).Countable := by
    apply (Set.countable_iUnion (fun g : L => Set.countable_iUnion
      (fun h : {g : G // g ∉ L} => (hsmall g h).countable))).mono
    rintro x ⟨hxU, hxV⟩
    obtain ⟨g, hg⟩ := mem_iUnion.mp hxU
    obtain ⟨h, hh⟩ := mem_iUnion.mp hxV
    exact mem_iUnion₂.mpr ⟨g, h, hg, hh⟩
  have huv : U ∪ V = univ := by
    apply Set.eq_univ_of_forall
    intro x
    have hx : x ∈ ⋃ g : G, g • closure D := by rw [hcov]; trivial
    obtain ⟨g, hg⟩ := mem_iUnion.mp hx
    by_cases hgl : g ∈ L
    · exact Or.inl (mem_iUnion.mpr ⟨⟨g, hgl⟩, hg⟩)
    · exact Or.inr (mem_iUnion.mpr ⟨⟨g, hgl⟩, hg⟩)
  obtain ⟨hdense, hpre⟩ := hremove (U ∩ V) hZ
  apply top_unique
  intro g _hg
  by_contra hgn
  obtain ⟨u, huD, huZ⟩ := hdense.inter_open_nonempty D ho hn
  have huU : u ∈ U := mem_iUnion.mpr ⟨⟨1, L.one_mem⟩, u, subset_closure huD, by simp⟩
  have hgo : IsOpen (g • D) := (Homeomorph.smul g).isOpenMap D ho
  have hgnon : (g • D).Nonempty := hn.image (fun x => g • x)
  obtain ⟨v, ⟨w, hw, hgw⟩, hvZ⟩ := hdense.inter_open_nonempty (g • D) hgo hgnon
  have hvV : v ∈ V := mem_iUnion.mpr ⟨⟨g, hgn⟩, w, subset_closure hw, hgw⟩
  obtain ⟨z, hzZ, hzU, hzV⟩ := isPreconnected_closed_iff.mp hpre U V hUc hVc
    (by intro z _hz; rw [huv]; trivial) ⟨u, huZ, huU⟩ ⟨v, hvZ, hvV⟩
  exact hzZ ⟨hzU, hzV⟩

/-- The original side-pairing elements are those attached to genuine positive-length closed intersections. -/
def fuchsianSidePairingElements
    {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H)
    (D : Set P.domain.carrier) : Set H :=
  {g | g ≠ 1 ∧ IsFuchsianPolygonSide P D (closure D ∩ fuchsianDomainTile P D g)}

/-- The actual side-pairing elements generate the full original Fuchsian group. -/
theorem side_pairing_elements_generate
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H}
    {D : Set P.domain.carrier} (hD : IsConvexFuchsianPolygon P D) :
    Subgroup.closure (fuchsianSidePairingElements P D) = ⊤ := by
  let : Countable H := P.countable
  let : ContinuousConstSMul H P.domain.carrier := _root_.LowDimensionalTopology.Geometry.Surfaces.mobiusDomainContinuousConstSMul P.domain
  have hgen := nontrivial_closed_tiles_generate D
    ((isFuchsianFundamentalDomain_iff P D).mp hD.locallyFinite.fundamental).1
    ((isFuchsianFundamentalDomain_iff P D).mp hD.locallyFinite.fundamental).2.1.nonempty
    hD.locallyFinite.locallyFinite hD.locallyFinite.fundamental.closure_cover
    (fun Z hZ => P.countable_complement hZ)
  have hle : Subgroup.closure {g : H | (closure D ∩ g • closure D).Nontrivial} ≤
      Subgroup.closure (fuchsianSidePairingElements P D) := by
    apply (Subgroup.closure_le _).mpr
    intro g hg
    by_cases he : g = 1
    · exact he ▸ (Subgroup.closure (fuchsianSidePairingElements P D)).one_mem
    · exact Subgroup.subset_closure ⟨he, hD.side_of_nontrivial_intersection he hg⟩
  exact top_unique (hgen ▸ hle)

end LowDimensionalTopology.Geometry.Fuchsian
