module
public import LowDimensionalTopology.Geometry.Fuchsian.FundamentalDomain.CyclicPresentation.OriginalCyclicPreCompletion
/-!
# Descending the polygon map to the cusp completion

The preface projection respects the side-gluing relation and therefore
descends continuously to the word realization. Augmented orbit coverage
makes the descended map onto the original cusp completion.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 600000
open Set Topology
open scoped Complex.UnitDisc
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Algebra LowDimensionalTopology.Geometry.Auxiliary.Analysis
  LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.Euclidean
  LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Mobius
  LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces
  LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Inversive
  LowDimensionalTopology.Geometry.DiscreteGroups.Action LowDimensionalTopology.Geometry.Fuchsian
  LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace LowDimensionalTopology.Geometry.Surfaces.CyclicSurface
open LeanEval.Topology.ClassificationOfSurfaces
open FiniteCyclicPresentation SurfaceCellComplex
open LeanEval.Topology.ClassificationOfSurfaces.Moise
section CuspDescent
variable {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup} (D₀:FuchsianDisc H)
    {L:Set (geometricDiscData D₀).domain.carrier}
    (hL:IsConvexFuchsianPolygon (geometricDiscData D₀) L) (ha:(geometricDiscData D₀).area L≠⊤)
    (J:PolygonalCircle)
    (hc:J.carrier=_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonKleinPlane '' (⋃v:OriginalRefinedSide
      hL,v.carrier))
    (hv:∀p,J.IsVertexPoint p↔p∈_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonKleinPlane ''
      originalRefinedEndpointSet hL)
    (e:ZMod J.n≃OriginalRefinedSide hL) (hs:∀i,J.edgeSegment i=(e i).planeCarrier)
    {n:ℕ} (S:_root_.LowDimensionalTopology.Geometry.Polygon.CyclicDiscPolygonSupportData n)
    (hr:S.toCenteredData.kleinRegion=fuchsianPolygonCompactKlein (geometricDiscData D₀) L)
    (hpar:∀u:Circle,(u:ℂ)∈fuchsianPolygonIdealBoundary (geometricDiscData D₀) L→
      ∃f:geometricDiscGroup D₀,f≠1∧_root_.LowDimensionalTopology.Geometry.Mobius.MobiusParabolic f.val∧
        f.val.val ((u:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=((u:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))

/-- The projection is constant on the actual equivalence relation generated by every stored original side pairing. -/
theorem originalCyclicPreCompletionMap_respects
    {a b:(originalCyclicPresentation J e).presentation.PolygonalPreRealization}
    (hab:(originalCyclicPresentation J e).presentation.PolygonalGluingRel
      (originalCyclicPresentation J e).valid a b) :
    originalCyclicPreCompletionMap D₀ hL ha J hc hv e hs S hr hpar a=
      originalCyclicPreCompletionMap D₀ hL ha J hc hv e hs S hr hpar b := by
  change Relation.EqvGen (PolygonGluing.Generator
    ((originalCyclicPresentation J e).presentation.polygonalIdentifications
      (originalCyclicPresentation J e).valid)) a b at hab
  induction hab with
  | rel a b h =>
      cases h with
      | glue identification hi t =>
          obtain ⟨pairing,rfl⟩:=hi
          exact originalCyclicPreCompletionMap_pairing D₀ hL ha J hc hv e hs S hr hpar pairing t
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- The unchanged faithful original pairing-word quotient projects into the unique original all-cusp completion. -/
def originalCyclicCompletionMap :
    (originalCyclicPresentation J e).presentation.PolygonalRealization
      (originalCyclicPresentation J e).valid→FuchsianCuspCompletion D₀ :=
  Quotient.lift (originalCyclicPreCompletionMap D₀ hL ha J hc hv e hs S hr hpar)
    (fun _ _ hab=>originalCyclicPreCompletionMap_respects D₀ hL ha J hc hv e hs S hr hpar hab)

/-- The actual quotient map retains exactly the original preface projection on every point. -/
theorem originalCyclicCompletionMap_mk
    (x:(originalCyclicPresentation J e).presentation.PolygonalPreRealization) :
    originalCyclicCompletionMap D₀ hL ha J hc hv e hs S hr hpar
      ((originalCyclicPresentation J e).presentation.polygonalMk
        (originalCyclicPresentation J e).valid x)=
      originalCyclicPreCompletionMap D₀ hL ha J hc hv e hs S hr hpar x := rfl

/-- The faithful original word quotient map is continuous for the actual cusp-completion topology. -/
theorem continuous_originalCyclicCompletionMap :
    Continuous (originalCyclicCompletionMap D₀ hL ha J hc hv e hs S hr hpar) :=
  (continuous_originalCyclicPreCompletionMap D₀ hL ha J hc hv e hs S hr hpar).quotient_lift _

/-- Every actual old orbit or added cusp has an original word representative, by the original polygon's genuine augmented-orbit coverage. -/
theorem originalCyclicCompletionMap_surjective :
    Function.Surjective (originalCyclicCompletionMap D₀ hL ha J hc hv e hs S hr hpar) := by
  intro x
  obtain ⟨p,hp⟩:=fuchsianCuspSubsetProjection_surjective D₀
    (originalFiniteClosedHull (geometricDiscNormalizer D₀) S.vertices)
    (finite_cyclic_hull_original_cusp_admissible D₀ L S hr hpar)
    (finite_cyclic_hull_meets_original_augmented_orbit D₀ hL.locallyFinite S hr) x
  let E:=originalCyclicPreSphereHomeomorph hL ha J hc hv e hs (geometricDiscNormalizer D₀) S hr
  refine ⟨(originalCyclicPresentation J e).presentation.polygonalMk
    (originalCyclicPresentation J e).valid (E.symm p),?_⟩
  rw [originalCyclicCompletionMap_mk]
  change fuchsianCuspSubsetProjection D₀ _ _ (E (E.symm p))=x
  rw [E.apply_symm_apply]
  exact hp
end CuspDescent
end LowDimensionalTopology.Geometry.Fuchsian
