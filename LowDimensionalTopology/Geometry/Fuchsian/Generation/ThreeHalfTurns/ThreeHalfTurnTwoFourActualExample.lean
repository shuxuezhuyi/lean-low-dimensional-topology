/-- Every parameter of the reduced numerator-two branch has an actual
hyperbolic triangle group generated by three genuine half-turns, with its
actual genus, full cone-order list and cusp count. Coprimality derives the
odd denominator already required by that branch. -/
theorem exists_two_four_reduced_halfturn_actual_signature
    (q : ℕ) (hq : 5≤q) (hred : Nat.Coprime 2 q) :
    ∃T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle,∃x y z : ℍ≃ᵢℍ,
      T.alpha=Real.pi/(q:ℝ) ∧ T.beta=Real.pi/4 ∧ T.gamma=Real.pi/2 ∧
      orderOf x=2 ∧ orderOf y=2 ∧ orderOf z=2 ∧
      Subgroup.closure ({x,y,z}:Set (ℍ≃ᵢℍ))=triangleConformalGroup T ∧
      DiscreteTopology (triangleConformalGroup T) ∧
      ∃P : HalfPlaneFuchsianGroup (closedTriangleMobiusGroup T),
        HasCofiniteFuchsianSignature P.asFuchsianDisc 0 [2,4,q] 0 := by
  obtain ⟨T,x,y,z,hα,hβ,hγ,hx,hy,hz,hG,hdisc⟩:=
    exists_two_four_odd_halfturn_triangle q hq (Nat.coprime_two_left.mp hred)
  let ha : IsIntegralTriangleAngle T.alpha:=Or.inr ⟨q,by omega,hα⟩
  let hb : IsIntegralTriangleAngle T.beta:=Or.inr ⟨4,by omega,hβ⟩
  let hc : IsIntegralTriangleAngle T.gamma:=Or.inr ⟨2,by omega,hγ⟩
  let P:=closedTriangleMobiusData T ha hb hc
  have hSig:=closedTriangle_actual_signature_finite T q 4 2 (by omega)
    (by omega) (by omega) hα hβ hγ P
  have hPerm : ([2,4,q]:List ℕ).Perm [q,4,2]:=
    (List.Perm.swap 4 2 [q]).trans
      ((List.Perm.cons 4 (List.Perm.swap q 2 [])).trans (List.Perm.swap q 4 [2]))
  exact ⟨T,x,y,z,hα,hβ,hγ,hx,hy,hz,hG,hdisc,P,hSig.perm_orders hPerm⟩

end LowDimensionalTopology.Geometry.Fuchsian
