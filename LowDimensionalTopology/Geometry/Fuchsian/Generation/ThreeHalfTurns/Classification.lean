/-- The large-parameter signature belongs to every genuine half-plane model
of the unchanged original generated group, rather than a chosen data witness. -/
theorem threeHalfTurn_triangle_large_parameter_signature (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam:1<_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))) :
    ∃hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)),
    ∃hFG:(_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))).FG,
      HasNielsenFuchsianSignature P.cayleyData (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius) hFG 0 [2,2,2] 0 1 := by
  obtain ⟨P',hNE,hFG,hSig⟩:=threeHalfTurn_triangle_large_parameter_classification T A B C hA hB hC hlam
  have he:P'=P:=by cases P';cases P;rfl
  subst P'
  exact ⟨hNE,hFG,hSig⟩

/-- Arbitrary original-disc coordinates have the same actual large-parameter
signature. The fixed geometric model is the proved whole-group, whole-disc
normalization; its quotient is the original quotient in genuine coordinates. -/
theorem threeHalfTurn_original_large_parameter_signature
    (f g h:_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
    (D:FuchsianDisc (Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    (hf:orderOf f=2) (hg:orderOf g=2) (hh:orderOf h=2)
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    (hlarge:2<_root_.LowDimensionalTopology.Geometry.Mobius.mobiusTraceAbs (f*g*h)) :
    ∃hFG:(geometricDiscGroup D).FG,
      HasNielsenFuchsianSignature (geometricDiscData D)
        (hNE.conjugation (geometricDiscNormalizer D)) hFG 0 [2,2,2] 0 1 := by
  let F:Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=⟨f,Subgroup.subset_closure (by simp)⟩
  let G:Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=⟨g,Subgroup.subset_closure (by simp)⟩
  let K:Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=⟨h,Subgroup.subset_closure (by simp)⟩
  let A:=D.normalizedLift F
  let B:=D.normalizedLift G
  let C:=D.normalizedLift K
  let q₀:=D.halfPlaneNormalizer
  have hA:orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)=2:=by
    rw [D.normalizedLift_spec]
    exact ((MulAut.conj q₀).orderOf_eq f).trans hf
  have hB:orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B)=2:=by
    rw [D.normalizedLift_spec]
    exact ((MulAut.conj q₀).orderOf_eq g).trans hg
  have hC:orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)=2:=by
    rw [D.normalizedLift_spec]
    exact ((MulAut.conj q₀).orderOf_eq h).trans hh
  have hgroup:D.normalizedGroup=Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    change (Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)).map
      (MulAut.conj q₀).toMonoidHom=_
    rw [MonoidHom.map_closure,Set.image_insert_eq,Set.image_insert_eq,Set.image_singleton]
    change Subgroup.closure {q₀*f*q₀⁻¹,q₀*g*q₀⁻¹,q₀*h*q₀⁻¹}=_
    rw [←D.normalizedLift_spec F,←D.normalizedLift_spec G,←D.normalizedLift_spec K]
  have hNE':_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)):=by
    rw [←hgroup]
    exact hNE.conjugation q₀
  have hprod:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)=q₀*(f*g*h)*q₀⁻¹:=by
    dsimp only [A,B,C]
    rw [map_mul,map_mul,D.normalizedLift_spec,D.normalizedLift_spec,D.normalizedLift_spec]
    change (q₀*f*q₀⁻¹)*(q₀*g*q₀⁻¹)*(q₀*h*q₀⁻¹)=q₀*(f*g*h)*q₀⁻¹
    group
  have habs:|Matrix.trace (A*B*C).val|=_root_.LowDimensionalTopology.Geometry.Mobius.mobiusTraceAbs (f*g*h):=by
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_traceAbs,hprod,_root_.LowDimensionalTopology.Geometry.Mobius.mobiusTraceAbs,_root_.LowDimensionalTopology.Geometry.Mobius.mobiusSquaredTrace_conjugation]
    rfl
  obtain ⟨T,hAt,hBt,hCt⟩:=threeHalfTurn_original_centers_triangle A B C hA hB hC hNE'
  have hlam:1<_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T:=by
    have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurn_triple_abs_trace T A B C hAt hBt hCt
    rw [habs] at he
    linarith only [he,hlarge]
  obtain ⟨P,hNEP,hFGP,hSig⟩:=threeHalfTurn_triangle_large_parameter_classification T A B C hAt hBt hCt hlam
  have hwhole:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))=geometricDiscGroup D:=by
    rw [←hgroup]
    change _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius
      (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate q₀ (Subgroup.closure ({f,g,h}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))=_
    rw [_root_.LowDimensionalTopology.Geometry.DiscreteGroups.dilation_subgroupConjugate_compose]
    rfl
  have hModel:∃Q:UnitDiscFuchsianGroup (geometricDiscGroup D),
      ∃hNEQ:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (geometricDiscGroup D),∃hFGQ:(geometricDiscGroup D).FG,
      HasNielsenFuchsianSignature Q hNEQ hFGQ 0 [2,2,2] 0 1:=by
    rw [←hwhole]
    exact ⟨P.cayleyData,hNEP.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius,hFGP,hSig⟩
  obtain ⟨Q,hNEQ,hFGQ,hSigQ⟩:=hModel
  have he:Q=geometricDiscData D:=by cases Q;cases geometricDiscData D;rfl
  subst Q
  exact ⟨hFGQ,hSigQ⟩

end LowDimensionalTopology.Geometry.Fuchsian
