/-- Reflection in the actual imaginary axis carries every real-centered
h-circle to its reflected h-circle, including the complete native carrier. -/
theorem halfTurn_reflection_circle_carrier (c r:ℝ) (hr:0<r) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry UpperHalfPlane.J '' (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle c r hr).carrier=
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle (-c) r hr).carrier := by
  have hinv (z:ℍ):UpperHalfPlane.J • (UpperHalfPlane.J • z)=z:=by
    rw [←mul_smul,←pow_two,UpperHalfPlane.J_sq,one_smul]
  have hn (z:ℍ):‖((UpperHalfPlane.J • z:ℍ):ℂ)-((-c:ℝ):ℂ)‖=‖(z:ℂ)-(c:ℂ)‖:=by
    rw [UpperHalfPlane.coe_J_smul]
    calc
      _=‖-conj ((z:ℂ)-(c:ℂ))‖:=by congr 1;simp;ring
      _=_:=by rw [norm_neg,Complex.norm_conj]
  ext z
  constructor
  · rintro ⟨x,hx,rfl⟩
    change ‖((UpperHalfPlane.J • x:ℍ):ℂ)-((-c:ℝ):ℂ)‖=r
    exact (hn x).trans hx
  · intro hz
    refine ⟨UpperHalfPlane.J • z,?_,hinv z⟩
    change ‖((UpperHalfPlane.J • z:ℍ):ℂ)-(c:ℂ)‖=r
    have hh:=hn (UpperHalfPlane.J • z)
    rw [hinv z] at hh
    exact hh.symm.trans hz

/-- The original large-parameter group has a genuine ordinary point on its
own ideal boundary. Both actual orientations of the supporting frame are
handled by native isometries and their real extended homeomorphisms. -/
theorem threeHalfTurn_large_parameter_ordinary_boundary (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam:1<_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    ∃ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary,ξ∈_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) := by
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  have hrange:range (fun i:Fin 3=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (![A,B,C] i))=
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    ext x
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp
    · rintro (rfl|rfl|rfl)
      · exact ⟨0,rfl⟩
      · exact ⟨1,rfl⟩
      · exact ⟨2,rfl⟩
  have hd:DiscreteTopology H:=
    (threeHalfTurn_large_parameter_discrete_freeProduct T A B C hA hB hC hlam.le).1
  let P:=threeHalfTurn_real_halfPlaneData A B C hd
  let P':HalfPlaneFuchsianGroup (Subgroup.closure (range (fun i:Fin 3=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (![A,B,C] i)))):=
    hrange.symm ▸ P
  obtain ⟨ξ,g,s,hs,L,_hξ,hg,_hend,hcent,hpres,hframe⟩:=
    halfTurn_large_parameter_separated_support_frame T A B C hA hB hC hlam
  have hAt (i:Fin 3):_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (![A,B,C] i) (![T.a,T.b,T.c] i):=by
    fin_cases i <;> assumption
  let G:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex≃ₜ_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinearHomeomorph (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g)
  have hG (z:ℍ):G (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g z):=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.realMobiusMatrix_coe g hg z
  have hgb (x:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex):G x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary↔x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary:=by
    exact Set.ext_iff.mp (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realMobiusMatrix_preimage_boundary g) x
  have hJb (x:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex):_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisReflectionExtendedHomeomorph x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary↔
      x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary:=by
    cases x using OnePoint.rec with
    | infty => simp [_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisReflectionExtendedHomeomorph,_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary]
    | coe z =>
      change ((-conj z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary↔(z:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary
      simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary,mem_insert_iff,OnePoint.coe_ne_infty,false_or,
        OnePoint.coe_injective.mem_set_image,mem_ofPred_eq,Complex.neg_im,Complex.conj_im,neg_neg]
  have getPoint (a:ℝ) (ha0:-1<a) (ha1:a<1) (f:ℍ≃ᵢℍ)
      (F:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex≃ₜ_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
      (hF:∀z:ℍ,F (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (f z))
      (hb:∀x:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex,F x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary↔x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
      (hL:∀i,f '' (L i).carrier=(halfTurnSeparatedLines a ha1 i).carrier):
      ∃x∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary,x∈_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet H:=by
    have ho:=halfTurnSeparated_transport_gap_ordinary (![A,B,C]) (![T.a,T.b,T.c])
      hAt L hcent hpres P' a ha0 ha1 f F hF hL
    let r:ℝ:=(a-1)/2
    have hr0:-1<r:=by dsimp [r];linarith only [ha0]
    have hr1:r<a:=by dsimp [r];linarith only [ha0]
    let y:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=((r:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    have hyb:y∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary:=by
      exact Or.inr ⟨(r:ℂ),by simp,rfl⟩
    have hyg:y∈halfTurnSeparatedSphereGap a:=by
      exact ⟨(r:ℂ),⟨hr0,hr1⟩,rfl⟩
    refine ⟨F.symm y,?_,?_⟩
    · exact (hb _).mp (by simpa using hyb)
    · have hh:=ho (show F.symm y∈F ⁻¹' halfTurnSeparatedSphereGap a by simpa using hyg)
      simpa only [hrange] using hh
  rcases hframe with hf|hf
  · apply getPoint s hs.1 hs.2 (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g) G hG hgb
    exact hf
  · have hs0:-1< -s:=by linarith only [hs.2]
    have hs1:-s<1:=by linarith only [hs.1]
    let f:ℍ≃ᵢℍ:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g).trans (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry UpperHalfPlane.J)
    let F:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex≃ₜ_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=G.trans _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisReflectionExtendedHomeomorph
    have hF (z:ℍ):F (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (f z):=by
      change _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisReflectionExtendedHomeomorph (G (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z))=_
      rw [hG]
      change ((-conj ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g z:ℍ):ℂ):ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=
        (((UpperHalfPlane.J • (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g z):ℍ):ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
      rw [UpperHalfPlane.coe_J_smul]
    apply getPoint (-s) hs0 hs1 f F hF (fun x=>(hJb (G x)).trans (hgb x))
    intro i
    change (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry UpperHalfPlane.J (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g z)) '' _=_
    rw [←image_image,hf i]
    fin_cases i
    · ext z
      change (∃x:ℍ,x.re=1 ∧ UpperHalfPlane.J • x=z)↔z.re= -1
      constructor
      · rintro ⟨x,hx,rfl⟩
        rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.imaginaryAxisReflection_re,hx]
      · intro hz
        refine ⟨UpperHalfPlane.J • z,?_,?_⟩
        · rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.imaginaryAxisReflection_re,hz];ring
        · rw [←mul_smul,←pow_two,UpperHalfPlane.J_sq,one_smul]
    · ext z
      change (∃x:ℍ,x.re= -1 ∧ UpperHalfPlane.J • x=z)↔z.re=1
      constructor
      · rintro ⟨x,hx,rfl⟩
        rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.imaginaryAxisReflection_re,hx];ring
      · intro hz
        refine ⟨UpperHalfPlane.J • z,?_,?_⟩
        · rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.imaginaryAxisReflection_re,hz]
        · rw [←mul_smul,←pow_two,UpperHalfPlane.J_sq,one_smul]
    · change _root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry UpperHalfPlane.J ''
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle ((s-1)/2) ((s+1)/2) _).carrier=
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle ((-s+1)/2) ((1- -s)/2) _).carrier
      have hc:-((s-1)/2)=(-s+1)/2:=by ring
      have hr:(s+1)/2=(1- -s)/2:=by ring
      simpa only [hc,hr] using
        halfTurn_reflection_circle_carrier ((s-1)/2) ((s+1)/2) (by linarith only [hs.1])

