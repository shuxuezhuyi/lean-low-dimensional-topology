    rw [(halfTurn_standard_ideal_components i).2]
    fin_cases i
    · exact fun _ hz=>hz.2.2
    · exact fun _ hz=>hz.1
    · exact fun _ hz=>hz.2.1
  have hlt (x a : ℝ) : x<a ↔ ¬(x=a ∨ a<x) := by
    constructor
    · intro h he
