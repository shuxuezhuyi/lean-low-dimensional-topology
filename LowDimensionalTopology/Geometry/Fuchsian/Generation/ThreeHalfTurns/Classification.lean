      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q).val ξ=((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ)=((α:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (B*A)).val ξ)=((β:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ∧
