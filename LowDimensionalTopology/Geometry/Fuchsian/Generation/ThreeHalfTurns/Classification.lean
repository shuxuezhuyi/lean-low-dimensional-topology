/-- Every actual finite-or-ideal triangle has density-null native frontier. -/
theorem halfTurnIdeal_triangle_frontier_null (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) :
    volume (frontier T.interior)=0 := by
  have hs : frontier T.interior⊆⋃i : Fin 3,(T.nativeLine i).carrier := by
    intro z hz
    rw [←T.nativeSide_boundary] at hz
    obtain ⟨S,⟨i,rfl⟩,hi⟩:=mem_sUnion.mp hz
    apply mem_iUnion.mpr
    refine ⟨i,?_⟩
    rw [T.nativeSide_eq_carrier_inter_line] at hi
    exact hi.2
  exact measure_mono_null hs (measure_iUnion_null (fun i=>(T.nativeLine i).volume_zero))

/--
The actual triangle interior packing and actual closed-orbit coverage
produce the literal fundamental domain, including its orbit selector.
-/
theorem halfTurnIdeal_native_fundamental (H : Subgroup (ℍ≃ᵢℍ)) (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (hpacking : ∀g : H,g≠1→Disjoint (g • T.interior) T.interior)
    (hcover : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.MeetsEveryOrbit H ℍ (closure T.interior)) :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume T.interior := by
  refine ⟨T.interior_isOpen,⟨T.interior_nonempty,T.interior_isPreconnected⟩,?_,
    halfTurnIdeal_triangle_frontier_null T⟩
  apply exists_fundamentalSet_between _ _ subset_closure hcover
  intro x hx y hy hxy
  obtain ⟨g,hg⟩:=(Quotient.exact hxy : MulAction.orbitRel H ℍ x y)
  change g • y=x at hg
  by_cases he : g=1
  · simpa only [he,one_smul] using hg.symm
  · exact False.elim (disjoint_left.mp (hpacking g he) ⟨y,hy,hg⟩ hx)

/-- Faithful boundary action transfers the proved sphere packing to the
unchanged native isometries and the same actual half-plane set. -/
theorem halfTurnIdeal_native_packing_of_boundary
    (H : Subgroup (ℍ≃ᵢℍ)) (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (U : Set ℍ)
    (hpack : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsMobiusPacking (nativeConformalSubgroupMobiusHom H hConf).range
      (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' U)) :
    ∀g : H,g≠1→Disjoint (g • U) U := by
  let f:=nativeConformalSubgroupMobiusHom H hConf
  intro g hgne
  let a : f.range:=⟨f g,⟨g,rfl⟩⟩
  have ha : a≠1:=by
    intro he
    have hf : f g=f 1:=(congrArg Subtype.val he).trans f.map_one.symm
    exact hgne ((nativeConformalSubgroupMobiusHom_isometry H hConf).injective hf)
  apply disjoint_left.mpr
  rintro z ⟨x,hx,rfl⟩ hz
  apply disjoint_left.mp (hpack a ha)
  · refine ⟨_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint x,⟨x,hx,rfl⟩,?_⟩
    exact nativeConformalSubgroupMobiusHom_action H hConf g x
  · exact ⟨g•x,hz,rfl⟩

