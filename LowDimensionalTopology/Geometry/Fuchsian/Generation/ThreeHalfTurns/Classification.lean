    · have hbX : b-X<0 := by linarith
      have haX : a-X<0 := by linarith
      have hab0 : a-b<0 := by linarith
      rw [show σ=(-1 : ℝ) by simp only [σ,ite_eq_left hab]]
      have hp:=mul_pos (mul_pos (mul_pos (by norm_num : (0 : ℝ)<2)
        (neg_pos.mpr hbX)) (neg_pos.mpr haX)) (neg_pos.mpr hab0)
      nlinarith only [hp]
    · have hbX : 0<b-X := by linarith
      have haX : 0<a-X := by linarith
      have hab0 : a-b<0 := by linarith
      rw [show σ=(-1 : ℝ) by simp only [σ,ite_eq_left hab]]
      have hp:=mul_pos (mul_pos (mul_pos (by norm_num : (0 : ℝ)<2) hbX) haX)
        (neg_pos.mpr hab0)
      nlinarith only [hp]
    · have hbX : 0<b-X := by linarith
      have haX : 0<a-X := by linarith
      have hab0 : 0<a-b := by linarith
      rw [show σ=(1 : ℝ) by simp only [σ,ite_eq_right (by linarith : ¬a<b)]]
      exact mul_pos (mul_pos (mul_pos (by norm_num) hbX) haX) hab0
    · have hbX : b-X<0 := by linarith
      have haX : a-X<0 := by linarith
      have hab0 : 0<a-b := by linarith
