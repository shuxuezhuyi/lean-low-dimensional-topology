/-- The four literal real chains admit a positive real projective chart with
three prescribed endpoint values and the fourth image strictly between them. -/
theorem halfTurnChain_normalizer_four_real_chains (X a b d : ℝ)
    (horder : (a<b ∧ b<d ∧ d<X) ∨ (d<X ∧ X<a ∧ a<b) ∨
      (X<d ∧ d<b ∧ b<a) ∨ (b<a ∧ a<X ∧ X<d)) :
    ∃ (g : GL (Fin 2) ℝ) (s : ℝ), 0<g.val.det ∧ s∈Ioo (-1) 1 ∧
      ((_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((X : ℂ) : OnePoint ℂ)=
