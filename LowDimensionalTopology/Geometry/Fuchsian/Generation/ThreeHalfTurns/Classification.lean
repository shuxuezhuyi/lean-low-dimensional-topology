theorem halfTurn_ideal_triangle_line_normalization
    (ξ η ζ : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (_hξ : ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (_hη : η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hζ : ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hξη : ξ≠η) (hηζ : η≠ζ) (hζξ : ζ≠ξ)
    (L M N : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hL : L.idealEndpoints={ξ,η})
    (hM : M.idealEndpoints={η,ζ}) (hN : N.idealEndpoints={ζ,ξ}) :
    ∃g : GL (Fin 2) ℝ,0<g.val.det ∧
      (g • · : ℍ→ℍ) '' L.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle 0 1 (by norm_num)).carrier ∧
      (((g • · : ℍ→ℍ) '' M.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical (-1)).carrier ∧
        (g • · : ℍ→ℍ) '' N.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 1).carrier) ∨
       ((g • · : ℍ→ℍ) '' M.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 1).carrier ∧
        (g • · : ℍ→ℍ) '' N.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical (-1)).carrier)) := by
  have hζL : ζ∉L.idealEndpoints := by
    rw [hL]
