/-- At every original invariant at least one, the unchanged three actual
half-turns generate a discrete group and their three whole cyclic factors
have genuinely injective free-product evaluation. No discreteness, packing,
ideal triangle, open gap, line or normalizer premise is supplied. -/
theorem threeHalfTurn_large_parameter_discrete_freeProduct (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam : 1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    let J : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![A,B,C]
    let H : Fin 3→Type:=fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))
    let f : ∀i,H i→*_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup:=fun i=>(Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))).subtype
    _root_.LowDimensionalTopology.Geometry.Mobius.IsDiscreteMobiusSubgroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) ∧
      Function.Injective (Monoid.CoprodI.lift f) ∧
      (Monoid.CoprodI.lift f).range=Subgroup.closure
        ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup) := by
  obtain ⟨ξ,η,ζ,hξ,hη,hζ,hξη,hηζ,hζξ,hAξ,hAη,hBη,hBζ,hCζ,hCξ,
    L,M,N,hL,hM,hN,hu,hv,hw⟩:=
    halfTurn_large_parameter_ideal_triangle T A B C hA hB hC hlam
  obtain ⟨p,m,U,hU,hp,hnot,hsub,hcomp,_hdisj,hcross⟩:=
    halfTurn_ideal_triangle_halfplanes ξ η ζ hξ hη hζ hξη hηζ hζξ L M N hL hM hN
  let J : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![A,B,C]
  let v : Fin 3→ℍ:=![T.a,T.b,T.c]
  let lines : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![L,M,N]
  have hJ : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (J i) (v i):=by
    intro i
    fin_cases i
    · exact hA
    · exact hB
    · exact hC
  have hvL : ∀i,v i∈(lines i).carrier:=by
    intro i
    fin_cases i
    · exact hu
    · exact hv
    · exact hw
  have hInv : ∀i,(fun z:ℍ=>J i•z) '' (lines i).carrier=(lines i).carrier:=by
    intro i
    fin_cases i
    · exact halfTurn_line_image_of_exchanged_endpoints A L ξ η hL hAξ hAη
    · exact halfTurn_line_image_of_exchanged_endpoints B M η ζ hM hBη hBζ
    · exact halfTurn_line_image_of_exchanged_endpoints C N ζ ξ hN hCζ hCξ
  have hOuter : ∀i j:Fin 3,i≠j→
      ((lines j).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (lines j) p)ᶜ⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (lines i) p:=by
    intro i j hij
    rw [←hcomp j]
    exact hcross i j hij
  have hRange : range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))=
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    ext g
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [J]
    · rintro (he|he|he)
      · exact ⟨0,he.symm⟩
      · exact ⟨1,he.symm⟩
      · exact ⟨2,he.symm⟩
  have hmain:=halfTurn_three_factor_gap_discrete J v hJ lines hvL hInv p
    (fun i=>(hnot i).1) U hU ⟨p,hp⟩ hsub hOuter
  rwa [hRange] at hmain

end LowDimensionalTopology.Geometry.Fuchsian

