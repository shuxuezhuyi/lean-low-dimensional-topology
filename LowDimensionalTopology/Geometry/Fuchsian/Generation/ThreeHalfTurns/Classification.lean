        _root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((b : ℂ) : OnePoint ℂ)=
          (((1 : ℝ) : ℂ) : OnePoint ℂ) ∧
        _root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((d : ℂ) : OnePoint ℂ)=
          ((s : ℂ) : OnePoint ℂ)) ∨
       (_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((X : ℂ) : OnePoint ℂ)=
          (((1 : ℝ) : ℂ) : OnePoint ℂ) ∧
        _root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((a : ℂ) : OnePoint ℂ)=∞ ∧
        _root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((b : ℂ) : OnePoint ℂ)=
          (((-1 : ℝ) : ℂ) : OnePoint ℂ) ∧
        _root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g) ((d : ℂ) : OnePoint ℂ)=
          ((s : ℂ) : OnePoint ℂ))) := by
  let σ : ℝ:=if a<b then -1 else 1
  let M : Matrix (Fin 2) (Fin 2) ℝ:=
    !![σ*(b+X-2*a),σ*(a*(X+b)-2*X*b);b-X,-a*(b-X)]
  have hdet : M.det=σ*2*(b-X)*(a-X)*(a-b) := by
    rw [Matrix.det_fin_two]
    change σ*(b+X-2*a)*(-a*(b-X))-σ*(a*(X+b)-2*X*b)*(b-X)=_
    ring
  have hpos : 0<M.det := by
    rw [hdet]
