theorem threeHalfTurn_large_parameter_core_area (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam:1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T)
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))) :
    ∃P:HalfPlaneFuchsianGroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)),
    letI:=P.nativeAction
    ∀F:Set ℍ,_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) ℍ volume F →
      volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))≤
        ENNReal.ofReal Real.pi := by
  have hd:=(threeHalfTurn_large_parameter_discrete_freeProduct T A B C hA hB hC hlam).1
  let P:=threeHalfTurn_real_halfPlaneData A B C hd
  obtain ⟨ξ,η,ζ,hξ,hη,hζ,hξη,hηζ,hζξ,hAξ,hAη,hBη,hBζ,hCζ,hCξ,
    L,M,N,hL,hM,hN,hu,hv,hw⟩:=
    halfTurn_large_parameter_ideal_triangle T A B C hA hB hC hlam
  let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
  have hIdeal:=halfTurn_large_actualIdealTriangle_ideal ξ η ζ hξ hη hζ hξη hηζ hζξ
  have hLines:=halfTurn_large_actualIdealTriangle_lines ξ η ζ hξ hη hζ hξη hηζ hζξ
    L M N hL hM hN
  let J:Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![A,B,C]
  let centers:Fin 3→ℍ:=![T.a,T.b,T.c]
  let lines:Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![R.sideLineC,R.sideLineA,R.sideLineB]
  have hJ:∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (J i) (centers i):=by
    intro i
    fin_cases i
    · exact hA
    · exact hB
    · exact hC
  have hCenters:∀i,centers i∈(lines i).carrier:=by
    intro i
    fin_cases i
    · change T.a∈R.sideLineC.carrier
      rw [hLines.2.2]
      exact hu
    · change T.b∈R.sideLineA.carrier
      rw [hLines.1]
      exact hv
    · change T.c∈R.sideLineB.carrier
      rw [hLines.2.1]
      exact hw
  have hInv:∀i,(fun z:ℍ=>J i • z) '' (lines i).carrier=(lines i).carrier:=by
    intro i
    fin_cases i
    · change (fun z:ℍ=>A • z) '' R.sideLineC.carrier=R.sideLineC.carrier
      rw [hLines.2.2]
      exact halfTurn_line_image_of_exchanged_endpoints A L ξ η hL hAξ hAη
    · change (fun z:ℍ=>B • z) '' R.sideLineA.carrier=R.sideLineA.carrier
      rw [hLines.1]
      exact halfTurn_line_image_of_exchanged_endpoints B M η ζ hM hBη hBζ
    · change (fun z:ℍ=>C • z) '' R.sideLineB.carrier=R.sideLineB.carrier
      rw [hLines.2.1]
      exact halfTurn_line_image_of_exchanged_endpoints C N ζ ξ hN hCζ hCξ
  obtain ⟨p,m,_hp,hnot,hsub,hcomp,_hdisj,hcross⟩:=
    halfTurn_ideal_triangle_whole_interior_components R hIdeal.1 hIdeal.2.1 hIdeal.2.2
  have hOuter:∀i j:Fin 3,i≠j→
      ((lines j).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (lines j) p)ᶜ⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (lines i) p:=by
    intro i j hij
    rw [←hcomp j]
    exact hcross i j hij
  have hGenerators:range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))=
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    ext g
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [J]
    · rintro (he|he|he)
      · exact ⟨0,he.symm⟩
      · exact ⟨1,he.symm⟩
      · exact ⟨2,he.symm⟩
  have hPacking:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsMobiusPacking (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))
      (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' R.interior):=by
    rw [←hGenerators]
    exact halfTurn_three_factor_gap_packing J centers hJ lines hCenters hInv p
      (fun i=>(hnot i).1) R.interior hsub hOuter
  refine ⟨P,?_⟩
  intro F hF
  exact threeHalfTurn_ideal_core_area_of_packing A B C P hNE R hIdeal centers hJ hInv hPacking F hF

end LowDimensionalTopology.Geometry.Fuchsian

