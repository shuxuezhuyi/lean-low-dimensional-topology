/-- A true ordinary point of the original invariant boundary produces an actual
maximal boundary-hyperbolic cyclic conjugacy class of the original group. -/
theorem finitelyGenerated_ordinary_boundary_has_boundaryClass
    {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup} (P:UnitDiscFuchsianGroup H)
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H) (hFG:H.FG) (ξ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ:ξ∈frontier P.domain.carrier) (hOrd:ξ∈_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet H) :
    Nonempty (FuchsianBoundaryHyperbolicCyclicConjugacyClasses P.asFuchsianDisc) := by
  let q:=P.asFuchsianDisc.nielsenArcNormalizer hNE
  have hq:=P.asFuchsianDisc.nielsenArcNormalizer_image hNE
  have hinf:=P.asFuchsianDisc.nielsenArcNormalizer_limit hNE
  let K:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate q H
  let Λ:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusLimitSet K
  have hξnot:ξ∉_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusLimitSet H:=hOrd
  have hImage:q.val ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary\Λ:=by
    rw [←P.asFuchsianDisc.nielsen_ordinaryBoundary_image q hq]
    exact mem_image_of_mem q.val ⟨hξ,hξnot⟩
  rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.nielsen_halfPlane_ordinary_representation Λ hinf] at hImage
  obtain ⟨x,hx,_hxe⟩:=hImage
  have hK:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary K:=hNE.conjugation q
  have hInfinite:Λ.Infinite:=fun hf=>_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusLimitSet_not_countable K hK hf.countable
  have hBoundary:Λ⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary:=
    (P.asFuchsianDisc.nielsenConjugate q).nielsenHalfPlane_limit_subset hq
  have hRealNonempty:(_root_.LowDimensionalTopology.Geometry.Hyperbolic.nielsenHalfPlaneRealSet Λ).Nonempty:=
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.nielsenHalfPlaneRealSet_infinite Λ hInfinite hBoundary hinf).nonempty
  obtain ⟨G,hG⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.nielsen_realGap_exists
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.nielsenHalfPlaneRealSet_isClosed Λ (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusLimitSet_isClosed K)) hRealNonempty hx
  obtain ⟨L,hGL⟩:=nielsenGap_original_native_line P hNE G
  have hL:L∈nielsenBoundaryDiscLineFamily P hNE:=⟨G,⟨x,hx,hG⟩,hGL⟩
  obtain ⟨f,hf,_hAxis⟩:=finitelyGenerated_nielsen_boundary_line_boundaryHyperbolic P hNE hFG L hL
  obtain ⟨p,hfp⟩:=_root_.LowDimensionalTopology.Geometry.Mobius.mobius_nonidentity_has_boundary_fixed f.val hf.hyperbolic.1.1
  let M:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusBoundaryStabilizer H p
  have hfM:f.val∈M:=(_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mem_mobiusBoundaryStabilizer H p f.val).mpr ⟨f.property,hfp⟩
  have hMax:IsMaximalCyclicIn H M:=
    nonidentity_stabilizer_isMaximalCyclic P.asFuchsianDisc f.val f.property hf.hyperbolic.1.1 p hfp
  exact ⟨Quotient.mk _ ⟨M,hMax,f,hfM,hf⟩⟩

