  have hNEQ:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary K:=hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius
  let largeSignatureEllipticFinite:Finite (FuchsianCyclicConjugacyClasses Q.asFuchsianDisc .elliptic):=
