/-- The actual three-cone, positive-boundary-end core budget forces exactly
the source's second-kind signature; actual cusps cannot remain in this budget. -/
theorem halfTurn_large_signature_budget (g p t:ℕ) (orders:List ℕ)
    (h2:∀m∈orders,2≤m) (hlen:3≤orders.length) (ht:1≤t)
    (hArea:2*(g:ℝ)-2+(t:ℝ)+(p:ℝ)+
      (orders.map (fun m:ℕ=>1-1/(m:ℝ))).sum≤1/2) :
    g=0 ∧ p=0 ∧ t=1 ∧ orders=[2,2,2] := by
  have hlo:=signature_elliptic_sum_lower orders h2
  have hlR:(3:ℝ)≤orders.length:=by exact_mod_cast hlen
  have htR:(1:ℝ)≤t:=by exact_mod_cast ht
  have hgR:0≤(g:ℝ):=Nat.cast_nonneg _
  have hpR:0≤(p:ℝ):=Nat.cast_nonneg _
  have htotal:1≤p+t:=by omega
  have he:2*(g:ℝ)-2+((p+t:ℕ):ℝ)+
      (orders.map (fun m:ℕ=>1-1/(m:ℝ))).sum=1/2:=by
    push_cast
    apply le_antisymm
    · linarith only [hArea]
    · linarith only [hlo,hlR,htR,hgR,hpR]
  obtain ⟨hg,hpt,ho⟩:=halfTurn_ideal_signature_budget g (p+t) orders h2 hlen htotal he
  exact ⟨hg,by omega,by omega,ho⟩

end LowDimensionalTopology.Geometry.Fuchsian

