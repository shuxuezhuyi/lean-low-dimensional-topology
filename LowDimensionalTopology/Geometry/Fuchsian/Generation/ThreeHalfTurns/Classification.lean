/-- The original three distinct true ideal vertices form a genuine
compactified triangle; no ideal-triangle data is supplied. -/
def halfTurn_large_actualIdealTriangle (ξ η ζ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ:ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hη:η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hζ:ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hξη:ξ≠η) (hηζ:η≠ζ) (hζξ:ζ≠ξ) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle where
  a:=⟨ξ,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHalfPlaneSet_eq_open_union_boundary ▸ Or.inr hξ⟩
  b:=⟨η,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHalfPlaneSet_eq_open_union_boundary ▸ Or.inr hη⟩
  c:=⟨ζ,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHalfPlaneSet_eq_open_union_boundary ▸ Or.inr hζ⟩
  noncollinear:=by
    rintro ⟨L,hA,hB,hC⟩
    have hA':ξ∈L.idealEndpoints:=(L.closedCarrier_mem_ideal_iff _ hξ).mp hA
    have hB':η∈L.idealEndpoints:=(L.closedCarrier_mem_ideal_iff _ hη).mp hB
    have hC':ζ∈L.idealEndpoints:=(L.closedCarrier_mem_ideal_iff _ hζ).mp hC
    obtain ⟨a,b,_,_,_,_,hEnds,_⟩:=L.exists_idealEndpoints_pair
    rw [hEnds] at hA' hB' hC'
    simp only [mem_insert_iff,mem_singleton_iff] at hA' hB' hC'
    aesop

/-- These are all actual ideal vertices in the true compactified disc. -/
theorem halfTurn_large_actualIdealTriangle_ideal (ξ η ζ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ:ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hη:η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hζ:ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hξη:ξ≠η) (hηζ:η≠ζ) (hζξ:ζ≠ξ) :
    let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
    ‖(R.toDiscTriangle.a:ℂ)‖=1 ∧ ‖(R.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(R.toDiscTriangle.c:ℂ)‖=1 := by
  let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
  exact ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm R.a hξ,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm R.b hη,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm R.c hζ⟩

/-- The registered true sides coincide with the original three actual pair
lines, rather than merely sharing labels. -/
theorem halfTurn_large_actualIdealTriangle_lines (ξ η ζ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ:ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hη:η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hζ:ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hξη:ξ≠η) (hηζ:η≠ζ) (hζξ:ζ≠ξ)
    (L M N:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hL:L.idealEndpoints={ξ,η})
    (hM:M.idealEndpoints={η,ζ}) (hN:N.idealEndpoints={ζ,ξ}) :
    let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
    R.sideLineA=M ∧ R.sideLineB=N ∧ R.sideLineC=L := by
  let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
  have hpair (K:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (p q:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHalfPlaneModel)
      (hp:p.val∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hq:q.val∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
      (hpq:p.val≠q.val) (hpK:p∈K.closedCarrier) (hqK:q∈K.closedCarrier) :
      K.idealEndpoints={p.val,q.val}:=by
    obtain ⟨a,b,_,_,_,_,he,_⟩:=K.exists_idealEndpoints_pair
    exact he.trans (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pair_eq_of_two_mem_ne (he ▸ (K.closedCarrier_mem_ideal_iff p hp).mp hpK)
      (he ▸ (K.closedCarrier_mem_ideal_iff q hq).mp hqK) hpq)
  refine ⟨?_,?_,?_⟩
  · apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.idealEndpoints_injective
    exact (hpair R.sideLineA R.b R.c hη hζ hηζ
      ((R.toDiscTriangle.sideLineA.closedCarrier_cayley_mem R.b).mp R.toDiscTriangle.b_mem_sideLineA)
      ((R.toDiscTriangle.sideLineA.closedCarrier_cayley_mem R.c).mp R.toDiscTriangle.c_mem_sideLineA)).trans hM.symm
  · apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.idealEndpoints_injective
    exact (hpair R.sideLineB R.c R.a hζ hξ hζξ
      ((R.toDiscTriangle.sideLineB.closedCarrier_cayley_mem R.c).mp R.toDiscTriangle.c_mem_sideLineB)
      ((R.toDiscTriangle.sideLineB.closedCarrier_cayley_mem R.a).mp R.toDiscTriangle.a_mem_sideLineB)).trans hN.symm
  · apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.idealEndpoints_injective
    exact (hpair R.sideLineC R.a R.b hξ hη hξη
      ((R.toDiscTriangle.sideLineC.closedCarrier_cayley_mem R.a).mp R.toDiscTriangle.a_mem_sideLineC)
      ((R.toDiscTriangle.sideLineC.closedCarrier_cayley_mem R.b).mp R.toDiscTriangle.b_mem_sideLineC)).trans hL.symm

/-- The physical ideal-triangle density area is pi. -/
theorem halfTurn_large_actualIdealTriangle_area (ξ η ζ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ:ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hη:η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hζ:ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hξη:ξ≠η) (hηζ:η≠ζ) (hζξ:ζ≠ξ) :
    let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
    volume R.interior=ENNReal.ofReal Real.pi := by
  let R:=halfTurn_large_actualIdealTriangle ξ η ζ hξ hη hζ hξη hηζ hζξ
  obtain ⟨ha,hb,hc⟩:=halfTurn_large_actualIdealTriangle_ideal ξ η ζ hξ hη hζ hξη hηζ hζξ
  change volume R.interior=ENNReal.ofReal Real.pi
  have hA:R.alpha=0:=R.toDiscTriangle.alpha_of_ideal ha
  have hB:R.beta=0:=R.toDiscTriangle.beta_of_ideal hb
  have hC:R.gamma=0:=R.toDiscTriangle.gamma_of_ideal hc
  rw [R.area_eq_angle_defect,hA,hB,hC]
  simp only [sub_zero]


/-- The actual original half-plane action has precisely the unchanged three
native matrix generators as its whole image. -/
theorem threeHalfTurn_nativeHom_range (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))) :
    P.nativeHom.range=Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C}:Set (ℍ≃ᵢℍ)) := by
  let H:=Subgroup.closure
    ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  let N:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C}:Set (ℍ≃ᵢℍ))
  have hmatrix (X:Matrix.SpecialLinearGroup (Fin 2) ℝ) (hX:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X∈H) :
      P.nativeHom ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X,hX⟩=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry X:=by
    apply DFunLike.ext
    intro z
    exact P.nativeAction_realSL ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X,hX⟩ X rfl z
  have hall:∀g (hg:g∈H),P.nativeHom ⟨g,hg⟩∈N:=by
    intro g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      rcases hg with rfl|rfl|rfl
      · rw [hmatrix]
        exact Subgroup.subset_closure (by simp)
      · rw [hmatrix]
        exact Subgroup.subset_closure (by simp)
      · rw [hmatrix]
        exact Subgroup.subset_closure (by simp)
    | one =>
      change P.nativeHom 1∈N
      rw [map_one]
      exact N.one_mem
    | mul x y hx hy ihx ihy =>
      change P.nativeHom (⟨x,hx⟩*⟨y,hy⟩)∈N
      rw [map_mul]
      exact N.mul_mem ihx ihy
    | inv x hx ih =>
      change P.nativeHom (⟨x,hx⟩⁻¹)∈N
      rw [map_inv]
      exact N.inv_mem ih
  apply le_antisymm
  · rintro g ⟨h,rfl⟩
    exact hall h.val h.property
  · apply (Subgroup.closure_le _).mpr
    rintro g (rfl|rfl|rfl)
