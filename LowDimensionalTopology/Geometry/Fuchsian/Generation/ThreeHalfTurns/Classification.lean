/-- Actual exchange of the two original ideal endpoints preserves the entire
original geodesic, as an exact image in the hyperbolic plane. -/
theorem halfTurn_line_image_of_exchanged_endpoints
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine)
    (ξ η : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) (hL : L.idealEndpoints={ξ,η})
    (hξη : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ=η) (hηξ : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val η=ξ) :
    (fun z:ℍ=>A•z) '' L.carrier=L.carrier := by
  let g:=Matrix.SpecialLinearGroup.mapGL ℝ A
  let M:=L.realGLMap g
  have hg : 0<g.val.det:=by
    change 0<Matrix.det A.val
    rw [A.det_coe]
    norm_num
  have hfrac : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val=_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g):=by
    simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius,MonoidHom.comp_apply,_root_.LowDimensionalTopology.Geometry.Mobius.invariantDisc_specialLinear_action,
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_matrix,g]
  have hM : M=L:=by
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.idealEndpoints_injective
    rw [L.idealEndpoints_realGL_image M g hg (L.realGLMap_carrier g).symm,
      ←hfrac,hL,image_pair,hξη,hηξ,Set.pair_comm]
  change (fun z:ℍ=>g•z) '' L.carrier=L.carrier
  rw [←L.realGLMap_carrier g,show L.realGLMap g=L from hM]

/-- A true half-turn takes every point of the inner component into the
literal complement of that component together with its original line. -/
theorem halfTurn_inner_to_true_outer
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hu : u∈L.carrier)
    (hL : (fun z:ℍ=>A•z) '' L.carrier=L.carrier)
    (p : ℍ) (hp : p∉L.carrier) (z : ℍ) (hz : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L p) :
    A•z∈(L.carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L p)ᶜ := by
  intro hmem
  rcases hmem with hAz|hIn
  · rw [←hL] at hAz
    obtain ⟨x,hx,he⟩:=hAz
    have heq : x=z:=MulAction.injective A he
    have hzL : z∉L.carrier:=connectedComponentIn_subset L.carrierᶜ p hz
    exact hzL (heq ▸ hx)
  · exact halfTurn_open_halfPlane_opposite A u hA L hu p hp z hz hIn

/-- Three actual half-turn factors with their true geodesic component gap
generate a genuinely discrete whole Mobius subgroup. The gap and component
inclusions are geometric inputs of this internal consumer, not packing or
discreteness assumptions. -/
theorem halfTurn_three_factor_gap_discrete
    (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : Fin 3→ℍ)
    (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i)) (L : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine)
    (hu : ∀i,u i∈(L i).carrier)
    (hLines : ∀i,(fun z:ℍ=>A i•z) '' (L i).carrier=(L i).carrier)
    (p : ℍ) (hp : ∀i,p∉(L i).carrier) (U : Set ℍ)
    (hU : IsOpen U) (hUn : U.Nonempty)
    (hsub : ∀i,U⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p)
    (hcross : ∀i j:Fin 3,i≠j→
      ((L j).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L j) p)ᶜ⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p) :
    let H : Fin 3→Type:=fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))
    let f : ∀i,H i→*_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup:=fun i=>(Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))).subtype
    _root_.LowDimensionalTopology.Geometry.Mobius.IsDiscreteMobiusSubgroup (Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))) ∧
      Function.Injective (Monoid.CoprodI.lift f) ∧
      (Monoid.CoprodI.lift f).range=Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))) := by
  classical
  let : MetricSpace _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=_root_.LowDimensionalTopology.Geometry.Mobius.complexChordalMetricSpace
  let H : Fin 3→Type:=fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))
  let f : ∀i,H i→*_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup:=fun i=>(Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))).subtype
  let B : Fin 3→Set ℍ:=fun i=>((L i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p)ᶜ
  let O : Fin 3→Set _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=fun i=>_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' B i
  let V : Set _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' U
  have move (i : Fin 3) (z : ℍ) (hz : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p) : A i•z∈B i:=
    halfTurn_inner_to_true_outer (A i) (u i) (hA i) (L i) (hu i)
      (hLines i) p (hp i) z hz
  have hpp : Pairwise fun i j=>∀g:H i,g≠1→f i g • O j⊆O i:=by
    intro i j hij g hgne
    have hg : g.val=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i):=halfTurn_zpowers_nonidentity
      (A i) (u i) (hA i) g.val g.property (fun he=>hgne (Subtype.ext he))
    rintro q ⟨v,⟨z,hz,rfl⟩,rfl⟩
    change g.val.val (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)∈_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' B i
    rw [hg]
    change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)).val (((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))∈_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' B i
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action]
    exact ⟨A i•z,move i z (hcross i j hij hz),rfl⟩
  have hstart : ∀i (g:H i),g≠1→f i g • V⊆O i:=by
    intro i g hgne
    have hg : g.val=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i):=halfTurn_zpowers_nonidentity
      (A i) (u i) (hA i) g.val g.property (fun he=>hgne (Subtype.ext he))
    rintro q ⟨v,⟨z,hz,rfl⟩,rfl⟩
    change g.val.val (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)∈_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' B i
    rw [hg]
    change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)).val (((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))∈_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' B i
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action]
    exact ⟨A i•z,move i z (hsub i hz),rfl⟩
  have hgap : ∀i,Disjoint (O i) V:=by
    intro i
    apply Set.disjoint_left.mpr
    rintro q ⟨z,hz,rfl⟩ ⟨w,hw,hwe⟩
    have he : w=z:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_isOpenEmbedding.injective hwe
    exact hz (Or.inr (hsub i (he ▸ hw)))
  let : ContinuousSMul _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=⟨by
      change Continuous (fun p:_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup×_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex=>_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusContinuousMap p.1 p.2)
      exact continuous_eval.comp
        ((_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusContinuousMap_isometry.continuous.comp continuous_fst).prodMk continuous_snd)⟩
  have hOn : ∀i,(O i).Nonempty:=by
    intro i
    obtain ⟨z,hz⟩:=hUn
    exact ⟨_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (A i•z),⟨A i•z,move i z (hsub i hz),rfl⟩⟩
  have hOd : Pairwise fun i j=>Disjoint (O i) (O j):=by
    intro i j hij
    apply Set.disjoint_left.mpr
    rintro q ⟨z,hz,rfl⟩ ⟨w,hw,hwe⟩
    have he : w=z:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_isOpenEmbedding.injective hwe
    exact hz (Or.inr (hcross i j hij (he ▸ hw)))
  have hinj : Function.Injective (Monoid.CoprodI.lift f):=
    Monoid.CoprodI.lift_injective_of_ping_pong f (Or.inl (by simp)) O hOn hOd hpp
  have hd : DiscreteTopology (Monoid.CoprodI.lift f).range:=
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.discreteTopology_range_of_pingPong_gap f O V
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_isOpenEmbedding.isOpenMap U hU)
      (hUn.image _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint) hpp hstart hgap
  have hR : (Monoid.CoprodI.lift f).range=
      Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))):=by
    apply le_antisymm
    · apply Monoid.CoprodI.lift_range_le
      intro i x hx
      obtain ⟨g,rfl⟩:=hx
      exact (Subgroup.zpowers_le.mpr (Subgroup.subset_closure (mem_range_self i))) g.property
    · apply (Subgroup.closure_le _).mpr
      rintro x ⟨i,rfl⟩
      refine ⟨Monoid.CoprodI.of (⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i),Subgroup.mem_zpowers _⟩:H i),?_⟩
      exact Monoid.CoprodI.lift_of f _
  rw [hR] at hd
  exact ⟨hd,hinj,hR⟩

