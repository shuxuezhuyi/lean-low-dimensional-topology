/-- The genuine Cayley model preserves the actual Nielsen core density area,
so the half-plane estimate applies to the unchanged actual signature model. -/
theorem halfTurn_cayley_nielsen_core_area {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P:HalfPlaneFuchsianGroup H) (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H)
    (F:Set ℍ) (hF:MeasurableSet F) :
    fuchsianNielsenCoreArea P.cayleyData (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius)
      (P.cayleyCoordinate '' F)=
      volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE)) := by
  let halfTurnCayleyCoreSphereMeasurable:MeasurableSpace _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=borel _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex
  let halfTurnCayleyCoreSphereBorel:BorelSpace _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=⟨rfl⟩
  let Q:=P.cayleyData
  let e:=P.cayleyCoordinate
  have hdisc:Q.asFuchsianDisc=P.asFuchsianDisc.nielsenConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius:=by
    apply fuchsianDisc_eq_of_carrier_eq
    exact cayleyMobius_image_openHalfPlane.symm
  have hpoint (z:ℍ):(e z).val=_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z):=by
    have he:=_root_.LowDimensionalTopology.Geometry.Surfaces.discFiniteHomeomorph_symm_coe (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)
    change _=_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val (((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius_apply,_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedCayley_halfPlane]
    exact he
  let N:=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE
  have hN:_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val '' P.asFuchsianDisc.nielsenRegion hNE=
      Q.asFuchsianDisc.nielsenRegion (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius):=by
    rw [hdisc]
    exact nielsenRegion_conjugation_image P.asFuchsianDisc hNE _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius
  have hmap:e '' N=fuchsianNielsenCore Q (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius):=by
    apply subset_antisymm
    · rintro _ ⟨z,hz,rfl⟩
      change (e z).val∈Q.asFuchsianDisc.nielsenRegion (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius)
      rw [hpoint,←hN]
      exact ⟨_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z,hz,rfl⟩
    · intro y hy
      change y.val∈Q.asFuchsianDisc.nielsenRegion (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius) at hy
      obtain ⟨x,hx,hxy⟩:=hN.symm ▸ hy
      have hxR:x∈range _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint:=by
        rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_range]
        exact (P.asFuchsianDisc.nielsenRegion_properties hNE).1 hx
      obtain ⟨z,rfl⟩:=hxR
      exact ⟨z,hx,Subtype.ext ((hpoint z).trans hxy)⟩
  have hm:MeasurableSet (F∩N):=hF.inter
    (((P.asFuchsianDisc.nielsenRegion_properties hNE).2.2.1.preimage
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_isOpenEmbedding.continuous).measurableSet)
  have him:e '' (F∩N)=e '' F∩fuchsianNielsenCore Q (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius):=by
    rw [image_inter e.injective,hmap]
  change Q.area (e '' F∩fuchsianNielsenCore Q (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius))=volume (F∩N)
  rw [←him,←P.cayleyCoordinate_area_map,
    Measure.map_apply e.continuous.measurable (e.measurableEmbedding.measurableSet_image.mpr hm)]
  rw [e.injective.preimage_image]

