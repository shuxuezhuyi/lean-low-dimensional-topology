/-- Genuine pair lines of three distinct actual ideal vertices have three
pairwise disjoint outer components and a nonempty open inner gap. All
components and the gap are constructed from those original lines. -/
theorem halfTurn_ideal_triangle_halfplanes
    (ξ η ζ : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ : ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hη : η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hζ : ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) (hξη : ξ≠η) (hηζ : η≠ζ) (hζξ : ζ≠ξ)
    (L M N : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hL : L.idealEndpoints={ξ,η})
    (hM : M.idealEndpoints={η,ζ}) (hN : N.idealEndpoints={ζ,ξ}) :
    let S : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![L,M,N]
    ∃(q : ℍ)(m : Fin 3→ℍ)(U : Set ℍ),IsOpen U ∧ q∈U ∧
      (∀i : Fin 3,q∉(S i).carrier ∧ m i∉(S i).carrier) ∧
      (∀i : Fin 3,U⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q) ∧
      (∀i : Fin 3,_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
        ((S i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q)ᶜ) ∧
      (Pairwise fun i j : Fin 3=>Disjoint
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j))) ∧
      (∀i j : Fin 3,i≠j→ _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j)⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q) := by
  let S : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![L,M,N]
  obtain ⟨g,hg,hgL,hgMN⟩:=halfTurn_ideal_triangle_line_normalization
    ξ η ζ hξ hη hζ hξη hηζ hζξ L M N hL hM hN
  let f : ℍ≃ᵢℍ:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g
  obtain ⟨U₀,hU₀,hq₀,hnot₀,hsub₀,hcomp₀,hdisj₀,houter₀⟩:=halfTurn_standard_ideal_halfplanes
  have hTransport (σ : Equiv.Perm (Fin 3))
      (hLines : ∀i : Fin 3,f '' (S i).carrier=(halfTurnStandardIdealLine (σ i)).carrier) :
      ∃(q : ℍ)(m : Fin 3→ℍ)(U : Set ℍ),IsOpen U ∧ q∈U ∧
        (∀i : Fin 3,q∉(S i).carrier ∧ m i∉(S i).carrier) ∧
        (∀i : Fin 3,U⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q) ∧
        (∀i : Fin 3,_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
          ((S i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q)ᶜ) ∧
        (Pairwise fun i j : Fin 3=>Disjoint
          (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j))) ∧
        (∀i j : Fin 3,i≠j→ _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j)⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q) := by
    let q:=f.symm halfTurnStandardIdealInnerPoint
    let m : Fin 3→ℍ:=fun i=>f.symm (halfTurnStandardIdealOuterPoint (σ i))
    let U:=f ⁻¹' U₀
    have hnot (i : Fin 3) : q∉(S i).carrier ∧ m i∉(S i).carrier := by
      constructor
      · intro hx
        have hh:=mem_image_of_mem f hx
        rw [hLines i] at hh
        exact (hnot₀ (σ i)).1 (by simpa only [q,f.apply_symm_apply] using hh)
      · intro hx
        have hh:=mem_image_of_mem f hx
        rw [hLines i] at hh
        exact (hnot₀ (σ i)).2 (by simpa only [m,f.apply_symm_apply] using hh)
    have hInnerImage (i : Fin 3) : f '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q=
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) halfTurnStandardIdealInnerPoint := by
      simpa only [q,f.apply_symm_apply] using
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane f (S i) _ (hLines i) q (hnot i).1
    have hOuterImage (i : Fin 3) : f '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) (halfTurnStandardIdealOuterPoint (σ i)) := by
      simpa only [m,f.apply_symm_apply] using
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane f (S i) _ (hLines i) (m i) (hnot i).2
    have hInner (i : Fin 3) (z : ℍ) : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) q ↔
        f z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) halfTurnStandardIdealInnerPoint := by
      rw [←hInnerImage i]
      exact f.injective.mem_set_image.symm
    have hOuter (i : Fin 3) (z : ℍ) : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i) ↔
        f z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i))
          (halfTurnStandardIdealOuterPoint (σ i)) := by
      rw [←hOuterImage i]
      exact f.injective.mem_set_image.symm
    have hLine (i : Fin 3) (z : ℍ) : z∈(S i).carrier ↔
        f z∈(halfTurnStandardIdealLine (σ i)).carrier := by
      rw [←hLines i]
      exact f.injective.mem_set_image.symm
    refine ⟨q,m,U,hU₀.preimage f.continuous,?_,hnot,?_,?_,?_,?_⟩
    · change f (f.symm halfTurnStandardIdealInnerPoint)∈U₀
      rwa [f.apply_symm_apply]
    · intro i z hz
      exact (hInner i z).mpr (hsub₀ (σ i) hz)
    · intro i
      ext z
      rw [hOuter i z,hcomp₀ (σ i)]
      simp only [mem_compl_iff,mem_union,←hLine i z,←hInner i z]
    · intro i j hij
      apply disjoint_left.mpr
      intro z hzi hzj
      exact disjoint_left.mp (hdisj₀ (fun he=>hij (σ.injective he)))
        ((hOuter i z).mp hzi) ((hOuter j z).mp hzj)
    · intro i j hij z hz
      exact (hInner i z).mpr (houter₀ (σ i) (σ j) (fun he=>hij (σ.injective he))
        ((hOuter j z).mp hz))
  rcases hgMN with ⟨hgM,hgN⟩|⟨hgM,hgN⟩
  · apply hTransport (Equiv.refl _)
    intro i
    fin_cases i
    · exact hgL
    · exact hgM
    · exact hgN
  · apply hTransport (Equiv.swap 1 2)
    intro i
    fin_cases i
    · exact hgL
    · exact hgM
    · exact hgN

end LowDimensionalTopology.Geometry.Fuchsian

