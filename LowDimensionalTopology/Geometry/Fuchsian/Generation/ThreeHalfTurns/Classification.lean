/-- For the original matrix-generated group, genuine ideal chamber packing
already bounds its actual Nielsen core area by pi. No whole-plane cover or
fundamental-domain identity for the chamber is assumed. -/
theorem threeHalfTurn_ideal_core_area_of_packing
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    (R:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(R.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(R.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(R.toDiscTriangle.c:ℂ)‖=1)
    (centers:Fin 3→ℍ)
    (hAt:∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt ((![A,B,C]:Fin 3→_) i) (centers i))
    (hLines:∀i,(fun z:ℍ=>(![A,B,C]:Fin 3→_) i • z) ''
      ((![(R.sideLineC),(R.sideLineA),(R.sideLineB)]:Fin 3→_) i).carrier=
      ((![(R.sideLineC),(R.sideLineA),(R.sideLineB)]:Fin 3→_) i).carrier)
    (hpacking:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsMobiusPacking (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))
      (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' R.interior)) (F:Set ℍ) :
    letI:=P.nativeAction
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) ℍ volume F →
    volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))≤
      ENNReal.ofReal Real.pi := by
  let N:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C}:Set (ℍ≃ᵢℍ))
  let J:Fin 3→(ℍ≃ᵢℍ):=![_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A]
  have hRange:range J=({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C}:Set (ℍ≃ᵢℍ)):=by
    ext g
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [J]
    · rintro (he|he|he)
      · exact ⟨2,he.symm⟩
      · exact ⟨0,he.symm⟩
      · exact ⟨1,he.symm⟩
  have hN:Subgroup.closure (range J)=N:=congrArg Subgroup.closure hRange
  have hG:P.nativeHom.range=Subgroup.closure (range J):=by
    rw [hN]
    exact threeHalfTurn_nativeHom_range A B C P
  have hpack:∀g:N,g≠1→Disjoint (g • R.interior) R.interior:=by
    apply halfTurnIdeal_native_packing_of_boundary N (threeHalfTurn_native_group_conformal A B C)
    rwa [threeHalfTurn_native_group_mobius_image A B C]
  have hpair:∀g∈Subgroup.closure (range J),∀h∈Subgroup.closure (range J),g≠h→
      Disjoint (g '' R.interior) (h '' R.interior):=by
    intro g hg h hh hne
    rw [hN] at hg hh
    let a:N:=⟨h⁻¹*g,N.mul_mem (N.inv_mem hh) hg⟩
    have ha:a≠1:=by
      intro he
      have he':h⁻¹*g=1:=congrArg Subtype.val he
      exact hne (inv_mul_eq_one.mp he').symm
    apply disjoint_left.mpr
    rintro z ⟨x,hx,hxz⟩ ⟨y,hy,hyz⟩
    apply disjoint_left.mp (hpack a ha) ?_ hy
    refine ⟨x,hx,?_⟩
    change (h⁻¹*g) x=y
    change h.symm (g x)=y
    rw [hxz,←hyz,h.symm_apply_apply]
  have hJ:∀i,J i*J i=1:=by
    have order_two (i:Fin 3) :
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry ((![A,B,C]:Fin 3→_) i)*_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry ((![A,B,C]:Fin 3→_) i)=1:=by
      have he:orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry ((![A,B,C]:Fin 3→_) i))=2:=
        (hSLIsometry_orderOf_eq_realSLMobius _).trans (hAt i).1
      have hh:=pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry ((![A,B,C]:Fin 3→_) i))
      rwa [he,pow_two] at hh
    intro i
    fin_cases i
    · exact order_two 1
    · exact order_two 2
    · exact order_two 0
  have hJL:∀i,J i '' (R.nativeLine i).carrier=(R.nativeLine i).carrier:=by
    intro i
    fin_cases i
    · exact hLines 1
    · exact hLines 2
    · exact hLines 0
  have hcore:=halfTurnIdealPatch_nielsen_core_cover P hNE R hideal J hJ hJL hpair hG
  let largeCoreOriginalAction:=P.nativeAction
  intro hF
  have hcover:_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE⊆
      ⋃g:(Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)),
        g • closure R.interior:=by
    intro z hz
    obtain ⟨g,hg,x,hx,rfl⟩:=mem_iUnion₂.mp (hcore hz)
    have hg':g∈P.nativeHom.range:=by rwa [hG]
    obtain ⟨a,rfl⟩:=hg'
    exact mem_iUnion.mpr ⟨a,⟨x,hx,rfl⟩⟩
  calc
    _≤volume (closure R.interior):=
      halfTurnIdealPatch_core_area_le_cover P hNE (closure R.interior) F hF hcover
    _=volume R.interior:=measure_closure_of_null_frontier (halfTurnIdeal_triangle_frontier_null R)
    _=ENNReal.ofReal Real.pi:=by
      have hA:R.alpha=0:=R.toDiscTriangle.alpha_of_ideal hideal.1
      have hB:R.beta=0:=R.toDiscTriangle.beta_of_ideal hideal.2.1
      have hC:R.gamma=0:=R.toDiscTriangle.gamma_of_ideal hideal.2.2
      rw [R.area_eq_angle_defect,hA,hB,hC,sub_zero,sub_zero,sub_zero]

