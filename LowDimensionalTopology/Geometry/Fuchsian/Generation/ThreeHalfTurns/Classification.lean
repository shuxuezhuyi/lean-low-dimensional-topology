    exact fun h=>h.elim hζξ hηζ.symm
  obtain ⟨g,hg,hζi,hgL⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneLine_ideal_point_normalizer L ζ hζ hζL
  let F:=_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g)
  have hEnds:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realGL_image_idealEndpoints g hg L _ hgL
  have hx : F ξ=(-1 : ℂ) ∨ F ξ=(1 : ℂ) := by
    have hx : F ξ∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle 0 1 (by norm_num)).idealEndpoints := by
      rw [←hEnds,hL]
      exact mem_image_of_mem F (by simp)
    simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.circle_idealEndpoints,zero_sub,zero_add,mem_insert_iff,mem_singleton_iff,
      Complex.ofReal_neg,Complex.ofReal_one] using hx
  have hy : F η=(-1 : ℂ) ∨ F η=(1 : ℂ) := by
    have hy : F η∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle 0 1 (by norm_num)).idealEndpoints := by
      rw [←hEnds,hL]
      exact mem_image_of_mem F (by simp)
    simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.circle_idealEndpoints,zero_sub,zero_add,mem_insert_iff,mem_singleton_iff,
      Complex.ofReal_neg,Complex.ofReal_one] using hy
  have hxy : F ξ≠F η:=fun he=>hξη ((_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinearHomeomorph (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g)).injective he)
  have hNs : N.idealEndpoints={ξ,ζ}:=hN.trans (Set.pair_comm ζ ξ)
  refine ⟨g,hg,hgL,?_⟩
  rcases hx with hx|hx <;> rcases hy with hy|hy
  · exact False.elim (hxy (hx.trans hy.symm))
  · exact Or.inr ⟨halfTurn_ideal_line_image_vertical g hg M η ζ 1 hM hy hζi,
      halfTurn_ideal_line_image_vertical g hg N ξ ζ (-1) hNs
        (by simpa only [Complex.ofReal_neg,Complex.ofReal_one] using hx) hζi⟩
  · exact Or.inl ⟨halfTurn_ideal_line_image_vertical g hg M η ζ (-1) hM
      (by simpa only [Complex.ofReal_neg,Complex.ofReal_one] using hy) hζi,
      halfTurn_ideal_line_image_vertical g hg N ξ ζ 1 hNs hx hζi⟩
  · exact False.elim (hxy (hx.trans hy.symm))

