/-- The unchanged actual group generated by the three geometric half-turns. -/
def halfTurnFreeProductGroup (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup := Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))

/-- The actual map from the three actual cyclic factors to the original group. -/
def halfTurnFreeProductLift (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    CoprodI (fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))→*_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup :=
  CoprodI.lift (fun i=>(Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))).subtype)

/-- Its actual range is the whole original generated group. -/
theorem halfTurnFreeProductLift_range (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    (halfTurnFreeProductLift A).range=halfTurnFreeProductGroup A := by
  rw [halfTurnFreeProductLift,CoprodI.range_eq_iSup]
  simp only [Subgroup.range_subtype]
  apply le_antisymm
  · apply iSup_le
    intro i
    apply Subgroup.zpowers_le.mpr
    exact Subgroup.subset_closure ⟨i,rfl⟩
  · change Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))≤_
    rw [Subgroup.closure_le]
    rintro _ ⟨i,rfl⟩
    exact (le_iSup (fun j=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j))) i)
      (Subgroup.mem_zpowers _)

/-- Faithfulness of the actual free-product map identifies it with the entire
original group, without a supplied range or generation assumption. -/
def halfTurnFreeProductEquiv (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hL : Function.Injective (halfTurnFreeProductLift A)) :
    CoprodI (fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))≃*halfTurnFreeProductGroup A :=
  (MonoidHom.ofInjective hL).trans (MulEquiv.subgroupCongr (halfTurnFreeProductLift_range A))

/-- The unique nontrivial character of an actual order-two cyclic factor. -/
def halfTurnFreeProduct_factorCharacter (g : _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup) (hg : orderOf g=2) :
    Subgroup.zpowers g→*Multiplicative (ZMod 2) :=
  monoidHomOfForallMemZpowers
    (g:=⟨g,Subgroup.mem_zpowers g⟩)
    (fun x=>by
      obtain ⟨n,hn⟩:=x.property
      exact ⟨n,Subtype.ext hn⟩)
    (show orderOf (Multiplicative.ofAdd (1:ZMod 2))∣
      orderOf (⟨g,Subgroup.mem_zpowers g⟩:Subgroup.zpowers g) by
      rw [Subgroup.orderOf_mk,hg,orderOf_ofAdd_eq_addOrderOf,ZMod.addOrderOf_one])

theorem halfTurnFreeProduct_factorCharacter_generator (g : _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
    (hg : orderOf g=2) :
    halfTurnFreeProduct_factorCharacter g hg ⟨g,Subgroup.mem_zpowers g⟩=
      Multiplicative.ofAdd (1:ZMod 2) := by
  exact monoidHomOfForallMemZpowers_apply_gen _ _

/-- The literal original generator as an element of its whole generated group. -/
def halfTurnFreeProductGenerator (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (i : Fin 3) :
    halfTurnFreeProductGroup A := ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i),Subgroup.subset_closure ⟨i,rfl⟩⟩

/-- The `i`th parity character on the actual whole original generated group. -/
def halfTurnFreeProductCharacter (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (u : Fin 3→ℍ) (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i))
    (hL : Function.Injective (halfTurnFreeProductLift A)) (i : Fin 3) :
    halfTurnFreeProductGroup A→*Multiplicative (ZMod 2) :=
  (CoprodI.lift (fun j=>if i=j then halfTurnFreeProduct_factorCharacter (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j))
    (hA j).1 else 1)).comp (halfTurnFreeProductEquiv A hL).symm.toMonoidHom

/-- Each actual generator has the corresponding Kronecker parity value. -/
theorem halfTurnFreeProductCharacter_generator
    (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : Fin 3→ℍ)
    (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i))
    (hL : Function.Injective (halfTurnFreeProductLift A)) (i j : Fin 3) :
    halfTurnFreeProductCharacter A u hA hL i (halfTurnFreeProductGenerator A j)=
      if i=j then Multiplicative.ofAdd (1:ZMod 2) else 1 := by
  let x : Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j)):=
    ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j),Subgroup.mem_zpowers _⟩
  let v : CoprodI (fun i=>Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))):=CoprodI.of x
  have he : halfTurnFreeProductEquiv A hL v=halfTurnFreeProductGenerator A j:=by
    apply Subtype.ext
    change halfTurnFreeProductLift A (CoprodI.of x)=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j)
    rw [halfTurnFreeProductLift,CoprodI.lift_of]
    rfl
  have hs : (halfTurnFreeProductEquiv A hL).symm (halfTurnFreeProductGenerator A j)=v:=by
    rw [←he,MulEquiv.symm_apply_apply]
  unfold halfTurnFreeProductCharacter
  simp only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,hs]
  dsimp only [v]
  rw [CoprodI.lift_of]
  by_cases hij : i=j
  · simp only [hij,ite_true]
    exact halfTurnFreeProduct_factorCharacter_generator _ _
  · simp only [hij,ite_false,MonoidHom.one_apply]

/-- Distinct actual factors cannot be conjugate by any element of the whole
original generated group, as detected by their genuine parity characters. -/
theorem halfTurnFreeProduct_generators_not_conjugate
    (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : Fin 3→ℍ)
    (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i))
    (hL : Function.Injective (halfTurnFreeProductLift A))
    (i j : Fin 3) (hij : i≠j) (g : halfTurnFreeProductGroup A) :
    g.val*_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)*g.val⁻¹≠_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A j) := by
  intro he
  have heH : g*halfTurnFreeProductGenerator A i*g⁻¹=halfTurnFreeProductGenerator A j:=Subtype.ext he
  have hh:=congrArg (halfTurnFreeProductCharacter A u hA hL i) heH
  rw [map_mul,map_mul,map_inv,halfTurnFreeProductCharacter_generator,
    halfTurnFreeProductCharacter_generator] at hh
  simp only [ite_true,hij,ite_false] at hh
  have hone : (Multiplicative.ofAdd (1:ZMod 2):Multiplicative (ZMod 2))=1:=by
    simpa only [mul_comm,mul_left_comm,mul_assoc,mul_inv_cancel,mul_one,one_mul] using hh
  have hz : (1:ZMod 2)=0:=congrArg Multiplicative.toAdd hone
  exact one_ne_zero hz

/-- No original real-SL representative of a whole-group element can take one
actual center to a different factor's center. -/
theorem halfTurnFreeProduct_centers_not_realSL_orbit
    (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : Fin 3→ℍ)
    (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i))
    (hL : Function.Injective (halfTurnFreeProductLift A))
    (i j : Fin 3) (hij : i≠j) (q : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hq : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q∈halfTurnFreeProductGroup A) : q•u i≠u j := by
  intro he
  have hc:=(hA i).conjugate q
  rw [he] at hc
  have hg:=hc.unique (hA j)
  rw [map_mul,map_mul,map_inv] at hg
  exact halfTurnFreeProduct_generators_not_conjugate A u hA hL i j hij ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q,hq⟩ hg

/-- The three physical centers belong to pairwise different orbits for the
entire actual original group acting on its original sphere points. -/
theorem halfTurnFreeProduct_centers_not_orbit
    (A : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : Fin 3→ℍ)
    (hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (u i))
    (hL : Function.Injective (halfTurnFreeProductLift A))
    (i j : Fin 3) (hij : i≠j) (g : halfTurnFreeProductGroup A) :
    g.val.val ((u i:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)≠((u j:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) := by
  intro he
  have hle : halfTurnFreeProductGroup A≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius.range:=by
    change Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))≤_
    rw [Subgroup.closure_le]
    rintro _ ⟨k,rfl⟩
    exact ⟨A k,rfl⟩
  obtain ⟨q,hq⟩:=hle g.property
  have hqmem : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius q∈halfTurnFreeProductGroup A:=hq.symm ▸ g.property
  have hcenter : q•u i=u j:=by
    apply UpperHalfPlane.ext
    apply OnePoint.coe_injective
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,hq]
    exact he
  exact halfTurnFreeProduct_centers_not_realSL_orbit A u hA hL i j hij q hqmem hcenter

end LowDimensionalTopology.Geometry.Fuchsian


