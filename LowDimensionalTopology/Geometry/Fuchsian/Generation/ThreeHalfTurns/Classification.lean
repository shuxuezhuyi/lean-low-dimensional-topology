    _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at (u*t) (mul_pos hu (zero_lt_one.trans ht))
  have hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w) T.c:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w
  have hOne : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T=1:=
    halfTurnCanonical_center_triangle_invariant u t hu ht w hw htrace
  have h:=threeHalfTurn_large_parameter_discrete_freeProduct T _ _ _ hA hB hC
    (by rw [hOne])
  exact ⟨h.1,h.2.1⟩

/-- The unchanged whole native group cannot identify different actual
canonical half-turn centers; the three proved parity characters detect this. -/
theorem halfTurnIdeal_canonical_centers_orbits
    (u t : ℝ) (hu : 0<u) (ht : 1<t) (w : ℍ) (hw : 0<w.re)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2) :
    let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu
    let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))
    let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
    let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
    let centers:Fin 3→ℍ:=![_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu,
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu (zero_lt_one.trans ht)),w]
    ∀(i j : Fin 3)(g : H),g•centers i=centers j→i=j := by
  let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu
  let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))
  let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
  let J : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![U,V,W]
  let centers:Fin 3→ℍ:=![_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu (zero_lt_one.trans ht)),w]
  have hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (J i) (centers i):=by
    intro i
    fin_cases i
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at u hu
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at (u*t) (mul_pos hu (zero_lt_one.trans ht))
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w
  have hL : Function.Injective (halfTurnFreeProductLift J):=
    (halfTurnIdeal_canonical_discrete_freeProduct u t hu ht w hw htrace).2
  have hGenerators : range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))=
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius W}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    ext g
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [J]
    · rintro (he|he|he)
      · exact ⟨0,he.symm⟩
      · exact ⟨1,he.symm⟩
      · exact ⟨2,he.symm⟩
  let hConf:=threeHalfTurn_native_group_conformal U V W
  let f:=nativeConformalSubgroupMobiusHom H hConf
  have hRange : f.range=halfTurnFreeProductGroup J:=by
    change _=Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i)))
    rw [hGenerators]
    exact threeHalfTurn_native_group_mobius_image U V W
  intro _ _ _ _ _ i j g hmove
  by_contra hij
  have hmem : f g∈halfTurnFreeProductGroup J:=by
    rw [←hRange]
    exact ⟨g,rfl⟩
  have hne:=halfTurnFreeProduct_centers_not_orbit J centers hA hL i j hij ⟨f g,hmem⟩
  apply hne
  exact (nativeConformalSubgroupMobiusHom_action H hConf g (centers i)).trans
    (congrArg _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint hmove)

