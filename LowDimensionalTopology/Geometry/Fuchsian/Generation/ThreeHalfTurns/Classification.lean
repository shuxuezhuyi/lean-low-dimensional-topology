/-- For every genuine all-ideal triangle, the constructed interior point and
the three true outer components work for its entire actual interior. -/
theorem halfTurn_ideal_triangle_whole_interior_components (R : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (ha : ‖(R.toDiscTriangle.a:ℂ)‖=1) (hb : ‖(R.toDiscTriangle.b:ℂ)‖=1)
    (hc : ‖(R.toDiscTriangle.c:ℂ)‖=1) :
    let S : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![R.sideLineC,R.sideLineA,R.sideLineB]
    ∃(p : ℍ)(m : Fin 3→ℍ),p∈R.interior ∧
      (∀i : Fin 3,p∉(S i).carrier ∧ m i∉(S i).carrier) ∧
      (∀i : Fin 3,R.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p) ∧
      (∀i : Fin 3,_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
        ((S i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p)ᶜ) ∧
      (Pairwise fun i j : Fin 3=>Disjoint
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j))) ∧
      (∀i j : Fin 3,i≠j→ _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j)⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p) := by
  let T:=R.toDiscTriangle
  let S : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=![R.sideLineC,R.sideLineA,R.sideLineB]
  obtain ⟨g,hg,hEnd,hgC⟩:=T.exists_ideal_vertex_area_normalizer hc
  obtain ⟨a,b,hna,hnb,_hia,_hib,hab,haE,hbE,hgA,hgB⟩:=
    T.normalized_sides_and_vertices hc g hg hEnd hgC
  let F:=_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g)
  have hEnds:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realGL_image_idealEndpoints g hg T.sideLineC.toHalfPlane
    (.circle 0 1 (by norm_num)) hgC
  have hend (v : 𝕔𝔻) (hv : ‖(v:ℂ)‖=1) (hvL : v∈T.sideLineC.closedCarrier)
      (c : ℂ) (hcE : F (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedCayley.symm (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedDiscToExtended v))=c) :
      c=(-1:ℂ) ∨ c=1 := by
    have hp:= (T.sideLineC.closedCarrier_ideal_iff_halfPlane v hv).mpr hvL
    have himg : F (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedCayley.symm (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedDiscToExtended v))∈
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.circle 0 1 (by norm_num)).idealEndpoints:=
      hEnds ▸ mem_image_of_mem F hp
    rw [hcE] at himg
    simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.circle_idealEndpoints,zero_sub,zero_add,mem_insert_iff,mem_singleton_iff,
      Complex.ofReal_neg,Complex.ofReal_one] at himg
    exact himg.elim (fun h=>Or.inl (OnePoint.coe_injective h))
      (fun h=>Or.inr (OnePoint.coe_injective h))
  have haEnds:=hend T.a ha T.a_mem_sideLineC a haE
  have hbEnds:=hend T.b hb T.b_mem_sideLineC b hbE
  have hspan : min a.re b.re= -1 ∧ max a.re b.re=1:=by
    rcases haEnds with heA|heA <;> rcases hbEnds with heB|heB <;>
      rw [heA,heB] at hab ⊢ <;> norm_num at *
  let f : ℍ≃ᵢℍ:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hGLIsometry g
  let p:=f.symm halfTurnStandardIdealInnerPoint
  have hstd : halfTurnStandardIdealInnerPoint∈f '' R.interior:=by
    have he:=T.normalized_interior_eq_graph hc g hg hEnd hgC a b hna hnb hab haE hbE hgA hgB
    change halfTurnStandardIdealInnerPoint∈(g • · : ℍ→ℍ) '' T.halfPlaneInterior
    rw [he]
    norm_num [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneAboveGraph,hspan.1,hspan.2,halfTurnStandardIdealInnerPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe]
  have hp : p∈R.interior:=by
    apply f.injective.mem_set_image.mp
    change f (f.symm halfTurnStandardIdealInnerPoint)∈f '' R.interior
    rwa [f.apply_symm_apply]
  have hwhole : ∀i : Fin 3,R.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p:=by
    have he:=T.halfPlaneInterior_eq_components p hp
    intro i z hz
    change z∈T.halfPlaneInterior at hz
    rw [he] at hz
    fin_cases i
    · exact hz.2.2
    · exact hz.1
    · exact hz.2.1
  obtain ⟨_U₀,_hU₀,_hq₀,hnot₀,_hsub₀,hcomp₀,hdisj₀,houter₀⟩:=halfTurn_standard_ideal_halfplanes
  have hTransport (σ : Equiv.Perm (Fin 3))
      (hLines : ∀i : Fin 3,f '' (S i).carrier=(halfTurnStandardIdealLine (σ i)).carrier) :
      ∃(p : ℍ)(m : Fin 3→ℍ),p∈R.interior ∧
        (∀i : Fin 3,p∉(S i).carrier ∧ m i∉(S i).carrier) ∧
        (∀i : Fin 3,R.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p) ∧
        (∀i : Fin 3,_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
          ((S i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p)ᶜ) ∧
        (Pairwise fun i j : Fin 3=>Disjoint
          (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j))) ∧
        (∀i j : Fin 3,i≠j→ _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S j) (m j)⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p) := by
    let m : Fin 3→ℍ:=fun i=>f.symm (halfTurnStandardIdealOuterPoint (σ i))
    have hnot (i : Fin 3) : p∉(S i).carrier ∧ m i∉(S i).carrier:=by
      constructor
      · intro hx
        have hh:=mem_image_of_mem f hx
        rw [hLines i] at hh
        exact (hnot₀ (σ i)).1 (by simpa only [p,f.apply_symm_apply] using hh)
      · intro hx
        have hh:=mem_image_of_mem f hx
        rw [hLines i] at hh
        exact (hnot₀ (σ i)).2 (by simpa only [m,f.apply_symm_apply] using hh)
    have hInnerImage (i : Fin 3) : f '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p=
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) halfTurnStandardIdealInnerPoint:=by
      simpa only [p,f.apply_symm_apply] using
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane f (S i) _ (hLines i) p (hnot i).1
    have hOuterImage (i : Fin 3) : f '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i)=
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) (halfTurnStandardIdealOuterPoint (σ i)):=by
      simpa only [m,f.apply_symm_apply] using
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane f (S i) _ (hLines i) (m i) (hnot i).2
    have hInner (i : Fin 3) (z : ℍ) : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) p ↔
        f z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i)) halfTurnStandardIdealInnerPoint:=by
      rw [←hInnerImage i]
      exact f.injective.mem_set_image.symm
    have hOuter (i : Fin 3) (z : ℍ) : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (S i) (m i) ↔
        f z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine (σ i))
          (halfTurnStandardIdealOuterPoint (σ i)):=by
      rw [←hOuterImage i]
      exact f.injective.mem_set_image.symm
    have hLine (i : Fin 3) (z : ℍ) : z∈(S i).carrier ↔
        f z∈(halfTurnStandardIdealLine (σ i)).carrier:=by
      rw [←hLines i]
      exact f.injective.mem_set_image.symm
    refine ⟨p,m,hp,hnot,hwhole,?_,?_,?_⟩
    · intro i
      ext z
      rw [hOuter i z,hcomp₀ (σ i)]
      simp only [mem_compl_iff,mem_union,←hLine i z,←hInner i z]
    · intro i j hij
      apply disjoint_left.mpr
      intro z hzi hzj
      exact disjoint_left.mp (hdisj₀ (fun he=>hij (σ.injective he)))
        ((hOuter i z).mp hzi) ((hOuter j z).mp hzj)
    · intro i j hij z hz
      exact (hInner i z).mpr (houter₀ (σ i) (σ j) (fun he=>hij (σ.injective he))
        ((hOuter j z).mp hz))
  rcases haEnds with heA|heA <;> rcases hbEnds with heB|heB
  · rw [heA,heB] at hab
    exact (hab rfl).elim
  · apply hTransport (Equiv.swap 1 2)
    intro i
    fin_cases i
    · exact hgC
    · change (g • · : ℍ→ℍ) '' T.sideLineA.toHalfPlane.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 1).carrier
      simpa only [heB,Complex.one_re] using hgA
    · change (g • · : ℍ→ℍ) '' T.sideLineB.toHalfPlane.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical (-1)).carrier
      simpa only [heA,Complex.neg_re,Complex.one_re] using hgB
  · apply hTransport (Equiv.refl _)
    intro i
    fin_cases i
    · exact hgC
    · change (g • · : ℍ→ℍ) '' T.sideLineA.toHalfPlane.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical (-1)).carrier
      simpa only [heB,Complex.neg_re,Complex.one_re] using hgA
    · change (g • · : ℍ→ℍ) '' T.sideLineB.toHalfPlane.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 1).carrier
      simpa only [heA,Complex.one_re] using hgB
  · rw [heA,heB] at hab
    exact (hab rfl).elim

