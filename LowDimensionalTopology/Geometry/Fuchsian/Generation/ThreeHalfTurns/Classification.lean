theorem halfTurnIdeal_pairCircle_mem (a b : ℝ) (hab : a<b) (z : ℍ) :
    z∈(halfTurn_idealPairLine a b hab).carrier ↔
      Complex.normSq (z:ℂ)-(a+b)*z.re+a*b=0 := by
  have h:=halfTurn_pairCircle_cut_iff a b hab z
