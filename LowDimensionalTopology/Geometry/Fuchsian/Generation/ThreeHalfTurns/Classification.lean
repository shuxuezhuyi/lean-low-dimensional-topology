/-- The two actual ends of the real coordinate tend to the true ideal point at infinity. -/
theorem halfTurnChain_real_infty_limits :
    Tendsto (fun x:ℝ=>((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)) atTop (𝓝 ∞) ∧
    Tendsto (fun x:ℝ=>((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)) atBot (𝓝 ∞) := by
  have htop : Tendsto (fun x:ℝ=>(x:ℂ)) atTop (coclosedCompact ℂ):=
    ((RCLike.tendsto_ofReal_atTop_cobounded ℂ).mono_right Metric.cobounded_le_cocompact).mono_right
      cocompact_le_coclosedCompact
  have hbot : Tendsto (fun x:ℝ=>(x:ℂ)) atBot (coclosedCompact ℂ):=
    ((RCLike.tendsto_ofReal_atBot_cobounded ℂ).mono_right Metric.cobounded_le_cocompact).mono_right
      cocompact_le_coclosedCompact
  exact ⟨OnePoint.tendsto_coe_infty.comp htop,OnePoint.tendsto_coe_infty.comp hbot⟩

/-- Finite real endpoint values give actual finite real values in every prescribed
real neighborhood along either real end, by genuine sphere continuity. -/
theorem halfTurnChain_eventually_real_interval
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (a lo hi : ℝ)
    (hInf : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ∞=((a:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))
    (hlo : lo<a) (hhi : a<hi) (l : Filter ℝ)
    (hl : Tendsto (fun x:ℝ=>((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)) l (𝓝 ∞)) :
    ∀ᶠ (x : ℝ) in l,∃y:ℝ,lo<y ∧ y<hi ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=((y:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) := by
  let V : Set ℂ:={z|lo<z.re ∧ z.re<hi}
  let U : Set _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=((↑):ℂ→_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) '' V
  have hU : IsOpen U:=OnePoint.isOpenEmbedding_coe.isOpenMap V
    ((isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt Complex.continuous_re continuous_const))
  have haU : ((a:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈U:=⟨a,⟨hlo,hhi⟩,rfl⟩
  have ht:=((_root_.LowDimensionalTopology.Geometry.Mobius.mobiusBoundaryHomeomorph (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)).continuous.tendsto ∞).comp hl
  change Tendsto (fun x:ℝ=>(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)) l
    (𝓝 ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ∞)) at ht
  rw [hInf] at ht
  filter_upwards [ht.eventually (hU.mem_nhds haU)] with x hx
  obtain ⟨z,hz,he⟩:=hx
  have hB : ((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary:=by
    rw [he]
    exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_maps_boundary A (by simp [_root_.LowDimensionalTopology.Geometry.Hyperbolic.coe_mem_halfPlaneIdealBoundary])
  have him : z.im=0:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.coe_mem_halfPlaneIdealBoundary z).mp hB
  have hre : (z.re:ℂ)=z:=Complex.ext rfl (by simpa only [Complex.ofReal_im] using him.symm)
  exact ⟨z.re,hz.1,hz.2,by rw [hre];exact he.symm⟩

/-- A genuine nontrivial dilation and two distinct finite endpoint values supply
four actual boundary iterates in one of the four strict real orders. -/
theorem halfTurnChain_dilation_seed
    (A B : Matrix.SpecialLinearGroup (Fin 2) ℝ) (a b k : ℝ)
    (hA : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ∞=((a:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))
    (hBA : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (B*A)).val ∞=((b:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))
    (hab : a≠b) (hk : 0<k) (hk1 : k≠1) :
    ∃x α β:ℝ,(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=((α:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (B*A)).val ((x:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=((β:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ∧
      ((α<β ∧ β<k*x ∧ k*x<x) ∨ (k*x<x ∧ x<α ∧ α<β) ∨
       (x<k*x ∧ k*x<β ∧ β<α) ∨ (β<α ∧ α<x ∧ x<k*x)) := by
  obtain ⟨hTop,hBot⟩:=halfTurnChain_real_infty_limits
  have hkt : Tendsto (fun x:ℝ=>k*x) atTop atTop:=Tendsto.const_mul_atTop hk tendsto_id
  have hkb : Tendsto (fun x:ℝ=>k*x) atBot atBot:=Tendsto.const_mul_atBot hk tendsto_id
  rcases lt_or_gt_of_ne hab with hab|hba
  · have hAt:=halfTurnChain_eventually_real_interval A a (a-1) ((a+b)/2) hA
      (by linarith) (by linarith) atTop hTop
    have hBt:=halfTurnChain_eventually_real_interval (B*A) b ((a+b)/2) (b+1) hBA
      (by linarith) (by linarith) atTop hTop
    have hAb:=halfTurnChain_eventually_real_interval A a (a-1) ((a+b)/2) hA
      (by linarith) (by linarith) atBot hBot
    have hBb:=halfTurnChain_eventually_real_interval (B*A) b ((a+b)/2) (b+1) hBA
      (by linarith) (by linarith) atBot hBot
    rcases lt_or_gt_of_ne hk1 with hk1|hk1
    · obtain ⟨x,hax,hbx,hpos,hbig⟩:=(hAt.and (hBt.and
        ((eventually_gt_atTop (0:ℝ)).and (hkt.eventually (eventually_gt_atTop (b+1)))))).exists
      obtain ⟨α,hαlo,hαhi,hα⟩:=hax
      obtain ⟨β,hβlo,hβhi,hβ⟩:=hbx
      exact ⟨x,α,β,hα,hβ,Or.inl ⟨by linarith,by linarith,by nlinarith⟩⟩
    · obtain ⟨x,hax,hbx,hneg,hsmall⟩:=(hAb.and (hBb.and
        ((eventually_lt_atBot (0:ℝ)).and (eventually_lt_atBot (a-1))))).exists
      obtain ⟨α,hαlo,hαhi,hα⟩:=hax
      obtain ⟨β,hβlo,hβhi,hβ⟩:=hbx
      exact ⟨x,α,β,hα,hβ,Or.inr (Or.inl ⟨by nlinarith,by linarith,by linarith⟩)⟩
  · have hAt:=halfTurnChain_eventually_real_interval A a ((a+b)/2) (a+1) hA
      (by linarith) (by linarith) atTop hTop
    have hBt:=halfTurnChain_eventually_real_interval (B*A) b (b-1) ((a+b)/2) hBA
      (by linarith) (by linarith) atTop hTop
    have hAb:=halfTurnChain_eventually_real_interval A a ((a+b)/2) (a+1) hA
      (by linarith) (by linarith) atBot hBot
    have hBb:=halfTurnChain_eventually_real_interval (B*A) b (b-1) ((a+b)/2) hBA
      (by linarith) (by linarith) atBot hBot
    rcases lt_or_gt_of_ne hk1 with hk1|hk1
    · obtain ⟨x,hax,hbx,hneg,hsmall⟩:=(hAb.and (hBb.and
        ((eventually_lt_atBot (0:ℝ)).and (hkb.eventually (eventually_lt_atBot (b-1)))))).exists
      obtain ⟨α,hαlo,hαhi,hα⟩:=hax
      obtain ⟨β,hβlo,hβhi,hβ⟩:=hbx
      exact ⟨x,α,β,hα,hβ,Or.inr (Or.inr (Or.inl ⟨by nlinarith,by linarith,by linarith⟩))⟩
    · obtain ⟨x,hax,hbx,hpos,hbig⟩:=(hAt.and (hBt.and
        ((eventually_gt_atTop (0:ℝ)).and (eventually_gt_atTop (a+1))))).exists
      obtain ⟨α,hαlo,hαhi,hα⟩:=hax
      obtain ⟨β,hβlo,hβhi,hβ⟩:=hbx
      exact ⟨x,α,β,hα,hβ,Or.inr (Or.inr (Or.inr ⟨by linarith,by linarith,by nlinarith⟩))⟩

