  · intro he
    have hlo:=h.2.2.1.mp he.le
    have hhi:=h.2.2.2.mp he.ge
    linarith only [hlo,hhi]
  · intro he
    exact le_antisymm (h.2.2.1.mpr he.le) (h.2.2.2.mpr he.ge)

