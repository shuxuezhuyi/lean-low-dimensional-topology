/-- A true half-turn has no fixed point on the actual ideal boundary. -/
theorem halfTurn_ideal_not_fixed (A : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u) (ξ : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hξ : ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary) : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ≠ξ := by
  intro hfix
  exact _root_.LowDimensionalTopology.Geometry.Mobius.mobiusElliptic_fixed_not_mem_disc_frontier _ hA.elliptic
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHalfPlaneSet_isComplexOpenDisc (realSLMobius_image_openHalfPlane A) hfix
    (nielsen_openHalfPlane_frontier.symm ▸ hξ)

/-- At an actual ideal fixed point of the reverse three-factor word, its
three successive vertices are genuinely distinct and each original
half-turn exchanges the corresponding two vertices. -/
theorem halfTurn_ideal_fixed_word_triangle
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u v w : ℍ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B v) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C w)
    (ξ : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) (hξ : ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary)
    (hfix : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (C*B*A)).val ξ=ξ) :
    let η:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ
    let ζ:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val η
    η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧ ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧
      ξ≠η ∧ η≠ζ ∧ ζ≠ξ ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val η=ξ ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ζ=η ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ζ=ξ ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ξ=ζ := by
  dsimp only
  have hη:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_maps_boundary A hξ
  have hζ:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_maps_boundary B hη
  have hA2 : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)^2=1 := by
    simpa only [hA.1] using pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)
  have hB2 : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B)^2=1 := by
    simpa only [hB.1] using pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B)
  have hC2 : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)^2=1 := by
    simpa only [hC.1] using pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)
  have hAA : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ)=ξ := by
    change ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)^2).val ξ=ξ
    rw [hA2]
    rfl
  have hBB : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val
      ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ))=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ := by
    change ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B)^2).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ)=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ
    rw [hB2]
    rfl
  have hCζ : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val
      ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ))=ξ := by
    rw [map_mul,map_mul] at hfix
    exact hfix
  have hCξ : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ξ=
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ) := by
    have he:(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val
        ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ)))=
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ) := by
      change ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)^2).val _=_
      rw [hC2]
      rfl
    rw [hCζ] at he
    exact he
  refine ⟨hη,hζ,Ne.symm (halfTurn_ideal_not_fixed A u hA ξ hξ),
    Ne.symm (halfTurn_ideal_not_fixed B v hB _ hη),?_,hAA,hBB,hCζ,hCξ⟩
  intro he
  have hf:=hCζ
  rw [he] at hf
  exact halfTurn_ideal_not_fixed C w hC ξ hξ hf

/-- The original parameter at least one supplies an actual ideal fixed
point of the reverse word; no fixed-point or discreteness premise is added. -/
theorem halfTurn_large_parameter_ideal_fixed (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam : 1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    ∃ξ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex,ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (C*B*A)).val ξ=ξ := by
  have htr:|Matrix.trace (C*B*A).val|=2*_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T:=
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurn_six_product_orders_abs_trace_eq_twice_triangleInvariant T A B C hA hB hC).2.2.2.1
  have hsq:=congrArg (fun r:ℝ=>r^2) htr
  rw [sq_abs] at hsq
  have ht:4≤(Matrix.trace (C*B*A).val)^2:=by nlinarith
  have hn:=halfTurn_triple_ne_one C B A T.c T.b T.a hC hB hA
  rcases eq_or_lt_of_le ht with he|he
  · have hp:_root_.LowDimensionalTopology.Geometry.Mobius.MobiusParabolic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (C*B*A)):=
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_parabolic_iff _ hn).mpr he.symm
    obtain ⟨ξ,hξ⟩:=hp.2
    have hf: (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (C*B*A)).val ξ=ξ:=(hξ ξ).mpr rfl
    exact ⟨ξ,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_parabolic_fixed_boundary _ hp ξ hf,hf⟩
  · obtain ⟨ξ,η,_hne,hξ,_hη,hfix⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_hyperbolic_fixed_pair _ hn he
    exact ⟨ξ,hξ,(hfix ξ).mpr (Or.inl rfl)⟩

/-- An original half-turn exchanging the two ideal ends of a genuine line
has its actual center on that line. Unique nearest points make the
geometric conclusion independent of a chosen coordinate normalizer. -/
theorem halfTurn_center_mem_exchanged_line
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (ξ η : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hL : L.idealEndpoints={ξ,η})
    (hξη : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ=η) (hηξ : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val η=ξ) :
    u∈L.carrier := by
  let g:=Matrix.SpecialLinearGroup.mapGL ℝ A
  let M:=L.realGLMap g
  have hg:0<g.val.det:=by
    change 0<Matrix.det A.val
    rw [A.det_coe]
    norm_num
  have hfrac:(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val=_root_.LowDimensionalTopology.Geometry.Mobius.fractionalLinear (_root_.LowDimensionalTopology.Geometry.Hyperbolic.complexifiedRealMobiusMatrix g):=by
    simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius,MonoidHom.comp_apply,_root_.LowDimensionalTopology.Geometry.Mobius.invariantDisc_specialLinear_action,
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_matrix,g]
  have hM:M=L:=by
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.idealEndpoints_injective
    rw [L.idealEndpoints_realGL_image M g hg (L.realGLMap_carrier g).symm,
      ←hfrac,hL,image_pair,hξη,hηξ,Set.pair_comm]
  have hInv:(fun z:ℍ=>A•z) '' L.carrier=L.carrier:=by
    change (fun z:ℍ=>g•z) '' L.carrier=L.carrier
    rw [←L.realGLMap_carrier g,show L.realGLMap g=L from hM]
  obtain ⟨p,⟨hp,hd⟩,huniq⟩:=L.exists_unique_nearest_point u
  have hpA:A•p∈L.carrier:=hInv ▸ mem_image_of_mem (fun z:ℍ=>A•z) hp
  have hdA:L.pointDist u=dist u (A•p):=by
    rw [hd]
    have he:dist (A•u) (A•p)=dist u p:=(isometry_smul ℍ A).dist_eq u p
    rw [hA.2] at he
    exact he.symm
  have hfixed:A•p=p:=huniq (A•p) ⟨hpA,hdA⟩
  exact (hA.fixed_iff p).mp hfixed ▸ hp

/-- For the original parameter at least one, a genuine ideal triangle has
the three actual half-turn centers on its three respective sides. Its
vertices and side incidences are constructed from the original word. -/
theorem halfTurn_large_parameter_ideal_triangle (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam : 1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    ∃ξ η ζ:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex,ξ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧ η∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧
      ζ∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary ∧ ξ≠η ∧ η≠ζ ∧ ζ≠ξ ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ=η ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val η=ξ ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val η=ζ ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val ζ=η ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ζ=ξ ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C).val ξ=ζ ∧
      ∃L M N:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine,L.idealEndpoints={ξ,η} ∧ M.idealEndpoints={η,ζ} ∧
        N.idealEndpoints={ζ,ξ} ∧ T.a∈L.carrier ∧ T.b∈M.carrier ∧ T.c∈N.carrier := by
  obtain ⟨ξ,hξ,hfix⟩:=halfTurn_large_parameter_ideal_fixed T A B C hA hB hC hlam
  let η:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A).val ξ
  let ζ:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B).val η
  obtain ⟨hη,hζ,hξη,hηζ,hζξ,hAη,hBζ,hCζ,hCξ⟩:=
    halfTurn_ideal_fixed_word_triangle A B C T.a T.b T.c hA hB hC ξ hξ hfix
  obtain ⟨L,hL⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.exists_halfPlaneLine_of_idealEndpoints ξ η hξ hη hξη
  obtain ⟨M,hM⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.exists_halfPlaneLine_of_idealEndpoints η ζ hη hζ hηζ
  obtain ⟨N,hN⟩:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.exists_halfPlaneLine_of_idealEndpoints ζ ξ hζ hξ hζξ
  exact ⟨ξ,η,ζ,hξ,hη,hζ,hξη,hηζ,hζξ,rfl,hAη,rfl,hBζ,hCζ,hCξ,
    L,M,N,hL,hM,hN,
    halfTurn_center_mem_exchanged_line A T.a hA L ξ η hL rfl hAη,
    halfTurn_center_mem_exchanged_line B T.b hB M η ζ hM rfl hBζ,
    halfTurn_center_mem_exchanged_line C T.c hC N ζ ξ hN hCζ hCξ⟩

end LowDimensionalTopology.Geometry.Fuchsian

