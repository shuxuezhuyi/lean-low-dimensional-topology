        [halfTurnStandardIdealInnerPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe])

/-- The standard actual ideal triangle has pairwise disjoint outer
half-planes and a genuine nonempty open gap between them. -/
theorem halfTurn_standard_ideal_halfplanes :
    ∃U : Set ℍ,IsOpen U ∧ halfTurnStandardIdealInnerPoint∈U ∧
      (∀i : Fin 3,halfTurnStandardIdealInnerPoint∉(halfTurnStandardIdealLine i).carrier ∧
        halfTurnStandardIdealOuterPoint i∉(halfTurnStandardIdealLine i).carrier) ∧
      (∀i : Fin 3,U⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint) ∧
      (∀i : Fin 3,_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) (halfTurnStandardIdealOuterPoint i)=
        ((halfTurnStandardIdealLine i).carrier∪
          _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint)ᶜ) ∧
      (Pairwise fun i j : Fin 3=>Disjoint
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) (halfTurnStandardIdealOuterPoint i))
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine j) (halfTurnStandardIdealOuterPoint j))) ∧
      (∀i j : Fin 3,i≠j→
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine j) (halfTurnStandardIdealOuterPoint j)⊆
          _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint) := by
  let U : Set ℍ:={z| -1<z.re ∧ z.re<1 ∧ 1<‖(z : ℂ)‖}
  have hU : IsOpen U:=(isOpen_lt continuous_const UpperHalfPlane.continuous_re).inter
    ((isOpen_lt UpperHalfPlane.continuous_re continuous_const).inter
      (isOpen_lt continuous_const UpperHalfPlane.continuous_coe.norm))
  have hq : halfTurnStandardIdealInnerPoint∈U:=by
    norm_num [U,halfTurnStandardIdealInnerPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,Complex.norm_def,Complex.normSq_apply]
  have hnot (i : Fin 3) :
      halfTurnStandardIdealInnerPoint∉(halfTurnStandardIdealLine i).carrier ∧
      halfTurnStandardIdealOuterPoint i∉(halfTurnStandardIdealLine i).carrier := by
    fin_cases i <;> norm_num [halfTurnStandardIdealLine,halfTurnStandardIdealInnerPoint,
      halfTurnStandardIdealOuterPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.carrier,Complex.norm_def,
      Complex.normSq_apply]
  have hsub (i : Fin 3) : U⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i)
