/-- A genuine half-turn preserves every actual whole geodesic through its center. -/
theorem halfTurn_preserves_line_through_center
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hu : u∈L.carrier) :
    (fun z:ℍ=>A•z) '' L.carrier=L.carrier := by
  obtain ⟨q,hq⟩:=L.exists_SL_normalizer
  have hLine : (fun x:ℍ=>q•x) '' L.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier:=by
    change (fun x:ℍ=>(Matrix.SpecialLinearGroup.mapGL ℝ q)•x) '' L.carrier=_
    rw [←L.realGLMap_carrier (Matrix.SpecialLinearGroup.mapGL ℝ q),hq]
  have hMem (z : ℍ) : z∈L.carrier ↔ (q•z).re=0:=by
    constructor
    · intro hz
      change q•z∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier
      rw [←hLine]
      exact mem_image_of_mem (fun x:ℍ=>q•x) hz
    · intro hz
      have hh : q•z∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier:=hz
      rw [←hLine] at hh
      obtain ⟨v,hv,he⟩:=hh
      exact MulAction.injective q he ▸ hv
  have hqu : (q•u).re=0:=(hMem u).mp hu
  let y:=q•u
  have hy : _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 y.im y.im_pos=y:=UpperHalfPlane.ext_re_im hqu.symm rfl
  have hAxis : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL y.im y.im_pos) y:=by
    rw [←hy]
    exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at y.im y.im_pos
  have hEq (z : ℍ) : (q*A*q⁻¹)•z=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL y.im y.im_pos•z:=by
    apply UpperHalfPlane.ext
    apply OnePoint.coe_injective
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,(hA.conjugate q).unique hAxis]
  have hRe (z : ℍ) : (q•(A•z)).re=
      -(y.im^2*(q•z).re)/Complex.normSq ((q•z:ℍ):ℂ):=by
    have hh:=hEq (q•z)
    rw [mul_smul,mul_smul,inv_smul_smul] at hh
    rw [hh]
    exact sideOpposition_axis_halfturn_real y.im y.im_pos (q•z)
  have hPres (z : ℍ) : A•z∈L.carrier ↔ z∈L.carrier:=by
    rw [hMem,hMem,hRe]
    have hN : Complex.normSq ((q•z:ℍ):ℂ)≠0:=
      (Complex.normSq_pos.mpr (UpperHalfPlane.ne_zero (q•z))).ne'
    have hY : y.im^2≠0:=pow_ne_zero 2 y.im_pos.ne'
    constructor
    · intro hz
      have hh:=(div_eq_zero_iff.mp hz).resolve_right hN
      exact (mul_eq_zero.mp (neg_eq_zero.mp hh)).resolve_left hY
    · intro hz
      rw [hz,mul_zero,neg_zero,zero_div]
  ext z
  constructor
  · rintro ⟨v,hv,rfl⟩
    exact (hPres v).mpr hv
  · intro hz
    refine ⟨A⁻¹•z,?_,smul_inv_smul A z⟩
    apply (hPres (A⁻¹•z)).mp
    simpa only [smul_inv_smul] using hz

/-- Each actual weak outer region of the three ideal sides lies strictly
inside both other sides. Strictness comes from the positive imaginary coordinate. -/
theorem halfTurnIdealTriangle_closed_outer_cross
    (m k : ℝ) (hm : 1≤m) (hk : m<k) (z : ℍ) :
    let Pf:=Complex.normSq (z:ℂ)+(m-1)*z.re-m
    let Pg:=Complex.normSq (z:ℂ)-(k-m)*z.re-m*k
    let Pw:=Complex.normSq (z:ℂ)-(k+1)*z.re+k
    (Pf≤0→Pg<0 ∧ 0<Pw) ∧ (0≤Pg→0<Pf ∧ 0<Pw) ∧
      (Pw≤0→0<Pf ∧ Pg<0) := by
  let Pf:=Complex.normSq (z:ℂ)+(m-1)*z.re-m
  let Pg:=Complex.normSq (z:ℂ)-(k-m)*z.re-m*k
  let Pw:=Complex.normSq (z:ℂ)-(k+1)*z.re+k
  change (Pf≤0→Pg<0 ∧ 0<Pw) ∧ (0≤Pg→0<Pf ∧ 0<Pw) ∧
    (Pw≤0→0<Pf ∧ Pg<0)
  have hm1 : 0<m+1:=by linarith only [hm]
  have hk1 : 0<k-1:=by linarith only [hm,hk]
  have hkm : 0<k+m:=by linarith only [hm,hk]
  have hy : 0<z.im^2:=sq_pos_of_pos z.im_pos
  have h1 : 0<(k-1)*Pf+(m+1)*Pw:=by
    convert mul_pos hkm (add_pos_of_nonneg_of_pos (sq_nonneg (z.re-1)) hy) using 1
    dsimp only [Pf,Pw]
    rw [Complex.normSq_apply]
    simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    ring
  have h2 : 0<(m+k)*Pf-(m+1)*Pg:=by
    convert mul_pos hk1 (add_pos_of_nonneg_of_pos (sq_nonneg (z.re+m)) hy) using 1
    dsimp only [Pf,Pg]
    rw [Complex.normSq_apply]
    simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    ring
  have h3 : 0<(m+k)*Pw-(k-1)*Pg:=by
    convert mul_pos hm1 (add_pos_of_nonneg_of_pos (sq_nonneg (z.re-k)) hy) using 1
    dsimp only [Pw,Pg]
    rw [Complex.normSq_apply]
    simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    ring
  constructor
  · intro hf
    have hf1:=mul_nonpos_of_nonneg_of_nonpos hk1.le hf
    have hf2:=mul_nonpos_of_nonneg_of_nonpos hkm.le hf
    constructor
    · exact (mul_lt_mul_iff_right₀ hm1).mp (by nlinarith only [h2,hf2])
    · exact (mul_pos_iff_of_pos_left hm1).mp (by linarith only [h1,hf1])
  constructor
  · intro hg
    have hg2:=mul_nonneg hm1.le hg
    have hg3:=mul_nonneg hk1.le hg
    constructor
    · exact (mul_pos_iff_of_pos_left hkm).mp (by linarith only [h2,hg2])
    · exact (mul_pos_iff_of_pos_left hkm).mp (by linarith only [h3,hg3])
  · intro hw
    have hw1:=mul_nonpos_of_nonneg_of_nonpos hm1.le hw
    have hw3:=mul_nonpos_of_nonneg_of_nonpos hkm.le hw
    constructor
    · exact (mul_pos_iff_of_pos_left hk1).mp (by linarith only [h1,hw1])
    · exact (mul_lt_mul_iff_right₀ hk1).mp (by nlinarith only [h3,hw3])

