  have hn (z : ℍ) (hz : ‖(z : ℂ)‖<1) : -1<z.re ∧ z.re<1:=
    abs_lt.mp ((Complex.abs_re_le_norm (z : ℂ)).trans_lt hz)
  have houter (i j : Fin 3) (hij : i≠j) :
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine j) (halfTurnStandardIdealOuterPoint j)⊆
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint := by
    rw [(halfTurn_standard_ideal_components j).1,(halfTurn_standard_ideal_components i).2]
    fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta,Fin.isValue,ne_eq,not_true_eq_false] at hij
    · intro z hz
      change z.re< -1 at hz
      change 1<‖(z : ℂ)‖
      have ha : 1 < |z.re| := by
        rw [abs_of_neg (lt_trans hz (by norm_num))]
        linarith only [hz]
      exact ha.trans_le (Complex.abs_re_le_norm (z : ℂ))
    · exact fun z hz=>lt_of_lt_of_le hz ((le_abs_self z.re).trans (Complex.abs_re_le_norm (z : ℂ)))
    · exact fun z hz=>(hn z hz).1
    · intro z hz
      change 1<z.re at hz
      change -1<z.re
      linarith only [hz]
    · exact fun z hz=>(hn z hz).2
    · intro z hz
      change z.re< -1 at hz
      change z.re<1
      linarith only [hz]
  refine ⟨U,hU,hq,hnot,hsub,hcomp,?_,houter⟩
  intro i j hij
  apply disjoint_left.mpr
  intro z hzi hzj
  have hi: z∉(halfTurnStandardIdealLine i).carrier∪
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint:=by
    rwa [hcomp i] at hzi
  exact hi (Or.inr (houter i j hij hzj))

end LowDimensionalTopology.Geometry.Fuchsian

