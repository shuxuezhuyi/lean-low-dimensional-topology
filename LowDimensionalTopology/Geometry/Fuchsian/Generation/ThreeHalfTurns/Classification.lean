/-- The ideal three-half-turn chamber's genuine area budget forces three
order-two cone classes, one actual cusp and genus zero. -/
theorem halfTurn_ideal_signature_budget (g p : ℕ) (orders : List ℕ)
    (h2 : ∀m∈orders,2≤m) (hlen : 3≤orders.length) (hp : 1≤p)
    (hArea : 2*(g : ℝ)-2+(p : ℝ)+
      (orders.map (fun m : ℕ=>1-1/(m : ℝ))).sum=1/2) :
    g=0 ∧ p=1 ∧ orders=[2,2,2] := by
  have hlo:=signature_elliptic_sum_lower orders h2
  have hlR : (3 : ℝ)≤orders.length:=by exact_mod_cast hlen
  have hpR : (1 : ℝ)≤p:=by exact_mod_cast hp
  have hgR : 0≤(g : ℝ):=Nat.cast_nonneg _
  have hg0 : (g : ℝ)=0:=by linarith only [hlo,hlR,hpR,hgR,hArea]
  have hg : g=0:=by exact_mod_cast hg0
  have hp1R : (p : ℝ)=1:=by linarith only [hlo,hlR,hpR,hg0,hArea]
  have hp1 : p=1:=by exact_mod_cast hp1R
  have hl3R : (orders.length : ℝ)=3:=by
    linarith only [hlo,hlR,hg0,hp1R,hArea]
  have hl3 : orders.length=3:=by exact_mod_cast hl3R
  obtain ⟨a,b,c,rfl⟩:=List.length_eq_three.mp hl3
  have ha : 2≤a:=h2 a (by simp)
  have hb : 2≤b:=h2 b (by simp)
  have hc : 2≤c:=h2 c (by simp)
  have hwa:=(signature_elliptic_weight_bounds a ha).1
  have hwb:=(signature_elliptic_weight_bounds b hb).1
  have hwc:=(signature_elliptic_weight_bounds c hc).1
  simp only [List.map_cons,List.map_nil,List.sum_cons,List.sum_nil] at hArea
  have order_two (m : ℕ) (hm : 2≤m) (hw : 1-1/(m : ℝ)=1/2) : m=2 := by
    have hm0 : 0<(m : ℝ):=by exact_mod_cast (show 0<m by omega)
    have he:=congrArg (fun x : ℝ=>x*m) hw
    field_simp at he
    have hm2 : (m : ℝ)=2:=by nlinarith only [he,hm0]
    exact_mod_cast hm2
  have hae : a=2:=order_two a ha (by linarith only [hArea,hg0,hp1R,hwa,hwb,hwc])
  have hbe : b=2:=order_two b hb (by linarith only [hArea,hg0,hp1R,hwa,hwb,hwc])
  have hce : c=2:=order_two c hc (by linarith only [hArea,hg0,hp1R,hwa,hwb,hwc])
  exact ⟨hg,hp1,by rw [hae,hbe,hce]⟩

/-- A genuine finite-area native domain supplies a genuine completion genus,
all actual elliptic classes and all actual cusp classes, with the same area. -/
theorem halfTurnNative_finite_fundamental_signature
    (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (F : Set ℍ)
    (hF : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F) (hFin : volume F≠⊤) :
    ∃g p : ℕ,∃orders : List ℕ,
      HasCofiniteFuchsianSignature
        (nativeConformalSubgroup_halfPlaneData H hConf).asFuchsianDisc g orders p ∧
      (volume F).toReal=2*Real.pi*(2*(g : ℝ)-2+(p : ℝ)+
        (orders.map (fun m : ℕ=>1-1/(m : ℝ))).sum) := by
  let P:=nativeConformalSubgroup_halfPlaneData H hConf
  let nativeIdealSignatureOriginalAction:=P.nativeAction
  let e:=nativeCovolume_groupEquiv H hConf
  have he (g : (nativeConformalSubgroupMobiusHom H hConf).range) (z : ℍ) :
      g•z=e.symm g•z := by
    have hh:=nativeCovolume_groupEquiv_action H hConf (e.symm g) z
    rw [e.apply_symm_apply] at hh
    exact hh
  have hF' : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain (nativeConformalSubgroupMobiusHom H hConf).range ℍ volume F := by
    have ht:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain.equivariant_preimage e.symm (Homeomorph.refl ℍ) he hF
    simpa using ht
  have hgeom:=P.geometric_fundamental hF'
  have harea:=compactCover_original_geometric_area P F hF.isOpen.measurableSet
  have hgeomFin : geometricModelArea P.asFuchsianDisc
      (geometricHalfPlaneIdentity P.asFuchsianDisc rfl ⁻¹' F)≠⊤:=by
    rw [harea]
    exact hFin
  obtain ⟨_g₀,_orders₀,_cusps₀,hSig₀⟩:=
    finite_area_actual_cofinite_signature_exists P.asFuchsianDisc _ hgeom hgeomFin
  let actualIdealSignatureEllipticFinite : Finite
      (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic):=hSig₀.ellipticClassesFinite
  obtain ⟨g,hgenus,hA⟩:=
    finite_area_original_actual_signature_area P.asFuchsianDisc _ hgeom hgeomFin
  refine ⟨g,Nat.card (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .parabolic),
    fuchsianEllipticOrderList P.asFuchsianDisc,?_,?_⟩
  · exact { ellipticClassesFinite:=actualIdealSignatureEllipticFinite
            parabolicClassesFinite:=hSig₀.parabolicClassesFinite
            compact:=hSig₀.compact
            topologicalGenus:=hgenus
            ellipticOrders:=List.Perm.refl _
            cuspCount:=rfl }
  · rwa [harea] at hA

/-- A literal ideal chamber of area pi, three actual distinct half-turn
center orbits and a genuine parabolic force precisely the source signature.
Every area, class and cusp used below belongs to the unchanged native group. -/
theorem halfTurnIdeal_native_signature
    (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (F : Set ℍ)
    (hF : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F)
    (hArea : volume F=ENNReal.ofReal Real.pi)
    (centers : Fin 3→ℍ)
    (hcenters : ∀i,∃f : H,orderOf f=2 ∧ f•centers i=centers i)
    (horbit : ∀(i j : Fin 3)(g : H),g•centers i=centers j→i=j)
    (hpar : ∃a : H,_root_.LowDimensionalTopology.Geometry.Mobius.MobiusParabolic ((nativeCovolume_groupEquiv H hConf) a).val) :
    HasCofiniteFuchsianSignature
      (nativeConformalSubgroup_halfPlaneData H hConf).asFuchsianDisc 0 [2,2,2] 1 := by
  let P:=nativeConformalSubgroup_halfPlaneData H hConf
  let e:=nativeCovolume_groupEquiv H hConf
  have hFin : volume F≠⊤:=by rw [hArea];simp
  obtain ⟨g,p,orders,hSig,hBudget⟩:=
    halfTurnNative_finite_fundamental_signature H hConf F hF hFin
  let : Finite (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic):=hSig.ellipticClassesFinite
  let : Finite (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .parabolic):=hSig.parabolicClassesFinite
  have hfix : ∀i : Fin 3,∃f : H,_root_.LowDimensionalTopology.Geometry.Mobius.MobiusElliptic (e f).val ∧ f•centers i=centers i := by
    intro i
    obtain ⟨f,hf,hfix⟩:=hcenters i
    exact ⟨f,halfTurnNative_elliptic_of_order H hConf f 2 (by decide) hf,hfix⟩
  have hClasses:=halfTurnNative_elliptic_classes_card_lower H hConf 3 centers hfix horbit
  have hlen : 3≤orders.length:=by rwa [hSig.orders_length]
  obtain ⟨a,ha⟩:=hpar
  obtain ⟨ξ,hξ⟩:=ha.2
  let z : fuchsianCyclicFixedPoints P.asFuchsianDisc .parabolic:=
    ⟨ξ,(by intro he;cases he),(e a).val,(e a).property,ha,(hξ ξ).mpr rfl⟩
  obtain ⟨c,_b,_hb⟩:=fuchsianParabolicPointRepresentative_orbit_cover P.asFuchsianDisc z
  let : Nonempty (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .parabolic):=⟨c⟩
  have hp : 1≤p:=by
    rw [hSig.cuspCount]
    exact Nat.card_pos
  rw [hArea,ENNReal.toReal_ofReal Real.pi_pos.le] at hBudget
  have hs : 2*(g : ℝ)-2+(p : ℝ)+(orders.map (fun m : ℕ=>1-1/(m : ℝ))).sum=1/2 := by
    apply mul_left_cancel₀ (show (2*Real.pi : ℝ)≠0 by positivity)
    calc
      _=Real.pi:=hBudget.symm
      _=2*Real.pi*(1/2):=by ring
  obtain ⟨rfl,rfl,rfl⟩:=halfTurn_ideal_signature_budget g p orders
    (fun _ hm=>hSig.orders_two_le hm) hlen hp hs
  exact hSig

