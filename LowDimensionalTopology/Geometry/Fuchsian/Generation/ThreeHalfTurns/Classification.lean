    (hlam:1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) := by
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  have hAm:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A∈H:=Subgroup.subset_closure (by simp)
  have hBm:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B∈H:=Subgroup.subset_closure (by simp)
  have hCm:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C∈H:=Subgroup.subset_closure (by simp)
  have hTm:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (C*B*A)∈H:=by
    rw [map_mul,map_mul]
