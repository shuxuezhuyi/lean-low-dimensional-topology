/-- The original three-center group at parameter greater than one is discrete,
non-elementary and has its actual whole-quotient signature, with no supplied
ordinary gap, boundary class, packing, domain or signature hypothesis. -/
theorem threeHalfTurn_triangle_large_parameter_classification (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam:1<_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) :
    let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
    ∃P:HalfPlaneFuchsianGroup H,∃hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H,
    ∃hFG:(_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius H).FG,
      HasNielsenFuchsianSignature P.cayleyData (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius) hFG 0 [2,2,2] 0 1 := by
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  have hd:DiscreteTopology H:=
    (threeHalfTurn_large_parameter_discrete_freeProduct T A B C hA hB hC hlam.le).1
  let P:=threeHalfTurn_real_halfPlaneData A B C hd
  have hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H:=threeHalfTurn_large_parameter_nonElementary T A B C hA hB hC hlam.le
  let K:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius H
  let Q:=P.cayleyData
  have hFG:H.FG:=(Subgroup.fg_iff H).mpr
    ⟨{_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C},rfl,Set.toFinite _⟩
  let largeClassificationOriginalFG:Group.FG H:=(Group.fg_iff_subgroup_fg H).mpr hFG
  let groupEquiv:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugateEquivalence _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius H
  let largeClassificationCayleyFG:Group.FG K:=
    Group.fg_of_surjective (f:=groupEquiv.toMonoidHom) groupEquiv.surjective
  have hFGQ:K.FG:=(Group.fg_iff_subgroup_fg K).mp largeClassificationCayleyFG
  obtain ⟨ξ,hξ,hOrd⟩:=threeHalfTurn_large_parameter_ordinary_boundary T A B C hA hB hC hlam
  have hfront:_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ∈frontier Q.domain.carrier:=by
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ∈frontier _root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedUnitDisc
    rw [←cayleyMobius_image_openHalfPlane]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ∈frontier ((_root_.LowDimensionalTopology.Geometry.Mobius.mobiusBoundaryHomeomorph _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius) '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHalfPlaneSet)
    rw [←Homeomorph.image_frontier,nielsen_openHalfPlane_frontier]
    exact mem_image_of_mem _ hξ
  have ho:_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ∈_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet K:=by
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ∉_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusLimitSet K
    rw [←nielsen_mobiusLimitSet_conjugation H _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius]
    intro he
    obtain ⟨z,hz,hzξ⟩:=he
    exact hOrd (_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val.injective hzξ ▸ hz)
  have hBoundary:=finitelyGenerated_ordinary_boundary_has_boundaryClass
    Q (hNE.conjugation _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius) hFGQ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius.val ξ) hfront ho
  obtain ⟨hFG',hSig⟩:=threeHalfTurn_large_signature_from_boundary T A B C hA hB hC hlam.le P hNE hBoundary
  exact ⟨P,hNE,hFG',hSig⟩

end LowDimensionalTopology.Geometry.Fuchsian

