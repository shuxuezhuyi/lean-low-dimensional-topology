/-- The genuine native closure of a closed-model triangle is the
intersection of its three actual closed inner half-planes. -/
theorem halfTurn_closedTriangle_closure_halfplanes (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (q : ℍ) (hq : q∈T.interior) :
    closure T.interior=_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineA q∩
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineB q∩_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineC q) := by
  let R:=T.toDiscTriangle
  have hp:0<(R.halfPlaneCoordinate q).1 ∧ 0<(R.halfPlaneCoordinate q).2 ∧
      (R.halfPlaneCoordinate q).1+(R.halfPlaneCoordinate q).2<1:=
    (R.mem_halfPlaneInterior_iff q).mp hq
  have hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q={z : ℍ|0<(T.nativeCoordinate z).1} := by
    ext z
    exact R.mem_component_iff_cut _ Prod.fst continuous_fst
      (fun x=>(R.halfPlaneCoordinate_second_line x).symm)
      (R.openCoordinateDomain_convex.inter
        (convex_halfSpace_gt (ContinuousLinearMap.fst ℝ ℝ ℝ).toLinearMap.isLinear (0 : ℝ)))
      q hp.1 z
  have hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q={z : ℍ|0<(T.nativeCoordinate z).2} := by
    ext z
    exact R.mem_component_iff_cut _ Prod.snd continuous_snd
      (fun x=>(R.halfPlaneCoordinate_first_line x).symm)
      (R.openCoordinateDomain_convex.inter
        (convex_halfSpace_gt (ContinuousLinearMap.snd ℝ ℝ ℝ).toLinearMap.isLinear (0 : ℝ)))
      q hp.2.1 z
  have hALine (z : ℍ) : z∈R.sideLineA.toHalfPlane.carrier ↔
      1-(R.halfPlaneCoordinate z).1-(R.halfPlaneCoordinate z).2=0 := by
    rw [←R.halfPlaneCoordinate_opposite_line z]
    constructor <;> intro h <;> linarith only [h]
  have hAConv : Convex ℝ {p : ℝ×ℝ|0<1-p.1-p.2} := by
    have he : {p : ℝ×ℝ|0<1-p.1-p.2}={p : ℝ×ℝ|p.1+p.2<1}:=by
      ext p
      change (0<1-p.1-p.2) ↔ p.1+p.2<1
      constructor <;> intro h <;> linarith only [h]
    rw [he]
    exact convex_halfSpace_lt
      (ContinuousLinearMap.fst ℝ ℝ ℝ+ContinuousLinearMap.snd ℝ ℝ ℝ).toLinearMap.isLinear 1
  have hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q=
      {z : ℍ|(T.nativeCoordinate z).1+(T.nativeCoordinate z).2<1} := by
    ext z
    have he:=R.mem_component_iff_cut _ (fun p=>1-p.1-p.2)
      ((continuous_const.sub continuous_fst).sub continuous_snd) hALine
      (R.openCoordinateDomain_convex.inter hAConv) q (by linarith only [hp.2.2]) z
    change z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane R.sideLineA.toHalfPlane q ↔
      (R.halfPlaneCoordinate z).1+(R.halfPlaneCoordinate z).2<1
    rw [he]
    constructor <;> intro h <;> linarith only [h]
  have hcont:=T.nativeCoordinate_isOpenEmbedding.continuous
  have hOpen:=T.nativeCoordinate_isOpenEmbedding.isOpenMap
  have hf : IsOpenMap (fun z : ℍ=>(T.nativeCoordinate z).1):=
    (isOpenMap_fst : IsOpenMap (Prod.fst : ℝ×ℝ→ℝ)).comp hOpen
  have hs : IsOpenMap (fun z : ℍ=>(T.nativeCoordinate z).2):=
    (isOpenMap_snd : IsOpenMap (Prod.snd : ℝ×ℝ→ℝ)).comp hOpen
  let sum : (ℝ×ℝ)→L[ℝ]ℝ:=ContinuousLinearMap.fst ℝ ℝ ℝ+ContinuousLinearMap.snd ℝ ℝ ℝ
  have hsum : IsOpenMap (fun z : ℍ=>(T.nativeCoordinate z).1+(T.nativeCoordinate z).2):=
    (sum.isOpenMap (fun r=>⟨(r,0),by simp [sum]⟩)).comp hOpen
  have hBClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineB q={z : ℍ|0≤(T.nativeCoordinate z).1} := by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane,hB]
    have he:=hf.preimage_closure_eq_closure_preimage (continuous_fst.comp hcont) (Ioi (0 : ℝ))
    rw [closure_Ioi] at he
    exact he.symm
  have hCClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineC q={z : ℍ|0≤(T.nativeCoordinate z).2} := by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane,hC]
    have he:=hs.preimage_closure_eq_closure_preimage (continuous_snd.comp hcont) (Ioi (0 : ℝ))
    rw [closure_Ioi] at he
    exact he.symm
  have hAClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineA q=
      {z : ℍ|(T.nativeCoordinate z).1+(T.nativeCoordinate z).2≤1} := by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane,hA]
    have he:=hsum.preimage_closure_eq_closure_preimage
      ((continuous_fst.comp hcont).add (continuous_snd.comp hcont)) (Iio (1 : ℝ))
    rw [closure_Iio] at he
    exact he.symm
  rw [T.closure_interior_coordinate,hAClosed,hBClosed,hCClosed]
  ext z
  change (0≤(T.nativeCoordinate z).1 ∧ 0≤(T.nativeCoordinate z).2 ∧
    (T.nativeCoordinate z).1+(T.nativeCoordinate z).2≤1) ↔
    (T.nativeCoordinate z).1+(T.nativeCoordinate z).2≤1 ∧
      0≤(T.nativeCoordinate z).1 ∧ 0≤(T.nativeCoordinate z).2
  tauto

/-- A real ideal vertex is retained in the actual compactified half-plane. -/
def halfTurn_realIdealPoint (x : ℝ) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHalfPlaneModel:=
  ⟨((x : ℂ) : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex),(_root_.LowDimensionalTopology.Geometry.Hyperbolic.coe_mem_closedHalfPlaneSet _).mpr (by simp)⟩

theorem halfTurn_realIdealPoint_ideal (x : ℝ) :
    (halfTurn_realIdealPoint x).val∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneIdealBoundary := by
  exact (_root_.LowDimensionalTopology.Geometry.Hyperbolic.coe_mem_halfPlaneIdealBoundary (x : ℂ)).mpr (by simp)

/-- The literal three vertices from the parabolic product construction
determine a genuine ideal triangle, rather than an assumed region model. -/
def halfTurn_canonicalIdealTriangle (m k : ℝ) (hm : 1≤m) (hk : m<k) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle where
  a:=halfTurn_realIdealPoint 1
  b:=halfTurn_realIdealPoint (-m)
  c:=halfTurn_realIdealPoint k
  noncollinear:=by
    rintro ⟨L,hA,hB,hC⟩
    have hA':(halfTurn_realIdealPoint 1).val∈L.idealEndpoints:=
      (L.closedCarrier_mem_ideal_iff _ (halfTurn_realIdealPoint_ideal 1)).mp hA
    have hB':(halfTurn_realIdealPoint (-m)).val∈L.idealEndpoints:=
      (L.closedCarrier_mem_ideal_iff _ (halfTurn_realIdealPoint_ideal (-m))).mp hB
    have hC':(halfTurn_realIdealPoint k).val∈L.idealEndpoints:=
      (L.closedCarrier_mem_ideal_iff _ (halfTurn_realIdealPoint_ideal k)).mp hC
    have hAB : (halfTurn_realIdealPoint 1).val≠(halfTurn_realIdealPoint (-m)).val := by
      intro he
      have he':(1 : ℝ)= -m:=by
        exact_mod_cast OnePoint.coe_injective he
      linarith only [hm,he']
    have hAC : (halfTurn_realIdealPoint 1).val≠(halfTurn_realIdealPoint k).val := by
      intro he
      have he':(1 : ℝ)=k:=by exact_mod_cast OnePoint.coe_injective he
      linarith only [hm,hk,he']
    have hBC : (halfTurn_realIdealPoint (-m)).val≠(halfTurn_realIdealPoint k).val := by
      intro he
      have he':-m=k:=by exact_mod_cast OnePoint.coe_injective he
      linarith only [hm,hk,he']
    obtain ⟨a,b,_,_,_,_,hEnds,_⟩:=L.exists_idealEndpoints_pair
    rw [hEnds] at hA' hB' hC'
    simp only [mem_insert_iff,mem_singleton_iff] at hA' hB' hC'
    aesop

end LowDimensionalTopology.Geometry.Fuchsian





namespace LowDimensionalTopology.Geometry.Fuchsian
open Set Filter Topology
open scoped UpperHalfPlane OnePoint MatrixGroups
open LowDimensionalTopology.Geometry.DiscreteGroups
  LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Fuchsian
  LowDimensionalTopology.Geometry.Hyperbolic
  LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace
  LowDimensionalTopology.Geometry.Mobius
  LowDimensionalTopology.Geometry.Auxiliary.Topology
