/-- The original large-parameter group has at least three genuine maximal
elliptic classes, detected by the actual three-factor characters. -/
theorem threeHalfTurn_large_elliptic_classes_card_lower (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C:Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hlam:1≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    [Finite (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic)] :
    3≤Nat.card (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic) := by
  let J:Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![A,B,C]
  let centers:Fin 3→ℍ:=![T.a,T.b,T.c]
  have hJ:∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (J i) (centers i):=by
    intro i
    fin_cases i
    · exact hA
    · exact hB
    · exact hC
  have hLift:Function.Injective (halfTurnFreeProductLift J):=
    (threeHalfTurn_large_parameter_discrete_freeProduct T A B C hA hB hC hlam).2.1
  have hGenerators:range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i))=
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    ext g
    simp only [mem_range,mem_insert_iff,mem_singleton_iff]
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [J]
    · rintro (he|he|he)
      · exact ⟨0,he.symm⟩
      · exact ⟨1,he.symm⟩
      · exact ⟨2,he.symm⟩
  have hGroup:halfTurnFreeProductGroup J=Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=
    congrArg Subgroup.closure hGenerators
  have hMem (i:Fin 3):_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i)∈Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup):=by
    rw [←hGroup]
    exact Subgroup.subset_closure (mem_range_self i)
  have hp (i:Fin 3):_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (centers i)∈
      fuchsianCyclicFixedPoints P.asFuchsianDisc .elliptic:=by
    refine ⟨?_,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i),hMem i,(hJ i).elliptic,?_⟩
    · intro _
      exact _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint_mem _
    · change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i)).val (((centers i:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex))=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (centers i)
      rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action]
      exact congrArg _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (hJ i).2
  let point (i:Fin 3):fuchsianCyclicFixedPoints P.asFuchsianDisc .elliptic:=⟨_,hp i⟩
  let e:=fuchsianCyclicConjugacyClassesEquiv P.asFuchsianDisc .elliptic
  let cls (i:Fin 3):FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic:=
    e.symm (Quotient.mk'' (point i))
  have hinj:Function.Injective cls:=by
    intro i j hij
    by_contra hne
    have he:(Quotient.mk'' (point i):MulAction.orbitRel.Quotient
        (Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))
        (fuchsianCyclicFixedPoints P.asFuchsianDisc .elliptic))=Quotient.mk'' (point j):=by
      have hh:=congrArg e hij
      simpa only [cls,e.apply_symm_apply] using hh
    obtain ⟨g,hg⟩:=(Quotient.exact he:MulAction.orbitRel _ _ (point i) (point j))
    have hgJ:g.val∈halfTurnFreeProductGroup J:=by rw [hGroup];exact g.property
    exact halfTurnFreeProduct_centers_not_orbit J centers hJ hLift j i (Ne.symm hne)
      ⟨g.val,hgJ⟩ (congrArg Subtype.val hg)
  simpa only [Nat.card_fin] using Nat.card_le_card_of_injective cls hinj

