/-- An actual convex old ideal-tile patch sharing the interior of the base
cannot enter the new ideal triangle's side if its interiors do not overlap. -/
theorem halfTurnIdealPatch_nonpositive_of_base_disjoint
    (S:Set (ℝ×ℝ)) (hS:Convex ℝ S) (hmid:((1/2:ℝ),0)∈S)
    (hdisj:Disjoint S _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardOpenTriangle) : ∀x∈S,x.2≤0 := by
  intro x hx
  by_contra hn
  have hxpos:0<x.2:=lt_of_not_ge hn
  let p:ℝ→ℝ×ℝ:=fun t=>(1-t) • ((1/2:ℝ),0)+t • x
  have hp:Continuous p:=by fun_prop
  have hnear:∀ᶠt in 𝓝 (0:ℝ),0<(p t).1 ∧ (p t).1+(p t).2<1:=by
    have ho:IsOpen {y:ℝ×ℝ|0<y.1 ∧ y.1+y.2<1}:=
      (isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt (continuous_fst.add continuous_snd) continuous_const)
    exact hp.continuousAt.eventually (ho.mem_nhds (by norm_num [p]))
  obtain ⟨ε,hε,hcond⟩:=Metric.eventually_nhds_iff.mp hnear
  let t:=min (ε/2) (1/2)
  have ht:0<t:=lt_min (by positivity) (by norm_num)
  have ht1:t≤1:=le_trans (min_le_right _ _) (by norm_num)
  have htε:dist t 0<ε:=by
    rw [Real.dist_eq,sub_zero,abs_of_pos ht]
    exact lt_of_le_of_lt (min_le_left _ _) (by linarith only [hε])
  have hpS:p t∈S:=hS hmid hx (sub_nonneg.mpr ht1) ht.le (by ring)
  have hpT:p t∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardOpenTriangle:=by
    have hh:=hcond htε
    refine ⟨hh.1,?_,hh.2⟩
    change (1-t)*0+t*x.2>0
    nlinarith only [mul_pos ht hxpos]
  exact Set.disjoint_left.mp hdisj hpS hpT

/-- Crossing the full shared ideal side splits every actual segment into
two pieces in the respective old patch and new triangle. -/
theorem halfTurnIdealPatch_attach_convex
    (Ω S:Set (ℝ×ℝ)) (hΩ:Convex ℝ Ω) (hS:Convex ℝ S) (hsub:S⊆Ω)
    (hmid:((1/2:ℝ),0)∈S) (hdisj:Disjoint S _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardOpenTriangle)
    (haxis:∀z∈Ω,z.2=0→z∈S ∧ z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle) :
    Convex ℝ (S∪(_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩Ω)) := by
  have ht:Convex ℝ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩Ω):=_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle_convex.inter hΩ
  have hnonpos:=halfTurnIdealPatch_nonpositive_of_base_disjoint S hS hmid hdisj
  have hcross (x:ℝ×ℝ) (hx:x∈S) (y:ℝ×ℝ) (hy:y∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩Ω) :
      segment ℝ x y⊆S∪(_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩Ω) := by
    have hconn:IsPreconnected (segment ℝ x y):=(convex_segment x y).isPreconnected
    have hzexists:0∈Prod.snd '' segment ℝ x y:=
      hconn.intermediate_value (left_mem_segment ℝ x y) (right_mem_segment ℝ x y)
        continuous_snd.continuousOn ⟨hnonpos x hx,hy.1.2.1⟩
    obtain ⟨z,hzseg,hz0⟩:=hzexists
    have hzΩ:z∈Ω:=hΩ.segment_subset (hsub hx) hy.2 hzseg
    obtain ⟨hzS,hzT⟩:=haxis z hzΩ hz0
    have hzline:z∈range (AffineMap.lineMap x y:ℝ→ℝ×ℝ):=by
      rw [segment_eq_image_lineMap] at hzseg
      obtain ⟨t,_,he⟩:=hzseg
      exact ⟨t,he⟩
    intro q hq
    by_cases hqx:q=x
    · exact Or.inl (hqx ▸ hx)
    by_cases hqy:q=y
    · exact Or.inr (hqy ▸ hy)
    have hqo:q∈openSegment ℝ x y:=mem_openSegment_of_ne_left_right (Ne.symm hqx) (Ne.symm hqy) hq
    rcases openSegment_subset_union x y hzline hqo with he|he
    · exact Or.inl (he ▸ hzS)
    rcases he with hleft|hright
    · exact Or.inl (hS.segment_subset hx hzS (openSegment_subset_segment _ _ _ hleft))
    · exact Or.inr (ht.segment_subset ⟨hzT,hzΩ⟩ hy (openSegment_subset_segment _ _ _ hright))
  apply convex_iff_segment_subset.mpr
  intro x hx y hy
  rcases hx with hx|hx <;> rcases hy with hy|hy
  · exact (hS.segment_subset hx hy).trans subset_union_left
  · exact hcross x hx y hy
  · rw [segment_symm]
    exact hcross y hy x hx
  · exact (ht.segment_subset hx hy).trans subset_union_right


/-- Actual native triangle coordinates preserve exactly the original
geodesic convexity of every set. -/
theorem halfTurnIdealPatch_coordinate_convex_iff (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (S:Set ℍ) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex S ↔ Convex ℝ (T.nativeCoordinate '' S) := by
  constructor
  · intro hs
    apply convex_iff_segment_subset.mpr
    rintro x ⟨z,hz,rfl⟩ y ⟨w,hw,rfl⟩ v hv
    change v∈segment ℝ (T.toDiscTriangle.halfPlaneCoordinate z)
      (T.toDiscTriangle.halfPlaneCoordinate w) at hv
    rw [←T.toDiscTriangle.halfPlaneCoordinate_image_closedHSegment] at hv
    obtain ⟨a,ha,rfl⟩:=hv
    exact mem_image_of_mem T.nativeCoordinate (hs z hz w hw ha)
  · intro hs z hz w hw a ha
    have hm:=hs.segment_subset (mem_image_of_mem T.nativeCoordinate hz)
      (mem_image_of_mem T.nativeCoordinate hw)
    have hseg:T.nativeCoordinate a∈segment ℝ (T.nativeCoordinate z) (T.nativeCoordinate w):=by
      change T.toDiscTriangle.halfPlaneCoordinate a∈segment ℝ
        (T.toDiscTriangle.halfPlaneCoordinate z) (T.toDiscTriangle.halfPlaneCoordinate w)
      rw [←T.toDiscTriangle.halfPlaneCoordinate_image_closedHSegment]
      exact mem_image_of_mem T.toDiscTriangle.halfPlaneCoordinate ha
    obtain ⟨b,hb,he⟩:=hm hseg
    exact T.nativeCoordinate_isOpenEmbedding.injective he ▸ hb

/-- For two genuine ideal endpoints, the whole actual base line is a side
of the true closed triangle, including every finite point on that line. -/
theorem halfTurnIdealPatch_ideal_base_axis
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (ha:‖(T.toDiscTriangle.a:ℂ)‖=1)
    (hb:‖(T.toDiscTriangle.b:ℂ)‖=1)
    (q:ℝ×ℝ) (hq:q∈T.toDiscTriangle.openCoordinateDomain) (hq0:q.2=0) :
    q∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle := by
  rw [←T.toDiscTriangle.halfPlaneCoordinate_range] at hq
  obtain ⟨z,rfl⟩:=hq
  let p:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)
  have hline:p∈T.toDiscTriangle.sideLineC.closedCarrier:=
    (T.toDiscTriangle.sideLineC_iff_coordinate p).mpr hq0
  have hside:p∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelDiscHSegment T.toDiscTriangle.a T.toDiscTriangle.b:=by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelDiscHSegment_ideal_endpoints T.toDiscTriangle.sideLineC
      T.toDiscTriangle.a T.toDiscTriangle.b ha hb T.toDiscTriangle.a_ne_b
      T.toDiscTriangle.a_mem_sideLineC T.toDiscTriangle.b_mem_sideLineC]
    exact hline
  have hseg:T.toDiscTriangle.coordinate p∈segment ℝ (0,0) (1,0):=by
    rw [←T.toDiscTriangle.coordinate_a,←T.toDiscTriangle.coordinate_b,
      ←T.toDiscTriangle.coordinate_image_segment]
    exact mem_image_of_mem T.toDiscTriangle.coordinate hside
  exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle_convex.segment_subset
    (by norm_num [_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle]) (by norm_num [_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle]) hseg

/-- Attaching an actual ideal triangle across its entire base to an actual
convex old tile patch preserves geodesic convexity. Disjointness is the
proved packing input of the three-half-turn consumer, not a convexity premise. -/
theorem halfTurnIdealPatch_attach_native
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (ha:‖(T.toDiscTriangle.a:ℂ)‖=1)
    (hb:‖(T.toDiscTriangle.b:ℂ)‖=1)
    (S:Set ℍ) (hS:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex S) (hline:T.sideLineC.carrier⊆S)
    (hdisj:Disjoint S T.interior) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (S∪closure T.interior) := by
  apply (halfTurnIdealPatch_coordinate_convex_iff T _).mpr
  have hs:= (halfTurnIdealPatch_coordinate_convex_iff T S).mp hS
  let Ω:=T.toDiscTriangle.openCoordinateDomain
  have hsub:T.nativeCoordinate '' S⊆Ω:=by
    rintro _ ⟨z,_,rfl⟩
    change T.toDiscTriangle.halfPlaneCoordinate z∈T.toDiscTriangle.openCoordinateDomain
    rw [←T.toDiscTriangle.halfPlaneCoordinate_range]
    exact mem_range_self z
  have hmid:((1/2:ℝ),0)∈T.nativeCoordinate '' S:=by
    have hm:=T.toDiscTriangle.facetMidpoint_mem_openDomain 2
    change ((1/2:ℝ),0)∈T.toDiscTriangle.openCoordinateDomain at hm
    rw [←T.toDiscTriangle.halfPlaneCoordinate_range] at hm
    obtain ⟨z,hz⟩:=hm
    refine ⟨z,hline ?_,hz⟩
    exact (T.toDiscTriangle.halfPlaneCoordinate_first_line z).mp (by rw [hz])
  have hd:Disjoint (T.nativeCoordinate '' S) _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardOpenTriangle:=by
    apply Set.disjoint_left.mpr
    rintro _ ⟨z,hz,rfl⟩ hzT
    have hm:z∈T.interior:=by
      rw [←T.nativeCoordinate_image_interior] at hzT
      exact T.nativeCoordinate_isOpenEmbedding.injective.mem_set_image.mp hzT
    exact Set.disjoint_left.mp hdisj hz hm
  have haxis:∀q∈Ω,q.2=0→q∈T.nativeCoordinate '' S ∧ q∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle:=by
    intro q hq hq0
    refine ⟨?_,halfTurnIdealPatch_ideal_base_axis T ha hb q hq hq0⟩
    change q∈T.toDiscTriangle.openCoordinateDomain at hq
    rw [←T.toDiscTriangle.halfPlaneCoordinate_range] at hq
    obtain ⟨z,rfl⟩:=hq
    exact mem_image_of_mem T.nativeCoordinate
      (hline ((T.toDiscTriangle.halfPlaneCoordinate_first_line z).mp hq0))
  have he:T.nativeCoordinate '' closure T.interior=_root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩Ω:=by
    rw [T.closure_interior_coordinate,image_preimage_eq_inter_range]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩range T.toDiscTriangle.halfPlaneCoordinate=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.standardClosedTriangle∩T.toDiscTriangle.openCoordinateDomain
    rw [T.toDiscTriangle.halfPlaneCoordinate_range]
  rw [image_union,he]
  exact halfTurnIdealPatch_attach_convex Ω (T.nativeCoordinate '' S)
    T.toDiscTriangle.openCoordinateDomain_convex hs hsub hmid hd haxis


/-- Cyclic reindexing does not change the actual open triangle. -/
theorem halfTurnIdealPatch_cycle_interior (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) : T.cycle.interior=T.interior := by
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc ⁻¹' T.toDiscTriangle.cycle.interior=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc ⁻¹' T.toDiscTriangle.interior
  rw [T.toDiscTriangle.incenter_cycle_interior]

/-- All three actual ideal sides admit the same proved attachment. -/
theorem halfTurnIdealPatch_attach_native_side
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (i:Fin 3) (S:Set ℍ) (hS:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex S)
    (hline:(T.nativeLine i).carrier⊆S) (hdisj:Disjoint S T.interior) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (S∪closure T.interior) := by
  fin_cases i
  · have hi:T.cycle.interior=T.interior:=halfTurnIdealPatch_cycle_interior T
    rw [←hi]
    exact halfTurnIdealPatch_attach_native T.cycle hideal.2.1 hideal.2.2 S hS hline (hi ▸ hdisj)
  · have hi:T.cycle.cycle.interior=T.interior:=
      (halfTurnIdealPatch_cycle_interior T.cycle).trans (halfTurnIdealPatch_cycle_interior T)
    rw [←hi]
    exact halfTurnIdealPatch_attach_native T.cycle.cycle hideal.2.2 hideal.1 S hS hline (hi ▸ hdisj)
  · exact halfTurnIdealPatch_attach_native T hideal.1 hideal.2.1 S hS hline hdisj

/-- Attaching the original group's actual translate, rather than a
supplied abstract face, preserves convexity across its whole side. -/
theorem halfTurnIdealPatch_attach_translate
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (i:Fin 3) (g:ℍ≃ᵢℍ) (S:Set ℍ) (hS:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex S)
    (hline:g '' (T.nativeLine i).carrier⊆S) (hdisj:Disjoint S (g '' T.interior)) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (S∪g '' closure T.interior) := by
  have hs:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (g.symm '' S):=hS.isometry_image g.symm.isometry
  have hL:(T.nativeLine i).carrier⊆g.symm '' S:=by
    intro z hz
    exact ⟨g z,hline ⟨z,hz,rfl⟩,g.symm_apply_apply z⟩
  have hd:Disjoint (g.symm '' S) T.interior:=by
    apply Set.disjoint_left.mpr
    rintro _ ⟨z,hz,rfl⟩ hT
    exact Set.disjoint_left.mp hdisj hz ⟨g.symm z,hT,g.apply_symm_apply z⟩
  have hh:=(halfTurnIdealPatch_attach_native_side T hideal i (g.symm '' S) hs hL hd).isometry_image g.isometry
  have he:g '' (g.symm '' S)=S:=by
    rw [image_image]
    simp only [g.apply_symm_apply,image_id']
  rw [image_union,he] at hh
  exact hh


/-- Every whole side of an actual ideal triangle belongs to its actual
finite closed carrier; this is derived from the true ideal endpoints. -/
theorem halfTurnIdealPatch_whole_side
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (i:Fin 3) : (T.nativeLine i).carrier⊆closure T.interior := by
  have hbase (U:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (ha:‖(U.toDiscTriangle.a:ℂ)‖=1)
      (hb:‖(U.toDiscTriangle.b:ℂ)‖=1) : U.sideLineC.carrier⊆closure U.interior:=by
    intro z hz
    rw [U.closure_interior_coordinate]
    exact halfTurnIdealPatch_ideal_base_axis U ha hb (U.nativeCoordinate z)
      (U.toDiscTriangle.halfPlaneCoordinate_range ▸ mem_range_self z)
      ((U.toDiscTriangle.halfPlaneCoordinate_first_line z).mpr hz)
  fin_cases i
  · have hh:=hbase T.cycle hideal.2.1 hideal.2.2
    rwa [halfTurnIdealPatch_cycle_interior T] at hh
  · have hh:=hbase T.cycle.cycle hideal.2.2 hideal.1
    rwa [halfTurnIdealPatch_cycle_interior T.cycle,halfTurnIdealPatch_cycle_interior T] at hh
  · exact hbase T hideal.1 hideal.2.1

/-- The original true closed triangle is geodesically convex. -/
theorem halfTurnIdealPatch_closed_convex (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (closure T.interior) := by
  apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex.closure
  apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hConvex_iff_cayley_discHConvex T.interior).mpr
  rw [T.cayley_interior]
  exact T.toDiscTriangle.interior_discHConvex

/-- The actual translates of an ideal triangle can be connected by finite
convex tile patches. A repeated tile is retained once, and every new tile
is attached across its whole actual ideal side. -/
theorem halfTurnIdealPatch_finite_convex_patch
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (A:Fin 3→(ℍ≃ᵢℍ)) (hA:∀i,(A i)*(A i)=1)
    (hL:∀i,A i '' (T.nativeLine i).carrier=(T.nativeLine i).carrier)
    (hpack:∀g∈Subgroup.closure (range A),∀h∈Subgroup.closure (range A),g≠h→
      Disjoint (g '' T.interior) (h '' T.interior))
    (g:ℍ≃ᵢℍ) (hg:g∈Subgroup.closure (range A)) :
    ∃F:Finset (ℍ≃ᵢℍ),1∈F ∧ g∈F ∧
      (∀h∈F,h∈Subgroup.closure (range A)) ∧
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (⋃h∈F,h '' closure T.interior) := by
  classical
  let G:=Subgroup.closure (range A)
  let P:(ℍ≃ᵢℍ)→Prop:=fun x=>∃F:Finset (ℍ≃ᵢℍ),1∈F ∧ x∈F ∧
    (∀h∈F,h∈G) ∧ _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (⋃h∈F,h '' closure T.interior)
  have hstep (x:ℍ≃ᵢℍ) (hx:x∈G) (i:Fin 3) (hp:P x) : P (x*A i):=by
    obtain ⟨F,hF1,hFx,hFG,hFc⟩:=hp
    let C:=⋃h∈F,h '' closure T.interior
    have hnew:x*A i∈G:=G.mul_mem hx (Subgroup.subset_closure (mem_range_self i))
    by_cases hmem:x*A i∈F
    · exact ⟨F,hF1,hmem,hFG,hFc⟩
    have hdisj:Disjoint C ((x*A i) '' T.interior):=by
      apply Set.disjoint_left.mpr
      intro z hz hznew
      obtain ⟨h,hh,hz⟩:=mem_iUnion₂.mp hz
      have hne:h≠x*A i:=by intro he;exact hmem (he ▸ hh)
      have hd:= (hpack h (hFG h hh) (x*A i) hnew hne).closure_left
        ((x*A i).toHomeomorph.isOpenMap T.interior T.interior_isOpen)
      change Disjoint (closure (h.toHomeomorph '' T.interior)) _ at hd
      rw [←h.toHomeomorph.image_closure] at hd
      exact Set.disjoint_left.mp hd hz hznew
    have hside:(x*A i) '' (T.nativeLine i).carrier⊆C:=by
      rintro z ⟨y,hy,rfl⟩
      have hAy:A i y∈(T.nativeLine i).carrier:=hL i ▸ mem_image_of_mem (A i) hy
      exact mem_iUnion₂.mpr ⟨x,hFx,⟨A i y,halfTurnIdealPatch_whole_side T hideal i hAy,rfl⟩⟩
    have hcv:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (C∪(x*A i) '' closure T.interior):=
      halfTurnIdealPatch_attach_translate T hideal i (x*A i) C hFc hside hdisj
    refine ⟨insert (x*A i) F,Finset.mem_insert_of_mem hF1,Finset.mem_insert_self _ _,?_,?_⟩
    · intro h hh
      rcases Finset.mem_insert.mp hh with rfl|hh
      · exact hnew
      · exact hFG h hh
    · have he:(⋃h∈insert (x*A i) F,h '' closure T.interior)=
          C∪(x*A i) '' closure T.interior:=by
        ext z
        simp only [mem_union,C,mem_iUnion,exists_prop,Finset.mem_insert]
        aesop
      rw [he]
      exact hcv
  have hone:P 1:=by
    refine ⟨{1},by simp,by simp,?_,?_⟩
    · intro h hh
      have he:h=1:=Finset.mem_singleton.mp hh
      subst h
      exact G.one_mem
    · simpa using halfTurnIdealPatch_closed_convex T
  have hp:P g:=by
    induction hg using Subgroup.closure_induction_right with
    | one => exact hone
    | @mul_right x hx a ha ih =>
      obtain ⟨i,rfl⟩:=ha
      exact hstep x hx i ih
    | @mul_inv_cancel x hx a ha ih =>
      obtain ⟨i,rfl⟩:=ha
      have hai:(A i)⁻¹=A i:=inv_eq_of_mul_eq_one_left (hA i)
      rw [hai]
      exact hstep x hx i ih
  exact hp


/-- The saturation by the original whole generated group is genuinely
geodesically convex. No global convexity, core containment or orbit cover
is supplied: finite convex patches have been constructed from the actual
shared ideal sides and true packing. -/
theorem halfTurnIdealPatch_saturation_convex
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (A:Fin 3→(ℍ≃ᵢℍ)) (hA:∀i,(A i)*(A i)=1)
    (hL:∀i,A i '' (T.nativeLine i).carrier=(T.nativeLine i).carrier)
    (hpack:∀g∈Subgroup.closure (range A),∀h∈Subgroup.closure (range A),g≠h→
      Disjoint (g '' T.interior) (h '' T.interior)) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (⋃g∈Subgroup.closure (range A),g '' closure T.interior) := by
  let G:=Subgroup.closure (range A)
  intro x hx y hy z hz
  obtain ⟨g,hg,p,hp,rfl⟩:=mem_iUnion₂.mp hx
  obtain ⟨h,hh,q,hq,rfl⟩:=mem_iUnion₂.mp hy
  let k:=g⁻¹*h
  have hk:k∈G:=G.mul_mem (G.inv_mem hg) hh
  obtain ⟨F,hF1,hFk,hFG,hFc⟩:=
    halfTurnIdealPatch_finite_convex_patch T hideal A hA hL hpack k hk
  let C:=⋃a∈F,a '' closure T.interior
  have hpC:p∈C:=mem_iUnion₂.mpr ⟨1,hF1,⟨p,hp,by simp⟩⟩
  have hqC:k q∈C:=mem_iUnion₂.mpr ⟨k,hFk,⟨q,hq,rfl⟩⟩
  have hgp:g p∈g '' C:=mem_image_of_mem g hpC
  have hhq:h q∈g '' C:=by
    refine ⟨k q,hqC,?_⟩
    change (g*(g⁻¹*h)) q=h q
    rw [mul_inv_cancel_left]
  have hzc:z∈g '' C:=(hFc.isometry_image g.isometry) (g p) hgp (h q) hhq hz
  obtain ⟨v,hv,rfl⟩:=hzc
  obtain ⟨a,ha,b,hb,rfl⟩:=mem_iUnion₂.mp hv
  exact mem_iUnion₂.mpr ⟨g*a,G.mul_mem hg (hFG a ha),⟨b,hb,rfl⟩⟩


/-- The Nielsen region is contained in every nonempty invariant open native
convex set, by its minimality and compatibility with the native action. -/
theorem halfTurnIdealPatch_nielsen_minimal_native
    {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup} (P:HalfPlaneFuchsianGroup H)
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H) (S:Set ℍ) (ho:IsOpen S) (hne:S.Nonempty)
    (hc:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex S) :
    letI:=P.nativeAction
    (∀g:H,∀z∈S,g • z∈S) →
    _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE⊆S := by
  let patchOriginalAction:=P.nativeAction
  intro hi
  have hsub:_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S⊆P.asFuchsianDisc.carrier:=by
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHalfPlaneSet
    rw [←nielsen_halfPlanePoint_range]
    exact image_subset_range _ _
  have hconv:P.asFuchsianDisc.HyperbolicallyConvex (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S):=
    (P.asFuchsianDisc.hyperbolicallyConvex_halfPlane rfl S).mpr hc
  have hinv:∀g:H,∀p∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S,g • p∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S:=by
    intro g p hp
    obtain ⟨z,hz,rfl⟩:=hp
    refine ⟨g • z,hi g z hz,?_⟩
    exact (P.nativeAction_boundary g z).symm
  have hmin:=(P.asFuchsianDisc.nielsenRegion_isLeast_nonempty_open_invariant_convex hNE).2
    ⟨hsub,hne.image _,nielsen_halfPlanePoint_isOpenEmbedding.isOpenMap S ho,hconv,hinv⟩
  intro z hz
  exact nielsen_halfPlanePoint_isOpenEmbedding.injective.mem_set_image.mp (hmin hz)

/-- The original group's true Nielsen region is covered by the actual
closed ideal tiles. Only the actual packing and generator-side identities
enter: the global core cover is derived from finite convex patches and
the existing original Nielsen minimality theorem. -/
theorem halfTurnIdealPatch_nielsen_core_cover
    {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup} (P:HalfPlaneFuchsianGroup H) (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H)
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (hideal:‖(T.toDiscTriangle.a:ℂ)‖=1 ∧
      ‖(T.toDiscTriangle.b:ℂ)‖=1 ∧ ‖(T.toDiscTriangle.c:ℂ)‖=1)
    (A:Fin 3→(ℍ≃ᵢℍ)) (hA:∀i,(A i)*(A i)=1)
    (hL:∀i,A i '' (T.nativeLine i).carrier=(T.nativeLine i).carrier)
    (hpack:∀g∈Subgroup.closure (range A),∀h∈Subgroup.closure (range A),g≠h→
      Disjoint (g '' T.interior) (h '' T.interior))
    (hG:P.nativeHom.range=Subgroup.closure (range A)) :
    _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE⊆
      ⋃g∈Subgroup.closure (range A),g '' closure T.interior := by
  let G:=Subgroup.closure (range A)
  let U:=⋃g∈G,g '' closure T.interior
  have hU:_root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex U:=halfTurnIdealPatch_saturation_convex T hideal A hA hL hpack
  have hT:T.interior⊆interior U:=by
    apply interior_maximal ?_ T.interior_isOpen
    intro z hz
    exact mem_iUnion₂.mpr ⟨1,G.one_mem,⟨z,subset_closure hz,by simp⟩⟩
  have hmove (g:ℍ≃ᵢℍ) (hg:g∈G) : g '' U=U:=by
    apply subset_antisymm
    · rintro _ ⟨z,hz,rfl⟩
      obtain ⟨a,ha,b,hb,rfl⟩:=mem_iUnion₂.mp hz
      exact mem_iUnion₂.mpr ⟨g*a,G.mul_mem hg ha,⟨b,hb,rfl⟩⟩
    · intro z hz
      obtain ⟨a,ha,b,hb,rfl⟩:=mem_iUnion₂.mp hz
      refine ⟨(g⁻¹*a) b,mem_iUnion₂.mpr ⟨g⁻¹*a,G.mul_mem (G.inv_mem hg) ha,⟨b,hb,rfl⟩⟩,?_⟩
      change (g*(g⁻¹*a)) b=a b
      rw [mul_inv_cancel_left]
  have hcore:_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE⊆interior U:=by
    apply halfTurnIdealPatch_nielsen_minimal_native P hNE (interior U) isOpen_interior
      (T.interior_nonempty.mono hT) hU.interior
    let patchCoreAction:=P.nativeAction
    intro g z hz
    have hg:P.nativeHom g∈G:=by
      change P.nativeHom g∈Subgroup.closure (range A)
      rw [←hG]
      exact mem_range_self g
    have him:(P.nativeHom g) '' interior U=interior U:=by
      change (P.nativeHom g).toHomeomorph '' interior U=interior U
      rw [(P.nativeHom g).toHomeomorph.image_interior]
      exact congrArg interior (hmove (P.nativeHom g) hg)
    exact him ▸ mem_image_of_mem (P.nativeHom g) hz
  exact hcore.trans interior_subset


/-- A genuine cover only of the actual Nielsen region suffices for the
core-area upper bound. The closed tiles need not cover the whole plane,
and they are not declared to be a fundamental domain. -/
theorem halfTurnIdealPatch_core_area_le_cover
    {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup} (P:HalfPlaneFuchsianGroup H)
    (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H) (C F:Set ℍ) :
    letI:=P.nativeAction
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F →
    (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE⊆⋃g:H,g • C) →
    volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))≤volume C := by
  let patchAreaOriginalAction:=P.nativeAction
  let patchAreaCountable:Countable H:=_root_.LowDimensionalTopology.Geometry.Mobius.discreteMobius_countable H P.discrete
  let patchAreaContinuous:ContinuousConstSMul H ℍ:=⟨fun g=>(P.nativeHom g).continuous⟩
  let patchAreaInvariant:SMulInvariantMeasure H ℍ volume:=⟨by
    intro g S hS
    exact (_root_.LowDimensionalTopology.Geometry.Hyperbolic.nativeIsometry_measurePreserving (P.nativeHom g)).measure_preimage hS.nullMeasurableSet⟩
  let patchAreaNoAtoms:NullSingletonClass (volume:Measure ℍ):=⟨by
    intro z
    rw [UpperHalfPlane.volume_eq_lintegral]
    simp⟩
  intro hF hcover
  obtain ⟨F₀,hF₀,hFsub,hFcl⟩:=hF.exists_fundamentalSet
  have hnull:∀g:H,g≠1→volume {x:ℍ|g • x=x}=0:=by
    intro g hg
    have hgn:g.val≠1:=fun he=>hg (Subtype.ext he)
    have hf:((_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint:ℍ→_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) ⁻¹'
        {z:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex|g.val.val z=z}).Finite:=
      (mobius_boundary_fixed_finite g.val hgn).preimage _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint_injective.injOn
    have hsub:{x:ℍ|g • x=x}⊆_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹'
        {z:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex|g.val.val z=z}:=by
      intro z hz
      change g.val.val (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z
      rw [P.nativeAction_boundary,hz]
    exact (hf.subset hsub).countable.measure_zero volume
  have hMF:MeasureTheory.IsFundamentalDomain H F₀ volume:=
    hF₀.measureDomain_of_fixed_null
      (hF.nullMeasurableSet_of_between H ℍ hFsub hFcl) hnull
  have hAE:=hF.ae_eq_of_between H ℍ hFsub hFcl
  have hAEcore:(F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))=ᵐ[volume]
      (F₀∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE)):=by
    filter_upwards [hAE] with z hz
    exact congrArg (fun b:Prop=>b ∧ _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z∈P.asFuchsianDisc.nielsenRegion hNE) hz.symm
  calc
    volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))=
        volume (F₀∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE)):=measure_congr hAEcore
    _≤volume (⋃g:H,g • C∩F₀):=by
      apply measure_mono
      rintro z ⟨hzF,hzN⟩
      obtain ⟨g,hg⟩:=mem_iUnion.mp (hcover hzN)
      exact mem_iUnion.mpr ⟨g,hg,hzF⟩
    _≤∑'g:H,volume (g • C∩F₀):=measure_iUnion_le _
    _=volume C:=(hMF.measure_eq_tsum C).symm

