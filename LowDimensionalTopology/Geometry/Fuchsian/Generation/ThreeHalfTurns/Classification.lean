  change (if (g 1 0 : ℂ)*(x : ℂ)+(g 1 1 : ℂ)=0 then ∞ else
    ((((g 0 0 : ℂ)*(x : ℂ)+(g 0 1 : ℂ))/
      ((g 1 0 : ℂ)*(x : ℂ)+(g 1 1 : ℂ)) : ℂ) : OnePoint ℂ))=_
  have hc : (g 1 0 : ℂ)*(x : ℂ)+(g 1 1 : ℂ)≠0 := by exact_mod_cast hd
