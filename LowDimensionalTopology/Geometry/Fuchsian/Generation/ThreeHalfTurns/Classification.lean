      · exact Or.inr he
  have hcomp (i : Fin 3) :
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) (halfTurnStandardIdealOuterPoint i)=
        ((halfTurnStandardIdealLine i).carrier∪
          _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnStandardIdealLine i) halfTurnStandardIdealInnerPoint)ᶜ := by
    rw [(halfTurn_standard_ideal_components i).1,(halfTurn_standard_ideal_components i).2]
    ext z
    fin_cases i
    · change ‖(z : ℂ)‖<1 ↔ ¬(‖(z : ℂ)-(0 : ℝ)‖=1 ∨ 1<‖(z : ℂ)‖)
      rw [Complex.ofReal_zero,sub_zero]
      exact hlt _ _
    · change z.re< -1 ↔ ¬(z.re= -1 ∨ -1<z.re)
      exact hlt _ _
    · change 1<z.re ↔ ¬(z.re=1 ∨ z.re<1)
