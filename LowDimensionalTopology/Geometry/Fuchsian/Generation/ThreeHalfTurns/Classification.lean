/-- The three literal geodesic inequalities for ideal endpoints `1,-m,k`. -/
def halfTurnIdealTriangleRegion (m k : ℝ) : Set ℍ :=
  {z | 0≤Complex.normSq (z:ℂ)+(m-1)*z.re-m ∧
    Complex.normSq (z:ℂ)-(k-m)*z.re-m*k≤0 ∧
    0≤Complex.normSq (z:ℂ)-(k+1)*z.re+k}

/-- Exact coordinates of the actual axis half-turn, including its squared norm. -/
theorem halfTurnIdealFold_axis_coordinates (a : ℝ) (ha : 0<a) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL a ha•z).re= -(a^2*z.re)/Complex.normSq (z:ℂ) ∧
    Complex.normSq ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL a ha•z:ℍ):ℂ)=a^4/Complex.normSq (z:ℂ) := by
  refine ⟨sideOpposition_axis_halfturn_real a ha z,?_⟩
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe,Complex.normSq_div,Complex.normSq_neg,map_pow,Complex.normSq_ofReal]
  ring

/-- A point in the closed radial region has one of three actual half-turn
positions in the literal closed ideal triangle. -/
theorem halfTurnIdealFold_raw (u t : ℝ) (hu : 1≤u) (hut : u≤t) (z : ℍ)
    (hlo : 1≤Complex.normSq (z:ℂ))
    (hhi : Complex.normSq (z:ℂ)≤(t^2)^2) (hx : 0≤z.re)
    (hc : 0≤Complex.normSq (z:ℂ)-(t^2+1)*z.re+t^2) :
    z∈halfTurnIdealTriangleRegion (u^2) (t^2) ∨
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)•z∈halfTurnIdealTriangleRegion (u^2) (t^2) ∨
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t)
        (mul_pos (zero_lt_one.trans_le hu) (zero_lt_one.trans_le (hu.trans hut)))•z∈
        halfTurnIdealTriangleRegion (u^2) (t^2) := by
  let N:=Complex.normSq (z:ℂ)
  let x:=z.re
  let m:=u^2
  let k:=t^2
  have hm : 1≤m:=by dsimp only [m];nlinarith only [hu]
  have hk : m≤k:=by dsimp only [m,k];nlinarith only [hu,hut]
  have hN : 0<N:=zero_lt_one.trans_le hlo
  have hNx2 : x^2≤N:=by
    dsimp only [x,N]
    rw [Complex.normSq_apply]
    change z.re^2≤z.re*z.re+z.im*z.im
    nlinarith only [sq_nonneg z.im]
  have hNx : x≤N:=by
    by_cases hh : x≤1
    · exact hh.trans hlo
    · have hh' : 1<x:=lt_of_not_ge hh
      nlinarith only [hNx2,hh']
  have hxk : x≤k:=by nlinarith only [hNx2,hhi,hm,hk,hx]
  by_cases hF : 0≤N+(m-1)*x-m
  · by_cases hG : N-(k-m)*x-m*k≤0
    · exact Or.inl ⟨hF,hG,hc⟩
    · right;right
      obtain ⟨hr,hn⟩:=halfTurnIdealFold_axis_coordinates (u*t)
        (mul_pos (zero_lt_one.trans_le hu) (zero_lt_one.trans_le (hu.trans hut))) z
      have hsq : (u*t)^2=m*k:=by dsimp only [m,k];ring
      have hfour : (u*t)^4=(m*k)^2:=by rw [show (u*t)^4=((u*t)^2)^2 by ring,hsq]
      rw [hsq] at hr
      rw [hfour] at hn
      change 0≤_ ∧ _≤0 ∧ 0≤_
      rw [hr,hn]
      change 0≤(m*k)^2/N+(m-1)*(-(m*k*x)/N)-m ∧
        (m*k)^2/N-(k-m)*(-(m*k*x)/N)-m*k≤0 ∧
        0≤(m*k)^2/N-(k+1)*(-(m*k*x)/N)+k
      have hm0 : 0<m:=zero_lt_one.trans_le hm
      have hk0 : 0<k:=hm0.trans_le hk
      have hbound : 0≤m*k^2-k*(m-1)*x-N:=by
        have hh:=mul_nonneg (mul_nonneg (sub_nonneg.mpr hm) hk0.le)
          (sub_nonneg.mpr hxk)
        nlinarith only [hh,hhi]
      constructor
      · convert div_nonneg (mul_nonneg hm0.le hbound) hN.le using 1
        · field_simp
          ring
      constructor
      · have hh : 0<N-(k-m)*x-m*k:=lt_of_not_ge hG
        convert div_nonpos_of_nonpos_of_nonneg
          (neg_nonpos.mpr (mul_nonneg (mul_nonneg hm0.le hk0.le) hh.le)) hN.le using 1
        · field_simp
          ring
      · convert div_nonneg (show 0≤(m*k)^2+(k+1)*m*k*x+k*N by positivity) hN.le using 1
        · field_simp
          ring
  · right;left
    obtain ⟨hr,hn⟩:=halfTurnIdealFold_axis_coordinates u (zero_lt_one.trans_le hu) z
    have hfour : u^4=m^2:=by dsimp only [m];ring
    rw [hfour] at hn
    change 0≤_ ∧ _≤0 ∧ 0≤_
    rw [hr,hn]
    change 0≤m^2/N+(m-1)*(-(m*x)/N)-m ∧
      m^2/N-(k-m)*(-(m*x)/N)-m*k≤0 ∧
      0≤m^2/N-(k+1)*(-(m*x)/N)+k
    have hm0 : 0<m:=zero_lt_one.trans_le hm
    have hk0 : 0<k:=hm0.trans_le hk
    have hbound : 0≤k*N-(k-m)*x-m:=by
      have hh:=add_nonneg (mul_nonneg (sub_nonneg.mpr hk) (sub_nonneg.mpr hNx))
        (mul_nonneg hm0.le (sub_nonneg.mpr hlo))
      nlinarith only [hh]
    constructor
    · have hh : N+(m-1)*x-m<0:=lt_of_not_ge hF
      convert div_nonneg (mul_nonneg hm0.le (neg_nonneg.mpr hh.le)) hN.le using 1
      · field_simp
        ring
    constructor
    · convert div_nonpos_of_nonpos_of_nonneg
        (neg_nonpos.mpr (mul_nonneg hm0.le hbound)) hN.le using 1
      · field_simp
        ring
    · convert div_nonneg (show 0≤m^2+(k+1)*m*x+k*N by positivity) hN.le using 1
      · field_simp
        ring

/-- The actual trace-two equality gives the genuine ideal third-side circle. -/
theorem halfTurnIdealFold_trace_scalar (t x y : ℝ) (ht : 1<t)
    (hx : 0<x) (hy : 0<y) (hn : x^2+y^2=t^2)
    (htrace : (t-1/t)*x/y=2) : (t^2+1)*x=2*t^2 := by
  have ht0 : 0<t:=zero_lt_one.trans ht
  have hlinear : (t^2-1)*x=2*t*y:=by
    have h:=(div_eq_iff hy.ne').mp htrace
    have hmul:=congrArg (fun r : ℝ=>t*r) h
    have he : t*((t-1/t)*x)=(t^2-1)*x:=by field_simp
    rw [he] at hmul
    nlinarith only [hmul]
  have hs:=congrArg (fun r : ℝ=>r^2) hlinear
  have hnorm:=congrArg (fun r : ℝ=>4*t^2*r) hn
  have hsq : ((t^2+1)*x)^2=(2*t^2)^2:=by nlinarith only [hs,hnorm]
  exact (sq_eq_sq₀ (by positivity) (by positivity)).mp hsq

/-- The scalar condition for the finite fold follows from the actual three-matrix
trace, without any supplied ideal-circle geometry. -/
theorem halfTurnIdealFold_scalar_of_actual_trace (u t : ℝ) (hu : 0<u) (ht : 1<t)
    (w : ℍ) (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2) :
    (t^2+1)*w.re=2*t^2 := by
  have ht0 : 0<t:=zero_lt_one.trans ht
  have hr : (u*t)/u-u/(u*t)=t-1/t:=by field_simp
  rw [axisHalfTurns_point_triple_trace,hr] at htrace
  have hp : 0<(t-1/t)*w.re/w.im:=by
    have htt : 0<t-1/t:=by
      apply sub_pos.mpr
      apply (div_lt_iff₀ ht0).mpr
      nlinarith only [ht]
    exact div_pos (mul_pos htt hw) w.im_pos
  rw [abs_of_pos hp] at htrace
  exact halfTurnIdealFold_trace_scalar t w.re w.im ht hw w.im_pos hn htrace

/-- Every genuine canonical trace-two quadrilateral point has one of its three
specified actual positions in the literal closed ideal triangle. -/
theorem halfTurnIdealFold_canonical (u t : ℝ) (hu : 1≤u) (hut : u<t)
    (w : ℍ) (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans (hu.trans_lt hut)))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2)
    (z : ℍ) (hz : z∈halfTurnClosedQuad (t^2) w) :
    z∈halfTurnIdealTriangleRegion (u^2) (t^2) ∨
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)•z∈halfTurnIdealTriangleRegion (u^2) (t^2) ∨
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans (hu.trans_lt hut)))•z∈halfTurnIdealTriangleRegion (u^2) (t^2) := by
  obtain ⟨hlo,hhi,hx,hc⟩:=hz
  have he:=halfTurnIdealFold_scalar_of_actual_trace u t (zero_lt_one.trans_le hu)
    (hu.trans_lt hut) w hw hn htrace
  have hdiv : 2*t^2/w.re=t^2+1:=(div_eq_iff hw.ne').mpr (by nlinarith only [he])
  apply halfTurnIdealFold_raw u t hu hut.le z
  · rw [Complex.normSq_eq_norm_sq]
    nlinarith only [hlo]
  · rw [Complex.normSq_eq_norm_sq]
    exact (sq_le_sq₀ (norm_nonneg _) (sq_nonneg t)).mpr hhi
  · exact hx
  · change 0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2) at hc
    rw [hn,hdiv] at hc
    simpa only [Complex.normSq_apply,UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,pow_two] using hc

/-- The actual whole generated orbit meets the literal ideal triangle: the
public quadrilateral cover is followed by at most one of the two actual half-turns. -/
theorem halfTurnIdealFold_meetsEveryOrbit
    (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (u t : ℝ) (hu : 1≤u) (hut : u<t) (w : ℍ) (hw : 0<w.re)
    (hn : w.re^2+w.im^2=t^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans (hu.trans_lt hut)))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2)
    (hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu))∈H)
    (hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
      (zero_lt_one.trans (hu.trans_lt hut))))∈H)
    (hW : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)∈H) (z : ℍ) :
    ∃a∈MulAction.orbit H z,a∈halfTurnIdealTriangleRegion (u^2) (t^2) := by
  have ht : 1<t:=hu.trans_lt hut
  have ht0 : 0<t:=zero_lt_one.trans ht
  have hk : 1<t^2:=by nlinarith only [ht]
  have hD : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (zero_lt_one.trans hk))∈H:=by
    rw [←halfTurnNative_axis_product u t (zero_lt_one.trans_le hu) ht0]
    exact H.mul_mem hG hF
  obtain ⟨a,ha,hqa⟩:=halfTurnClosedQuad_meetsEveryOrbit H (t^2) hk hD u
    (zero_lt_one.trans_le hu) hF w hw hW z
  rcases halfTurnIdealFold_canonical u t hu hut w hw hn htrace a hqa with h|h|h
  · exact ⟨a,ha,h⟩
  · refine ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)•a,?_,h⟩
    rw [←MulAction.orbit_eq_iff.mpr ha]
    exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)),hF⟩,rfl⟩
  · refine ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu) ht0)•a,?_,h⟩
    rw [←MulAction.orbit_eq_iff.mpr ha]
    exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu) ht0)),hG⟩,rfl⟩

