  let largeSignatureOriginalEllipticFinite:Finite (FuchsianCyclicConjugacyClasses P.asFuchsianDisc .elliptic):=
    finitelyGenerated_cyclic_classes_finite P.asFuchsianDisc hNE hFG .elliptic
  let largeSignatureBoundaryFinite:Finite (FuchsianBoundaryHyperbolicCyclicConjugacyClasses Q.asFuchsianDisc):=
    finitelyGenerated_boundary_cyclic_classes_finite Q hFGQ
  let largeSignatureBoundaryNonempty:Nonempty (FuchsianBoundaryHyperbolicCyclicConjugacyClasses Q.asFuchsianDisc):=
    hBoundary
  let classEquiv:=fuchsianCyclicConjugacyClassesConjugationEquiv P.asFuchsianDisc
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius Q.asFuchsianDisc cayleyMobius_image_openHalfPlane.symm .elliptic
  have hCard:3≤Nat.card (FuchsianCyclicConjugacyClasses Q.asFuchsianDisc .elliptic):=by
    rw [←Nat.card_congr classEquiv]
