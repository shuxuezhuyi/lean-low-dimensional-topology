/-- The actual imaginary-axis half-turn reverses the sign of the real
coordinate at every genuine finite point. -/
theorem axisHalfTurn_real_coordinate (a : ℝ) (ha : 0<a) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL a ha•z).re= -(a^2)*z.re/Complex.normSq (z:ℂ) := by
  change ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL a ha•z:ℍ):ℂ).re=_
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe,Complex.div_re]
  simp [←Complex.ofReal_pow]

/-- Every original half-turn about a point of a true geodesic takes a
whole original open half-plane to the other side. -/
theorem halfTurn_open_halfPlane_opposite
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hu : u∈L.carrier) (m : ℍ) (hm : m∉L.carrier)
    (z : ℍ) (hz : z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L m) : A•z∉_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L m := by
  obtain ⟨q,hq⟩:=L.exists_SL_normalizer
  have hLine:(fun x:ℍ=>q•x) '' L.carrier=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier:=by
    change (fun x:ℍ=>(Matrix.SpecialLinearGroup.mapGL ℝ q)•x) '' L.carrier=_
    rw [←L.realGLMap_carrier (Matrix.SpecialLinearGroup.mapGL ℝ q),hq]
  have hqu:(q•u).re=0:=by
    have hh:q•u∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier:=by
      rw [←hLine]
      exact mem_image_of_mem (fun x:ℍ=>q•x) hu
    exact hh
  have hqm:(q•m).re≠0:=by
    intro he
    have hh:q•m∈(_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0).carrier:=he
    rw [←hLine] at hh
    obtain ⟨x,hx,heq⟩:=hh
    exact hm ((MulAction.injective q heq) ▸ hx)
  let y:=q•u
  have hy:_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 y.im y.im_pos=y:=UpperHalfPlane.ext_re_im hqu.symm rfl
  have hAxis:_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL y.im y.im_pos) y:=by
    rw [←hy]
    exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at y.im y.im_pos
  have hEq:∀x:ℍ,(q*A*q⁻¹)•x=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL y.im y.im_pos•x:=by
    intro x
    apply UpperHalfPlane.ext
    apply OnePoint.coe_injective
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,(hA.conjugate q).unique hAxis]
  have hRe:(q•(A•z)).re= -(y.im^2)*(q•z).re/Complex.normSq ((q•z:ℍ):ℂ):=by
    have hh:=hEq (q•z)
    rw [mul_smul,mul_smul,inv_smul_smul] at hh
    rw [hh]
    exact axisHalfTurn_real_coordinate y.im y.im_pos (q•z)
  have hMap:(fun x:ℍ=>q•x) '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L m=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.vertical 0) (q•m):=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry q) L (.vertical 0) hLine m hm
  have hzQ:q•z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.vertical 0) (q•m):=
    hMap ▸ mem_image_of_mem (fun x:ℍ=>q•x) hz
  intro hAz
  have hAzQ:q•(A•z)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.vertical 0) (q•m):=
    hMap ▸ mem_image_of_mem (fun x:ℍ=>q•x) hAz
  have hnorm:0<Complex.normSq ((q•z:ℍ):ℂ):=
    Complex.normSq_pos.mpr (UpperHalfPlane.ne_zero (q•z))
  rcases lt_or_gt_of_ne hqm with hleft|hright
  · rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.hReCutLt_eq_openHalfPlane 0 (q•m) hleft] at hzQ hAzQ
    change (q•z).re<0 at hzQ
    change (q•(A•z)).re<0 at hAzQ
    rw [hRe] at hAzQ
    have hh:0< -(y.im^2)*(q•z).re/Complex.normSq ((q•z:ℍ):ℂ):=
      div_pos (mul_pos_of_neg_of_neg (by nlinarith [sq_pos_of_pos y.im_pos]) hzQ) hnorm
    linarith
  · rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_vertical_gt 0 (q•m) hright] at hzQ hAzQ
