coverage are all derived from the original trace-two geometry. -/
theorem halfTurnIdeal_canonical_fundamental
    (u t : ℝ) (hu : 1≤u) (hut : u<t) (w : ℍ) (hw : 0<w.re)
    (hn : w.re^2+w.im^2=t^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans (hu.trans_lt hut)))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2) :
    let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)
    let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
      (zero_lt_one.trans (hu.trans_lt hut)))
    let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
    let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume
      (halfTurnIdeal_canonical_triangle u t hu hut).interior := by
  let hu0:=zero_lt_one.trans_le hu
  let ht:=hu.trans_lt hut
  let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu0
  let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu0 (zero_lt_one.trans ht))
  let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
  let T:=halfTurnIdeal_canonical_triangle u t hu hut
  have hd:= (halfTurnIdeal_canonical_discrete_freeProduct u t hu0 ht w hw htrace).1
  let : DiscreteTopology H:=threeHalfTurn_native_group_discrete_of_original U V W hd
  let hConf:=threeHalfTurn_native_group_conformal U V W
  have hpack : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsMobiusPacking (nativeConformalSubgroupMobiusHom H hConf).range
      (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint '' T.interior):=by
    rw [threeHalfTurn_native_group_mobius_image U V W]
    exact halfTurnIdeal_canonical_packing u t hu hut w hw hn htrace
  have hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U∈H:=Subgroup.subset_closure (by simp)
  have hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V∈H:=Subgroup.subset_closure (by simp)
  have hW : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W∈H:=Subgroup.subset_closure (by simp)
  have hm : 1≤u^2:=by nlinarith only [hu]
  have hk : u^2<t^2:=by nlinarith only [hu,hut]
  have hcl : closure T.interior=halfTurnIdealTriangleRegion (u^2) (t^2):=
    (halfTurn_canonicalIdealTriangle_region (u^2) (t^2) hm hk).2
  have hcover : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.MeetsEveryOrbit H ℍ (closure T.interior):=by
    intro z
    obtain ⟨a,ha,hregion⟩:=halfTurnIdealFold_meetsEveryOrbit H u t hu hut w hw hn htrace hF hG hW z
    obtain ⟨g,rfl⟩:=ha
    refine ⟨g,?_⟩
    rw [hcl]
    exact hregion
  exact halfTurnIdeal_native_fundamental H T
    (halfTurnIdeal_native_packing_of_boundary H hConf T.interior hpack) hcover

/-- The literal canonical ideal triangle has its genuine density area pi. -/
theorem halfTurnIdeal_canonical_area (u t : ℝ) (hu : 1≤u) (hut : u<t) :
    volume (halfTurnIdeal_canonical_triangle u t hu hut).interior=ENNReal.ofReal Real.pi := by
  let T:=halfTurnIdeal_canonical_triangle u t hu hut
  have hm : 1≤u^2:=by nlinarith only [hu]
  have hk : u^2<t^2:=by nlinarith only [hu,hut]
  have hAngles:=halfTurn_canonicalIdealTriangle_angles (u^2) (t^2) hm hk
  have hA : T.alpha=0:=hAngles.1
  have hB : T.beta=0:=hAngles.2.1
  have hC : T.gamma=0:=hAngles.2.2
  have hArea:=T.area_eq_angle_defect
  rw [hA,hB,hC,sub_zero,sub_zero,sub_zero] at hArea
  exact hArea

/-- The true canonical trace-two group has genus zero, exactly three actual
order-two elliptic classes and exactly one actual cusp. All group, domain,
area, orbit separation and parabolic data are proved inside the construction. -/
theorem halfTurnIdeal_canonical_signature
    (u t : ℝ) (hu : 1≤u) (hut : u<t) (w : ℍ) (hw : 0<w.re)
    (hn : w.re^2+w.im^2=t^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans (hu.trans_lt hut)))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2) :
    let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)
    let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
      (zero_lt_one.trans (hu.trans_lt hut)))
    let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
    let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
    letI:=threeHalfTurn_native_group_discrete_of_original U V W
      (halfTurnIdeal_canonical_discrete_freeProduct u t (zero_lt_one.trans_le hu)
        (hu.trans_lt hut) w hw htrace).1
    HasCofiniteFuchsianSignature (nativeConformalSubgroup_halfPlaneData H
      (threeHalfTurn_native_group_conformal U V W)).asFuchsianDisc 0 [2,2,2] 1 := by
  let hu0:=zero_lt_one.trans_le hu
  let ht:=hu.trans_lt hut
  let ht0:=zero_lt_one.trans ht
  let U:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu0
  let V:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu0 ht0)
  let W:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W}:Set (ℍ≃ᵢℍ))
  have hd:=(halfTurnIdeal_canonical_discrete_freeProduct u t hu0 ht w hw htrace).1
  let : DiscreteTopology H:=threeHalfTurn_native_group_discrete_of_original U V W hd
  let hConf:=threeHalfTurn_native_group_conformal U V W
  let J : Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ:=![U,V,W]
  let centers : Fin 3→ℍ:=![_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu0,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu0 ht0),w]
  have hA : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (J i) (centers i):=by
    intro i
    fin_cases i
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at u hu0
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at (u*t) (mul_pos hu0 ht0)
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w
  have hJ : ∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (J i)∈H:=by
    intro i
    fin_cases i <;> exact Subgroup.subset_closure (by simp [J])
  have hcenters : ∀i,∃a : H,orderOf a=2 ∧ a•centers i=centers i:=by
    intro i
    let a : H:=⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (J i),hJ i⟩
    refine ⟨a,?_,?_⟩
    · calc
        orderOf a=orderOf a.val:=(orderOf_injective H.subtype Subtype.val_injective a).symm
        _=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (J i)):=hSLIsometry_orderOf_eq_realSLMobius (J i)
        _=2:=(hA i).1
    · exact (hA i).2
  have horbit : ∀(i j : Fin 3)(a : H),a•centers i=centers j→i=j:=
    halfTurnIdeal_canonical_centers_orbits u t hu0 ht w hw htrace
  have hU : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U∈H:=Subgroup.subset_closure (by simp)
  have hV : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V∈H:=Subgroup.subset_closure (by simp)
  have hW : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W∈H:=Subgroup.subset_closure (by simp)
  let a : H:=⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry U*_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry V*_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry W,H.mul_mem (H.mul_mem hU hV) hW⟩
  let K:=U*V*W
  have hprod : a.val=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry K:=by
    apply IsometryEquiv.ext
    intro z
    change U•(V•(W•z))=(U*V*W)•z
    simp only [mul_smul]
  have heK : (nativeCovolume_groupEquiv H hConf a).val=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K:=by
    have hm : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry K∈H:=hprod ▸ a.property
    have ha : a=⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry K,hm⟩:=Subtype.ext hprod
    change nativeConformalSubgroupMobiusHom H hConf a=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K
    rw [ha,nativeConformalSubgroupMobiusHom_matrix]
  have hne : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K≠1:=halfTurn_triple_ne_one U V W
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu0) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu0 ht0)) w
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at u hu0) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at (u*t) (mul_pos hu0 ht0)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w)
  have hpar : _root_.LowDimensionalTopology.Geometry.Mobius.MobiusParabolic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K):=by
    apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_parabolic_iff K hne).mpr
    have hh:=congrArg (fun x : ℝ=>x^2) htrace
    rw [sq_abs] at hh
    exact hh.trans (by norm_num)
  exact halfTurnIdeal_native_signature H hConf
    (halfTurnIdeal_canonical_triangle u t hu hut).interior
    (halfTurnIdeal_canonical_fundamental u t hu hut w hw hn htrace)
    (halfTurnIdeal_canonical_area u t hu hut) centers hcenters horbit
    ⟨a,heK.symm ▸ hpar⟩

