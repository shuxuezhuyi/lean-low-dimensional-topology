theorem halfTurn_realIdealPoint_injective : Function.Injective halfTurn_realIdealPoint := by
  intro a b he
  have hh:=congrArg Subtype.val he
  exact_mod_cast OnePoint.coe_injective hh

def halfTurn_idealPairLine (a b : ℝ) (hab : a<b) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=
  .circle ((a+b)/2) ((b-a)/2) (div_pos (sub_pos.mpr hab) (by norm_num))

theorem halfTurn_idealPairLine_endpoints (a b : ℝ) (hab : a<b) :
    (halfTurn_idealPairLine a b hab).idealEndpoints=
      {(halfTurn_realIdealPoint a).val,(halfTurn_realIdealPoint b).val} := by
  rw [halfTurn_idealPairLine,_root_.LowDimensionalTopology.Geometry.Hyperbolic.circle_idealEndpoints]
  rw [show (a+b)/2-(b-a)/2=a by ring,show (a+b)/2+(b-a)/2=b by ring]
  rfl

theorem halfTurn_idealPairLine_closed_endpoints (a b : ℝ) (hab : a<b) :
    halfTurn_realIdealPoint a∈(halfTurn_idealPairLine a b hab).closedCarrier ∧
      halfTurn_realIdealPoint b∈(halfTurn_idealPairLine a b hab).closedCarrier := by
  constructor
  · apply ((halfTurn_idealPairLine a b hab).closedCarrier_mem_ideal_iff _
      (halfTurn_realIdealPoint_ideal a)).mpr
    rw [halfTurn_idealPairLine_endpoints]
    simp
  · apply ((halfTurn_idealPairLine a b hab).closedCarrier_mem_ideal_iff _
      (halfTurn_realIdealPoint_ideal b)).mpr
    rw [halfTurn_idealPairLine_endpoints]
    simp

/-- The side support lines of the actual canonical ideal triangle are the
three circles through its literal pairs of real ideal vertices. -/
theorem halfTurn_canonicalIdealTriangle_lines (m k : ℝ) (hm : 1≤m) (hk : m<k) :
    let T:=halfTurn_canonicalIdealTriangle m k hm hk
    T.sideLineA=halfTurn_idealPairLine (-m) k (by linarith) ∧
      T.sideLineB=halfTurn_idealPairLine 1 k (by linarith) ∧
      T.sideLineC=halfTurn_idealPairLine (-m) 1 (by linarith) := by
  let T:=halfTurn_canonicalIdealTriangle m k hm hk
  have hmk : -m<k:=by linarith only [hm,hk]
  have h1k : 1<k:=hm.trans_lt hk
  have hm1 : -m<1:=by linarith only [hm]
  have hA : T.toDiscTriangle.sideLineA=(halfTurn_idealPairLine (-m) k hmk).toDiscLine := by
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.eq_of_two_closed_points _ _ T.toDiscTriangle.b_ne_c
      T.toDiscTriangle.b_mem_sideLineA T.toDiscTriangle.c_mem_sideLineA
    · exact ((halfTurn_idealPairLine (-m) k hmk).toDiscLine.closedCarrier_cayley_mem T.b).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints (-m) k hmk).1)
    · exact ((halfTurn_idealPairLine (-m) k hmk).toDiscLine.closedCarrier_cayley_mem T.c).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints (-m) k hmk).2)
  have hB : T.toDiscTriangle.sideLineB=(halfTurn_idealPairLine 1 k h1k).toDiscLine := by
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.eq_of_two_closed_points _ _ T.toDiscTriangle.c_ne_a
      T.toDiscTriangle.c_mem_sideLineB T.toDiscTriangle.a_mem_sideLineB
    · exact ((halfTurn_idealPairLine 1 k h1k).toDiscLine.closedCarrier_cayley_mem T.c).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints 1 k h1k).2)
    · exact ((halfTurn_idealPairLine 1 k h1k).toDiscLine.closedCarrier_cayley_mem T.a).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints 1 k h1k).1)
  have hC : T.toDiscTriangle.sideLineC=(halfTurn_idealPairLine (-m) 1 hm1).toDiscLine := by
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.eq_of_two_closed_points _ _ T.toDiscTriangle.a_ne_b
      T.toDiscTriangle.a_mem_sideLineC T.toDiscTriangle.b_mem_sideLineC
    · exact ((halfTurn_idealPairLine (-m) 1 hm1).toDiscLine.closedCarrier_cayley_mem T.a).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints (-m) 1 hm1).2)
    · exact ((halfTurn_idealPairLine (-m) 1 hm1).toDiscLine.closedCarrier_cayley_mem T.b).mpr
        (by simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,T,halfTurn_canonicalIdealTriangle] using
          (halfTurn_idealPairLine_closed_endpoints (-m) 1 hm1).1)
  change T.toDiscTriangle.sideLineA.toHalfPlane=_ ∧
    T.toDiscTriangle.sideLineB.toHalfPlane=_ ∧ T.toDiscTriangle.sideLineC.toHalfPlane=_
  rw [hA,hB,hC,_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.toDiscLine_toHalfPlane]
  exact ⟨rfl,rfl,rfl⟩

theorem halfTurn_canonicalIdealTriangle_angles (m k : ℝ) (hm : 1≤m) (hk : m<k) :
    let T:=halfTurn_canonicalIdealTriangle m k hm hk
    T.alpha=0 ∧ T.beta=0 ∧ T.gamma=0 := by
  let T:=halfTurn_canonicalIdealTriangle m k hm hk
  exact ⟨T.toDiscTriangle.alpha_of_ideal
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm T.a (halfTurn_realIdealPoint_ideal 1)),
    T.toDiscTriangle.beta_of_ideal
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm T.b (halfTurn_realIdealPoint_ideal (-m))),
    T.toDiscTriangle.gamma_of_ideal
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_ideal_norm T.c (halfTurn_realIdealPoint_ideal k))⟩

theorem halfTurn_closedTriangle_closedPoint_closure (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (p : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHalfPlaneModel) (hp : p∈T.closedCarrier) :
    p.val∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' T.interior) := by
  have hpD : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayleyHomeomorph p∈T.toDiscTriangle.closedCarrier := by
    rw [←T.cayley_closedCarrier]
    exact mem_image_of_mem _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayleyHomeomorph hp
  have he:=T.toDiscTriangle.closedPoint_mem_closureInterior _ hpD
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_toExtended,_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedCayley.symm_apply_apply] at he
  exact he

