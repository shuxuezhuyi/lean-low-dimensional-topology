theorem halfTurn_unitCircle_inside (m : ℍ) (hm : ‖(m : ℂ)‖<1) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle 0 1 (by norm_num)) m={z : ℍ|‖(z : ℂ)‖<1} := by
