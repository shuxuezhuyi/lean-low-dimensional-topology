      simpa only [Complex.ofReal_zero,sub_zero] using
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_circle_outside 0 1 (by norm_num) halfTurnStandardIdealInnerPoint
          (by norm_num [halfTurnStandardIdealInnerPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,Complex.norm_def,Complex.normSq_apply])
  · constructor
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.hReCutLt_eq_openHalfPlane (-1) (halfTurnStandardIdealOuterPoint 1) (by norm_num
        [halfTurnStandardIdealOuterPoint,_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe])
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_vertical_gt (-1) halfTurnStandardIdealInnerPoint (by norm_num
