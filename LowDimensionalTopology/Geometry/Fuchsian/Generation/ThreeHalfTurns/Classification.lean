/-- The actual two distinct imaginary-axis centers and the actual positive-real
third center form a genuine noncollinear half-plane triangle. -/
def halfTurnCanonical_center_triangle (u t : ℝ) (hu : 0<u) (ht : 1<t)
    (w : ℍ) (hw : 0<w.re) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle where
  a:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu
  b:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu (zero_lt_one.trans ht))
  c:=w
  noncollinear:=by
    rintro ⟨L,hLa,hLb,hLc⟩
    have hne : _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 u hu≠_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (u*t) (mul_pos hu (zero_lt_one.trans ht)):=by
      intro he
      have hi:=congrArg UpperHalfPlane.im he
      change u=u*t at hi
      nlinarith only [hu,ht,hi]
    have hL : L=_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0:=L.eq_of_two_points (_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.vertical 0)
      hne hLa hLb rfl rfl
    rw [hL] at hLc
    change w.re=0 at hLc
    linarith only [hw,hLc]

/-- The actual trace-two condition gives exactly lambda one for the genuine
triangle of the unchanged canonical half-turn centers. -/
theorem halfTurnCanonical_center_triangle_invariant (u t : ℝ) (hu : 0<u) (ht : 1<t)
    (w : ℍ) (hw : 0<w.re)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|=2) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant (halfTurnCanonical_center_triangle u t hu ht w hw)=1 := by
  have hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)
      (halfTurnCanonical_center_triangle u t hu ht w hw).a:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at u hu
  have hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht)))
      (halfTurnCanonical_center_triangle u t hu ht w hw).b:=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at (u*t) (mul_pos hu (zero_lt_one.trans ht))
  have hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)
      (halfTurnCanonical_center_triangle u t hu ht w hw).c:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w
  have h:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurn_triple_abs_trace (halfTurnCanonical_center_triangle u t hu ht w hw)
    _ _ _ hA hB hC
  rw [htrace] at h
  linarith only [h]

