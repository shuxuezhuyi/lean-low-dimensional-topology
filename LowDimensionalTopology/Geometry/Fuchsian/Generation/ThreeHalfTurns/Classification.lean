  have hζfinite:∃b:ℝ,((b:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B1).val
