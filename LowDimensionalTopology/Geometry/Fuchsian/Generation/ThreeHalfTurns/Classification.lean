      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius U,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius V,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius W}:Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) ∧
      Function.Injective (halfTurnFreeProductLift (![U,V,W]:Fin 3→_)) := by
  let T:=halfTurnCanonical_center_triangle u t hu ht w hw
  have hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu) T.a:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_at u hu
