/-- On the unchanged actual half-plane, original geometric core area is
exactly the integral of the true native density inside the same Nielsen region. -/
theorem halfTurn_native_geometric_core_area {H:Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P:HalfPlaneFuchsianGroup H) (hNE:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H)
    (F:Set ℍ) (hF:MeasurableSet F) :
    geometricNielsenCoreArea P.asFuchsianDisc hNE
      (geometricHalfPlaneIdentity P.asFuchsianDisc rfl ⁻¹' F)=
      volume (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE)) := by
  let e:=geometricHalfPlaneIdentity P.asFuchsianDisc rfl
  have he:e ⁻¹' (F∩(_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' P.asFuchsianDisc.nielsenRegion hNE))=
      (e ⁻¹' F)∩(Subtype.val ⁻¹' P.asFuchsianDisc.nielsenRegion hNE):=by
    ext x
    simp only [mem_preimage,mem_inter_iff]
    rw [geometricHalfPlaneIdentity_extended]
  unfold geometricNielsenCoreArea
  rw [←he]
  exact compactCover_original_geometric_area P _
    (hF.inter (((P.asFuchsianDisc.nielsenRegion_properties hNE).2.2.1.preimage
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneBoundaryPoint_isOpenEmbedding.continuous).measurableSet))

end LowDimensionalTopology.Geometry.Fuchsian

