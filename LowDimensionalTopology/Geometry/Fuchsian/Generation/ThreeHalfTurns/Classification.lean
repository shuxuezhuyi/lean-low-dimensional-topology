/-- The whole actual cyclic group of an original half-turn consists of
the identity and that same half-turn. -/
theorem halfTurn_zpowers_nonidentity
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (g : _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup) (hg : g∈Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)) (hne : g≠1) :
    g=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A := by
  classical
  have hfin:IsOfFinOrder (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A):=
    orderOf_pos_iff.mp (by rw [hA.1];decide)
  obtain ⟨k,hk,rfl⟩:=Finset.mem_image.mp (hfin.mem_zpowers_iff_mem_range_orderOf.mp hg)
  have hk2:k<2:=by simpa only [hA.1,Finset.mem_range] using hk
  have h01:k=0 ∨ k=1:=by omega
  rcases h01 with rfl|rfl
  · exact False.elim (hne (pow_zero _))
  · exact pow_one _

/-- A true geodesic half-plane is an actual sphere packing for the entire
original half-turn subgroup, with no packing hypothesis. -/
theorem halfTurn_cyclic_open_halfPlane_packing
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u : ℍ) (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u)
    (L : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine) (hu : u∈L.carrier) (m : ℍ) (hm : m∉L.carrier) :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsMobiusPacking (Subgroup.zpowers (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A))
      ((fun z:ℍ=>((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)) '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane L m) := by
  intro g hgne
  have hbase:g.val≠1:=fun he=>hgne (Subtype.ext he)
  have hg:=halfTurn_zpowers_nonidentity A u hA g.val g.property hbase
  apply Set.disjoint_left.mpr
  rintro z ⟨ξ,⟨x,hx,rfl⟩,rfl⟩ ⟨y,hy,hye⟩
  rw [hg,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action] at hye
  have he:y=A•x:=UpperHalfPlane.ext (OnePoint.coe_injective hye)
  exact halfTurn_open_halfPlane_opposite A u hA L hu m hm x hx (he ▸ hy)

end LowDimensionalTopology.Geometry.Fuchsian

