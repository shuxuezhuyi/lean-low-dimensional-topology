  LowDimensionalTopology.Geometry.Surfaces

/-- The actual inner-circle component and its closure are the ordinary
strict and weak Euclidean norm cuts in the original half-plane. -/
theorem halfTurn_circle_inside_components (c r : ℝ) (hr : 0<r) (q : ℍ)
    (hq : ‖(q : ℂ)-(c : ℂ)‖<r) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle c r hr) q={z : ℍ|‖(z : ℂ)-(c : ℂ)‖<r} ∧
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane (.circle c r hr) q={z : ℍ|‖(z : ℂ)-(c : ℂ)‖≤r} := by
  have hOpen : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle c r hr) q={z : ℍ|‖(z : ℂ)-(c : ℂ)‖<r} := by
    apply subset_antisymm (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_circle_inside_subset c r hr q hq)
    have hp : IsPreconnected {z : ℍ|‖(z : ℂ)-(c : ℂ)‖<r} := by
      apply UpperHalfPlane.isEmbedding_coe.isInducing.isPreconnected_image.mp
      have hi : ((↑) : ℍ→ℂ) '' {z : ℍ|‖(z : ℂ)-(c : ℂ)‖<r}=
          {z : ℂ|0<z.im}∩Metric.ball (c : ℂ) r := by
        ext z
        simp only [mem_image,mem_ofPred_eq,mem_inter_iff,Metric.mem_ball,dist_eq_norm]
        exact ⟨fun ⟨w,hw,he⟩=>he ▸ ⟨w.im_pos,hw⟩,
          fun ⟨hz,hn⟩=>⟨⟨z,hz⟩,hn,rfl⟩⟩
      rw [hi]
      exact ((convex_halfSpace_gt Complex.imCLM.toLinearMap.isLinear 0).inter
        (convex_ball (c : ℂ) r)).isPreconnected
    apply hp.subset_connectedComponentIn hq
    exact fun z hz he=>hz.ne he
  refine ⟨hOpen,?_⟩
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane,hOpen]
  have he:=UpperHalfPlane.isOpenEmbedding_coe.isOpenMap.preimage_closure_eq_closure_preimage
    UpperHalfPlane.continuous_coe (Metric.ball (c : ℂ) r)
  rw [closure_ball (c : ℂ) hr.ne'] at he
  simpa [Metric.ball,Metric.closedBall,dist_eq_norm] using he.symm

theorem halfTurn_circle_outside_components (c r : ℝ) (hr : 0<r) (q : ℍ)
    (hq : r<‖(q : ℂ)-(c : ℂ)‖) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle c r hr) q={z : ℍ|r<‖(z : ℂ)-(c : ℂ)‖} ∧
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane (.circle c r hr) q={z : ℍ|r≤‖(z : ℂ)-(c : ℂ)‖} := by
  have hOpen:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_circle_outside c r hr q hq
  refine ⟨hOpen,?_⟩
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane,hOpen]
  have he:=UpperHalfPlane.isOpenEmbedding_coe.isOpenMap.preimage_closure_eq_closure_preimage
    UpperHalfPlane.continuous_coe (Metric.closedBall (c : ℂ) r)ᶜ
  have hAmbient : closure (Metric.closedBall (c : ℂ) r)ᶜ=(Metric.ball (c : ℂ) r)ᶜ := by
    rw [closure_compl,interior_closedBall (c : ℂ) hr.ne']
  rw [hAmbient] at he
  have hFirst : {z : ℍ|r<‖(z : ℂ)-(c : ℂ)‖}=
      ((↑) : ℍ→ℂ) ⁻¹' (Metric.closedBall (c : ℂ) r)ᶜ := by
    ext z
    simp [dist_eq_norm]
  have hSecond : {z : ℍ|r≤‖(z : ℂ)-(c : ℂ)‖}=
      ((↑) : ℍ→ℂ) ⁻¹' (Metric.ball (c : ℂ) r)ᶜ := by
    ext z
    simp [dist_eq_norm]
  rw [hFirst,hSecond]
  exact he.symm

/-- An actual finite ideal closure point fixes the component side: it is
not legitimate to choose the opposite norm cut just from a line equation. -/
theorem halfTurn_circle_side_of_real_closure (S : Set ℍ) (q : ℍ) (hq : q∈S)
    (c r : ℝ) (hr : 0<r) (d : ℝ)
    (hd : ((d : ℂ) : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' S))
    (hS : S⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle c r hr) q) :
    (|d-c| < r → ‖(q : ℂ)-(c : ℂ)‖<r) ∧
      (r < |d-c| → r<‖(q : ℂ)-(c : ℂ)‖) := by
  have hqn : ‖(q : ℂ)-(c : ℂ)‖≠r:=connectedComponentIn_subset _ _ (hS hq)
  constructor
  · intro hlt
    rcases lt_or_gt_of_ne hqn with hq'|hq'
    · exact hq'
    have hsub : ((↑) : ℍ→ℂ) '' S⊆{z : ℂ|r≤‖z-(c : ℂ)‖} := by
      rintro _ ⟨z,hz,rfl⟩
      have he:=hS hz
      rw [(halfTurn_circle_outside_components c r hr q hq').1] at he
      change r<‖(z : ℂ)-(c : ℂ)‖ at he
      exact he.le
    have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.finite_mem_extended_closure_mem_closed S _
      (isClosed_le continuous_const (continuous_id.sub continuous_const).norm) hsub (d : ℂ) hd
    change r≤‖(d : ℂ)-(c : ℂ)‖ at he
    have he' : r≤|(d-c)|:=by simpa only [←Complex.ofReal_sub,Complex.norm_real,Real.norm_eq_abs] using he
    exact False.elim ((not_le_of_gt hlt) he')
  · intro hgt
    rcases lt_or_gt_of_ne hqn with hq'|hq'
    · have hsub : ((↑) : ℍ→ℂ) '' S⊆{z : ℂ|‖z-(c : ℂ)‖≤r} := by
        rintro _ ⟨z,hz,rfl⟩
        have he:=hS hz
        rw [(halfTurn_circle_inside_components c r hr q hq').1] at he
        change ‖(z : ℂ)-(c : ℂ)‖<r at he
        exact he.le
      have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.finite_mem_extended_closure_mem_closed S _
        (isClosed_le (continuous_id.sub continuous_const).norm continuous_const) hsub (d : ℂ) hd
      change ‖(d : ℂ)-(c : ℂ)‖≤r at he
      have he' : |(d-c)|≤r:=by simpa only [←Complex.ofReal_sub,Complex.norm_real,Real.norm_eq_abs] using he
      exact False.elim ((not_le_of_gt hgt) he')
    · exact hq'

theorem halfTurn_pairCircle_polynomial (a b : ℝ) (z : ℂ) :
    ‖z-((a+b)/2 : ℝ)‖^2-((b-a)/2)^2=
      Complex.normSq z-(a+b)*z.re+a*b := by
  rw [←Complex.normSq_eq_norm_sq,Complex.normSq_apply,Complex.normSq_apply]
  simp only [Complex.sub_re,Complex.sub_im,Complex.ofReal_re,Complex.ofReal_im,sub_zero]
  ring

theorem halfTurn_pairCircle_cut_iff (a b : ℝ) (hab : a<b) (z : ℍ) :
    (‖(z : ℂ)-((a+b)/2 : ℝ)‖<(b-a)/2 ↔
      Complex.normSq (z : ℂ)-(a+b)*z.re+a*b<0) ∧
    ((b-a)/2<‖(z : ℂ)-((a+b)/2 : ℝ)‖ ↔
      0<Complex.normSq (z : ℂ)-(a+b)*z.re+a*b) ∧
    (‖(z : ℂ)-((a+b)/2 : ℝ)‖≤(b-a)/2 ↔
      Complex.normSq (z : ℂ)-(a+b)*z.re+a*b≤0) ∧
    ((b-a)/2≤‖(z : ℂ)-((a+b)/2 : ℝ)‖ ↔
      0≤Complex.normSq (z : ℂ)-(a+b)*z.re+a*b) := by
  have he:=halfTurn_pairCircle_polynomial a b (z : ℂ)
  change ‖(z : ℂ)-((a+b)/2 : ℝ)‖^2-((b-a)/2)^2=
    Complex.normSq (z : ℂ)-(a+b)*z.re+a*b at he
  have hr : 0≤(b-a)/2:=(div_pos (sub_pos.mpr hab) (by norm_num)).le
  have hn:=norm_nonneg ((z : ℂ)-((a+b)/2 : ℝ))
  refine ⟨(sq_lt_sq₀ hn hr).symm.trans ?_,(sq_lt_sq₀ hr hn).symm.trans ?_,
    (sq_le_sq₀ hn hr).symm.trans ?_,(sq_le_sq₀ hr hn).symm.trans ?_⟩ <;>
      constructor <;> intro h <;> linarith only [he,h]

end LowDimensionalTopology.Geometry.Fuchsian

