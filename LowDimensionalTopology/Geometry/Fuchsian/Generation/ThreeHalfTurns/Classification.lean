/-- Each inner component is selected by the actual triangle interior,
with all three strict and weak cuts retained for the packing consumer. -/
theorem halfTurn_canonicalIdealTriangle_components (m k : ℝ) (hm : 1≤m) (hk : m<k)
    (q : ℍ) (hq : q∈(halfTurn_canonicalIdealTriangle m k hm hk).interior) :
    let T:=halfTurn_canonicalIdealTriangle m k hm hk
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q=
      {z : ℍ|Complex.normSq (z : ℂ)-(k-m)*z.re-m*k<0} ∧
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q=
      {z : ℍ|0<Complex.normSq (z : ℂ)-(k+1)*z.re+k} ∧
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q=
      {z : ℍ|0<Complex.normSq (z : ℂ)+(m-1)*z.re-m} ∧
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineA q=
      {z : ℍ|Complex.normSq (z : ℂ)-(k-m)*z.re-m*k≤0} ∧
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineB q=
      {z : ℍ|0≤Complex.normSq (z : ℂ)-(k+1)*z.re+k} ∧
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineC q=
      {z : ℍ|0≤Complex.normSq (z : ℂ)+(m-1)*z.re-m} := by
  let T:=halfTurn_canonicalIdealTriangle m k hm hk
  have hmk : -m<k:=by linarith only [hm,hk]
  have h1k : 1<k:=hm.trans_lt hk
  have hm1 : -m<1:=by linarith only [hm]
  have hrA : 0<(k-(-m))/2:=div_pos (sub_pos.mpr hmk) (by norm_num)
  have hrB : 0<(k-1)/2:=div_pos (sub_pos.mpr h1k) (by norm_num)
  have hrC : 0<(1-(-m))/2:=div_pos (sub_pos.mpr hm1) (by norm_num)
  have hLines:=halfTurn_canonicalIdealTriangle_lines m k hm hk
  have hComp : T.interior=_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q∩
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q∩_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q):=
    T.toDiscTriangle.halfPlaneInterior_eq_components q hq
  have hSubA : T.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle ((-m+k)/2) ((k-(-m))/2) hrA) q := by
    intro z hz
    have he: z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q:=(hComp ▸ hz).1
    rw [hLines.1] at he
    exact he
  have hSubB : T.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle ((1+k)/2) ((k-1)/2) hrB) q := by
    intro z hz
    have he: z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q:=(hComp ▸ hz).2.1
    rw [hLines.2.1] at he
    exact he
  have hSubC : T.interior⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle ((-m+1)/2) ((1-(-m))/2) hrC) q := by
    intro z hz
    have he: z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q:=(hComp ▸ hz).2.2
    rw [hLines.2.2] at he
    exact he
  have hACl : ((1 : ℂ) : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' T.interior):=
    halfTurn_closedTriangle_closedPoint_closure T T.a
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.subset_closedHalfPlaneHConvexHull _ (by simp))
  have hBCl : (((-m : ℝ) : ℂ) : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' T.interior):=
    halfTurn_closedTriangle_closedPoint_closure T T.b
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.subset_closedHalfPlaneHConvexHull _ (by simp))
  have hCCl : ((k : ℂ) : _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.extendedHalfPlanePoint '' T.interior):=
    halfTurn_closedTriangle_closedPoint_closure T T.c
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.subset_closedHalfPlaneHConvexHull _ (by simp))
  have hqa : ‖(q : ℂ)-((-m+k)/2 : ℝ)‖<(k-(-m))/2:=
    (halfTurn_circle_side_of_real_closure T.interior q hq _ _ hrA 1 hACl hSubA).1
      (abs_lt.mpr ⟨by linarith only [hm,hk],by linarith only [hm,hk]⟩)
  have hqb : (k-1)/2<‖(q : ℂ)-((1+k)/2 : ℝ)‖:=
    (halfTurn_circle_side_of_real_closure T.interior q hq _ _ hrB (-m) hBCl hSubB).2 (by
      rw [abs_of_neg (by linarith only [hm,hk] : -m-(1+k)/2<0)]
      linarith only [hm,hk])
  have hqc : (1-(-m))/2<‖(q : ℂ)-((-m+1)/2 : ℝ)‖:=
    (halfTurn_circle_side_of_real_closure T.interior q hq _ _ hrC k hCCl hSubC).2 (by
      rw [abs_of_pos (by linarith only [hm,hk] : 0<k-(-m+1)/2)]
      linarith only [hm,hk])
  have hAOpen : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q=
      {z : ℍ|Complex.normSq (z : ℂ)-(-m+k)*z.re+(-m)*k<0} := by
    rw [hLines.1]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle _ _ hrA) q=_
    rw [(halfTurn_circle_inside_components _ _ hrA q hqa).1]
    ext z
    exact (halfTurn_pairCircle_cut_iff (-m) k hmk z).1
  have hBOpen : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q=
      {z : ℍ|0<Complex.normSq (z : ℂ)-(1+k)*z.re+1*k} := by
    rw [hLines.2.1]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle _ _ hrB) q=_
    rw [(halfTurn_circle_outside_components _ _ hrB q hqb).1]
    ext z
    exact (halfTurn_pairCircle_cut_iff 1 k h1k z).2.1
  have hCOpen : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q=
      {z : ℍ|0<Complex.normSq (z : ℂ)-(-m+1)*z.re+(-m)*1} := by
    rw [hLines.2.2]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (.circle _ _ hrC) q=_
    rw [(halfTurn_circle_outside_components _ _ hrC q hqc).1]
    ext z
    exact (halfTurn_pairCircle_cut_iff (-m) 1 hm1 z).2.1
  have hAClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineA q=
      {z : ℍ|Complex.normSq (z : ℂ)-(-m+k)*z.re+(-m)*k≤0} := by
    rw [hLines.1]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane (.circle _ _ hrA) q=_
    rw [(halfTurn_circle_inside_components _ _ hrA q hqa).2]
    ext z
    exact (halfTurn_pairCircle_cut_iff (-m) k hmk z).2.2.1
  have hBClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineB q=
      {z : ℍ|0≤Complex.normSq (z : ℂ)-(1+k)*z.re+1*k} := by
    rw [hLines.2.1]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane (.circle _ _ hrB) q=_
    rw [(halfTurn_circle_outside_components _ _ hrB q hqb).2]
    ext z
    exact (halfTurn_pairCircle_cut_iff 1 k h1k z).2.2.2
  have hCClosed : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane T.sideLineC q=
      {z : ℍ|0≤Complex.normSq (z : ℂ)-(-m+1)*z.re+(-m)*1} := by
    rw [hLines.2.2]
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedHHalfPlane (.circle _ _ hrC) q=_
    rw [(halfTurn_circle_outside_components _ _ hrC q hqc).2]
    ext z
    exact (halfTurn_pairCircle_cut_iff (-m) 1 hm1 z).2.2.2
  have hAPoly (z : ℍ) : Complex.normSq (z : ℂ)-(-m+k)*z.re+(-m)*k=
      Complex.normSq (z : ℂ)-(k-m)*z.re-m*k := by ring
  have hBPoly (z : ℍ) : Complex.normSq (z : ℂ)-(1+k)*z.re+1*k=
      Complex.normSq (z : ℂ)-(k+1)*z.re+k := by ring
  have hCPoly (z : ℍ) : Complex.normSq (z : ℂ)-(-m+1)*z.re+(-m)*1=
      Complex.normSq (z : ℂ)+(m-1)*z.re-m := by ring
  refine ⟨?_,?_,?_,?_,?_,?_⟩
  · simpa only [hAPoly] using hAOpen
  · simpa only [hBPoly] using hBOpen
  · simpa only [hCPoly] using hCOpen
  · simpa only [hAPoly] using hAClosed
  · simpa only [hBPoly] using hBClosed
  · simpa only [hCPoly] using hCClosed

/-- The literal parabolic-product cuts are exactly the interior and
native closed carrier of the genuine three-ideal-vertex triangle. -/
theorem halfTurn_canonicalIdealTriangle_region (m k : ℝ) (hm : 1≤m) (hk : m<k) :
    let T:=halfTurn_canonicalIdealTriangle m k hm hk
    T.interior={z : ℍ|0<Complex.normSq (z : ℂ)+(m-1)*z.re-m ∧
      Complex.normSq (z : ℂ)-(k-m)*z.re-m*k<0 ∧
      0<Complex.normSq (z : ℂ)-(k+1)*z.re+k} ∧
      closure T.interior=halfTurnIdealTriangleRegion m k := by
  let T:=halfTurn_canonicalIdealTriangle m k hm hk
  obtain ⟨q,hq⟩:=T.interior_nonempty
  obtain ⟨hAOpen,hBOpen,hCOpen,hAClosed,hBClosed,hCClosed⟩:=
    halfTurn_canonicalIdealTriangle_components m k hm hk q hq
  have hComp : T.interior=_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineA q∩
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineB q∩_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane T.sideLineC q):=
    T.toDiscTriangle.halfPlaneInterior_eq_components q hq
  constructor
  · rw [hComp,hAOpen,hBOpen,hCOpen]
    ext z
    simp only [mem_inter_iff,mem_ofPred_eq]
    tauto
  · rw [halfTurn_closedTriangle_closure_halfplanes T q hq,hAClosed,hBClosed,hCClosed]
    ext z
    simp only [halfTurnIdealTriangleRegion,mem_inter_iff,mem_ofPred_eq]
    tauto

end LowDimensionalTopology.Geometry.Fuchsian

