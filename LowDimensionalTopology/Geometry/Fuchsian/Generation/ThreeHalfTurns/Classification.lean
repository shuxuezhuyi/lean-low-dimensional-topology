/-- The three genuine lines of the normalized open-ended chamber. -/
def halfTurnSeparatedLines (s:ℝ) (hs:s<1) : Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine:=
  ![.vertical (-1),.vertical 1,.circle ((s+1)/2) ((1-s)/2) (by linarith)]

def halfTurnSeparatedNativeGap (s:ℝ) : Set ℍ:={z|-1<z.re ∧ z.re<s}

def halfTurnSeparatedSphereGap (s:ℝ) : Set _root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex:=
  ((↑):ℂ→_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) '' {z:ℂ|-1<z.re ∧ z.re<s}

/-- The actual standard open-ended chamber has a whole native strip gap;
all outer-to-inner inclusions follow from true circle/vertical equations. -/
theorem halfTurnSeparated_components (s:ℝ) (hs0:-1<s) (hs1:s<1) :
    ∃p:ℍ,(∀i,p∉(halfTurnSeparatedLines s hs1 i).carrier) ∧
      (∀i,halfTurnSeparatedNativeGap s⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p) ∧
      (∀i j:Fin 3,i≠j→
        ((halfTurnSeparatedLines s hs1 j).carrier∪
          _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 j) p)ᶜ⊆
            _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p) := by
  let c:ℝ:=(s+1)/2
  let r:ℝ:=(1-s)/2
  have hr:0<r:=by dsimp [r];linarith only [hs1]
  have hleft (z:ℍ) (hz:z.re<s) : r<‖(z:ℂ)-(c:ℂ)‖:=by
    have hneg:((z:ℂ)-(c:ℂ)).re<0:=by
      simp only [Complex.sub_re,Complex.ofReal_re]
      dsimp [c]
      linarith only [hz,hs1]
    have hnorm:=Complex.abs_re_le_norm ((z:ℂ)-(c:ℂ))
    rw [abs_of_neg hneg] at hnorm
    simp only [Complex.sub_re,Complex.ofReal_re] at hnorm
    dsimp [c,r] at *
    linarith only [hnorm,hz]
  have hright (z:ℍ) (hz:1<z.re) : r<‖(z:ℂ)-(c:ℂ)‖:=by
    have hnorm:((z:ℂ)-(c:ℂ)).re≤‖(z:ℂ)-(c:ℂ)‖:=
      (le_abs_self _).trans (Complex.abs_re_le_norm _)
    simp only [Complex.sub_re,Complex.ofReal_re] at hnorm
    dsimp [c,r] at *
    linarith only [hnorm,hz]
  let p:ℍ:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe ((s-1)/2) 1 (by norm_num)
  have hpL:-1<p.re:=by change -1<(s-1)/2;linarith only [hs0]
  have hpS:p.re<s:=by change (s-1)/2<s;linarith only [hs0]
  have hpR:p.re<1:=hpS.trans hs1
  have hinner (i:Fin 3) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p=
      ![{z:ℍ|-1<z.re},{z:ℍ|z.re<1},{z:ℍ|r<‖(z:ℂ)-(c:ℂ)‖}] i:=by
    fin_cases i
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_vertical_gt (-1) p hpL
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.hReCutLt_eq_openHalfPlane 1 p hpR
    · exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane_circle_outside c r hr p (hleft p hpS)
  have hnot (i:Fin 3):p∉(halfTurnSeparatedLines s hs1 i).carrier:=by
    have hp:p∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p:=by
      rw [hinner i]
      fin_cases i
      · exact hpL
      · exact hpR
      · exact hleft p hpS
    exact connectedComponentIn_subset _ _ hp
  have houter (i:Fin 3) :
      ((halfTurnSeparatedLines s hs1 i).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p)ᶜ=
      ![{z:ℍ|z.re< -1},{z:ℍ|1<z.re},{z:ℍ|‖(z:ℂ)-(c:ℂ)‖<r}] i:=by
    rw [hinner i]
    ext z
    have ht (x a:ℝ) : ¬(x=a ∨ a<x) ↔ x<a:=by
      constructor
      · intro h
        by_contra! hge
        rcases eq_or_lt_of_le hge with he|he
        · exact h (Or.inl he.symm)
        · exact h (Or.inr he)
      · intro h hn
        rcases hn with he|he <;> linarith only [h,he]
    fin_cases i
    · change ¬(z.re= -1 ∨ -1<z.re) ↔ z.re< -1
      exact ht _ _
    · change ¬(z.re=1 ∨ z.re<1) ↔ 1<z.re
      simpa only [eq_comm] using ht 1 z.re
    · change ¬(‖(z:ℂ)-(c:ℂ)‖=r ∨ r<‖(z:ℂ)-(c:ℂ)‖) ↔ ‖(z:ℂ)-(c:ℂ)‖<r
      exact ht _ _
  have hinside (z:ℍ) (hz:‖(z:ℂ)-(c:ℂ)‖<r) : s<z.re ∧ z.re<1:=by
    have hnorm:|z.re-c|<r:=by
      have he:=lt_of_le_of_lt (Complex.abs_re_le_norm ((z:ℂ)-(c:ℂ))) hz
      simpa only [Complex.sub_re,Complex.ofReal_re,UpperHalfPlane.coe_re] using he
    obtain ⟨hl,hr'⟩:=abs_lt.mp hnorm
    dsimp [c,r] at *
    constructor <;> linarith only [hl,hr']
  refine ⟨p,hnot,?_,?_⟩
  · intro i z hz
    rw [hinner i]
    fin_cases i
    · exact hz.1
    · exact hz.2.trans hs1
    · exact hleft z hz.2
  · intro i j hij
    rw [houter j,hinner i]
    fin_cases i <;> fin_cases j <;> simp only [ne_eq,not_true_eq_false] at hij
    · intro z hz
      change 1<z.re at hz
      change -1<z.re
      linarith only [hz]
    · intro z hz
      change ‖(z:ℂ)-(c:ℂ)‖<r at hz
      exact hs0.trans (hinside z hz).1
    · intro z hz
      change z.re< -1 at hz
      change z.re<1
      linarith only [hz]
    · intro z hz
      change ‖(z:ℂ)-(c:ℂ)‖<r at hz
      exact (hinside z hz).2
    · intro z hz
      change z.re< -1 at hz
      exact hleft z (hz.trans hs0)
    · intro z hz
      change 1<z.re at hz
      exact hright z hz

/-- A real open interval in this actual normalized chamber is genuinely
ordinary for the entire unchanged generated group. -/
theorem halfTurnSeparated_gap_ordinary
    (A:Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (centers:Fin 3→ℍ)
    (hA:∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (centers i)) (s:ℝ) (hs0:-1<s) (hs1:s<1)
    (hCenters:∀i,centers i∈(halfTurnSeparatedLines s hs1 i).carrier)
    (hInv:∀i,(fun z:ℍ=>A i • z) '' (halfTurnSeparatedLines s hs1 i).carrier=
      (halfTurnSeparatedLines s hs1 i).carrier)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i))))) :
    halfTurnSeparatedSphereGap s⊆_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet (Subgroup.closure
      (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))) := by
  let U:=halfTurnSeparatedSphereGap s
  let V:=halfTurnSeparatedNativeGap s
  have hopen:IsOpen U:=OnePoint.isOpenEmbedding_coe.isOpenMap _
    ((isOpen_lt continuous_const Complex.continuous_re).inter
      (isOpen_lt Complex.continuous_re continuous_const))
  have htrace:_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' U=V:=by
    ext z
    change ((z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈((↑):ℂ→_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) '' _ ↔ _
    rw [OnePoint.coe_injective.mem_set_image]
    rfl
  obtain ⟨p,hp,hsub,hcross⟩:=halfTurnSeparated_components s hs0 hs1
  have hpack:=halfTurn_three_factor_gap_packing A centers hA
    (halfTurnSeparatedLines s hs1) hCenters hInv p hp V hsub hcross
  let separatedStripAction:=P.nativeAction
  apply halfPlane_native_wandering_gap_ordinary P U hopen
  intro g hg
  rw [htrace]
  apply disjoint_left.mpr
  rintro z ⟨x,hx,rfl⟩ hz
  apply disjoint_left.mp (hpack g hg)
  · refine ⟨_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint x,⟨x,hx,rfl⟩,?_⟩
    exact P.nativeAction_boundary g x
  · exact ⟨g • x,hz,rfl⟩


/-- Pulling the actual open-ended chamber back by its genuine extended
isometry preserves the original group's ordinary gap. The original group
and half-turns are unchanged even for a reflected coordinate chart. -/
theorem halfTurnSeparated_transport_gap_ordinary
    (A:Fin 3→Matrix.SpecialLinearGroup (Fin 2) ℝ) (centers:Fin 3→ℍ)
    (hA:∀i,_root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt (A i) (centers i)) (L:Fin 3→_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine)
    (hCenters:∀i,centers i∈(L i).carrier)
    (hInv:∀i,(fun z:ℍ=>A i • z) '' (L i).carrier=(L i).carrier)
    (P:HalfPlaneFuchsianGroup (Subgroup.closure (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))))
    (s:ℝ) (hs0:-1<s) (hs1:s<1) (f:ℍ≃ᵢℍ) (F:_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex≃ₜ_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)
    (hcompat:∀z:ℍ,F (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)=_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (f z))
    (hLines:∀i,f '' (L i).carrier=(halfTurnSeparatedLines s hs1 i).carrier) :
    F ⁻¹' halfTurnSeparatedSphereGap s⊆_root_.LowDimensionalTopology.Geometry.DiscreteGroups.mobiusOrdinarySet (Subgroup.closure
      (range (fun i=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A i)))) := by
  obtain ⟨p₀,hp₀,hsub₀,hcross₀⟩:=halfTurnSeparated_components s hs0 hs1
  let p:=f.symm p₀
  let V:=f ⁻¹' halfTurnSeparatedNativeGap s
  let U:=F ⁻¹' halfTurnSeparatedSphereGap s
  have hp (i:Fin 3):p∉(L i).carrier:=by
    intro hz
    have hh:=mem_image_of_mem f hz
    rw [hLines i] at hh
    exact hp₀ i (by simpa only [p,f.apply_symm_apply] using hh)
  have hinnerImage (i:Fin 3):f '' _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p₀:=by
    simpa only [p,f.apply_symm_apply] using
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.native_image_open_halfPlane f (L i) _ (hLines i) p (hp i)
  have hline (i:Fin 3) (z:ℍ):z∈(L i).carrier↔f z∈(halfTurnSeparatedLines s hs1 i).carrier:=by
    rw [←hLines i]
    exact f.injective.mem_set_image.symm
  have hinner (i:Fin 3) (z:ℍ):z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p↔
      f z∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (halfTurnSeparatedLines s hs1 i) p₀:=by
    rw [←hinnerImage i]
    exact f.injective.mem_set_image.symm
  have hsub (i:Fin 3):V⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p:=by
    intro z hz
    exact (hinner i z).mpr (hsub₀ i hz)
  have hcross:∀i j:Fin 3,i≠j→
      ((L j).carrier∪_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L j) p)ᶜ⊆_root_.LowDimensionalTopology.Geometry.Hyperbolic.openHHalfPlane (L i) p:=by
    intro i j hij z hz
    apply (hinner i z).mpr
    apply hcross₀ i j hij
    simpa only [mem_compl_iff,mem_union,←hline j z,←hinner j z] using hz
  have hpack:=halfTurn_three_factor_gap_packing A centers hA L hCenters hInv p hp V hsub hcross
  have hopen:IsOpen U:=
    (OnePoint.isOpenEmbedding_coe.isOpenMap _
      ((isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const))).preimage F.continuous
  have htrace:_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint ⁻¹' U=V:=by
    ext z
    change F (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint z)∈halfTurnSeparatedSphereGap s↔
      f z∈halfTurnSeparatedNativeGap s
    rw [hcompat]
    change (((f z:ℂ):_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex)∈((↑):ℂ→_root_.LowDimensionalTopology.Geometry.Mobius.ExtendedComplex) '' _)↔_
    rw [OnePoint.coe_injective.mem_set_image]
    rfl
  let separatedTransportOriginalAction:=P.nativeAction
  apply halfPlane_native_wandering_gap_ordinary P U hopen
  intro g hg
  rw [htrace]
  apply disjoint_left.mpr
  rintro z ⟨x,hx,rfl⟩ hz
  apply disjoint_left.mp (hpack g hg)
  · exact ⟨_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint x,⟨x,hx,rfl⟩,P.nativeAction_boundary g x⟩
  · exact ⟨g • x,hz,rfl⟩

end LowDimensionalTopology.Geometry.Fuchsian

