  · rw [hLines.2.1]
    apply (halfTurnIdeal_pairCircle_mem _ _ _ _).mpr
    rw [Complex.normSq_apply]
    simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,one_mul]
    nlinarith only [hn,hscalar]

