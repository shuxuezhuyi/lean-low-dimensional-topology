/-- Restricting the genuine compactified triangle carrier to the original
upper half-plane gives exactly the native closure of its actual interior. -/
theorem halfTurn_closedTriangle_finite_carrier (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle) (z : ℍ) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel z∈T.closedCarrier ↔ z∈closure T.interior := by
  have hFirst : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel z∈T.closedCarrier ↔
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)∈T.toDiscTriangle.closedCarrier := by
    rw [←T.cayley_closedCarrier,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayley_on_interior]
    exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelCayleyHomeomorph.injective.mem_set_image.symm
  have hSecond : _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)∈T.toDiscTriangle.closedCarrier ↔
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z∈closure T.toDiscTriangle.interior := by
    rw [T.toDiscTriangle.closedCarrier_eq_closedModelClosure]
    exact (Set.ext_iff.mp (_root_.LowDimensionalTopology.Geometry.Hyperbolic.discRelativeClosure_eq_preimage T.toDiscTriangle.interior)
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)).symm
  have hThird : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z∈closure T.toDiscTriangle.interior ↔ z∈closure T.interior := by
    exact Set.ext_iff.mp (_root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyHomeomorph.preimage_closure T.toDiscTriangle.interior) z
  exact hFirst.trans (hSecond.trans hThird)

theorem halfTurn_canonicalIdealTriangle_finite_carrier (m k : ℝ) (hm : 1≤m) (hk : m<k) :
    let T:=halfTurn_canonicalIdealTriangle m k hm hk
    {z : ℍ|_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel z∈T.closedCarrier}=halfTurnIdealTriangleRegion m k := by
  let T:=halfTurn_canonicalIdealTriangle m k hm hk
  ext z
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel z∈T.closedCarrier ↔ z∈halfTurnIdealTriangleRegion m k
  rw [halfTurn_closedTriangle_finite_carrier]
  exact Set.ext_iff.mp (halfTurn_canonicalIdealTriangle_region m k hm hk).2 z

end LowDimensionalTopology.Geometry.Fuchsian

