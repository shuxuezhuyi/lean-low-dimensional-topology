/-- The pair trace is independent of all real-lift signs. -/
theorem halfTurn_pair_abs_trace (A B : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u v : ℍ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B v) :
    |Matrix.trace (A*B).val|=2*Real.cosh (dist u v) := by
  have he : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B)=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL u*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL v) := by
    simp only [map_mul]
    rw [hA.unique (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at u),hB.unique (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at v)]
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSL_abs_trace_congr he,_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_pair_trace,abs_mul,abs_of_pos (Real.cosh_pos _)]
  norm_num

/-- Three actual half-turns never have identity product; no discreteness is required. -/
theorem halfTurn_triple_ne_one (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ) (u v w : ℍ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A u) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B v) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C w) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)≠1 := by
  intro he
  have hC2 : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)^2=1 := by
    have hh:=pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C)
    rwa [hC.1] at hh
  have hp : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B)=_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C := by
    have hh:=congrArg (fun f : _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup=>f*_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C) he
    simpa only [map_mul,mul_assoc,←pow_two,hC2,mul_one,one_mul] using hh
  have ht:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSL_abs_trace_congr hp
  rw [halfTurn_pair_abs_trace A B u v hA hB,
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_order_two_iff_trace_zero C hC.ne_one).mp hC.1,abs_zero] at ht
  have hc:=Real.cosh_pos (dist u v)
  linarith only [ht,hc]

/-- The source parameter genuinely separates the three possible types of the product. -/
theorem halfTurn_triple_type_iff (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c) :
    (_root_.LowDimensionalTopology.Geometry.Mobius.MobiusHyperbolic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)) ↔ 1<_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T) ∧
    (_root_.LowDimensionalTopology.Geometry.Mobius.MobiusParabolic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)) ↔ _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T=1) ∧
    (_root_.LowDimensionalTopology.Geometry.Mobius.MobiusElliptic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)) ↔ _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T<1) := by
  have hn:=halfTurn_triple_ne_one A B C T.a T.b T.c hA hB hC
  have ht:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurn_triple_abs_trace T A B C hA hB hC
  have hs : (Matrix.trace (A*B*C).val)^2=4*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T)^2 := by
    have hsq:=congrArg (fun x : ℝ=>x^2) ht
    rw [sq_abs] at hsq
    nlinarith only [hsq]
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_hyperbolic_iff _ hn,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_parabolic_iff _ hn,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_elliptic_iff _ hn,hs]
  have hp:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant_pos T
  constructor
  · constructor <;> intro h <;> nlinarith only [h,hp,sq_nonneg (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T-1)]
  · constructor
    · constructor <;> intro h <;> nlinarith only [h,hp,sq_nonneg (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T-1)]
    · constructor <;> intro h <;> nlinarith only [h,hp,sq_nonneg (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T-1)]

/-- A positive absolute elliptic trace has a reduced acute rational half-angle
with denominator equal to the order of the actual transformation. -/
theorem realSL_positive_trace_acute_cosine (A : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Mobius.MobiusElliptic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A)) (hfin : IsOfFinOrder (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A))
    (lam : ℝ) (hlam : 0<lam) (ht : |Matrix.trace A.val|=2*lam) :
    ∃p q : ℕ, q=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A) ∧ 0<p ∧ 2*p<q ∧ p.Coprime q ∧
      lam=Real.cos (Real.pi*(p : ℝ)/q) := by
  obtain ⟨q,m,hq,hq2,hm0,hmq,hcop,hs⟩:=realSL_finite_order_trace_cosine A hA.1 hfin
  have hqR : (0 : ℝ)<q := by exact_mod_cast (by omega : 0<q)
  have hlamcos : lam^2=(Real.cos (Real.pi*(m : ℝ)/q))^2 := by
    have hsq:=congrArg (fun x : ℝ=>x^2) ht
    rw [sq_abs] at hsq
    nlinarith only [hs,hsq]
  by_cases hmhalf : 2*m≤q
  · have hangle : Real.pi*(m : ℝ)/q≤Real.pi/2 := by
      apply (div_le_iff₀ hqR).mpr
      have hh : 2*(m : ℝ)≤q := by exact_mod_cast hmhalf
      nlinarith only [hh,Real.pi_pos]
    have hcos : 0≤Real.cos (Real.pi*(m : ℝ)/q) :=
      Real.cos_nonneg_of_neg_pi_div_two_le_of_le (by
        have hz : 0≤Real.pi*(m : ℝ)/q:=by positivity
        linarith only [hz,Real.pi_pos]) hangle
    have heq : lam=Real.cos (Real.pi*(m : ℝ)/q) :=
      (sq_eq_sq₀ hlam.le hcos).mp hlamcos
    have hstrict : 2*m<q := by
      by_contra hn
      have hh : 2*m=q := by omega
      have ha : Real.pi*(m : ℝ)/q=Real.pi/2 := by
        have hhR : 2*(m : ℝ)=q := by exact_mod_cast hh
        apply (div_eq_iff hqR.ne').mpr
        rw [←hhR]
        ring
      rw [ha,Real.cos_pi_div_two] at heq
      linarith only [hlam,heq]
    exact ⟨m,q,hq,hm0,hstrict,hcop,heq⟩
  · have hsub : 0<q-m := Nat.sub_pos_of_lt hmq
    have hsubhalf : 2*(q-m)<q := by omega
    have hangle : Real.pi*((q-m : ℕ) : ℝ)/q=Real.pi-Real.pi*(m : ℝ)/q := by
      rw [Nat.cast_sub hmq.le]
      field_simp
    have hcos : 0≤Real.cos (Real.pi*((q-m : ℕ) : ℝ)/q) := by
      apply Real.cos_nonneg_of_neg_pi_div_two_le_of_le (by
        have hz : 0≤Real.pi*((q-m : ℕ) : ℝ)/q:=by positivity
        linarith only [hz,Real.pi_pos])
      apply (div_le_iff₀ hqR).mpr
      have hh : 2*((q-m : ℕ) : ℝ)≤q := by exact_mod_cast hsubhalf.le
      nlinarith only [hh,Real.pi_pos]
    have heq : lam=Real.cos (Real.pi*((q-m : ℕ) : ℝ)/q) := by
      apply (sq_eq_sq₀ hlam.le hcos).mp
      rw [hangle,Real.cos_pi_sub,neg_sq]
      exact hlamcos
    exact ⟨q-m,q,hq,hsub,hsubhalf,(Nat.coprime_self_sub_left hmq.le).mpr hcop,heq⟩

/--
Discreteness supplies the actual finite order and reduced cosine parameter
in the small-parameter branch. The subsequent geometric
classification must still bound the numerator and determine the signature.
-/
theorem halfTurn_small_parameter_reduced (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hA : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt A T.a) (hB : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt B T.b) (hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.IsHalfTurnAt C T.c)
    (hd : _root_.LowDimensionalTopology.Geometry.Mobius.IsDiscreteMobiusSubgroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)))
    (hsmall : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T<1) :
    ∃p q : ℕ, q=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)) ∧ 0<p ∧ 2*p<q ∧ p.Coprime q ∧
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T=Real.cos (Real.pi*(p : ℝ)/q) := by
  let G:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  have hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)∈G := by
    rw [map_mul,map_mul]
    exact G.mul_mem (G.mul_mem (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp))) (Subgroup.subset_closure (by simp))
  have he : _root_.LowDimensionalTopology.Geometry.Mobius.MobiusElliptic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (A*B*C)) :=
    ((halfTurn_triple_type_iff T A B C hA hB hC).2.2).mpr hsmall
  exact realSL_positive_trace_acute_cosine (A*B*C) he
    (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.discrete_elliptic_finiteOrder G hd _ hG he) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant T)
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurnTriangleInvariant_pos T) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfTurn_triple_abs_trace T A B C hA hB hC)

end LowDimensionalTopology.Geometry.Fuchsian


