  have hcondition:=(kleinSubdivisionEdge5_mem (halfTurnQuadKleinA k c)
    (halfTurnQuadKleinB k c) (halfTurnQuadKleinR m) (halfTurnQuadKleinS k)
    hr.1 hr.2 hp.1 hp.2.2.2.2.1 (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z) i).mp hraw
  have hne0 : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠0 := by
    simpa [kleinSubdivisionVertices5] using hne 0
  have hner : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(((m^2-1)/(m^2+1) : ℝ) : ℂ) := by
