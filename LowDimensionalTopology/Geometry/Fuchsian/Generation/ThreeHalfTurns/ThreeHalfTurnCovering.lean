/-- The true signed transverse hypercycle coordinate of an SL action. -/
theorem realSL_slope_formula (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (z : ℍ) :
    (A•z).re/(A•z).im=
      ((A 0 0*z.re+A 0 1)*(A 1 0*z.re+A 1 1)+A 0 0*A 1 0*z.im^2)/z.im := by
  have hd:=UpperHalfPlane.normSq_denom_ne_zero (Matrix.SpecialLinearGroup.mapGL ℝ A) z.im_ne_zero
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.sl2_im_smul]
  change ((A•z : ℍ) : ℂ).re/(z.im/_)=_
  rw [UpperHalfPlane.coe_specialLinearGroup_apply,Complex.div_re]
  simp only [Algebra.algebraMap_self_apply,Complex.mul_re,Complex.mul_im,Complex.add_re,
    Complex.add_im,Complex.ofReal_re,Complex.ofReal_im,zero_mul,add_zero,sub_zero,UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
  change (_ / Complex.normSq ((A 1 0 : ℂ)*(z : ℂ)+A 1 1)+
    _ / Complex.normSq ((A 1 0 : ℂ)*(z : ℂ)+A 1 1)) /
    (z.im/Complex.normSq ((A 1 0 : ℂ)*(z : ℂ)+A 1 1))=_
  change Complex.normSq ((A 1 0 : ℂ)*(z : ℂ)+A 1 1)≠0 at hd
  field_simp [hd]

/-- The side circle through a half-turn centre, orthogonal to its radial geodesic. -/
def halfTurnQuadCirclePolynomial (w z : ℍ) : ℝ :=
  z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)

/-- On the forbidden side, the actual half-turn decreases the signed hypercycle
coordinate; its opposite-side value remains above the negative old value. -/
theorem pointHalfTurnSL_slope_difference (w z : ℍ) (hw : 0<w.re) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im-z.re/z.im=
      w.re*halfTurnQuadCirclePolynomial w z/(w.im^2*z.im) := by
  rw [realSL_slope_formula]
  simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one,
    Matrix.of_apply,halfTurnQuadCirclePolynomial]
  field_simp [hw.ne']
  ring

theorem pointHalfTurnSL_slope_sum (w z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im+z.re/z.im=
      w.re*((z.re-w.re)^2+z.im^2+w.im^2)/(w.im^2*z.im) := by
  rw [realSL_slope_formula]
  simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one,
    Matrix.of_apply]
  field_simp
  ring

/-- A genuine height-relative hypercycle quantity strictly decreases under the
actual third half-turn whenever the point lies inside its forbidden side circle. -/
theorem pointHalfTurnSL_abs_slope_decreases (w z : ℍ) (hw : 0<w.re)
    (hz : halfTurnQuadCirclePolynomial w z<0) :
    |(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im| < |z.re/z.im| := by
  have hden : 0<w.im^2*z.im:=mul_pos (sq_pos_of_pos w.im_pos) z.im_pos
  have hlo : -(z.re/z.im)<(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im := by
    have hp : 0<w.re*((z.re-w.re)^2+z.im^2+w.im^2)/(w.im^2*z.im):=by
      exact div_pos (mul_pos hw (by positivity)) hden
    rw [←pointHalfTurnSL_slope_sum] at hp
    linarith only [hp]
  have hhi : (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im<z.re/z.im := by
    have hn : w.re*halfTurnQuadCirclePolynomial w z/(w.im^2*z.im)<0:=
      div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg hw hz) hden
    rw [←pointHalfTurnSL_slope_difference w z hw] at hn
    linarith only [hn]
  have hpos : 0<z.re/z.im:=by linarith only [hlo,hhi]
  rw [abs_of_pos hpos]
  exact abs_lt.mpr ⟨hlo,hhi⟩


/-- The literal closed half-annulus cut by the third half-turn's side circle. -/
def halfTurnClosedQuad (k : ℝ) (w : ℍ) : Set ℍ :=
  {z | 1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤ k ∧ 0≤ z.re ∧ 0≤ halfTurnQuadCirclePolynomial w z}

/-- The real interval between the two radial sides lies strictly on the
forbidden side exactly under the small-parameter scalar condition. -/
theorem halfTurn_quad_real_interval_negative (k c x : ℝ)
    (hc : k+1<2*c) (hx : x∈Icc 1 k) : x^2-2*c*x+k<0 := by
  have hp : (x-1)*(x-k)≤0:=mul_nonpos_of_nonneg_of_nonpos
    (by linarith only [hx.1]) (by linarith only [hx.2])
  have hq : (k+1-2*c)*x<0:=mul_neg_of_neg_of_pos
    (by linarith only [hc]) (by linarith only [hx.1])
  nlinarith only [hp,hq]

/-- In the small-parameter case the actual closed quadrilateral is compact
in the hyperbolic plane; no compactness or orbit coverage is an input. -/
theorem halfTurnClosedQuad_isCompact (k : ℝ) (w : ℍ)
    (hw : 0<w.re) (hwk : w.re^2+w.im^2=k) (hsmall : (k+1)*w.re<2*k) :
    IsCompact (halfTurnClosedQuad k w) := by
  let c:=k/w.re
  have hc : k+1<2*c:=by
    dsimp only [c]
    rw [←mul_div_assoc]
    apply (lt_div_iff₀ hw).mpr
    nlinarith only [hsmall]
  let E : Set ℂ:={z | 0≤ z.im ∧ 1≤‖z‖ ∧ ‖z‖≤ k ∧ 0≤ z.re ∧
    0≤ z.re^2+z.im^2-2*c*z.re+k}
  have hEclosed : IsClosed E:=by
    apply IsClosed.inter (isClosed_le continuous_const Complex.continuous_im)
    apply IsClosed.inter (isClosed_le continuous_const continuous_norm)
    apply IsClosed.inter (isClosed_le continuous_norm continuous_const)
    apply IsClosed.inter (isClosed_le continuous_const Complex.continuous_re)
    exact isClosed_le continuous_const
      (show Continuous (fun z : ℂ=>z.re^2+z.im^2-2*c*z.re+k) from by fun_prop)
  have hEcompact : IsCompact E:=(isCompact_closedBall (0 : ℂ) k).of_isClosed_subset hEclosed
    (fun z hz=>by simpa only [Metric.mem_closedBall,dist_zero_right] using hz.2.2.1)
  have hEpos : ∀z∈E,0<z.im:=by
    intro z hz
    change 0≤ z.im ∧ 1≤‖z‖ ∧ ‖z‖≤ k ∧ 0≤ z.re ∧
      0≤ z.re^2+z.im^2-2*c*z.re+k at hz
    apply lt_of_le_of_ne hz.1
    intro he
    have him : z.im=0:=he.symm
    have hn : ‖z‖=z.re:=by
      have hez : z=(z.re : ℂ):=by apply Complex.ext <;> simp [him]
      calc
        ‖z‖=‖(z.re : ℂ)‖:=congrArg norm hez
        _=z.re:=by rw [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hz.2.2.2.1]
    have hx : z.re∈Icc 1 k:=by rw [hn] at hz;exact ⟨hz.2.1,hz.2.2.1⟩
    have hh:=halfTurn_quad_real_interval_negative k c z.re hc hx
    have hp:=hz.2.2.2.2
    rw [him,zero_pow (by norm_num : (2 : ℕ)≠0),add_zero] at hp
    linarith only [hh,hp]
  apply UpperHalfPlane.isEmbedding_coe.isCompact_iff.mpr
  have he : ((↑) : ℍ→ℂ) '' halfTurnClosedQuad k w=E:=by
    ext z
    constructor
    · rintro ⟨z,hz,rfl⟩
      refine ⟨z.im_pos.le,hz.1,hz.2.1,hz.2.2.1,?_⟩
      change 0≤z.re^2+z.im^2-2*c*z.re+k
      have hp:=hz.2.2.2
      simpa only [halfTurnQuadCirclePolynomial,hwk,mul_div_assoc,c] using hp
    · intro hz
      let u : ℍ:=⟨z,hEpos z hz⟩
      refine ⟨u,⟨hz.2.1,hz.2.2.1,hz.2.2.2.1,?_⟩,rfl⟩
      change 0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)
      simpa only [hwk,mul_div_assoc,c] using hz.2.2.2.2
  rw [he]
  exact hEcompact


/-- The literal trace in the pair-axis normal form, with arbitrary genuine
axis heights. The third centre is not placed at a supplied special angle. -/
theorem axisHalfTurns_point_triple_trace (u v : ℝ) (hu : 0<u) (hv : 0<v) (w : ℍ) :
    Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL v hv*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val=
      (v/u-u/v)*w.re/w.im := by
  simp only [Matrix.SpecialLinearGroup.coe_mul,Matrix.trace_fin_two,Matrix.mul_apply,Fin.sum_univ_two,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL,_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one,
    Matrix.of_apply]
  field_simp
  ring

/-- The actual small triple trace puts both real ends of the radial strip
strictly inside the third side circle. -/
theorem halfTurn_small_trace_compact_scalar (t x y : ℝ) (ht : 1<t)
    (hx : 0<x) (hy : 0<y) (hn : x^2+y^2=t^2)
    (htrace : (t-1/t)*x/y<2) : (t^2+1)*x<2*t^2 := by
  have ht0 : 0<t:=by linarith only [ht]
  have hlinear : (t^2-1)*x<2*t*y:=by
    have h:= (div_lt_iff₀ hy).mp htrace
    have hmul:=mul_lt_mul_of_pos_left h ht0
    have he : t*((t-1/t)*x)=(t^2-1)*x:=by field_simp
    rw [he] at hmul
    nlinarith only [hmul]
  have hleft : 0≤(t^2-1)*x:=mul_nonneg (by nlinarith only [ht]) hx.le
  have hright : 0≤2*t*y:=by positivity
  have hs:= (sq_lt_sq₀ hleft hright).mpr hlinear
  have hnorm:=congrArg (fun r : ℝ=>4*t^2*r) hn
  have hsq : ((t^2+1)*x)^2<(2*t^2)^2:=by
    nlinarith only [hs,hnorm]
  exact (sq_lt_sq₀ (by positivity) (by positivity)).mp hsq

/-- Smallness is obtained from the true three-matrix product, rather than
included as a geometric compactness premise. -/
theorem halfTurnClosedQuad_isCompact_of_trace (u v : ℝ) (hu : 0<u) (huv : u<v)
    (w : ℍ) (hw : 0<w.re) (hn : w.re^2+w.im^2=(v/u)^2)
    (htrace : |Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL v (hu.trans huv)*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val|<2) :
    IsCompact (halfTurnClosedQuad ((v/u)^2) w) := by
  have ht : 1<v/u:=(one_lt_div hu).mpr huv
  have htr : (v/u-1/(v/u))*w.re/w.im<2:=by
    rw [axisHalfTurns_point_triple_trace] at htrace
    have he : u/v=1/(v/u):=by field_simp
    rw [he] at htrace
    exact (le_abs_self _).trans_lt htrace
  exact halfTurnClosedQuad_isCompact ((v/u)^2) w hw hn
    (halfTurn_small_trace_compact_scalar (v/u) w.re w.im ht hw w.im_pos hn htr)

end LowDimensionalTopology.Geometry.Fuchsian

