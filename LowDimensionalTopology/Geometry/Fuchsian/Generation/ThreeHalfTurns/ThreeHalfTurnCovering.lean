  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (lt_trans zero_lt_one hu)),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (lt_trans zero_lt_one hu)
      (lt_trans zero_lt_one (hu.trans hut)))),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set (ℍ≃ᵢℍ))
  let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
  let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
  let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf
  have hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (lt_trans zero_lt_one hu))∈H:=
    Subgroup.subset_closure (by simp)
  have hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (lt_trans zero_lt_one hu)
      (lt_trans zero_lt_one (hu.trans hut))))∈H:=Subgroup.subset_closure (by simp)
  have hW : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)∈H:=Subgroup.subset_closure (by simp)
  have hD : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2)
      (sq_pos_of_pos (lt_trans zero_lt_one (hu.trans hut))))∈H:=by
    rw [←halfTurnNative_axis_product u t (lt_trans zero_lt_one hu) (lt_trans zero_lt_one (hu.trans hut))]
    exact H.mul_mem hG hF
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨s,rfl⟩
    obtain ⟨i,rfl⟩:=e.surjective s
    rw [halfTurnFivePairing_element_index]
    fin_cases i
    · exact hF
    · exact hG
    · exact H.inv_mem hD
    · exact hW
    · exact hD
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    simp only [mem_insert_iff,mem_singleton_iff] at hg
    have hm (i : Fin 5) : halfTurnFiveElement u t (lt_trans zero_lt_one hu)
        (lt_trans zero_lt_one (hu.trans hut)) w i∈(halfTurnFivePairing u t hu hut w hw hn hc).Generated:=by
      apply Subgroup.subset_closure
      exact ⟨e i,halfTurnFivePairing_element_index u t hu hut w hw hn hc i⟩
    rcases hg with rfl|rfl|rfl
    · exact hm 0
    · exact hm 1
    · exact hm 3

end LowDimensionalTopology.Geometry.Fuchsian




