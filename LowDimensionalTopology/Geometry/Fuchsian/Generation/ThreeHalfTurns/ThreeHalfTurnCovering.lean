theorem halfTurnQuadRefined_native_interior (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) :
    (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon (halfTurnQuadRefined k c m hk hc hm hmk)
      (halfTurnQuadRefined_finite k c m hk hc hm hmk)).interior=
      (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
        (halfTurnQuadCanonical_finite k c hk hc)).interior := by
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc ⁻¹' _=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc ⁻¹' _
  rw [halfTurnQuadRefined_interior]

/-- The true whole three-generator group has an integral covering multiplicity,
with no side-pairing, orbit-cover or covolume premise added to the source group. -/
theorem halfTurnCanonical_cover_multiplicity (u t : ℝ) (hu : 1≤u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    [DiscreteTopology (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
          (zero_lt_one.trans (hu.trans_lt hut)))),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set (ℍ≃ᵢℍ)))] :
    let H:=Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
          (zero_lt_one.trans (hu.trans_lt hut)))),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set (ℍ≃ᵢℍ))
    let hk:=one_lt_pow₀ (hu.trans_lt hut) (by decide : (2 : ℕ)≠0)
    let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
    let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q (halfTurnQuadCanonical_finite _ _ _ _)
    let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
    ∃N : ℕ,0<N ∧
      (∀z : ℍ,_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity H P.interior z=N) ∧
      Real.pi/21≤(MeasureTheory.covolume H ℍ volume).toReal ∧
      Real.pi-2*Real.arccos lam=(N : ℝ)*(MeasureTheory.covolume H ℍ volume).toReal := by
  have ht : 1<t:=hu.trans_lt hut
  let H:=Subgroup.closure
    ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (zero_lt_one.trans_le hu)),
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos (zero_lt_one.trans_le hu)
        (zero_lt_one.trans ht))),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set (ℍ≃ᵢℍ))
  by_cases hue : u=1
  · subst u
    let S:=halfTurnFour_pairing t ht w hw hn hc
    have he : S.Generated=H:=by
      simpa only [S,H,one_mul] using halfTurnFour_generated t ht w hw hn hc
    let : DiscreteTopology S.Generated:=by rw [he];infer_instance
    obtain ⟨N,hN,hCount,hLow,hArea⟩:=halfTurnFourPairing_cover_multiplicity t ht w hw hn hc
    rw [he] at hCount hLow hArea
    exact ⟨N,hN,hCount,hLow,hArea⟩
  · have hu' : 1<u:=lt_of_le_of_ne hu (Ne.symm hue)
    let S:=halfTurnFivePairing u t hu' hut w hw hn hc
    have he : S.Generated=H:=halfTurnFivePairing_generated u t hu' hut w hw hn hc
    let : DiscreteTopology S.Generated:=by rw [he];infer_instance
    obtain ⟨N,hN,hCount,hLow,hArea⟩:=halfTurnFivePairing_cover_multiplicity u t hu' hut w hw hn hc
    rw [he] at hCount hLow hArea
    have hb:=halfTurnFive_band_parameters u t hu' hut
    change (∀z : ℍ,_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity H
      (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon (halfTurnQuadRefined (t^2) (t^2/w.re) (u^2)
        hb.1 hc hb.2.1 hb.2.2) (halfTurnQuadRefined_finite _ _ _ _ _ _ _)).interior z=N) at hCount
    rw [halfTurnQuadRefined_native_interior] at hCount
    exact ⟨N,hN,hCount,hLow,hArea⟩

end LowDimensionalTopology.Geometry.Fuchsian


