    _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
      (halfTurnQuadCanonical_finite k c hk hc) 2 :=
  (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_injective _ _).ne (by decide)

/-- On the true unit summit the third half-turn agrees with genuine radial scaling. -/
theorem halfTurnFour_summit_halfturn (k c : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (w : ℍ) (hw : 0<w.re) (hn : w.re^2+w.im^2=k) (hck : c=k/w.re) :
    let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
    let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q (halfTurnQuadCanonical_finite k c hk hc) 3
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z=_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (zero_lt_one.trans hk)•z := by
  let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
  let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q (halfTurnQuadCanonical_finite k c hk hc) 3
  have hz:=halfTurnFour_unit_summit k c hk hc
  have hz0 : z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0:=by
    have hp:=hz.2
    change z.re^2+z.im^2-2*c*z.re+k=0 at hp
    simpa only [hn,hck,div_mul_eq_mul_div,mul_div_assoc] using hp
  have hN : Complex.normSq (z : ℂ)=1:=by
    rw [Complex.normSq_eq_norm_sq,hz.1];norm_num
  have hcoord:=pointHalfTurn_side_circle_coordinates w z hw hz0
  apply UpperHalfPlane.ext
  apply Complex.ext
  · change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).re=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k _•z).re
    rw [hcoord.1,hN,div_one,hn,_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_re]
  · change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•z).im=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k _•z).im
    rw [hcoord.2,hN,div_one,hn,_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_im]

/-- The genuine canonical triple fixes the actual unit summit of its own polygon. -/
theorem halfTurnCanonical_product_fixes_summit (u t : ℝ) (hu : 0<u) (ht : 1<t)
    (w : ℍ) (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) :
    let hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
    let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
    let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q (halfTurnQuadCanonical_finite _ _ _ _) 3
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht)))*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)) z=z := by
  let hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
  let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
  let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q (halfTurnQuadCanonical_finite _ _ _ _) 3
  let D:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)))
  have hFG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht)))=D⁻¹:=by
    rw [show D=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht)))*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu) from (halfTurnNative_axis_product u t hu (zero_lt_one.trans ht)).symm]
    rw [mul_inv_rev,halfTurnNative_axis_inverse,halfTurnNative_axis_inverse]
  have hH : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w) z=D z:=
    halfTurnFour_summit_halfturn (t^2) (t^2/w.re) hk hc w hw hn rfl
  rw [hFG]
  change D⁻¹ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w) z)=z
  rw [hH]
  exact D.inv_apply_self z

