/-- The faithful boundary representation merely relabels the genuine native conformal group. -/
def nativeCovolume_groupEquiv (H : Subgroup (ℍ≃ᵢℍ))
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) :
    H≃*(nativeConformalSubgroupMobiusHom H hConf).range :=
  MonoidHom.ofInjective (nativeConformalSubgroupMobiusHom_isometry H hConf).injective

/-- The original boundary group and the native group act on exactly the same physical points. -/
theorem nativeCovolume_groupEquiv_action (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (g : H) (z : ℍ) :
    letI:=(nativeConformalSubgroup_halfPlaneData H hConf).nativeAction
    nativeCovolume_groupEquiv H hConf g • z=g • z := by
  let nativeCovolumeOriginalAction:=(nativeConformalSubgroup_halfPlaneData H hConf).nativeAction
  apply _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint_injective
  rw [←(nativeConformalSubgroup_halfPlaneData H hConf).nativeAction_boundary]
  exact nativeConformalSubgroupMobiusHom_action H hConf g z

/-- Genuine measure fundamental domains transport along the actual faithful boundary representation. -/
theorem nativeCovolume_measureDomain_transport (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (F : Set ℍ) :
    letI:=(nativeConformalSubgroup_halfPlaneData H hConf).nativeAction
    MeasureTheory.IsFundamentalDomain (nativeConformalSubgroupMobiusHom H hConf).range F volume →
      MeasureTheory.IsFundamentalDomain H F volume := by
  let nativeCovolumeOriginalAction:=(nativeConformalSubgroup_halfPlaneData H hConf).nativeAction
  intro hF
  let e:=nativeCovolume_groupEquiv H hConf
  have he (g : H) (z : ℍ) : e g • z=g • z:=nativeCovolume_groupEquiv_action H hConf g z
  have hi (g : (nativeConformalSubgroupMobiusHom H hConf).range) (z : ℍ) :
      e.symm g • z=g • z:=by
    have hh:=he (e.symm g) z
    rw [e.apply_symm_apply] at hh
    exact hh.symm
  have hm:=hF.preimage_of_equiv (f:=id) (MeasurePreserving.id volume).quasiMeasurePreserving
    e.symm.bijective (by intro g z;exact hi g z)
  simpa only [preimage_id] using hm

/-- A compact cover of every original native orbit constructs finite positive
actual covolume and the sharp original signature area lower bound. -/
theorem nativeCovolume_compact_cover (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (C : Set ℍ) (hC : IsCompact C)
    (hcover : ∀z : ℍ,∃g : H,g • z∈C) :
    0<MeasureTheory.covolume H ℍ volume ∧
      MeasureTheory.covolume H ℍ volume≤volume C ∧
      MeasureTheory.covolume H ℍ volume≠⊤ ∧
      Real.pi/21≤(MeasureTheory.covolume H ℍ volume).toReal := by
  let P:=nativeConformalSubgroup_halfPlaneData H hConf
  let nativeCovolumeOriginalAction:=P.nativeAction
  let e:=nativeCovolume_groupEquiv H hConf
  have hJcover (z : ℍ) : ∃g : (nativeConformalSubgroupMobiusHom H hConf).range,g • z∈C:=by
    obtain ⟨g,hg⟩:=hcover z
    exact ⟨e g,(nativeCovolume_groupEquiv_action H hConf g z).symm ▸ hg⟩
  obtain ⟨F,hF,hpos,hle,hfin⟩:=compactCover_native_finite_positive_fundamental P C hC hJcover
  have hMFJ:=native_geometric_fundamental_measureDomain P F hF
  have hMF:=nativeCovolume_measureDomain_transport H hConf F hMFJ
  let : Countable H:=_root_.LowDimensionalTopology.Geometry.Polygon.nativeDiscreteIsometrySubgroup_countable H
  let : ContinuousConstSMul H ℍ:=⟨fun g=>g.val.continuous⟩
  have hcov : MeasureTheory.covolume H ℍ volume=volume F:=hMF.covolume_eq_volume volume
  have hgeom:=P.geometric_fundamental hF
  have harea:=compactCover_original_geometric_area P F hF.isOpen.measurableSet
  have hlo:=compactCover_original_finite_area_lower_bound P.asFuchsianDisc _ hgeom
    (by rw [harea];exact hpos) (by rw [harea];exact hfin)
  rw [harea] at hlo
  rw [hcov]
  exact ⟨hpos,hle,hfin,hlo⟩

/-- The sharp bound concerns the actual Mathlib covolume of the unchanged native group. -/
theorem nativeCovolume_compact_cover_lower_bound (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H]
    (hConf : H≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup) (C : Set ℍ) (hC : IsCompact C)
    (hcover : ∀z : ℍ,∃g : H,g • z∈C) :
    Real.pi/21≤(MeasureTheory.covolume H ℍ volume).toReal :=
  (nativeCovolume_compact_cover H hConf C hC hcover).2.2.2

end LowDimensionalTopology.Geometry.Fuchsian


