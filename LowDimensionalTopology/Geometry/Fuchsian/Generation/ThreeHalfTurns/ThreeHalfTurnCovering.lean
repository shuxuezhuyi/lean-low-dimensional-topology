/-- The literal positive dilation acts by its real integral scale. -/
theorem verticalDilation_isometry_zpow_coe (k : ℝ) (hk : 0<k) (n : ℤ) (z : ℍ) :
    (((_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk))^n • z : ℍ):ℂ)=(k^n:ℝ)*(z:ℂ) := by
  let d:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)
  have hd (v : ℍ) : ((d • v : ℍ):ℂ)=(k:ℂ)*(v:ℂ):=_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe k hk v
  have hdi (v : ℍ) : ((d⁻¹ • v : ℍ):ℂ)=(k:ℂ)⁻¹*(v:ℂ) := by
    have hh:=hd (d⁻¹ • v)
    rw [smul_inv_smul] at hh
    calc
      ((d⁻¹ • v : ℍ):ℂ)=(v:ℂ)/(k:ℂ):=by
        apply (eq_div_iff (Complex.ofReal_ne_zero.mpr hk.ne')).mpr
        simpa only [mul_comm] using hh.symm
      _=(k:ℂ)⁻¹*(v:ℂ):=by rw [div_eq_mul_inv,mul_comm]
  change ((d^n • z : ℍ):ℂ)=_
  induction n using Int.induction_on generalizing z with
  | zero => simp
  | succ n ih =>
      rw [zpow_add, mul_smul, zpow_one, ih, hd, zpow_add₀ hk.ne', zpow_one]
      push_cast
      ring
  | pred n ih =>
      rw [zpow_sub, zpow_one, mul_smul, ih, hdi, zpow_sub₀ hk.ne', zpow_one]
      push_cast
      ring

/-- Integral radial normalization preserves the actual signed transverse ratio. -/
theorem verticalDilation_isometry_zpow_slope (k : ℝ) (hk : 0<k) (n : ℤ) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)^n • z).re/
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)^n • z).im=z.re/z.im := by
  have he:=verticalDilation_isometry_zpow_coe k hk n z
  have hr:=congrArg Complex.re he
  have hi:=congrArg Complex.im he
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)^n • z).re=_ at hr
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)^n • z).im=_ at hi
  simp only [Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
    zero_mul,sub_zero,add_zero] at hr hi
  rw [hr,hi]
  exact mul_div_mul_left _ _ (zpow_pos hk n).ne'

/-- An actual positive dilation produces an actual weak-annulus orbit representative. -/
theorem native_dilation_annulus_representative
    (H : Subgroup (ℍ≃ᵢℍ)) (k : ℝ) (hk : 1<k)
    (hd : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (lt_trans zero_lt_one hk))∈H) (z : ℍ) :
    ∃w∈MulAction.orbit H z, 1≤‖(w:ℂ)‖ ∧ ‖(w:ℂ)‖≤k ∧
      w.re/w.im=z.re/z.im := by
  let hkp:0<k:=lt_trans zero_lt_one hk
  let n : ℤ := -⌊Real.log ‖(z:ℂ)‖/Real.log k⌋
  let d:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hkp)
  let w:ℍ:=d^n • z
  have hcoe: (w:ℂ)=(k^n:ℝ)*(z:ℂ):=verticalDilation_isometry_zpow_coe k hkp n z
  have hnorm: ‖(w:ℂ)‖=k^n*‖(z:ℂ)‖:=by
    rw [hcoe,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (zpow_pos hkp n)]
  have hlog:Real.log ‖(w:ℂ)‖=(n:ℝ)*Real.log k+Real.log ‖(z:ℂ)‖:=by
    rw [hnorm,Real.log_mul (zpow_pos hkp n).ne' (norm_pos_iff.mpr z.ne_zero).ne',Real.log_zpow]
  have hkl:0<Real.log k:=Real.log_pos hk
  have h0:=Int.sub_floor_div_mul_nonneg (Real.log ‖(z:ℂ)‖) hkl
  have h1:=Int.sub_floor_div_mul_lt (Real.log ‖(z:ℂ)‖) hkl
  have hwlog:0≤Real.log ‖(w:ℂ)‖ ∧ Real.log ‖(w:ℂ)‖≤Real.log k:=by
    rw [hlog]
    dsimp [n]
    push_cast
    constructor <;> linarith
  refine ⟨w,MulAction.mem_orbit_iff.mpr ⟨⟨d^n,H.zpow_mem hd n⟩,rfl⟩,?_,?_,
    verticalDilation_isometry_zpow_slope k hkp n z⟩
  · exact (Real.log_nonneg_iff (norm_pos_iff.mpr w.ne_zero)).mp hwlog.1
  · exact (Real.log_le_log_iff (norm_pos_iff.mpr w.ne_zero) hkp).mp hwlog.2

/-- Axis half-turns reverse the actual signed transverse ratio. -/
theorem axisHalfTurn_slope_neg (u : ℝ) (hu : 0<u) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im=-(z.re/z.im) := by
  have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe u hu z
  rw [←Complex.ofReal_pow] at he
  have hr:=congrArg Complex.re he
  have hi:=congrArg Complex.im he
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re=_ at hr
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im=_ at hi
  simp only [Complex.div_re,Complex.div_im,Complex.neg_re,Complex.neg_im,
    Complex.ofReal_re,Complex.ofReal_im,zero_mul,neg_zero] at hr hi
  simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im] at hr hi
  rw [hr,hi]
  field_simp [(Complex.normSq_pos.mpr z.ne_zero).ne',hu.ne',z.im_ne_zero]
  ring

/-- Radial normalization and a true half-turn give the closed right annulus,
with the original absolute transverse ratio exactly preserved. -/
theorem native_dihedral_annulus_representative
    (H : Subgroup (ℍ≃ᵢℍ)) (k : ℝ) (hk : 1<k)
    (hd : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (lt_trans zero_lt_one hk))∈H)
    (u : ℝ) (hu : 0<u) (hs : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)∈H) (z : ℍ) :
    ∃w∈MulAction.orbit H z, 1≤‖(w:ℂ)‖ ∧ ‖(w:ℂ)‖≤k ∧ 0≤w.re ∧
      |w.re/w.im|=|z.re/z.im| := by
  let v:ℍ:=if 0≤z.re then z else _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z
  have hv : v∈MulAction.orbit H z:=by
    dsimp [v]
    split_ifs with hz
    · exact MulAction.mem_orbit_self z
    · exact MulAction.mem_orbit_iff.mpr ⟨⟨_,hs⟩,rfl⟩
  have hvre:0≤v.re:=by
    dsimp [v]
    split_ifs with hz
    · exact hz
    · have he:=axisHalfTurn_slope_neg u hu z
      have hn:z.re/z.im<0:=div_neg_of_neg_of_pos (lt_of_not_ge hz) z.im_pos
      have hp:0<(_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im:=by linarith only [he,hn]
      exact le_of_lt ((div_pos_iff_of_pos_right (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im_pos).mp hp)
  have hvs:|v.re/v.im|=|z.re/z.im|:=by
    dsimp [v]
    split_ifs
    · rfl
    · rw [axisHalfTurn_slope_neg,abs_neg]
  obtain ⟨w,hw,hn0,hn1,hwr⟩:=native_dilation_annulus_representative H k hk hd v
  refine ⟨w,?_,hn0,hn1,?_,?_⟩
  · rw [MulAction.orbit_eq_iff.mpr hv] at hw
    exact hw
  · have hp:0≤w.re/w.im:=by rw [hwr];exact div_nonneg hvre v.im_pos.le
    simpa only [zero_mul] using (le_div_iff₀ w.im_pos).mp hp
  · rw [hwr,hvs]

/-- The actual closed radial band with a bounded transverse ratio is compact.
The positive lower height is derived from its norm and ratio constraints. -/
theorem native_annulus_bounded_slope_compact (k R : ℝ) (hR : 0≤R) :
    IsCompact {z:ℍ | 1≤‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖≤k ∧ |z.re/z.im|≤R} := by
  let δ:=1/(R+1)
  have hδ:0<δ:=by dsimp [δ]; positivity
  let C:Set ℂ:={z | ‖z‖≤k ∧ δ≤z.im}
  have hCclosed:IsClosed C:=by
    exact (isClosed_le continuous_norm continuous_const).inter
      (isClosed_le continuous_const Complex.continuous_im)
  have hCcompact:IsCompact C:=(isCompact_closedBall (0:ℂ) k).of_isClosed_subset hCclosed (by
    intro z hz
    simpa only [Metric.mem_closedBall,dist_zero_right] using hz.1)
  let K:Set ℍ:={z | (z:ℂ)∈C}
  have hKimage:UpperHalfPlane.coe '' K=C:=by
    ext z
    constructor
    · rintro ⟨w,hw,rfl⟩
      exact hw
    · intro hz
      exact ⟨⟨z,lt_of_lt_of_le hδ hz.2⟩,hz,rfl⟩
  have hKcompact:IsCompact K:=UpperHalfPlane.isEmbedding_coe.isCompact_iff.mpr (by
    rw [hKimage]
    exact hCcompact)
  have hslope:Continuous (fun z:ℍ=>|z.re/z.im|):=
    (UpperHalfPlane.continuous_re.div UpperHalfPlane.continuous_im (fun z=>z.im_pos.ne')).abs
  have hnorm:Continuous (fun z:ℍ=>‖(z:ℂ)‖):=UpperHalfPlane.continuous_coe.norm
  apply hKcompact.of_isClosed_subset
    ((isClosed_le continuous_const hnorm).inter ((isClosed_le hnorm continuous_const).inter
      (isClosed_le hslope continuous_const)))
  intro z hz
  change 1≤‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖≤k ∧ |z.re/z.im|≤R at hz
  change ‖(z:ℂ)‖≤k ∧ δ≤z.im
  refine ⟨hz.2.1,?_⟩
  have hratio:|z.re|≤R*z.im:=by
    have hh:=hz.2.2
    rw [abs_div,abs_of_pos z.im_pos] at hh
    exact (div_le_iff₀ z.im_pos).mp hh
  have hn:‖(z:ℂ)‖≤|z.re|+z.im:=by
    simpa only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,abs_of_pos z.im_pos] using
      Complex.norm_le_abs_re_add_abs_im (z:ℂ)
  apply (div_le_iff₀ (show 0<R+1 by linarith)).mpr
  nlinarith only [hz.1,hratio,hn]

/-- A genuine discrete native group containing a positive dilation and an axis
half-turn has a right-annulus orbit representative minimizing the actual
absolute transverse ratio throughout its entire original orbit. -/
theorem native_three_halfturn_orbit_minimizer
    (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H] (k : ℝ) (hk : 1<k)
    (hd : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (lt_trans zero_lt_one hk))∈H)
    (u : ℝ) (hu : 0<u) (hs : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)∈H) (z : ℍ) :
    ∃w∈MulAction.orbit H z, 1≤‖(w:ℂ)‖ ∧ ‖(w:ℂ)‖≤k ∧ 0≤w.re ∧
      ∀v∈MulAction.orbit H z, |w.re/w.im|≤|v.re/v.im| := by
  let R:=|z.re/z.im|
  let K:Set ℍ:={v | 1≤‖(v:ℂ)‖ ∧ ‖(v:ℂ)‖≤k ∧ |v.re/v.im|≤R}
  let S:Set ℍ:=(K∩MulAction.orbit H z)∩{v | 0≤v.re}
  have hK:IsCompact K:=native_annulus_bounded_slope_compact k R (abs_nonneg _)
  have hS:S.Finite:=((nativeIsometrySubgroup_discontinuous H).finite_inter_orbit z hK).subset
    (fun _ hv=>hv.1)
  obtain ⟨b,hbo,hb0,hb1,hbr,hbs⟩:=native_dihedral_annulus_representative H k hk hd u hu hs z
  have hb:b∈S:=⟨⟨⟨hb0,hb1,hbs.le⟩,hbo⟩,hbr⟩
  obtain ⟨w,hw,hmin⟩:=Set.exists_min_image S (fun v:ℍ=>|v.re/v.im|) hS ⟨b,hb⟩
  refine ⟨w,hw.1.2,hw.1.1.1,hw.1.1.2.1,hw.2,?_⟩
  intro v hv
  by_cases hvs:|v.re/v.im|≤R
  · obtain ⟨c,hco,hc0,hc1,hcr,hcs⟩:=native_dihedral_annulus_representative H k hk hd u hu hs v
    have hcoz:c∈MulAction.orbit H z:=by
      rw [MulAction.orbit_eq_iff.mpr hv] at hco
      exact hco
    have hc:c∈S:=⟨⟨⟨hc0,hc1,hcs.le.trans hvs⟩,hcoz⟩,hcr⟩
    exact (hmin c hc).trans_eq hcs
  · exact hw.1.1.2.2.trans (le_of_lt (lt_of_not_ge hvs))

end LowDimensionalTopology.Geometry.Fuchsian

