/-- Axis subdivision preserves the integral of the original hyperbolic density. -/
theorem halfTurnQuadRefined_area (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) :
    (halfTurnQuadRefined k c m hk hc hm hmk).area=
      (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.area := by
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon.area_eq_halfPlane_volume,_root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon.area_eq_halfPlane_volume,
    halfTurnQuadRefined_interior]

/-- The actual five-side group covers all native orbits by its unchanged compact polygon. -/
theorem halfTurnFivePairing_orbit_cover (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    [DiscreteTopology (halfTurnFivePairing u t hu hut w hw hn hc).Generated] :
    ∀z : ℍ,∃g : (halfTurnFivePairing u t hu hut w hw hn hc).Generated,
      g•z∈(_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon
        (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
        (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc)).carrier := by
  let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
  let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
  let S:=halfTurnFivePairing u t hu hut w hw hn hc
  let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf
  have hu0 : 0<u:=zero_lt_one.trans hu
  have ht0 : 0<t:=zero_lt_one.trans (hu.trans hut)
  have hh:=halfTurnFive_band_parameters u t hu hut
  have hm (i : Fin 5) : halfTurnFiveElement u t hu0 ht0 w i∈S.Generated:=by
    apply Subgroup.subset_closure
    exact ⟨e i,halfTurnFivePairing_element_index u t hu hut w hw hn hc i⟩
  intro z
  obtain ⟨a,ha,hqa⟩:=halfTurnClosedQuad_meetsEveryOrbit S.Generated (t^2) hh.1
    (hm 4) u hu0 (hm 0) w hw (hm 3) z
  rcases ha with ⟨g,rfl⟩
  refine ⟨g,?_⟩
  apply (halfTurnQuadRefined_native_carrier (t^2) (t^2/w.re) (u^2)
    hh.1 hc hh.2.1 hh.2.2 _).mpr
  simpa [halfTurnClosedQuad,halfTurnQuadCirclePolynomial,hn,
    div_mul_eq_mul_div,mul_div_assoc] using hqa

/-- True local side coverage gives a positive covering degree and the exact
actual density-area/covolume identity for the five-side branch. -/
theorem halfTurnFivePairing_cover_multiplicity (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    [DiscreteTopology (halfTurnFivePairing u t hu hut w hw hn hc).Generated] :
    let S:=halfTurnFivePairing u t hu hut w hw hn hc
    let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
    let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
    let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
    let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
    ∃N : ℕ,0<N ∧
      (∀z : ℍ,_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity S.Generated P.interior z=N) ∧
      Real.pi/21≤(MeasureTheory.covolume S.Generated ℍ volume).toReal ∧
      Real.pi-2*Real.arccos lam=
        (N : ℝ)*(MeasureTheory.covolume S.Generated ℍ volume).toReal := by
  let S:=halfTurnFivePairing u t hu hut w hw hn hc
  let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
  let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
  let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
  have hOpp : ∀s : P.Side,∀x∈s.val,x∉_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q→
      S.OppositeSideNeighborhoods s x:=by
    intro s x hx hv
    obtain ⟨i,rfl⟩:=(_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf).surjective s
    apply halfTurnFivePairing_opposition_index u t hu hut w hw hn hc i x hx
    rwa [finitePolygon_native_vertices_range Q hf] at hv
  obtain ⟨N,hN,hCount,hArea⟩:=finitePolygon_actual_multiplicity Q hf S hOpp
  have hConf : S.Generated≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup:=by
    rw [halfTurnFivePairing_generated]
    apply (Subgroup.closure_le _).mpr
    rintro f (rfl|rfl|rfl) <;> exact ⟨_,rfl⟩
  have hLow:=nativeCovolume_compact_cover_lower_bound S.Generated hConf P.carrier
    (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_isCompact Q hf)
    (halfTurnFivePairing_orbit_cover u t hu hut w hw hn hc)
  refine ⟨N,hN,hCount,hLow,?_⟩
  have hb:=halfTurnFive_band_parameters u t hu hut
  have hQarea : Q.area=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hb.1 hc).toDiscPolygon.area:=
    halfTurnQuadRefined_area (t^2) (t^2/w.re) (u^2) hb.1 hc hb.2.1 hb.2.2
  have hr:=congrArg ENNReal.toReal hArea
  rw [ENNReal.toReal_mul,ENNReal.toReal_natCast] at hr
  have hQnative : Q.area=volume P.interior:=Q.area_eq_halfPlane_volume
  rw [←hQnative,hQarea,halfTurnQuadCanonical_area] at hr
  exact hr

end LowDimensionalTopology.Geometry.Fuchsian


