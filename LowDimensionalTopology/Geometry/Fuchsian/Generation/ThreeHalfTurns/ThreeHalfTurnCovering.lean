/-- Every actual nonvertex point of the refined native polygon side satisfies
all other defining region inequalities strictly. -/
theorem halfTurnQuadRefined_native_side_strict (k c m : ℝ) (hk : 1<k)
    (hc : k+1<2*c) (hm : 1<m) (hmk : m<k) (i : Fin 5) (z : ℍ)
    (hx : z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadRefined k c m hk hc hm hmk) i)
    (hnot : z∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex (halfTurnQuadRefined k c m hk hc hm hmk)
      (halfTurnQuadRefined_finite k c m hk hc hm hmk))) :
    ![1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re^2+z.im^2-2*c*z.re+k,
      1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re^2+z.im^2-2*c*z.re+k,
      1<‖(z : ℂ)‖ ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k,
      1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re,
      ‖(z : ℂ)‖<k ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k] i := by
  have hraw : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z∈kleinSubdivisionEdge
      (kleinSubdivisionVertices5 (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
