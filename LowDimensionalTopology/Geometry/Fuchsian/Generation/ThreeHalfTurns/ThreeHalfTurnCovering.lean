/-- Each of the five actual native geodesic side sets has its original literal
axis, radial, or side-circle equation. -/
theorem halfTurnQuadRefined_side_iff (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) (i : Fin 5) (z : ℍ) :
    z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadRefined k c m hk hc hm hmk) i ↔
      ![z.re=0 ∧ z.im∈Icc 1 m,z.re=0 ∧ z.im∈Icc m k,
        ‖(z : ℂ)‖=k ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k,
        1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧ z.re^2+z.im^2-2*c*z.re+k=0,
        ‖(z : ℂ)‖=1 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k] i := by
  have h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  have hr:=halfTurnQuadKleinR_bounds k m hk hm hmk
  have hmem : z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadRefined k c m hk hc hm hmk) i ↔
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z∈kleinSubdivisionEdge
        (kleinSubdivisionVertices5 (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
          (halfTurnQuadKleinR m) (halfTurnQuadKleinS k)) i:=by
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelDiscHSegment _ _↔_
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_injective.mem_set_image,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKlein_image_closedModelDiscHSegment,
      halfTurnQuadRefined_coordinate,halfTurnQuadRefined_coordinate,
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion]
    rfl
  rw [hmem,kleinSubdivisionEdge5_mem _ _ _ _ hr.1 hr.2 h.1 h.2.2.2.2.1]
  fin_cases i
  · simpa [kleinSubdivisionEdgeCondition5,halfTurnQuadKleinR,halfTurnQuadKleinS] using nativeSideCoordinates_edge0 m hm z
  · simpa [kleinSubdivisionEdgeCondition5,halfTurnQuadKleinR,halfTurnQuadKleinS] using
      nativeSideCoordinates_edge1 m k (lt_trans zero_lt_one hm) (lt_trans zero_lt_one hk) z
  · simpa [kleinSubdivisionEdgeCondition5,halfTurnQuadKleinA,halfTurnQuadKleinB,
      halfTurnQuadKleinS] using nativeSideCoordinates_edge2 k c hk hc z
  · simpa [kleinSubdivisionEdgeCondition5,halfTurnQuadKleinA,halfTurnQuadKleinB,
      halfTurnQuadKleinS] using nativeSideCoordinates_edge3 k c hk hc z
  · simpa [kleinSubdivisionEdgeCondition5,halfTurnQuadKleinA] using nativeSideCoordinates_edge4 k c hk hc z

/-- The actual native axis half-turn has its genuine inverse equal to itself. -/
theorem halfTurnNative_axis_inverse (u : ℝ) (hu : 0<u) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu))⁻¹=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu) := by
  apply IsometryEquiv.ext
  intro z
  apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)).injective
  rw [IsometryEquiv.apply_inv_self]
  exact (axisHalfTurn_action_involutive u hu z).symm

/-- The actual native third half-turn has its genuine inverse equal to itself. -/
theorem halfTurnNative_point_inverse (w : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w))⁻¹=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w) := by
  apply IsometryEquiv.ext
  intro z
  apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)).injective
  rw [IsometryEquiv.apply_inv_self]
  exact (sideOpposition_point_halfturn_involutive w z).symm

theorem halfTurnNative_inverse_apply (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (z : ℍ) :
    ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A)⁻¹ : ℍ≃ᵢℍ) z=A⁻¹•z := by
  apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A).injective
  rw [IsometryEquiv.apply_inv_self]
  change z=A•(A⁻¹•z)
  exact (smul_inv_smul A z).symm

/-- The five genuine side-pairing transformations, in unchanged cyclic order. -/
def halfTurnFiveElement (u t : ℝ) (hu : 0<u) (ht : 0<t) (w : ℍ) : Fin 5→(ℍ≃ᵢℍ):=
  ![_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu ht)),
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos ht)))⁻¹,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos ht))]

theorem halfTurnFiveElement_paired (u t : ℝ) (hu : 0<u) (ht : 0<t) (w : ℍ) (i : Fin 5) :
    halfTurnFiveElement u t hu ht w (Equiv.swap 2 4 i)=(halfTurnFiveElement u t hu ht w i)⁻¹ := by
  fin_cases i <;> norm_num [halfTurnFiveElement,Equiv.swap_apply_def,
    halfTurnNative_axis_inverse,halfTurnNative_point_inverse]


/-- The second genuine axis half-turn followed by the first is the actual
radial dilation used in the unchanged side pairing. -/
theorem halfTurnNative_axis_product (u t : ℝ) (hu : 0<u) (ht : 0<t) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos ht)) := by
  apply IsometryEquiv.ext
  intro z
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) _•(_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu•z)=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos ht)•z
  rw [←mul_smul]
  apply UpperHalfPlane.ext
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurns_product_coe,_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe]
  have hr : u*t/u=t:=by field_simp
  rw [hr,Complex.ofReal_pow]


theorem halfTurnFive_band_parameters (u t : ℝ) (hu : 1<u) (hut : u<t) :
    1<t^2 ∧ 1<u^2 ∧ u^2<t^2 := by
  have ht : 1<t:=hu.trans hut
  have hup : 0<u:=lt_trans zero_lt_one hu
  have htp : 0<t:=lt_trans zero_lt_one ht
  exact ⟨by nlinarith only [ht],by nlinarith only [hu],
    (sq_lt_sq₀ hup.le htp.le).mpr hut⟩

def halfTurnFiveDiscPolygon (u t c : ℝ) (hu : 1<u) (hut : u<t) (hc : t^2+1<2*c) : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon 5:=
  let h:=halfTurnFive_band_parameters u t hu hut
  halfTurnQuadRefined (t^2) c (u^2) h.1 hc h.2.1 h.2.2

theorem halfTurnFiveDiscPolygon_finite (u t c : ℝ) (hu : 1<u) (hut : u<t) (hc : t^2+1<2*c)
    (i : Fin 5) : ‖((halfTurnFiveDiscPolygon u t c hu hut hc).vertices i : ℂ)‖<1:=by
  let h:=halfTurnFive_band_parameters u t hu hut
  exact halfTurnQuadRefined_finite (t^2) c (u^2) h.1 hc h.2.1 h.2.2 i

def halfTurnFiveLiteralSide (u t c : ℝ) : Fin 5→Set ℍ:=
  ![{z | z.re=0 ∧ z.im∈Icc 1 (u^2)}, {z | z.re=0 ∧ z.im∈Icc (u^2) (t^2)},
    {z | ‖(z : ℂ)‖=t^2 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+t^2},
    {z | 1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤t^2 ∧ 0≤z.re ∧ z.re^2+z.im^2-2*c*z.re+t^2=0},
    {z | ‖(z : ℂ)‖=1 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+t^2}]

theorem halfTurnFiveDiscPolygon_side (u t c : ℝ) (hu : 1<u) (hut : u<t) (hc : t^2+1<2*c)
    (i : Fin 5) : _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnFiveDiscPolygon u t c hu hut hc) i=
      halfTurnFiveLiteralSide u t c i := by
  ext z
  let h:=halfTurnFive_band_parameters u t hu hut
  have hh:=halfTurnQuadRefined_side_iff (t^2) c (u^2) h.1 hc h.2.1 h.2.2 i z
  fin_cases i <;> simpa [halfTurnFiveLiteralSide,halfTurnFiveDiscPolygon] using hh

/-- Every stated native side image is proved on the entire literal geodesic
side, including its original endpoints. -/
theorem halfTurnFive_literal_side_image (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (i : Fin 5) :
    (halfTurnFiveElement u t (lt_trans zero_lt_one hu) (lt_trans zero_lt_one (hu.trans hut)) w i) ''
      halfTurnFiveLiteralSide u t (t^2/w.re) i=
        halfTurnFiveLiteralSide u t (t^2/w.re) (Equiv.swap 2 4 i) := by
  have hup : 0<u:=lt_trans zero_lt_one hu
  have htp : 0<t:=lt_trans zero_lt_one (hu.trans hut)
  have hk : 0<t^2:=sq_pos_of_pos htp
  have hI : (fun z : ℍ=>((_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) hk))⁻¹ : ℍ≃ᵢℍ) z)=
      (fun z : ℍ=>(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) hk)⁻¹•z):=by
    funext z
    exact halfTurnNative_inverse_apply _ z
  fin_cases i
  · simpa [halfTurnFiveElement,halfTurnFiveLiteralSide,Equiv.swap_apply_def] using
      axisHalfTurn_lower_axis_side_image u hu.le
  · simpa [halfTurnFiveElement,halfTurnFiveLiteralSide,Equiv.swap_apply_def] using
      axisHalfTurn_upper_axis_side_image u t hup hut.le
  · simpa [halfTurnFiveElement,halfTurnFiveLiteralSide,Equiv.swap_apply_def,hn,
      mul_div_assoc,hI] using halfturn_radial_top_bottom_pairing w (t^2) hk hn
  · simpa [halfTurnFiveElement,halfTurnFiveLiteralSide,Equiv.swap_apply_def,hn,mul_div_assoc] using
      pointHalfTurn_side_circle_closed_side_self_pairing w hw
  · simpa [halfTurnFiveElement,halfTurnFiveLiteralSide,Equiv.swap_apply_def,hn,mul_div_assoc] using
      halfturn_radial_bottom_top_pairing w (t^2) hk hn


/-- The original five-side pairing is constructed from the actual maps and
whole-side image identities, without a supplied pairing hypothesis. -/
def halfTurnFivePairing (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2)
    (hc : t^2+1<2*(t^2/w.re)) :
    _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing (ℍ≃ᵢℍ) (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon
      (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
      (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc)) := by
  let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
  let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
  let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf
  let E:=halfTurnFiveElement u t (lt_trans zero_lt_one hu) (lt_trans zero_lt_one (hu.trans hut)) w
  refine {
    paired:=e.symm.trans ((Equiv.swap 2 4).trans e)
    involutive:=?_
    element:=(fun s=>E (e.symm s))
    element_paired:=?_
    side_image:=?_}
  · intro s
    change e (Equiv.swap 2 4 (e.symm (e (Equiv.swap 2 4 (e.symm s)))))=s
    rw [e.symm_apply_apply,Equiv.swap_apply_self,e.apply_symm_apply]
  · intro s
    change E (e.symm (e (Equiv.swap 2 4 (e.symm s))))=(E (e.symm s))⁻¹
    rw [e.symm_apply_apply]
    exact halfTurnFiveElement_paired u t _ _ w (e.symm s)
  · intro s
    obtain ⟨i,rfl⟩:=e.surjective s
    change E (e.symm (e i)) • (e i).val=(e (Equiv.swap 2 4 (e.symm (e i)))).val
    rw [e.symm_apply_apply]
    change E i '' _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide Q i=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide Q (Equiv.swap 2 4 i)
    rw [halfTurnFiveDiscPolygon_side,halfTurnFiveDiscPolygon_side]
    exact halfTurnFive_literal_side_image u t hu hut w hw hn i

/-- The element labeling is the original five explicit native transformations. -/
theorem halfTurnFivePairing_element_index (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) (i : Fin 5) :
    (halfTurnFivePairing u t hu hut w hw hn hc).element
