/-- Two distinct actual polygon corners in one genuine orbit contribute two
full cyclic stabilizer families to the actual angular sum. -/
theorem halfTurn_two_summit_angular_bound (H : Subgroup (ℍ≃ᵢℍ)) (P : Set ℍ)
    (A D : H) (z w : ℍ) (hA : A•z=z) (hD : D⁻¹•z=w) (hzw : z≠w) :
    (orderOf A : ℝ≥0∞)*(_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P z+_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P w)≤
      _root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity H P z := by
  classical
  let q:=orderOf A
  have hpow (n : ℕ) : A^n•z=z:=by
    induction n with
    | zero=>simp
    | succ n hn=>simp only [pow_succ,mul_smul,hA,hn]
  have hinv (n : ℕ) : (A^n)⁻¹•z=z:=by
    have he:=congrArg (fun x : ℍ=>(A^n)⁻¹•x) (hpow n)
    simpa only [inv_smul_smul] using he.symm
  let F : Bool×Fin q→H:=fun i=>if i.1 then A^i.2.val*D else A^i.2.val
  have hFpoint (i : Bool×Fin q) : (F i)⁻¹•z=if i.1 then w else z:=by
    rcases i with ⟨b,n⟩
    cases b
    · exact hinv n.val
    · change (A^n.val*D)⁻¹•z=w
      rw [mul_inv_rev,mul_smul,hinv,hD]
  have hF : Function.Injective F:=by
    rintro ⟨b,n⟩ ⟨c,m⟩ he
    have hpoint:=congrArg (fun g : H=>g⁻¹•z) he
    rw [hFpoint,hFpoint] at hpoint
    cases b <;> cases c
    · have hnm : n=m:=Fin.ext (pow_injOn_Iio_orderOf n.isLt m.isLt he)
      exact Prod.ext rfl hnm
    · exact (hzw (by simpa only [Bool.false_eq_true,ite_false,ite_true] using hpoint)).elim
    · exact (hzw (by simpa only [Bool.false_eq_true,ite_false,ite_true] using hpoint.symm)).elim
    · have he' : A^n.val=A^m.val:=mul_right_cancel he
      have hnm : n=m:=Fin.ext (pow_injOn_Iio_orderOf n.isLt m.isLt he')
      exact Prod.ext rfl hnm
  have hle:=ENNReal.tsum_comp_le_tsum_of_injective hF
    (fun g : H=>_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P (g⁻¹•z))
  change _≤_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity H P z at hle
  apply le_trans (le_of_eq ?_) hle
  simp_rw [hFpoint]
  rw [tsum_fintype,Fintype.sum_prod_type]
  simp only [Bool.false_eq_true,ite_false,ite_true,Finset.sum_const,Finset.card_univ,
    Fintype.card_fin,nsmul_eq_mul,Fintype.sum_bool]
  ring

