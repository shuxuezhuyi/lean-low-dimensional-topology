/-- The genuine Cayley identification preserves area on every measurable native set. -/
theorem compactCover_cayley_area {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (S : Set ℍ) (hS : MeasurableSet S) :
    P.cayleyData.area (P.cayleyCoordinate '' S)=volume S := by
  rw [←P.cayleyCoordinate_area_map,
    Measure.map_apply P.cayleyCoordinate.continuous.measurable
      (P.cayleyCoordinate.measurableEmbedding.measurableSet_image.mpr hS),
    Set.preimage_image_eq _ P.cayleyCoordinate.injective]

/-- Every actual discrete half-plane group admits a genuine source fundamental
 domain for its unchanged original group and unchanged native action. -/
theorem compactCover_native_fundamental_exists {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) :
    letI:=P.nativeAction
    ∃F:Set ℍ,_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F := by
  let nativeCompactAreaAction:=P.nativeAction
  obtain ⟨w,hw,_⟩:=exists_actual_dirichlet_horocycle_good_center P.cayleyData
  have hD:=dirichletDomain_fundamental P.cayleyData w hw
  let e:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugateEquivalence _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius H
  let E:=P.cayleyCoordinate
  have hmap:Measure.map E.symm P.cayleyData.area=volume:=by
    rw [←P.cayleyCoordinate_area_map,Measure.map_map E.symm.continuous.measurable E.continuous.measurable]
    simp only [Function.comp_def,E.symm_apply_apply,Measure.map_id']
  refine ⟨E ⁻¹' dirichletDomain P.cayleyData w,?_⟩
  have hf:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain.equivariant_preimage e E
    (fun g z=>P.cayleyCoordinate_equivariant g z) hD
  rw [hmap] at hf
  exact hf

/-- An actual compact orbit cover bounds the area of every genuine native
fundamental domain for the same original group, including elliptic stabilizers. -/
theorem compactCover_native_fundamental_volume_le {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (C : Set ℍ) (hC : IsCompact C) :
    letI:=P.nativeAction
    (∀z:ℍ,∃g:H,g • z∈C) →
    ∀F:Set ℍ,_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F → volume F≤volume C := by
  let nativeCompactAreaAction:=P.nativeAction
  intro hcover F hF
  let E:=P.cayleyCoordinate
  let Q:=P.cayleyData
  let K:=_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.Actions.subgroupConjugate _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyMobius H
  have hproj:_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection K Q.domain.carrier '' (E '' C)=univ:=by
    apply Set.eq_univ_of_forall
    intro q
    obtain ⟨x,rfl⟩:=Quotient.exists_rep q
    obtain ⟨g,hg⟩:=hcover (E.symm x)
    refine ⟨E (g • E.symm x),⟨g • E.symm x,hg,rfl⟩,?_⟩
    rw [P.cayleyCoordinate_equivariant,E.apply_symm_apply]
    exact _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection_smul K Q.domain.carrier _ x
  have hle:=fuchsianQuotientAreaMeasure_image_le Q (E '' C)
    (hC.image E.continuous).measurableSet
  rw [hproj,←fuchsianFundamentalDomain_quotient_area Q (E '' F) (P.cayley_fundamental hF),
    compactCover_cayley_area P F hF.isOpen.measurableSet,
    compactCover_cayley_area P C hC.measurableSet] at hle
  exact hle

/-- A compact actual orbit cover supplies a genuine nonzero finite-area
fundamental domain, with its area controlled by the original compact set. -/
theorem compactCover_native_finite_positive_fundamental {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (C : Set ℍ) (hC : IsCompact C) :
    letI:=P.nativeAction
    (∀z:ℍ,∃g:H,g • z∈C) →
    ∃F:Set ℍ,_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H ℍ volume F ∧
      0<volume F ∧ volume F≤volume C ∧ volume F≠⊤ := by
  let nativeCompactAreaAction:=P.nativeAction
  intro hcover
  obtain ⟨F,hF⟩:=compactCover_native_fundamental_exists P
  have hle:=compactCover_native_fundamental_volume_le P C hC hcover F hF
  exact ⟨F,hF,_root_.LowDimensionalTopology.Geometry.Polygon.native_open_volume_pos hF.isOpen hF.nonempty,hle,
    ne_top_of_le_ne_top hC.measure_ne_top hle⟩

/-- The literal original half-plane geometric fundamental domain has exactly
its native hyperbolic area; no numerical signature is used to define it. -/
theorem compactCover_original_geometric_area {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (F : Set ℍ) (hF : MeasurableSet F) :
    geometricModelArea P.asFuchsianDisc
      (geometricHalfPlaneIdentity P.asFuchsianDisc rfl ⁻¹' F)=volume F := by
  let E:=geometricHalfPlaneIdentity P.asFuchsianDisc rfl
  rw [←geometricHalfPlaneIdentity_volume_map P.asFuchsianDisc rfl,
    Measure.map_apply E.symm.continuous.measurable (E.continuous.measurable hF)]
  simp only [←preimage_comp,Function.comp_def,E.apply_symm_apply,preimage_id']

/-- Compact full-orbit coverage gives an actual finite-area original
fundamental domain and a genuine cofinite signature of the original disc. -/
theorem compactCover_original_finite_area_signature {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (C : Set ℍ) (hC : IsCompact C) :
    letI:=P.nativeAction
    (∀z:ℍ,∃g:H,g • z∈C) →
    ∃F:Set (fuchsianGeometricDomain P.asFuchsianDisc).carrier,
      _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H _ (geometricModelArea P.asFuchsianDisc) F ∧
      0<geometricModelArea P.asFuchsianDisc F ∧
      geometricModelArea P.asFuchsianDisc F≤volume C ∧
      geometricModelArea P.asFuchsianDisc F≠⊤ ∧
      ∃g orders cusps,HasCofiniteFuchsianSignature P.asFuchsianDisc g orders cusps := by
  let nativeCompactAreaAction:=P.nativeAction
  intro hcover
  obtain ⟨F,hF,hpos,hle,hfin⟩:=compactCover_native_finite_positive_fundamental P C hC hcover
  have hgF:=P.geometric_fundamental hF
  have he:=compactCover_original_geometric_area P F hF.isOpen.measurableSet
  have ha:geometricModelArea P.asFuchsianDisc
      (geometricHalfPlaneIdentity P.asFuchsianDisc rfl ⁻¹' F)≠⊤:=by rwa [he]
  refine ⟨_,hgF,?_,?_,ha,finite_area_actual_cofinite_signature_exists P.asFuchsianDisc _ hgF ha⟩
  · rwa [he]
  · rwa [he]

/-- The actual finite positive area of a genuine original fundamental domain
obeys the sharp numerical signature lower bound, with its genus and elliptic
orders supplied by the proved original area theorem. -/
theorem compactCover_original_finite_area_lower_bound {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (D : FuchsianDisc H) (F : Set (fuchsianGeometricDomain D).carrier)
    (hF : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain H _ (geometricModelArea D) F)
    (hpos : 0<geometricModelArea D F) (hfin : geometricModelArea D F≠⊤) :
    Real.pi/21≤(geometricModelArea D F).toReal := by
  let _originalCompactAreaFinite : Finite (FuchsianCyclicConjugacyClasses D .elliptic):=
    finite_area_elliptic_classes_finite D F hF hfin
  obtain ⟨g,_hg,hA⟩:=finite_area_original_actual_signature_area D F hF hfin
  let s:FuchsianSignature:={
    genus:=g
    ellipticOrders:=fuchsianEllipticOrderList D
    ellipticOrders_two_le:=fuchsianEllipticOrderList_two_le D
    parabolicEnds:=Nat.card (FuchsianCyclicConjugacyClasses D .parabolic)
    boundaryHyperbolicEnds:=0 }
  have he:(geometricModelArea D F).toReal=s.areaFormulaValue:=by
    simpa only [s,FuchsianSignature.areaFormulaValue,FuchsianSignature.deficit,
      Nat.cast_zero,add_zero] using hA
  have hdef:0<s.deficit:=by
    have hp:=ENNReal.toReal_pos (ne_of_gt hpos) hfin
    rw [he,FuchsianSignature.areaFormulaValue] at hp
    exact (mul_pos_iff_of_pos_left (show 0<2*Real.pi by positivity)).mp hp
  rw [he]
  exact (s.areaFormulaValue_sharp hdef).1

/-- A true compact orbit-covering region for the actual original group has
area at least pi/21. No fundamental domain, signature or area budget is assumed. -/
theorem compactCover_original_region_area_lower_bound {H : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup}
    (P : HalfPlaneFuchsianGroup H) (C : Set ℍ) (hC : IsCompact C) :
    letI:=P.nativeAction
    (∀z:ℍ,∃g:H,g • z∈C) → Real.pi/21≤(volume C).toReal := by
  let nativeCompactAreaAction:=P.nativeAction
  intro hcover
  obtain ⟨F,hF,hpos,hle,hfin,_hSig⟩:=compactCover_original_finite_area_signature P C hC hcover
  have hlo:=compactCover_original_finite_area_lower_bound P.asFuchsianDisc F hF hpos hfin
  exact hlo.trans ((ENNReal.toReal_le_toReal hfin hC.measure_ne_top).mpr hle)

