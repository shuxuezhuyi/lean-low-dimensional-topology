/-- Every original orbit meets the literal closed side-circle quadrilateral.
Only actual membership and discreteness of the generated transformations are
used; orbit coverage is proved by the decreasing transverse coordinate. -/
theorem halfTurnClosedQuad_meetsEveryOrbit
    (H : Subgroup (ℍ≃ᵢℍ)) [DiscreteTopology H] (k : ℝ) (hk : 1<k)
    (hd : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (lt_trans zero_lt_one hk))∈H)
    (u : ℝ) (hu : 0<u) (hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)∈H)
    (w : ℍ) (hw : 0<w.re) (hW : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)∈H)
    (z : ℍ) : ∃a∈MulAction.orbit H z,a∈halfTurnClosedQuad k w := by
  obtain ⟨a,ha,ha0,ha1,har,hmin⟩:=native_three_halfturn_orbit_minimizer H k hk hd u hu hF z
  refine ⟨a,ha,ha0,ha1,har,?_⟩
  by_contra hn
  have hneg : halfTurnQuadCirclePolynomial w a<0:=lt_of_not_ge hn
  have hdec:=pointHalfTurnSL_abs_slope_decreases w a hw hneg
  have hWa : _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w•a∈MulAction.orbit H z:=by
    rw [←MulAction.orbit_eq_iff.mpr ha]
    exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w),hW⟩,rfl⟩
  exact (not_lt_of_ge (hmin _ hWa)) hdec

end LowDimensionalTopology.Geometry.Fuchsian


