/-- Converting the two literal summit contributions to radians gives the
source covering-degree inequality with its genuine reduced numerator. -/
theorem halfTurn_two_summit_degree_lower (H : Subgroup (ℍ≃ᵢℍ)) (P : Set ℍ)
    (A D : H) (z w : ℍ) (hA : A•z=z) (hD : D⁻¹•z=w) (hzw : z≠w)
    (p q N : ℕ) (hq : orderOf A=q) (θ : ℝ)
    (hθq : θ*(q : ℝ)=Real.pi*p)
    (hz : _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngle P z=θ) (hw : _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngle P w=θ)
    (hN : _root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity H P z=N) : p≤N := by
  have hle:=halfTurn_two_summit_angular_bound H P A D z w hA hD hzw
  rw [hq,hN] at hle
  have hfrz : _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P z≠⊤:=
    ne_top_of_le_ne_top (by simp) (_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction_le_one P z)
  have hfrw : _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P w≠⊤:=
    ne_top_of_le_ne_top (by simp) (_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction_le_one P w)
  have hreal:=ENNReal.toReal_mono (by simp : (N : ℝ≥0∞)≠⊤) hle
  rw [ENNReal.toReal_mul,ENNReal.toReal_add hfrz hfrw,
    ENNReal.toReal_natCast,ENNReal.toReal_natCast] at hreal
  unfold _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngle at hz hw
  have he : 2*Real.pi*((q : ℝ)*((_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P z).toReal+
      (_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P w).toReal))=2*Real.pi*p:=by
    calc
      _=(q : ℝ)*(2*Real.pi*(_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P z).toReal+
        2*Real.pi*(_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P w).toReal):=by ring
      _=(q : ℝ)*(θ+θ):=by rw [hz,hw]
      _=2*Real.pi*p:=by nlinarith only [hθq]
  have hmul:=mul_le_mul_of_nonneg_left hreal (by positivity : 0≤2*Real.pi)
  rw [he] at hmul
  have hpr : (p : ℝ)≤N:=(mul_le_mul_iff_right₀ (by positivity : 0<2*Real.pi)).mp hmul
  exact_mod_cast hpr

end LowDimensionalTopology.Geometry.Fuchsian


