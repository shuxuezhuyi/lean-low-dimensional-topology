/-- The native group generated by the three genuine matrix actions is conformal. -/
theorem threeHalfTurn_native_group_conformal
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C} : Set (ℍ≃ᵢℍ))≤
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup := by
  apply (Subgroup.closure_le _).mpr
  rintro f (rfl|rfl|rfl)
  · exact ⟨A,rfl⟩
  · exact ⟨B,rfl⟩
  · exact ⟨C,rfl⟩

/-- The unchanged original three-generator group is exactly the faithful boundary
image of the group of the three actual native isometries. -/
theorem threeHalfTurn_native_group_mobius_image
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    (nativeConformalSubgroupMobiusHom
      (Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C} : Set (ℍ≃ᵢℍ)))
      (threeHalfTurn_native_group_conformal A B C)).range=
      Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup) := by
  let H:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C} : Set (ℍ≃ᵢℍ))
  let hH:=threeHalfTurn_native_group_conformal A B C
  let F:=nativeConformalSubgroupMobiusHom H hH
  let J:=Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  have hall : ∀g (hg : g∈H),F ⟨g,hg⟩∈J:=by
    intro g hg
    change g∈Subgroup.closure _ at hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      rcases hg with rfl|rfl|rfl
      · rw [nativeConformalSubgroupMobiusHom_matrix]
        exact Subgroup.subset_closure (by simp)
      · rw [nativeConformalSubgroupMobiusHom_matrix]
        exact Subgroup.subset_closure (by simp)
      · rw [nativeConformalSubgroupMobiusHom_matrix]
        exact Subgroup.subset_closure (by simp)
    | one =>
      change F 1∈J
      rw [map_one]
      exact J.one_mem
    | mul x y hx hy ihx ihy =>
      change F (⟨x,hx⟩*⟨y,hy⟩)∈J
      rw [map_mul]
      exact J.mul_mem ihx ihy
    | inv x hx ih =>
      change F (⟨x,hx⟩⁻¹)∈J
      rw [map_inv]
      exact J.inv_mem ih
  apply le_antisymm
  · rintro f ⟨g,rfl⟩
    exact hall g.val g.property
  · apply (Subgroup.closure_le _).mpr
    rintro f (rfl|rfl|rfl)
    · exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,Subgroup.subset_closure (by simp)⟩,
        nativeConformalSubgroupMobiusHom_matrix H hH A _⟩
    · exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,Subgroup.subset_closure (by simp)⟩,
        nativeConformalSubgroupMobiusHom_matrix H hH B _⟩
    · exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C,Subgroup.subset_closure (by simp)⟩,
        nativeConformalSubgroupMobiusHom_matrix H hH C _⟩

/-- Actual discreteness of the original matrix-generated Mobius group gives
actual discreteness of the same group acting natively on the half-plane. -/
theorem threeHalfTurn_native_group_discrete_of_original
    (A B C : Matrix.SpecialLinearGroup (Fin 2) ℝ)
    (hd : _root_.LowDimensionalTopology.Geometry.Mobius.IsDiscreteMobiusSubgroup
      (Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))) :
    DiscreteTopology
      (Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry C} : Set (ℍ≃ᵢℍ))) := by
  apply native_conformal_subgroup_discrete_of_image _ (threeHalfTurn_native_group_conformal A B C)
    (Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius A,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius B,_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius C} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)) hd
  intro g
  rw [←threeHalfTurn_native_group_mobius_image A B C]
  exact ⟨g,rfl⟩

/-- Faithful actual boundary extension preserves the order of every genuine
matrix action, including infinite order. -/
theorem hSLIsometry_orderOf_eq_realSLMobius (X : Matrix.SpecialLinearGroup (Fin 2) ℝ) :
    orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry X)=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X) := by
  calc
    orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry X)=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.nativeHalfPlaneExtension (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry X)) :=
      (orderOf_injective _root_.LowDimensionalTopology.Geometry.Hyperbolic.nativeHalfPlaneExtension _root_.LowDimensionalTopology.Geometry.Hyperbolic.nativeHalfPlaneExtension_injective _).symm
    _=orderOf (_root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusToFull (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X)):=by rw [nativeHalfPlaneExtension_hSL]
    _=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius X):=
      orderOf_injective _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusToFull _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusToFull_isometry.injective _

end LowDimensionalTopology.Geometry.Fuchsian


