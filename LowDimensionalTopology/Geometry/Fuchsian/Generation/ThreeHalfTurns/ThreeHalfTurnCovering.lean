        (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc) i)=
      halfTurnFiveElement u t (lt_trans zero_lt_one hu) (lt_trans zero_lt_one (hu.trans hut)) w i := by
  dsimp only [halfTurnFivePairing]
  rw [Equiv.symm_apply_apply]

/-- The side pairing generates the same entire actual three-half-turn group. -/
theorem halfTurnFivePairing_generated (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) :
