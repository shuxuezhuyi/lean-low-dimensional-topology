/-- All original closed finite vertices, with their actual native coordinates. -/
theorem finitePolygon_native_vertices_range {n : ℕ} (Q : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon n)
    (hf : ∀i,‖(Q.vertices i : ℂ)‖<1) :
    _root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q=range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf) := by
  ext z
  constructor
  · rintro ⟨i,hi⟩
    refine ⟨i,?_⟩
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.cayleyHomeomorph.injective
    apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.isEmbedding_discToClosedModel.injective
    exact (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate Q hf i).trans hi
  · rintro ⟨i,rfl⟩
    exact ⟨i,(_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate Q hf i).symm⟩

/-- The actual native closed polygon has exactly its actual finite disc image. -/
theorem finitePolygon_native_carrier_image {n : ℕ} (Q : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon n)
    (hf : ∀i,‖(Q.vertices i : ℂ)‖<1) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc '' (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).carrier=Q.finiteCarrier := by
  ext z
  constructor
  · rintro ⟨w,hw,rfl⟩
    exact (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier_iff Q hf w).mp hw
  · intro hz
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel z∈Q.closedCarrier at hz
    refine ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.discToHalfPlane z,?_,_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc_discToHalfPlane z⟩
    apply (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier_iff Q hf _).mpr
    simpa only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc_discToHalfPlane] using hz

/-- The local angular germ of the genuine native polygon at a real finite
vertex is its original geometric corner angle. -/
theorem finitePolygon_nativeLocalAngle_at_vertex {n : ℕ} (Q : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon n)
    (hf : ∀i,‖(Q.vertices i : ℂ)‖<1) (hQ : Q.IsConvex) (i : Fin n) :
    _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngle (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).interior
      (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf i)=Q.angle i := by
  let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
  let G:=_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygon_native_geometry Q
  have hP : IsCompact P.carrier:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_isCompact Q hf
  have hfrac:=G.localAngularFraction_interior_eq hP (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf i)
  change _root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P.interior _=_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction P.carrier _ at hfrac
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngle,hfrac,_root_.LowDimensionalTopology.Geometry.Polygon.nativeLocalAngularFraction,finitePolygon_native_carrier_image Q hf]
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.discLocalAngle Q.finiteCarrier (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf i))=_
  have hC : _root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscHConvex Q.finiteCarrier:=by rw [Q.finiteCarrier_eq_closure];exact hQ.closure
  have hv : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf i)∈Q.finiteCarrier:=by
    change _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel _∈Q.closedCarrier
    rw [_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate]
    exact Q.boundary_subset_closedCarrier (mem_iUnion.mpr ⟨i,_root_.LowDimensionalTopology.Geometry.Polygon.closedModelDiscHSegment_left_mem _ _⟩)
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.discLocalAngle_eq_of_convex hC hv]
  exact (convexPolygon_angle_eq_subtended Q hQ i _ (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate Q hf i).symm).symm

/-- The true side-pairing and original native discreteness force the same
positive integer angular multiplicity at every point of the actual polygon. -/
theorem finitePolygon_actual_multiplicity {n : ℕ} (Q : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon n)
    (hf : ∀i,‖(Q.vertices i : ℂ)‖<1)
    (S : _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing (ℍ≃ᵢℍ) (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf))
    [DiscreteTopology S.Generated]
    (hOpp : ∀s : (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).Side,∀x∈s.val,
      x∉_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q→S.OppositeSideNeighborhoods s x) :
    ∃N : ℕ,0<N ∧
      (∀z : ℍ,_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity S.Generated
        (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).interior z=N) ∧
      volume (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).interior=
        (N : ℝ≥0∞)*MeasureTheory.covolume S.Generated ℍ volume := by
  let G:=_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygon_native_geometry Q
  have hP : IsCompact (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).carrier:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_isCompact Q hf
  have hV : ∀x∈_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q,∀s : (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).Side,
      x∈s.val→S.element s x∈_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q:=by
    rw [finitePolygon_native_vertices_range Q hf]
    rintro x ⟨i,rfl⟩ s hx
    obtain ⟨j,hj⟩:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonPairing_preserves_vertices Q hf S i s hx
    exact ⟨j,hj⟩
  obtain ⟨N,hN,hCount⟩:=G.angularMultiplicity_positive_integer S hP hV hOpp
  have hInside (z : ℍ) : _root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity S.Generated
      (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).interior z=N:=
    (G.angularMultiplicity_interior_eq hP S.Generated z).trans (hCount z)
  obtain ⟨w,hw⟩:=nativeDiscreteIsometrySubgroup_exists_free_point S.Generated
  exact ⟨N,hN,hInside,G.area_eq_integer_mul_covolume S.Generated w hw N hInside⟩

