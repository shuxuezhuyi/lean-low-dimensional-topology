set_option quotPrecheck false in
local notation "quadSideValue" => (fun w z:ℍ=>
  z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2))
set_option quotPrecheck false in
local notation "quadSideRegion" => (fun (k:ℝ)(w:ℍ)=>
  {z:ℍ | 1≤‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖≤k ∧ 0≤z.re ∧ 0≤quadSideValue w z})

/-- The original point half-turn is an actual involution on the entire plane. -/
theorem sideOpposition_point_halfturn_involutive (w:ℍ) :
    Function.Involutive (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) := by
  have hs:_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)*_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)=1:=by
    have he:=pow_orderOf_eq_one (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w))
    rw [(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL_at w).1,pow_two] at he
    exact he
  intro z
  apply UpperHalfPlane.ext
  apply OnePoint.coe_injective
  rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius_action]
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)*_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)).val (z:ℂ)=(z:ℂ)
  rw [hs]
  rfl

/-- The signed transverse change under the actual third half-turn is the
literal side-circle value with its genuine positive height normalization. -/
theorem sideOpposition_halfturn_slope_difference (w z:ℍ) (hw:0<w.re) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im-z.re/z.im=
      w.re*quadSideValue w z/(w.im^2*z.im) := by
  have hslope (A:Matrix.SpecialLinearGroup (Fin 2) ℝ) (v:ℍ) :
      (A • v).re/(A • v).im=
        ((A 0 0*v.re+A 0 1)*(A 1 0*v.re+A 1 1)+A 0 0*A 1 0*v.im^2)/v.im := by
    have hd:=UpperHalfPlane.normSq_denom_ne_zero (Matrix.SpecialLinearGroup.mapGL ℝ A) v.im_ne_zero
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.sl2_im_smul]
    change ((A • v:ℍ):ℂ).re/(v.im/_)=_
    rw [UpperHalfPlane.coe_specialLinearGroup_apply,Complex.div_re]
    simp only [Algebra.algebraMap_self_apply,Complex.mul_re,Complex.mul_im,Complex.add_re,
      Complex.add_im,Complex.ofReal_re,Complex.ofReal_im,zero_mul,add_zero,sub_zero,
      UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    change (_/Complex.normSq ((A 1 0:ℂ)*(v:ℂ)+A 1 1)+
      _/Complex.normSq ((A 1 0:ℂ)*(v:ℂ)+A 1 1))/
        (v.im/Complex.normSq ((A 1 0:ℂ)*(v:ℂ)+A 1 1))=_
    change Complex.normSq ((A 1 0:ℂ)*(v:ℂ)+A 1 1)≠0 at hd
    field_simp [hd]
  rw [hslope]
  simp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.cons_val_fin_one,
    Matrix.of_apply]
  field_simp [hw.ne']
  ring

/-- The actual third half-turn reverses the side value divided by the actual
imaginary height, throughout the entire original hyperbolic plane. -/
theorem sideOpposition_halfturn_value_ratio_reverse (w z:ℍ) (hw:0<w.re) :
    quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im=
      -(quadSideValue w z/z.im) := by
  have h1:=sideOpposition_halfturn_slope_difference w z hw
  have h2:=sideOpposition_halfturn_slope_difference w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) hw
  have hInv:=sideOpposition_point_halfturn_involutive w z
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)=z at hInv
  rw [hInv] at h2
  have hfactor:w.re/w.im^2≠0:=div_ne_zero hw.ne' (sq_pos_of_pos w.im_pos).ne'
  have he:(w.re/w.im^2)*(quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im+
      quadSideValue w z/z.im)=0:=by
    calc
      _=w.re*quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)/(w.im^2*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im)+
          w.re*quadSideValue w z/(w.im^2*z.im):=by
        field_simp
      _=0:=by linarith only [h1,h2]
  have hz:quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)/(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im+
      quadSideValue w z/z.im=0:=(mul_eq_zero.mp he).resolve_left hfactor
  linarith only [hz]

/-- The union of the true quadrilateral and the inverse image under its
actual third half-turn contains a neighborhood wherever all the other actual
inequalities are strict at both original points. -/
theorem sideOpposition_third_side_union_germ (k:ℝ) (w x:ℍ) (hw:0<w.re)
    (hx:1<‖(x:ℂ)‖ ∧ ‖(x:ℂ)‖<k ∧ 0<x.re)
    (hHx:1<‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • x:ℍ):ℂ)‖ ∧
      ‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • x:ℍ):ℂ)‖<k ∧ 0<(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • x).re) :
    x∈interior (quadSideRegion k w ∪
      (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) ⁻¹' quadSideRegion k w) := by
  let H:ℍ→ℍ:=fun z=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z
  let U:Set ℍ:={z | 1<‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖<k ∧ 0<z.re}
  have hn:Continuous (fun z:ℍ=>‖(z:ℂ)‖):=UpperHalfPlane.continuous_coe.norm
  have hU:IsOpen U:=(isOpen_lt continuous_const hn).inter
    ((isOpen_lt hn continuous_const).inter (isOpen_lt continuous_const UpperHalfPlane.continuous_re))
  have hH:Continuous H:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)).continuous
  apply mem_interior.mpr
  refine ⟨U∩H ⁻¹' U,?_,hU.inter (hU.preimage hH),⟨hx,hHx⟩⟩
  intro z hz
  by_cases hP:0≤quadSideValue w z
  · exact Or.inl ⟨hz.1.1.le,hz.1.2.1.le,hz.1.2.2.le,hP⟩
  · have hp:0<quadSideValue w (H z)/(H z).im:=by
      rw [sideOpposition_halfturn_value_ratio_reverse w z hw]
      exact neg_pos.mpr (div_neg_of_neg_of_pos (lt_of_not_ge hP) z.im_pos)
    have hP':0<quadSideValue w (H z):=(div_pos_iff_of_pos_right (H z).im_pos).mp hp
    exact Or.inr ⟨hz.2.1.le,hz.2.2.1.le,hz.2.2.2.le,hP'.le⟩

/-- The actual axis half-turn reverses the real coordinate with a genuine
nonnegative radial factor, throughout the original native plane. -/
theorem sideOpposition_axis_halfturn_real (u:ℝ) (hu:0<u) (z:ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re=-(u^2*z.re)/Complex.normSq (z:ℂ) := by
  have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe u hu z
  rw [←Complex.ofReal_pow] at he
  have hr:=congrArg Complex.re he
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re=_ at hr
  simpa only [Complex.div_re,Complex.neg_re,Complex.neg_im,Complex.ofReal_re,
    Complex.ofReal_im,zero_mul,neg_zero,zero_div,add_zero,UpperHalfPlane.coe_re,neg_mul] using hr

/-- The original axis half-turn supplies a genuine two-sided neighborhood
where all three other actual quadrilateral constraints are strict at both points. -/
theorem sideOpposition_axis_side_union_germ (k u:ℝ) (hu:0<u) (w x:ℍ)
    (hx:1<‖(x:ℂ)‖ ∧ ‖(x:ℂ)‖<k ∧ 0<quadSideValue w x)
    (hFx:1<‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • x:ℍ):ℂ)‖ ∧
      ‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • x:ℍ):ℂ)‖<k ∧ 0<quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • x)) :
    x∈interior (quadSideRegion k w ∪
      (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z) ⁻¹' quadSideRegion k w) := by
  let F:ℍ→ℍ:=fun z=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z
  let U:Set ℍ:={z | 1<‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖<k ∧ 0<quadSideValue w z}
  have hn:Continuous (fun z:ℍ=>‖(z:ℂ)‖):=UpperHalfPlane.continuous_coe.norm
  have hp:Continuous (fun z:ℍ=>quadSideValue w z):=by fun_prop
  have hU:IsOpen U:=(isOpen_lt continuous_const hn).inter
    ((isOpen_lt hn continuous_const).inter (isOpen_lt continuous_const hp))
  have hF:Continuous F:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu)).continuous
  apply mem_interior.mpr
  refine ⟨U∩F ⁻¹' U,?_,hU.inter (hU.preimage hF),⟨hx,hFx⟩⟩
  intro z hz
  by_cases hR:0≤z.re
  · exact Or.inl ⟨hz.1.1.le,hz.1.2.1.le,hR,hz.1.2.2.le⟩
  · have hR':0≤(F z).re:=by
      rw [sideOpposition_axis_halfturn_real]
      exact div_nonneg (neg_nonneg.mpr
        (mul_nonpos_of_nonneg_of_nonpos (sq_nonneg u) (lt_of_not_ge hR).le)) (Complex.normSq_nonneg _)
    exact Or.inr ⟨hz.2.1.le,hz.2.2.1.le,hR',hz.2.2.2.le⟩

/-- Literal native norm scaling of the original positive dilation. -/
theorem sideOpposition_dilation_norm (k:ℝ) (hk:0<k) (z:ℍ) :
    ‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z:ℍ):ℂ)‖=k*‖(z:ℂ)‖ := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hk]

/-- Literal native norm scaling of the inverse of that same original dilation. -/
theorem sideOpposition_inverse_dilation_norm (k:ℝ) (hk:0<k) (z:ℍ) :
    ‖(((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • z:ℍ):ℂ)‖=‖(z:ℂ)‖/k := by
  have he:=sideOpposition_dilation_norm k hk ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • z)
  rw [smul_inv_smul] at he
  apply (eq_div_iff hk.ne').mpr
  simpa only [mul_comm] using he.symm

/-- The actual bottom-side dilation gives a full union neighborhood from
strict other inequalities at the original point and its genuine image. -/
theorem sideOpposition_bottom_side_union_germ (k:ℝ) (hk:0<k) (w x:ℍ)
    (hx:‖(x:ℂ)‖<k ∧ 0<x.re ∧ 0<quadSideValue w x)
    (hDx:1<‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • x:ℍ):ℂ)‖ ∧
      0<(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • x).re ∧ 0<quadSideValue w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • x)) :
    x∈interior (quadSideRegion k w ∪
      (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z) ⁻¹' quadSideRegion k w) := by
  let D:ℍ→ℍ:=fun z=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z
  let U:Set ℍ:={z | ‖(z:ℂ)‖<k ∧ 0<z.re ∧ 0<quadSideValue w z}
  let V:Set ℍ:={z | 1<‖(z:ℂ)‖ ∧ 0<z.re ∧ 0<quadSideValue w z}
  have hn:Continuous (fun z:ℍ=>‖(z:ℂ)‖):=UpperHalfPlane.continuous_coe.norm
  have hp:Continuous (fun z:ℍ=>quadSideValue w z):=by fun_prop
  have hr:Continuous (fun z:ℍ=>z.re):=UpperHalfPlane.continuous_re
  have hU:IsOpen U:=(isOpen_lt hn continuous_const).inter
    ((isOpen_lt continuous_const hr).inter (isOpen_lt continuous_const hp))
  have hV:IsOpen V:=(isOpen_lt continuous_const hn).inter
    ((isOpen_lt continuous_const hr).inter (isOpen_lt continuous_const hp))
  have hD:Continuous D:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)).continuous
  apply mem_interior.mpr
  refine ⟨U∩D ⁻¹' V,?_,hU.inter (hV.preimage hD),⟨hx,hDx⟩⟩
  intro z hz
  by_cases hN:1≤‖(z:ℂ)‖
  · exact Or.inl ⟨hN,hz.1.1.le,hz.1.2.1.le,hz.1.2.2.le⟩
  · have hN':‖((D z:ℍ):ℂ)‖≤k:=by
      rw [sideOpposition_dilation_norm]
      simpa only [mul_one] using mul_le_mul_of_nonneg_left (lt_of_not_ge hN).le hk.le
    exact Or.inr ⟨hz.2.1.le,hN',hz.2.2.1.le,hz.2.2.2.le⟩

/-- The actual inverse dilation gives the corresponding full neighborhood
along the original top side, under the explicit strict remaining constraints. -/
theorem sideOpposition_top_side_union_germ (k:ℝ) (hk:0<k) (w x:ℍ)
    (hx:1<‖(x:ℂ)‖ ∧ 0<x.re ∧ 0<quadSideValue w x)
    (hDx:‖(((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • x:ℍ):ℂ)‖<k ∧
      0<((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • x).re ∧ 0<quadSideValue w ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • x)) :
    x∈interior (quadSideRegion k w ∪
      (fun z:ℍ=>(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • z) ⁻¹' quadSideRegion k w) := by
  let D:ℍ→ℍ:=fun z=>(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • z
  let U:Set ℍ:={z | 1<‖(z:ℂ)‖ ∧ 0<z.re ∧ 0<quadSideValue w z}
  let V:Set ℍ:={z | ‖(z:ℂ)‖<k ∧ 0<z.re ∧ 0<quadSideValue w z}
  have hn:Continuous (fun z:ℍ=>‖(z:ℂ)‖):=UpperHalfPlane.continuous_coe.norm
  have hp:Continuous (fun z:ℍ=>quadSideValue w z):=by fun_prop
  have hr:Continuous (fun z:ℍ=>z.re):=UpperHalfPlane.continuous_re
  have hU:IsOpen U:=(isOpen_lt continuous_const hn).inter
    ((isOpen_lt continuous_const hr).inter (isOpen_lt continuous_const hp))
  have hV:IsOpen V:=(isOpen_lt hn continuous_const).inter
    ((isOpen_lt continuous_const hr).inter (isOpen_lt continuous_const hp))
  have hD:Continuous D:=(_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹)).continuous
  apply mem_interior.mpr
  refine ⟨U∩D ⁻¹' V,?_,hU.inter (hV.preimage hD),⟨hx,hDx⟩⟩
  intro z hz
  by_cases hN:‖(z:ℂ)‖≤k
  · exact Or.inl ⟨hz.1.1.le,hN,hz.1.2.1.le,hz.1.2.2.le⟩
  · have hN':1≤‖((D z:ℍ):ℂ)‖:=by
      rw [sideOpposition_inverse_dilation_norm]
      exact (one_le_div hk).mpr (lt_of_not_ge hN).le
    exact Or.inr ⟨hN',hz.2.1.le,hz.2.2.1.le,hz.2.2.2.le⟩

end LowDimensionalTopology.Geometry.Fuchsian


