/-- The four actual side maps supply the generators needed to cover every
native orbit by the unchanged original compact quadrilateral. -/
theorem halfTurnFourPairing_orbit_cover (t : ℝ) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    [DiscreteTopology (halfTurnFour_pairing t ht w hw hn hc).Generated] :
    ∀z : ℍ,∃g : (halfTurnFour_pairing t ht w hw hn hc).Generated,
      g•z∈(_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon
        (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
          (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon
        (halfTurnQuadCanonical_finite _ _ _ _)).carrier := by
  let hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
  let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
  let hf:=halfTurnQuadCanonical_finite (t^2) (t^2/w.re) hk hc
  let S:=halfTurnFour_pairing t ht w hw hn hc
  let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf
  have hm (i : Fin 4) : halfTurnFour_element t ht w i∈S.Generated:=by
    apply Subgroup.subset_closure
    exact ⟨e i,halfTurnFour_pairing_element_index t ht w hw hn hc i⟩
  intro z
  obtain ⟨a,ha,hqa⟩:=halfTurnClosedQuad_meetsEveryOrbit S.Generated (t^2) hk
    (hm 3) t (zero_lt_one.trans ht) (hm 0) w hw (hm 2) z
  rcases ha with ⟨g,rfl⟩
  refine ⟨g,?_⟩
  apply (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier_iff Q hf _).mpr
  apply (halfTurnQuadCanonical_native_closedCarrier (t^2) (t^2/w.re) hk hc _).mpr
  simpa [halfTurnClosedQuad,halfTurnQuadCirclePolynomial,hn,
    div_mul_eq_mul_div,mul_div_assoc] using hqa

/-- The actual four-side pairing gives a positive constant angular multiplicity,
the sharp covolume lower bound, and the exact original density-area identity. -/
theorem halfTurnFourPairing_cover_multiplicity (t : ℝ) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    [DiscreteTopology (halfTurnFour_pairing t ht w hw hn hc).Generated] :
    let S:=halfTurnFour_pairing t ht w hw hn hc
    let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon
    let hf:=halfTurnQuadCanonical_finite (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc
    let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
    let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
    ∃N : ℕ,0<N ∧
      (∀z : ℍ,_root_.LowDimensionalTopology.Geometry.Polygon.nativePolygonAngularMultiplicity S.Generated P.interior z=N) ∧
      Real.pi/21≤(MeasureTheory.covolume S.Generated ℍ volume).toReal ∧
      Real.pi-2*Real.arccos lam=
        (N : ℝ)*(MeasureTheory.covolume S.Generated ℍ volume).toReal := by
  let hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
  let S:=halfTurnFour_pairing t ht w hw hn hc
  let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
  let hf:=halfTurnQuadCanonical_finite (t^2) (t^2/w.re) hk hc
  let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
  have hConf : S.Generated≤_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneConformalIsometryGroup:=by
    rw [halfTurnFour_generated]
    apply (Subgroup.closure_le _).mpr
    rintro f (rfl|rfl|rfl)
    · exact ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one,rfl⟩
    · exact ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht),rfl⟩
    · exact ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w,rfl⟩
  have hOpp : ∀s : P.Side,∀x∈s.val,x∉_root_.LowDimensionalTopology.Geometry.Polygon.jordanPolygonNativeVertices Q→
      S.OppositeSideNeighborhoods s x:=by
    intro s x hx hv
    obtain ⟨i,rfl⟩:=(_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf).surjective s
    apply halfTurnFour_opposite t ht w hw hn hc i x hx
    rwa [finitePolygon_native_vertices_range Q hf] at hv
  obtain ⟨N,hN,hCount,hArea⟩:=finitePolygon_actual_multiplicity Q hf S hOpp
  have hLow:=nativeCovolume_compact_cover_lower_bound S.Generated hConf P.carrier
    (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_isCompact Q hf)
    (halfTurnFourPairing_orbit_cover t ht w hw hn hc)
  refine ⟨N,hN,hCount,hLow,?_⟩
  have hr:=congrArg ENNReal.toReal hArea
  rw [ENNReal.toReal_mul,ENNReal.toReal_natCast] at hr
  have hQnative : Q.area=volume P.interior:=Q.area_eq_halfPlane_volume
  rw [←hQnative,halfTurnQuadCanonical_area] at hr
  exact hr

end LowDimensionalTopology.Geometry.Fuchsian


open Set
open scoped UpperHalfPlane
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.DiscreteGroups
