/-- The geometric summit cosine is half the actual signed canonical triple trace. -/
theorem halfTurnCanonical_trace (u t : ℝ) (hu : 0<u) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) :
    let v:=u*t
    let hv:=mul_pos hu (zero_lt_one.trans ht)
    let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
    Matrix.trace (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL v hv*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w).val=2*lam := by
  dsimp only
  rw [axisHalfTurns_point_triple_trace,
    halfTurnQuadCanonical_cosine_trace t w.re w.im ht hw w.im_pos hn]
  have huN : u≠0:=hu.ne'
  have htN : t≠0:=(zero_lt_one.trans ht).ne'
  field_simp

/-- The numerator and exact denominator come from the actual canonical group
and product order, not from an assumed angle classification. -/
theorem halfTurnCanonical_reduced (u t : ℝ) (hu : 0<u) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    (hd : _root_.LowDimensionalTopology.Geometry.Mobius.IsDiscreteMobiusSubgroup (Subgroup.closure
      ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup))) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
    let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
    ∃p q : ℕ,q=orderOf (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K) ∧ 0<p ∧ 2*p<q ∧ p.Coprime q ∧
      Real.arccos lam=Real.pi*p/q := by
  let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu*
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))*_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w
  let G:=Subgroup.closure
    ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu),
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (zero_lt_one.trans ht))),
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} : Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)
  let lam:=halfTurnQuadKleinB (t^2) (t^2/w.re)/
    Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/w.re))^2+1-
      (halfTurnQuadKleinA (t^2) (t^2/w.re))^2)
  have hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
  have hb:=halfTurnQuadCanonical_angles (t^2) (t^2/w.re) hk hc
  have hlam : 0<lam ∧ lam<1:=⟨hb.1,hb.2.1⟩
  have htr : |Matrix.trace K.val|=2*lam:=by
    rw [halfTurnCanonical_trace u t hu ht w hw hn,abs_of_pos (mul_pos (by norm_num) hlam.1)]
  have hEllipse : _root_.LowDimensionalTopology.Geometry.Mobius.MobiusElliptic (_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K):=by
    by_contra he
    have hh:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSL_not_elliptic_abs_trace K he
    rw [htr] at hh
    linarith only [hh,hlam.2]
  have hK : _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius K∈G:=by
    dsimp only [K]
    rw [map_mul,map_mul]
    exact G.mul_mem (G.mul_mem (Subgroup.subset_closure (by simp))
      (Subgroup.subset_closure (by simp))) (Subgroup.subset_closure (by simp))
  obtain ⟨p,q,hq,hp,hpq,hcop,hcos⟩:=realSL_positive_trace_acute_cosine K hEllipse
    (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.discrete_elliptic_finiteOrder G hd _ hK hEllipse) lam hlam.1 htr
  refine ⟨p,q,hq,hp,hpq,hcop,?_⟩
  change Real.arccos lam=Real.pi*p/q
  rw [hcos]
  apply Real.arccos_cos (by positivity)
  have hqR : 0<(q : ℝ):=by exact_mod_cast (show 0<q by omega)
  apply (div_le_iff₀ hqR).mpr
  have hpqR : (p : ℝ)≤q:=by exact_mod_cast (show p≤q by omega)
  nlinarith only [mul_nonneg Real.pi_pos.le (sub_nonneg.mpr hpqR)]

end LowDimensionalTopology.Geometry.Fuchsian


