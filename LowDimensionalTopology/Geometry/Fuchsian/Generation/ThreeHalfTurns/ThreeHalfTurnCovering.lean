          (halfTurnQuadRefined_finite k c m hk hc hm hmk) j) =
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate ((halfTurnQuadRefined k c m hk hc hm hmk).vertices j) := by
          rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion,
            _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate]
      _ = kleinSubdivisionVertices5 (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
          (halfTurnQuadKleinR m) (halfTurnQuadKleinS k) j :=
