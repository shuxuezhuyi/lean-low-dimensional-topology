open Set
open scoped UpperHalfPlane Complex.UnitDisc
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Euclidean LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces

/-- An interior point of the first literal axis side has all other actual region
inequalities strict. -/
theorem nativeSideStrictness_edge0 (k c m : ℝ) (hk : 1<k) (hm : 1<m)
    (hmk : m<k) (z : ℍ)
    (hside : let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
      let r:=(m^2-1)/(m^2+1)
      K.im=0 ∧ 0≤K.re ∧ K.re≤r)
    (hne0 : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠0)
    (_hner : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(((m^2-1)/(m^2+1) : ℝ) : ℂ)) :
    1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re^2+z.im^2-2*c*z.re+k := by
  obtain ⟨hz,hlo,hhi⟩:=(nativeSideCoordinates_edge0 m hm z).mp hside
  have hn:=nativeSideCoordinates_axis_norm z hz
  have hnorm : ‖(z : ℂ)‖≠1 := by
    intro he
    apply hne0
    apply Complex.ext
    · exact (nativeSideCoordinates_re_zero z).mpr he
    · exact (nativeSideCoordinates_im_zero z).mpr hz
  refine ⟨lt_of_le_of_ne (hn.symm ▸ hlo) hnorm.symm,?_,?_⟩
  · rw [hn]
    exact hhi.trans_lt hmk
  · rw [hz]
    nlinarith only [hk,sq_nonneg z.im]

/-- An interior point of the second literal axis side has all other actual
region inequalities strict. -/
theorem nativeSideStrictness_edge1 (k c m : ℝ) (hk : 1<k) (hm : 1<m)
    (z : ℍ)
    (hside : let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
      let r:=(m^2-1)/(m^2+1)
      let s:=(k^2-1)/(k^2+1)
      K.im=0 ∧ r≤K.re ∧ K.re≤ s)
    (_hner : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(((m^2-1)/(m^2+1) : ℝ) : ℂ))
    (hnes : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(((k^2-1)/(k^2+1) : ℝ) : ℂ)) :
    1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re^2+z.im^2-2*c*z.re+k := by
  have hm0 : 0<m := lt_trans zero_lt_one hm
  have hk0 : 0<k := lt_trans zero_lt_one hk
  obtain ⟨hz,hlo,hhi⟩:=(nativeSideCoordinates_edge1 m k hm0 hk0 z).mp hside
  have hn:=nativeSideCoordinates_axis_norm z hz
  have hnorm : ‖(z : ℂ)‖≠k := by
    intro he
    apply hnes
    apply Complex.ext
    · exact (nativeSideCoordinates_re_eq_radius k hk0 z).mpr he
    · exact (nativeSideCoordinates_im_zero z).mpr hz
  refine ⟨?_,lt_of_le_of_ne (hn.symm ▸ hhi) hnorm,?_⟩
  · rw [hn]
    exact hm.trans_le hlo
  · rw [hz]
    nlinarith only [hk,sq_nonneg z.im]

/-- Away from the two actual endpoints the outer radial side satisfies the axis
and side-circle inequalities strictly. -/
theorem nativeSideStrictness_edge2 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ)
    (hside : let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
      let a:=(k+1)/(2*c)
      let b:=(k-1)/(2*c)
      let s:=(k^2-1)/(k^2+1)
      K.re=s ∧ b*s-a≤K.im ∧ K.im≤0)
    (hnes : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(((k^2-1)/(k^2+1) : ℝ) : ℂ))
    (hnet : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠
      (⟨(k^2-1)/(k^2+1),(k-1)/(2*c)*((k^2-1)/(k^2+1))-(k+1)/(2*c)⟩ : ℂ)) :
    1<‖(z : ℂ)‖ ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k := by
  have hc0 : 0<c := by linarith only [hk,hc]
  obtain ⟨hn,haxis,hpoly⟩:=(nativeSideCoordinates_edge2 k c hk hc z).mp hside
  have hre := hside.1
  have hzre : z.re≠0 := by
    intro he
    apply hnes
    apply Complex.ext
    · exact hre
    · exact (nativeSideCoordinates_im_zero z).mpr he
  have hzpoly : z.re^2+z.im^2-2*c*z.re+k≠0 := by
    intro he
    apply hnet
    apply Complex.ext
    · exact hre
    · have hh:=(nativeSideCoordinates_circle_zero k c hc0 z).mpr he
      rw [hre] at hh
      exact hh
  exact ⟨hn.symm ▸ hk,lt_of_le_of_ne haxis hzre.symm,
    lt_of_le_of_ne hpoly hzpoly.symm⟩

/-- The interior of the actual side-circle side lies strictly between the two
radial boundaries and strictly to the right of the actual imaginary axis. -/
theorem nativeSideStrictness_edge3 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ)
    (hside : let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
      let a:=(k+1)/(2*c)
      let b:=(k-1)/(2*c)
      let s:=(k^2-1)/(k^2+1)
      K.re∈Icc 0 s ∧ K.im=b*K.re-a)
    (hnet : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠
      (⟨(k^2-1)/(k^2+1),(k-1)/(2*c)*((k^2-1)/(k^2+1))-(k+1)/(2*c)⟩ : ℂ))
    (hneb : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(⟨0,-((k+1)/(2*c))⟩ : ℂ)) :
    1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re := by
  have hk0 : 0<k := lt_trans zero_lt_one hk
  have hc0 : 0<c := by linarith only [hk,hc]
  obtain ⟨hlo,hhi,_haxis,hpoly⟩:=(nativeSideCoordinates_edge3 k c hk hc z).mp hside
  have hnorm1 : ‖(z : ℂ)‖≠1 := by
    intro he
    have hre:=(nativeSideCoordinates_re_zero z).mpr he
    apply hneb
    apply Complex.ext
    · exact hre
    · have hh:=hside.2
      simpa only [hre,mul_zero,zero_sub] using hh
  have hnormk : ‖(z : ℂ)‖≠k := by
    intro he
    have hre:=(nativeSideCoordinates_re_eq_radius k hk0 z).mpr he
    apply hnet
    apply Complex.ext
    · exact hre
    · have hh:=hside.2
      rw [hre] at hh
      exact hh
  have hmul : 0<2*c*z.re := by
    nlinarith only [hpoly,hk0,sq_nonneg z.re,sq_nonneg z.im]
  exact ⟨lt_of_le_of_ne hlo hnorm1.symm,lt_of_le_of_ne hhi hnormk,
    pos_of_mul_pos_right hmul (by positivity)⟩

/-- Away from its actual endpoints the unit radial side satisfies the axis and
side-circle inequalities strictly. -/
theorem nativeSideStrictness_edge4 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ)
    (hside : let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
      let a:=(k+1)/(2*c)
      K.re=0 ∧ K.im∈Icc (-a) 0)
    (hneb : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠(⟨0,-((k+1)/(2*c))⟩ : ℂ))
    (hne0 : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠0) :
    ‖(z : ℂ)‖<k ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k := by
  have hc0 : 0<c := by linarith only [hk,hc]
  obtain ⟨hn,haxis,hpoly⟩:=(nativeSideCoordinates_edge4 k c hk hc z).mp hside
  have hre := hside.1
  have hzre : z.re≠0 := by
    intro he
    apply hne0
    apply Complex.ext
    · exact hre
    · exact (nativeSideCoordinates_im_zero z).mpr he
  have hzpoly : z.re^2+z.im^2-2*c*z.re+k≠0 := by
    intro he
    apply hneb
    apply Complex.ext
    · exact hre
    · have hh:=(nativeSideCoordinates_circle_zero k c hc0 z).mpr he
      simpa only [hre,mul_zero,zero_sub] using hh
  exact ⟨hn.symm ▸ hk,lt_of_le_of_ne haxis hzre.symm,
    lt_of_le_of_ne hpoly hzpoly.symm⟩

end LowDimensionalTopology.Geometry.Fuchsian


