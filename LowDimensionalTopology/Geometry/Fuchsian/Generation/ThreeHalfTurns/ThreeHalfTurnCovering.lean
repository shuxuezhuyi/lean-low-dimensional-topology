/-!
# Polygon covers for three half-turns

Explicit Klein support data and native side coordinates construct quadrilateral
and pentagon models. Their side pairings and orbit covers control compact
fundamental sets, quotient area and covering multiplicity. These geometric facts
supply the small-trace bound for a discrete group generated by three half-turns.
-/

@[expose] public section

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set InnerProductGeometry
open scoped Complex.UnitDisc UpperHalfPlane
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Euclidean LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces

/-- The four literal Klein vertices of the three-half-turn side-circle region. -/
def halfTurnTrapezoidKleinVertices (a b s : ℝ) : Fin 4→ℂ:=
  ![0,(s : ℂ),⟨s,b*s-a⟩,⟨0,-a⟩]

def halfTurnTrapezoidRawNormals (b : ℝ) : Fin 4→ℂ:=
  ![Complex.I,1,⟨b,-1⟩,-1]

def halfTurnTrapezoidRawOffsets (a s : ℝ) : Fin 4→ℝ:=![0,s,a,0]

theorem halfTurnTrapezoid_raw_table (a b s : ℝ) (i j : Fin 4) :
    inner ℝ (halfTurnTrapezoidRawNormals b i) (halfTurnTrapezoidKleinVertices a b s j)-
      halfTurnTrapezoidRawOffsets a s i=
      ![![0,0,b*s-a,-a],![-s,0,0,-s],![-a,b*s-a,0,0],![0,-s,-s,0]] i j := by
  fin_cases i <;> fin_cases j <;>
    norm_num [halfTurnTrapezoidRawNormals,halfTurnTrapezoidRawOffsets,
      halfTurnTrapezoidKleinVertices,_root_.LowDimensionalTopology.Geometry.Euclidean.complex_real_inner_coordinates] <;> ring

theorem halfTurnTrapezoid_raw_normal_ne_zero (b : ℝ) (i : Fin 4) :
    halfTurnTrapezoidRawNormals b i≠0 := by
  fin_cases i
  · exact Complex.I_ne_zero
  · exact one_ne_zero
  · intro he
    have hh:=congrArg Complex.im he
    norm_num [halfTurnTrapezoidRawNormals] at hh
  · exact neg_ne_zero.mpr one_ne_zero

/-- The concrete strict parameter inequalities place every actual vertex in
 the open unit Klein disc. -/
theorem halfTurnTrapezoid_vertices_norm_lt (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (_hs : 0<s) (_hs1 : s<1) (_hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    ‖halfTurnTrapezoidKleinVertices a b s i‖<1 := by
  apply (sq_lt_sq₀ (norm_nonneg _) (by norm_num)).mp
  rw [←Complex.normSq_eq_norm_sq]
  fin_cases i <;> norm_num [halfTurnTrapezoidKleinVertices,Complex.normSq_apply] <;>
    nlinarith only [ha,ha1,_hs,_hs1,_hd,htop]

/-- Pullback through the genuine closed Klein homeomorphism, rather than a
new declared hyperbolic polygon. -/
def halfTurnTrapezoidDiscVertex (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) : 𝕔𝔻:=
  _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinHomeomorph.symm (Complex.UnitClosedDisc.mk (halfTurnTrapezoidKleinVertices a b s i)
    (halfTurnTrapezoid_vertices_norm_lt a b s ha ha1 hs hs1 hd htop i).le)

theorem halfTurnTrapezoidDiscVertex_coordinate (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate (halfTurnTrapezoidDiscVertex a b s ha ha1 hs hs1 hd htop i)=
      halfTurnTrapezoidKleinVertices a b s i :=
  congrArg (fun z : 𝕔𝔻=>(z : ℂ)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinHomeomorph.apply_symm_apply _)

theorem halfTurnTrapezoid_vertices_injective (a b s : ℝ) (ha : 0<a) (hs : 0<s)
    (hd : 0<a-b*s) : Function.Injective (halfTurnTrapezoidKleinVertices a b s) := by
  intro i j he
  have hr:=congrArg Complex.re he
  have hi:=congrArg Complex.im he
  fin_cases i <;> fin_cases j <;>
    norm_num [halfTurnTrapezoidKleinVertices] at hr hi ⊢
  all_goals exfalso;linarith only [hr,hi,ha,hs,hd]

def halfTurnTrapezoidUnitNormal (b : ℝ) (i : Fin 4) : ℂ:=
  ‖halfTurnTrapezoidRawNormals b i‖⁻¹ • halfTurnTrapezoidRawNormals b i

def halfTurnTrapezoidUnitOffset (a b s : ℝ) (i : Fin 4) : ℝ:=
  halfTurnTrapezoidRawOffsets a s i/‖halfTurnTrapezoidRawNormals b i‖

theorem halfTurnTrapezoid_unit_evaluate (a b s : ℝ) (i : Fin 4) (z : ℂ) :
    inner ℝ (halfTurnTrapezoidUnitNormal b i) z-halfTurnTrapezoidUnitOffset a b s i=
      (inner ℝ (halfTurnTrapezoidRawNormals b i) z-halfTurnTrapezoidRawOffsets a s i)/
        ‖halfTurnTrapezoidRawNormals b i‖ := by
  rw [halfTurnTrapezoidUnitNormal,halfTurnTrapezoidUnitOffset,real_inner_smul_left,
    inv_mul_eq_div,sub_div]

/-- The actual normalized support data of the source quadrilateral. Its Jordan
curve, inside, convexity and later area come from proved supporting geometry. -/
def halfTurnTrapezoidSupportData (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) :
    _root_.LowDimensionalTopology.Geometry.Polygon.CyclicDiscPolygonSupportData 4 where
  three_le:=by decide
  vertices:=halfTurnTrapezoidDiscVertex a b s ha ha1 hs hs1 hd htop
  vertices_injective:=by
    intro i j he
    apply halfTurnTrapezoid_vertices_injective a b s ha hs hd
    have h:=congrArg _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate he
    simpa only [halfTurnTrapezoidDiscVertex_coordinate] using h
  normals:=halfTurnTrapezoidUnitNormal b
  normal_norm i:=by
    rw [halfTurnTrapezoidUnitNormal,norm_smul,Real.norm_eq_abs,
      abs_of_pos (inv_pos.mpr (norm_pos_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i))),
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i))]
  offsets:=halfTurnTrapezoidUnitOffset a b s
  incident i:=by
    constructor
    all_goals
      apply sub_eq_zero.mp
      rw [halfTurnTrapezoid_unit_evaluate,halfTurnTrapezoidDiscVertex_coordinate,
        halfTurnTrapezoid_raw_table]
    · fin_cases i <;> norm_num
    · have hr : ∀i : Fin 4,finRotate 4 i=i+1:=by decide
      rw [hr]
      fin_cases i <;> norm_num
  nonincident i j hji hjr:=by
    apply sub_neg.mp
    rw [halfTurnTrapezoid_unit_evaluate,halfTurnTrapezoidDiscVertex_coordinate,
      halfTurnTrapezoid_raw_table]
    apply div_neg_of_neg_of_pos _ (norm_pos_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i))
    have hr : ∀i : Fin 4,finRotate 4 i=i+1:=by decide
    rw [hr] at hjr
    fin_cases i <;> fin_cases j
    all_goals simp_all


/-- Radial-strip and side-circle parameters determine the concrete trapezoid. -/
def halfTurnQuadKleinA (k c : ℝ) : ℝ:=(k+1)/(2*c)
def halfTurnQuadKleinB (k c : ℝ) : ℝ:=(k-1)/(2*c)
def halfTurnQuadKleinS (k : ℝ) : ℝ:=(k^2-1)/(k^2+1)

/-- Every support and finite-vertex inequality is derived from the one
small-parameter condition, not supplied as polygon data at the source entry. -/
theorem halfTurnQuadKlein_parameter_bounds (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    let a:=halfTurnQuadKleinA k c
    let b:=halfTurnQuadKleinB k c
    let s:=halfTurnQuadKleinS k
    0<a ∧ a<1 ∧ 0<s ∧ s<1 ∧ 0<a-b*s ∧ s^2+(b*s-a)^2<1 := by
  have hk0 : 0<k:=by linarith only [hk]
  have hc0 : 0<c:=by linarith only [hk,hc]
  have hden : 0<k^2+1:=by positivity
  let a:=halfTurnQuadKleinA k c
  let b:=halfTurnQuadKleinB k c
  let s:=halfTurnQuadKleinS k
  have ha : 0<a:=by
    dsimp only [a,halfTurnQuadKleinA]
    exact div_pos (by linarith only [hk]) (by positivity)
  have ha1 : a<1:=by
    dsimp only [a,halfTurnQuadKleinA]
    exact (div_lt_one (by positivity)).mpr hc
  have hs : 0<s:=by
    dsimp only [s,halfTurnQuadKleinS]
    exact div_pos (by nlinarith only [hk]) hden
  have hs1 : s<1:=by
    dsimp only [s,halfTurnQuadKleinS]
    exact (div_lt_one hden).mpr (by linarith)
  let f:=2*k/(k^2+1)
  have hf : 0<f:=by dsimp only [f];positivity
  have hsf : s^2+f^2=1:=by
    dsimp only [s,halfTurnQuadKleinS,f]
    field_simp
    ring
  have hd : a-b*s=a*f:=by
    dsimp only [a,b,s,halfTurnQuadKleinA,halfTurnQuadKleinB,halfTurnQuadKleinS,f]
    field_simp
    ring
  have htop : s^2+(b*s-a)^2<1:=by
    have he : b*s-a= -(a*f):=by linarith only [hd]
    rw [he,neg_sq,mul_pow]
    have hsq : a^2<1:=by nlinarith only [ha,ha1]
    have hmul:=mul_lt_mul_of_pos_right hsq (sq_pos_of_pos hf)
    nlinarith only [hmul,hsf]
  exact ⟨ha,ha1,hs,hs1,hd.symm ▸ mul_pos ha hf,htop⟩

/-- The actual convex Jordan support model associated to the source side circle. -/
def halfTurnQuadCanonicalSupport (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    _root_.LowDimensionalTopology.Geometry.Polygon.CyclicDiscPolygonSupportData 4:=
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  halfTurnTrapezoidSupportData (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
    (halfTurnQuadKleinS k) h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2


/-- The actual Lorentz line normals are nonzero multiples of the literal raw
trapezoid support equations. -/
theorem halfTurnTrapezoid_support_raw_normal (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    let S:=halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop
    ∃ t : ℝ,t≠0 ∧
      (S.toCenteredData.supportLine i).incenterNormal=t • halfTurnTrapezoidRawNormals b i ∧
      (S.toCenteredData.supportLine i).incenterOffset=t*halfTurnTrapezoidRawOffsets a s i := by
  let S:=halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop
  obtain ⟨k,hk,hn,ht⟩:=S.toCenteredData.support_normal_proportional i
  have hm : ‖halfTurnTrapezoidRawNormals b i‖≠0:=
    norm_ne_zero_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i)
  refine ⟨k/‖halfTurnTrapezoidRawNormals b i‖,div_ne_zero hk hm,?_,?_⟩
  · rw [hn]
    change k • (‖halfTurnTrapezoidRawNormals b i‖⁻¹ • halfTurnTrapezoidRawNormals b i)=_
    rw [smul_smul,div_eq_mul_inv]
  · rw [ht]
    change k*(halfTurnTrapezoidRawOffsets a s i/‖halfTurnTrapezoidRawNormals b i‖)=_
    ring

/-- The inward sign cancels the arbitrary sign of a genuine side normal. -/
theorem halfTurn_raw_inward_scale (t x : ℝ) (ht : t≠0) (hx : x<0) :
    (t*x)/|t*x| *t= -|t| := by
  rw [abs_mul,abs_of_neg hx]
  field_simp [abs_ne_zero.mpr ht,hx.ne]
  nlinarith only [sq_abs t]

/-- A sign-correct cosine identity for the actual constructed polygon corner.
The normalization factors are proved from its real geodesic lines. -/
theorem halfTurnTrapezoid_corner_cosine_raw (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    let S:=halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop
    let j:=(finRotate 4).symm i
    ∃ u v : ℝ,0<u ∧ 0<v ∧
      u^2*(‖halfTurnTrapezoidRawNormals b i‖^2-(halfTurnTrapezoidRawOffsets a s i)^2)=1 ∧
      v^2*(‖halfTurnTrapezoidRawNormals b j‖^2-(halfTurnTrapezoidRawOffsets a s j)^2)=1 ∧
      Real.cos (S.toDiscPolygon.angle i)= -u*v*
        (inner ℝ (halfTurnTrapezoidRawNormals b i) (halfTurnTrapezoidRawNormals b j)-
          halfTurnTrapezoidRawOffsets a s i*halfTurnTrapezoidRawOffsets a s j) := by
  let S:=halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop
  let j:=(finRotate 4).symm i
  let L:=S.toCenteredData.supportLine i
  let M:=S.toCenteredData.supportLine j
  obtain ⟨u,hu,hLn,hLt⟩:=halfTurnTrapezoid_support_raw_normal a b s ha ha1 hs hs1 hd htop i
  obtain ⟨v,hv,hMn,hMt⟩:=halfTurnTrapezoid_support_raw_normal a b s ha ha1 hs hs1 hd htop j
  change L.incenterNormal=_ at hLn
  change L.incenterOffset=_ at hLt
  change M.incenterNormal=_ at hMn
  change M.incenterOffset=_ at hMt
  have hunitL:=L.toHalfPlane.incenterNormal_lorentz_unit
  have hunitM:=M.toHalfPlane.incenterNormal_lorentz_unit
  change ‖L.incenterNormal‖^2-L.incenterOffset^2=1 at hunitL
  change ‖M.incenterNormal‖^2-M.incenterOffset^2=1 at hunitM
  rw [hLn,hLt,norm_smul,Real.norm_eq_abs,mul_pow,sq_abs,mul_pow] at hunitL
  rw [hMn,hMt,norm_smul,Real.norm_eq_abs,mul_pow,sq_abs,mul_pow] at hunitM
  refine ⟨|u|,|v|,abs_pos.mpr hu,abs_pos.mpr hv,?_,?_,?_⟩
  · rw [sq_abs]
    nlinarith only [hunitL]
  · rw [sq_abs]
    nlinarith only [hunitM]
  · obtain ⟨q,hq⟩:=S.toDiscPolygon.interior_isConnected.nonempty
    have hqi:inner ℝ (S.normals i) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)<S.offsets i:=by
      exact (S.toCenteredData.toDiscPolygon_interior ▸ hq) i
    have hqj:inner ℝ (S.normals j) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)<S.offsets j:=by
      exact (S.toCenteredData.toDiscPolygon_interior ▸ hq) j
    have hpos : 0<((S.toCenteredData.cornerTriangle i).discCoordinate q).1 ∧
        0<((S.toCenteredData.cornerTriangle i).discCoordinate q).2:=⟨(S.toCenteredData.cornerTriangle_outgoing_cut i (_root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel q)).mp hqi,
      (S.toCenteredData.cornerTriangle_incoming_cut i (_root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel q)).mp hqj⟩
    have he:=(S.toCenteredData.cornerTriangle i).inward_normalPairing_cosine_of_positive_coordinates q hpos
    rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.inradiusSign_eq_inwardNormalSign,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.inradiusSign_eq_inwardNormalSign,
      S.toCenteredData.cornerTriangle_sideB,S.toCenteredData.cornerTriangle_sideC] at he
    change L.inradiusSign q*M.inradiusSign q*
      (inner ℝ L.incenterNormal M.incenterNormal-L.incenterOffset*M.incenterOffset)=_ at he
    have hrawi : inner ℝ (halfTurnTrapezoidRawNormals b i) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)-
        halfTurnTrapezoidRawOffsets a s i<0:=by
      have hdiv : (inner ℝ (halfTurnTrapezoidRawNormals b i) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)-
          halfTurnTrapezoidRawOffsets a s i)/‖halfTurnTrapezoidRawNormals b i‖<0:=by
        rw [←halfTurnTrapezoid_unit_evaluate]
        exact sub_neg.mpr hqi
      have hh:=(div_lt_iff₀ (norm_pos_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i))).mp hdiv
      simpa only [zero_mul] using hh
    have hrawj : inner ℝ (halfTurnTrapezoidRawNormals b j) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)-
        halfTurnTrapezoidRawOffsets a s j<0:=by
      have hdiv : (inner ℝ (halfTurnTrapezoidRawNormals b j) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinCoordinate q)-
          halfTurnTrapezoidRawOffsets a s j)/‖halfTurnTrapezoidRawNormals b j‖<0:=by
        rw [←halfTurnTrapezoid_unit_evaluate]
        exact sub_neg.mpr hqj
      have hh:=(div_lt_iff₀ (norm_pos_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b j))).mp hdiv
      simpa only [zero_mul] using hh
    have hsignL : L.inradiusSign q*u= -|u|:=by
      dsimp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.inradiusSign,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedDiscKleinAffine]
      rw [hLn,hLt,real_inner_smul_left,←mul_sub]
      exact halfTurn_raw_inward_scale u _ hu hrawi
    have hsignM : M.inradiusSign q*v= -|v|:=by
      dsimp only [_root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscLine.inradiusSign,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedDiscKleinAffine]
      rw [hMn,hMt,real_inner_smul_left,←mul_sub]
      exact halfTurn_raw_inward_scale v _ hv hrawj
    rw [hLn,hMn,hLt,hMt,real_inner_smul_left,real_inner_smul_right] at he
    rw [S.toDiscPolygon_angle]
    calc
      Real.cos (S.toCenteredData.cornerTriangle i).alpha=
          -(L.inradiusSign q*u)*(M.inradiusSign q*v)*
            (inner ℝ (halfTurnTrapezoidRawNormals b i) (halfTurnTrapezoidRawNormals b j)-
              halfTurnTrapezoidRawOffsets a s i*halfTurnTrapezoidRawOffsets a s j):=by
        nlinarith only [he]
      _= -|u| * |v| * _:=by rw [hsignL,hsignM];ring


/-- Literal Lorentz lengths of all four true raw support equations. -/
theorem halfTurnTrapezoid_raw_lorentz_lengths (a b s : ℝ) (i : Fin 4) :
    ‖halfTurnTrapezoidRawNormals b i‖^2-(halfTurnTrapezoidRawOffsets a s i)^2=
      ![1,1-s^2,b^2+1-a^2,1] i := by
  fin_cases i <;> norm_num [halfTurnTrapezoidRawNormals,halfTurnTrapezoidRawOffsets,
    ←Complex.normSq_eq_norm_sq,Complex.normSq_apply]; ring

/-- The exact adjacent raw pairings, including their genuine outward signs. -/
theorem halfTurnTrapezoid_raw_adjacent_pairings (a b s : ℝ) (i : Fin 4) :
    let j:=(finRotate 4).symm i
    inner ℝ (halfTurnTrapezoidRawNormals b i) (halfTurnTrapezoidRawNormals b j)-
      halfTurnTrapezoidRawOffsets a s i*halfTurnTrapezoidRawOffsets a s j=
      ![0,0,b-a*s,-b] i := by
  have hj : ∀i : Fin 4,(finRotate 4).symm i=i-1:=by decide
  dsimp only
  rw [hj]
  fin_cases i <;> norm_num [halfTurnTrapezoidRawNormals,halfTurnTrapezoidRawOffsets,
    _root_.LowDimensionalTopology.Geometry.Euclidean.complex_real_inner_coordinates]

theorem halfTurn_positive_normalization_factor (u D : ℝ) (hu : 0<u) (hD : 0<D)
    (hunit : u^2*D=1) : u=1/Real.sqrt D := by
  have hs : 0<Real.sqrt D:=Real.sqrt_pos.mpr hD
  have he : (u*Real.sqrt D)^2=1:=by rw [mul_pow,Real.sq_sqrt hD.le];exact hunit
  have hp : 0<u*Real.sqrt D:=mul_pos hu hs
  apply (eq_div_iff hs.ne').mpr
  nlinarith only [he,hp]

/-- All four numerical cosines are derived from the actual polygon angles. -/
theorem halfTurnTrapezoid_corner_cosines (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    let S:=halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop
    Real.cos (S.toDiscPolygon.angle i)=
      ![0,0,(a*s-b)/(Real.sqrt (b^2+1-a^2)*Real.sqrt (1-s^2)),b/Real.sqrt (b^2+1-a^2)] i := by
  obtain ⟨u,v,hu,hv,huN,hvN,hcos⟩:=
    halfTurnTrapezoid_corner_cosine_raw a b s ha ha1 hs hs1 hd htop i
  simp_rw [halfTurnTrapezoid_raw_lorentz_lengths] at huN hvN
  rw [halfTurnTrapezoid_raw_adjacent_pairings] at hcos
  have hj : ∀i : Fin 4,(finRotate 4).symm i=i-1:=by decide
  rw [hj] at hvN
  have hD : 0<b^2+1-a^2:=by nlinarith only [sq_nonneg b,ha,ha1]
  have hS : 0<1-s^2:=by nlinarith only [hs,hs1]
  fin_cases i <;> norm_num at huN hvN hcos ⊢
  · exact hcos
  · exact hcos
  · rw [halfTurn_positive_normalization_factor u _ hu hD huN,
      halfTurn_positive_normalization_factor v _ hv hS hvN] at hcos
    calc
      _= -(1/Real.sqrt (b^2+1-a^2)*(1/Real.sqrt (1-s^2))*(b-a*s)):=hcos
      _=_:=by ring
  · have hu1 : u=1:=by rcases huN with h|h;exact h;linarith only [h,hu]
    rw [hu1,halfTurn_positive_normalization_factor v _ hv hD hvN] at hcos
    calc
      _= 1*(1/Real.sqrt (b^2+1-a^2))*b:=hcos
      _=_:=by ring

theorem halfTurnTrapezoid_angle_mem_Ico (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (i : Fin 4) :
    (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.angle i∈
      Ico (0 : ℝ) Real.pi := by
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.CyclicDiscPolygonSupportData.toDiscPolygon_angle]
  exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedDiscTriangle.alpha_mem_Ico _

/-- The two base corners of the actual source quadrilateral are genuinely right. -/
theorem halfTurnTrapezoid_base_angles (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) :
    let P:=(halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon
    P.angle 0=Real.pi/2 ∧ P.angle 1=Real.pi/2 := by
  have both (i : Fin 4) (hi : i=0 ∨ i=1) :
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.angle i=Real.pi/2:=by
    have hcos:=halfTurnTrapezoid_corner_cosines a b s ha ha1 hs hs1 hd htop i
    have hangle:=halfTurnTrapezoid_angle_mem_Ico a b s ha ha1 hs hs1 hd htop i
    apply Real.strictAntiOn_cos.injOn ⟨hangle.1,hangle.2.le⟩
      ⟨by positivity,by linarith only [Real.pi_pos]⟩
    rw [Real.cos_pi_div_two]
    rcases hi with rfl|rfl <;> simpa using hcos
  exact ⟨both 0 (Or.inl rfl),both 1 (Or.inr rfl)⟩


/-- The two nonright angles of the actual compact source quadrilateral coincide. -/
theorem halfTurnQuadCanonical_angles (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    let P:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
    let lam:=halfTurnQuadKleinB k c /
      Real.sqrt ((halfTurnQuadKleinB k c)^2+1-(halfTurnQuadKleinA k c)^2)
    0<lam ∧ lam<1 ∧
      P.angle 0=Real.pi/2 ∧ P.angle 1=Real.pi/2 ∧
      P.angle 2=Real.arccos lam ∧ P.angle 3=Real.arccos lam := by
  let a:=halfTurnQuadKleinA k c
  let b:=halfTurnQuadKleinB k c
  let s:=halfTurnQuadKleinS k
  let D:=b^2+1-a^2
  let f:=2*k/(k^2+1)
  have hbnds:=halfTurnQuadKlein_parameter_bounds k c hk hc
  rcases hbnds with ⟨ha,ha1,hs,hs1,hd,htop⟩
  have hk0 : 0<k:=by linarith only [hk]
  have hc0 : 0<c:=by linarith only [hk,hc]
  have hb : 0<b:=by dsimp only [b,halfTurnQuadKleinB];positivity
  have hD : 0<D:=by dsimp only [D];nlinarith only [sq_nonneg b,ha,ha1]
  have hf : 0<f:=by dsimp only [f];positivity
  have hsf : 1-s^2=f^2:=by
    dsimp only [s,halfTurnQuadKleinS,f]
    field_simp
    ring
  have hroot : Real.sqrt (1-s^2)=f:=by
    rw [hsf,Real.sqrt_sq hf.le]
  have hrel : a*s-b=f*b:=by
    dsimp only [a,b,s,f,halfTurnQuadKleinA,halfTurnQuadKleinB,halfTurnQuadKleinS]
    field_simp
    ring
  have hrootD : 0<Real.sqrt D:=Real.sqrt_pos.mpr hD
  have hblt : b<Real.sqrt D:=by
    have hh:=Real.sq_sqrt hD.le
    dsimp only [D] at hh
    nlinarith only [hh,ha,ha1,hb,hrootD]
  have hlam0 : 0<b/Real.sqrt D:=div_pos hb hrootD
  have hlam1 : b/Real.sqrt D<1:=(div_lt_one hrootD).mpr hblt
  have hbase:=halfTurnTrapezoid_base_angles a b s ha ha1 hs hs1 hd htop
  have htwo:=halfTurnTrapezoid_corner_cosines a b s ha ha1 hs hs1 hd htop 2
  have hthree:=halfTurnTrapezoid_corner_cosines a b s ha ha1 hs hs1 hd htop 3
  norm_num only [Matrix.cons_val_zero',Matrix.cons_val_succ'] at htwo hthree
  rw [hroot,hrel] at htwo
  have hratio : f*b/(Real.sqrt D*f)=b/Real.sqrt D:=by field_simp
  change _=f*b/(Real.sqrt D*f) at htwo
  rw [hratio] at htwo
  have hang (i : Fin 4) (hcos :
      Real.cos ((halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.angle i)=b/Real.sqrt D) :
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.angle i=
        Real.arccos (b/Real.sqrt D):=by
    have hangle:=halfTurnTrapezoid_angle_mem_Ico a b s ha ha1 hs hs1 hd htop i
    rw [←hcos,Real.arccos_cos hangle.1 hangle.2.le]
  exact ⟨hlam0,hlam1,hbase.1,hbase.2,hang 2 htwo,hang 3 hthree⟩

/-- The area is the integral of the actual hyperbolic density on the polygon. -/
theorem halfTurnQuadCanonical_area (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    let P:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
    let lam:=halfTurnQuadKleinB k c /
      Real.sqrt ((halfTurnQuadKleinB k c)^2+1-(halfTurnQuadKleinA k c)^2)
    P.area.toReal=Real.pi-2*Real.arccos lam := by
  obtain ⟨_,_,h0,h1,h2,h3⟩:=halfTurnQuadCanonical_angles k c hk hc
  dsimp only
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon.area_toReal_eq_original_angle_defect]
  rw [Fin.sum_univ_four,h0,h1,h2,h3]
  norm_num
  ring


/-- Membership in the actual Klein support body is exactly the four literal
linear inequalities, including every boundary point. -/
theorem halfTurnTrapezoid_mem_kleinRegion (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (z : ℂ) :
    z∈(halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toCenteredData.kleinRegion ↔
      z.im≤0 ∧ z.re≤ s ∧ b*z.re-z.im≤a ∧ 0≤z.re := by
  change (∀i : Fin 4,inner ℝ (halfTurnTrapezoidUnitNormal b i) z≤
    halfTurnTrapezoidUnitOffset a b s i)↔_
  have he (i : Fin 4) : inner ℝ (halfTurnTrapezoidUnitNormal b i) z≤
      halfTurnTrapezoidUnitOffset a b s i ↔
      inner ℝ (halfTurnTrapezoidRawNormals b i) z≤halfTurnTrapezoidRawOffsets a s i:=by
    rw [←sub_nonpos,halfTurnTrapezoid_unit_evaluate]
    rw [div_le_iff₀ (norm_pos_iff.mpr (halfTurnTrapezoid_raw_normal_ne_zero b i)),zero_mul]
    exact sub_nonpos
  simp_rw [he]
  rw [Fin.forall_fin_succ]
  simp only [Fin.forall_fin_succ]
  norm_num [halfTurnTrapezoidRawNormals,halfTurnTrapezoidRawOffsets,
    _root_.LowDimensionalTopology.Geometry.Euclidean.complex_real_inner_coordinates,mul_comm]

/-- The previously constructed support body is genuinely the closed polygon,
not merely a set used to name it. -/
theorem halfTurnTrapezoid_closedCarrier_iff (a b s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1) (z : 𝕔𝔻) :
    z∈(halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.closedCarrier ↔
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate z).im≤0 ∧ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate z).re≤ s ∧
        b*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate z).re-(_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate z).im≤a ∧
        0≤(_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate z).re := by
  rw [←halfTurnTrapezoid_mem_kleinRegion a b s ha ha1 hs hs1 hd htop]
  rw [←_root_.LowDimensionalTopology.Geometry.Polygon.CenteredDiscPolygonSupportData.closedModelClosure_image]
  constructor
  · exact fun hz=>mem_image_of_mem _ hz
  · rintro ⟨y,hy,he⟩
    exact _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_injective he ▸ hy

/-- The actual native Klein coordinate sends the radial/circular quadrilateral
precisely to this support body. -/
theorem halfTurnQuadKlein_native_inequalities (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    K.im≤0 ∧ K.re≤halfTurnQuadKleinS k ∧
      halfTurnQuadKleinB k c*K.re-K.im≤halfTurnQuadKleinA k c ∧ 0≤K.re ↔
      1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*c*z.re+k := by
  have hk0 : 0<k:=by linarith only [hk]
  have hc0 : 0<c:=by linarith only [hk,hc]
  have hN : 0<z.re^2+z.im^2+1:=by positivity
  have hkden : 0<k^2+1:=by positivity
  have hn : ‖(z : ℂ)‖^2=z.re^2+z.im^2:=by
    rw [←Complex.normSq_eq_norm_sq,Complex.normSq_apply]
    simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,pow_two]
  have haxis : (-2*z.re)/(z.re^2+z.im^2+1)≤0 ↔ 0≤z.re:=by
    rw [div_le_iff₀ hN,zero_mul]
    constructor <;> intro hh <;> linarith only [hh]
  have hrad0 : 0≤(z.re^2+z.im^2-1)/(z.re^2+z.im^2+1) ↔ 1≤‖(z : ℂ)‖:=by
    rw [le_div_iff₀ hN]
    constructor
    · intro hh
      have hh' : 1≤‖(z : ℂ)‖^2:=by nlinarith only [hh,hn]
      nlinarith only [hh',norm_nonneg (z : ℂ)]
    · intro hh
      nlinarith only [hh,hn]
  have hrad1 : (z.re^2+z.im^2-1)/(z.re^2+z.im^2+1)≤halfTurnQuadKleinS k ↔
      ‖(z : ℂ)‖≤k:=by
    rw [halfTurnQuadKleinS,div_le_div_iff₀ hN hkden]
    constructor
    · intro hh
      have hh' : ‖(z : ℂ)‖^2≤k^2:=by nlinarith only [hh,hn]
      nlinarith only [hh',norm_nonneg (z : ℂ),hk0]
    · intro hh
      have hh' : ‖(z : ℂ)‖^2≤k^2:=sq_le_sq₀ (norm_nonneg _) hk0.le |>.mpr hh
      nlinarith only [hh',hn]
  have hcircle : halfTurnQuadKleinB k c*((z.re^2+z.im^2-1)/(z.re^2+z.im^2+1))-
      (-2*z.re)/(z.re^2+z.im^2+1)≤halfTurnQuadKleinA k c ↔
      0≤z.re^2+z.im^2-2*c*z.re+k:=by
    rw [←sub_nonneg]
    have he : halfTurnQuadKleinA k c-
        (halfTurnQuadKleinB k c*((z.re^2+z.im^2-1)/(z.re^2+z.im^2+1))-
          (-2*z.re)/(z.re^2+z.im^2+1))=
        (z.re^2+z.im^2-2*c*z.re+k)/(c*(z.re^2+z.im^2+1)):=by
      rw [halfTurnQuadKleinA,halfTurnQuadKleinB]
      field_simp
      ring
    rw [he,le_div_iff₀ (mul_pos hc0 hN),zero_mul]
  dsimp only
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (-2*z.re)/(z.re^2+z.im^2+1)≤0 ∧
    (z.re^2+z.im^2-1)/(z.re^2+z.im^2+1)≤halfTurnQuadKleinS k ∧
    halfTurnQuadKleinB k c*((z.re^2+z.im^2-1)/(z.re^2+z.im^2+1))-
      (-2*z.re)/(z.re^2+z.im^2+1)≤halfTurnQuadKleinA k c ∧
    0≤(z.re^2+z.im^2-1)/(z.re^2+z.im^2+1) ↔ _
  rw [haxis,hrad0,hrad1,hcircle]
  tauto


/-- The concrete native radial/circular region equals the actual closed polygon. -/
theorem halfTurnQuadCanonical_native_closedCarrier (k c : ℝ) (hk : 1<k)
    (hc : k+1<2*c) (z : ℍ) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)∈
        (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.closedCarrier ↔
      1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*c*z.re+k := by
  dsimp only [halfTurnQuadCanonicalSupport]
  rw [halfTurnTrapezoid_closedCarrier_iff,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion]
  exact halfTurnQuadKlein_native_inequalities k c hk hc z

/-- The true summit cosine recovers the genuine normalized half-turn trace
parameter after the radial normalization of the original three centers. -/
theorem halfTurnQuadCanonical_cosine_trace (t x y : ℝ) (ht : 1<t)
    (hx : 0<x) (hy : 0<y) (hn : x^2+y^2=t^2) :
    halfTurnQuadKleinB (t^2) (t^2/x) /
      Real.sqrt ((halfTurnQuadKleinB (t^2) (t^2/x))^2+1-
        (halfTurnQuadKleinA (t^2) (t^2/x))^2)=
      (t-1/t)*x/(2*y) := by
  have ht0 : 0<t:=by linarith only [ht]
  have htne : t≠0:=ht0.ne'
  have hxne : x≠0:=hx.ne'
  have hD : (halfTurnQuadKleinB (t^2) (t^2/x))^2+1-
      (halfTurnQuadKleinA (t^2) (t^2/x))^2=(y/t)^2:=by
    rw [halfTurnQuadKleinA,halfTurnQuadKleinB]
    field_simp
    nlinarith only [hn,mul_nonneg (sq_nonneg t) (sq_nonneg t)]
  rw [hD,Real.sqrt_sq (div_pos hy ht0).le,halfTurnQuadKleinB]
  field_simp

end LowDimensionalTopology.Geometry.Fuchsian

namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Euclidean LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces

/-- The actual five raw vertices obtained by subdividing the horizontal edge. -/
def kleinSubdivisionVertices5 (a b r s : ℝ) : Fin 5 → ℂ :=
  ![0,(r : ℂ),(s : ℂ),⟨s,b*s-a⟩,⟨0,-a⟩]

/-- The original four actual raw vertices. -/
def kleinSubdivisionVertices4 (a b s : ℝ) : Fin 4 → ℂ :=
  ![0,(s : ℂ),⟨s,b*s-a⟩,⟨0,-a⟩]

def kleinSubdivisionEdge {n : ℕ} (v : Fin n → ℂ) (i : Fin n) : Set ℂ :=
  segment ℝ (v i) (v (finRotate n i))

def kleinSubdivisionBoundary {n : ℕ} (v : Fin n → ℂ) : Set ℂ :=
  ⋃ i,kleinSubdivisionEdge v i

theorem kleinSubdivisionHorizontal_mem (x y : ℝ) (hxy : x<y) (z : ℂ) :
    z∈segment ℝ (x : ℂ) (y : ℂ) ↔ z.im=0 ∧ z.re∈Icc x y := by
  constructor
  · rintro ⟨u,v,hu,hv,huv,he⟩
    have hre:=congrArg Complex.re he
    have him:=congrArg Complex.im he
    simp only [Complex.add_re,Complex.add_im,Complex.smul_re,Complex.smul_im,
      Complex.ofReal_re,Complex.ofReal_im,smul_eq_mul,mul_zero,add_zero] at hre him
    refine ⟨him.symm,?_,?_⟩
    · calc
        x = u*x+v*x := by rw [←add_mul,huv,one_mul]
        _ ≤ u*x+v*y := add_le_add le_rfl (mul_le_mul_of_nonneg_left hxy.le hv)
        _ = z.re := hre
    · calc
        z.re = u*x+v*y := hre.symm
        _ ≤ u*y+v*y := add_le_add (mul_le_mul_of_nonneg_left hxy.le hu) le_rfl
        _ = y := by rw [←add_mul,huv,one_mul]
  · rintro ⟨hi,hx,hy⟩
    refine ⟨(y-z.re)/(y-x),(z.re-x)/(y-x),
      div_nonneg (by linarith) (by linarith),
      div_nonneg (by linarith) (by linarith),?_,?_⟩
    · field_simp [ne_of_gt (sub_pos.mpr hxy)]
      ring
    · apply Complex.ext
      · simp only [Complex.add_re,Complex.smul_re,Complex.ofReal_re,smul_eq_mul]
        field_simp [ne_of_gt (sub_pos.mpr hxy)]
        ring
      · simp only [Complex.add_im,Complex.smul_im,Complex.ofReal_im,smul_eq_mul,
          mul_zero,add_zero,hi]

theorem kleinSubdivisionVertical_mem (x y t : ℝ) (hyt : y<t) (z : ℂ) :
    z∈segment ℝ (⟨x,y⟩ : ℂ) (⟨x,t⟩ : ℂ) ↔ z.re=x ∧ z.im∈Icc y t := by
  constructor
  · rintro ⟨u,v,hu,hv,huv,he⟩
    have hre:=congrArg Complex.re he
    have him:=congrArg Complex.im he
    simp only [Complex.add_re,Complex.add_im,Complex.smul_re,Complex.smul_im,smul_eq_mul] at hre him
    refine ⟨?_,?_,?_⟩
    · rw [←add_mul,huv,one_mul] at hre
      exact hre.symm
    · calc
        y = u*y+v*y := by rw [←add_mul,huv,one_mul]
        _ ≤ u*y+v*t := add_le_add le_rfl (mul_le_mul_of_nonneg_left hyt.le hv)
        _ = z.im := him
    · calc
        z.im = u*y+v*t := him.symm
        _ ≤ u*t+v*t := add_le_add (mul_le_mul_of_nonneg_left hyt.le hu) le_rfl
        _ = t := by rw [←add_mul,huv,one_mul]
  · rintro ⟨hr,hy,ht⟩
    refine ⟨(t-z.im)/(t-y),(z.im-y)/(t-y),
      div_nonneg (by linarith) (by linarith),
      div_nonneg (by linarith) (by linarith),?_,?_⟩
    · field_simp [ne_of_gt (sub_pos.mpr hyt)]
      ring
    · apply Complex.ext
      · simp only [Complex.add_re,Complex.smul_re,smul_eq_mul]
        rw [hr]
        field_simp [ne_of_gt (sub_pos.mpr hyt)]
        ring
      · simp only [Complex.add_im,Complex.smul_im,smul_eq_mul]
        field_simp [ne_of_gt (sub_pos.mpr hyt)]
        ring

theorem kleinSubdivisionTop_mem (a b s : ℝ) (hs : 0<s) (z : ℂ) :
    z∈segment ℝ (⟨0,-a⟩ : ℂ) (⟨s,b*s-a⟩ : ℂ) ↔
      z.re∈Icc 0 s ∧ z.im=b*z.re-a := by
  constructor
  · rintro ⟨u,v,hu,hv,huv,he⟩
    have hre:=congrArg Complex.re he
    have him:=congrArg Complex.im he
    simp only [Complex.add_re,Complex.add_im,Complex.smul_re,Complex.smul_im,smul_eq_mul,
      mul_zero,zero_add] at hre him
    refine ⟨⟨?_,?_⟩,?_⟩
    · nlinarith
    · nlinarith
    · rw [←hre,←him]
      have hu1 : u=1-v := by linarith only [huv]
      rw [hu1]
      ring
  · rintro ⟨⟨hr0,hrs⟩,hi⟩
    refine ⟨1-z.re/s,z.re/s,?_,div_nonneg hr0 hs.le,?_,?_⟩
    · exact sub_nonneg.mpr ((div_le_one hs).mpr hrs)
    · ring
    · apply Complex.ext
      · simp only [Complex.add_re,Complex.smul_re,smul_eq_mul,mul_zero,zero_add]
        field_simp [hs.ne']
      · simp only [Complex.add_im,Complex.smul_im,smul_eq_mul]
        rw [hi]
        field_simp [hs.ne']
        ring

theorem kleinSubdivisionTop_below (a b s x : ℝ) (ha : 0<a)
    (hd : 0<a-b*s) (hx : x∈Icc 0 s) : b*x-a<0 := by
  by_cases hb : 0≤b
  · have hm:=mul_le_mul_of_nonneg_left hx.2 hb
    linarith
  · have hm:=mul_nonpos_of_nonpos_of_nonneg (le_of_not_ge hb) hx.1
    linarith

def kleinSubdivisionEdgeCondition5 (a b r s : ℝ) (z : ℂ) : Fin 5 → Prop :=
  ![z.im=0 ∧ z.re∈Icc 0 r,
    z.im=0 ∧ z.re∈Icc r s,
    z.re=s ∧ z.im∈Icc (b*s-a) 0,
    z.re∈Icc 0 s ∧ z.im=b*z.re-a,
    z.re=0 ∧ z.im∈Icc (-a) 0]

theorem kleinSubdivisionEdge5_mem (a b r s : ℝ) (hr : 0<r) (hrs : r<s)
    (ha : 0<a) (hd : 0<a-b*s) (z : ℂ) (i : Fin 5) :
    z∈kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) i ↔
      kleinSubdivisionEdgeCondition5 a b r s z i := by
  have hs : 0<s := hr.trans hrs
  fin_cases i
  · simpa [kleinSubdivisionEdge,kleinSubdivisionVertices5,finRotate_apply,
      kleinSubdivisionEdgeCondition5] using kleinSubdivisionHorizontal_mem 0 r hr z
  · simpa [kleinSubdivisionEdge,kleinSubdivisionVertices5,finRotate_apply,
      kleinSubdivisionEdgeCondition5] using kleinSubdivisionHorizontal_mem r s hrs z
  · change z∈segment ℝ (s : ℂ) (⟨s,b*s-a⟩ : ℂ) ↔
      z.re=s ∧ z.im∈Icc (b*s-a) 0
    rw [segment_symm]
    exact kleinSubdivisionVertical_mem s (b*s-a) 0 (by linarith) z
  · simpa [kleinSubdivisionEdge,kleinSubdivisionVertices5,finRotate_apply,
      kleinSubdivisionEdgeCondition5,segment_symm ℝ (⟨s,b*s-a⟩ : ℂ) (⟨0,-a⟩ : ℂ)]
      using kleinSubdivisionTop_mem a b s hs z
  · change z∈segment ℝ (⟨0,-a⟩ : ℂ) (⟨0,0⟩ : ℂ) ↔
      z.re=0 ∧ z.im∈Icc (-a) 0
    exact kleinSubdivisionVertical_mem 0 (-a) 0 (by linarith) z

theorem kleinSubdivisionVertices5_injective (a b r s : ℝ) (hr : 0<r)
    (hrs : r<s) (ha : 0<a) (hd : 0<a-b*s) :
    Function.Injective (kleinSubdivisionVertices5 a b r s) := by
  intro i j he
  have hre:=congrArg Complex.re he
  have him:=congrArg Complex.im he
  fin_cases i <;> fin_cases j <;>
    norm_num [kleinSubdivisionVertices5] at hre him ⊢
  all_goals exfalso;linarith only [hre,him,hr,hrs,ha,hd]

theorem kleinSubdivisionEdge5_inter_left_endpoints (a b r s : ℝ) (hr : 0<r)
    (hrs : r<s) (ha : 0<a) (hd : 0<a-b*s) (i j : Fin 5) (hij : i≠j) :
    kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) i ∩
      kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) j ⊆
      {kleinSubdivisionVertices5 a b r s i,
        kleinSubdivisionVertices5 a b r s (finRotate 5 i)} := by
  intro z hz
  have hi:=(kleinSubdivisionEdge5_mem a b r s hr hrs ha hd z i).mp hz.1
  have hj:=(kleinSubdivisionEdge5_mem a b r s hr hrs ha hd z j).mp hz.2
  have ht : z.re∈Icc 0 s → z.im=b*z.re-a → z.im<0 := by
    intro hx he
    rw [he]
    exact kleinSubdivisionTop_below a b s z.re ha hd hx
  fin_cases i <;> fin_cases j <;> try exact (hij rfl).elim
  all_goals norm_num [kleinSubdivisionEdgeCondition5,kleinSubdivisionVertices5,
    finRotate_apply,Complex.ext_iff] at hi hj ⊢
  all_goals rcases hi with ⟨hi1,hi2⟩;rcases hj with ⟨hj1,hj2⟩
  all_goals first
    | (have hlt:=ht hj1 hj2;linarith)
    | (have hlt:=ht hi1 hi2;linarith)
    | (exfalso;linarith)
    | (left;constructor <;> nlinarith)
    | (right;constructor <;> nlinarith)

theorem kleinSubdivisionVertices5_simple_edges (a b r s : ℝ) (hr : 0<r)
    (hrs : r<s) (ha : 0<a) (hd : 0<a-b*s) (i j : Fin 5) (hij : i≠j) :
    kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) i ∩
      kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) j ⊆
      {kleinSubdivisionVertices5 a b r s i,
        kleinSubdivisionVertices5 a b r s (finRotate 5 i)} ∩
      {kleinSubdivisionVertices5 a b r s j,
        kleinSubdivisionVertices5 a b r s (finRotate 5 j)} := by
  intro z hz
  exact ⟨kleinSubdivisionEdge5_inter_left_endpoints a b r s hr hrs ha hd i j hij hz,
    kleinSubdivisionEdge5_inter_left_endpoints a b r s hr hrs ha hd j i hij.symm ⟨hz.2,hz.1⟩⟩

theorem kleinSubdivisionEdge4_mem (a b s : ℝ) (hs : 0<s)
    (ha : 0<a) (hd : 0<a-b*s) (z : ℂ) (i : Fin 4) :
    z∈kleinSubdivisionEdge (kleinSubdivisionVertices4 a b s) i ↔
      ![z.im=0 ∧ z.re∈Icc 0 s,
        z.re=s ∧ z.im∈Icc (b*s-a) 0,
        z.re∈Icc 0 s ∧ z.im=b*z.re-a,
        z.re=0 ∧ z.im∈Icc (-a) 0] i := by
  fin_cases i
  · simpa [kleinSubdivisionEdge,kleinSubdivisionVertices4,finRotate_apply]
      using kleinSubdivisionHorizontal_mem 0 s hs z
  · change z∈segment ℝ (s : ℂ) (⟨s,b*s-a⟩ : ℂ) ↔
      z.re=s ∧ z.im∈Icc (b*s-a) 0
    rw [segment_symm]
    exact kleinSubdivisionVertical_mem s (b*s-a) 0 (by linarith) z
  · simpa [kleinSubdivisionEdge,kleinSubdivisionVertices4,finRotate_apply,
      segment_symm ℝ (⟨s,b*s-a⟩ : ℂ) (⟨0,-a⟩ : ℂ)]
      using kleinSubdivisionTop_mem a b s hs z
  · change z∈segment ℝ (⟨0,-a⟩ : ℂ) (⟨0,0⟩ : ℂ) ↔
      z.re=0 ∧ z.im∈Icc (-a) 0
    exact kleinSubdivisionVertical_mem 0 (-a) 0 (by linarith) z

/-- Subdivision changes the cyclic presentation and preserves the entire actual boundary. -/
theorem kleinSubdivisionBoundary_eq (a b r s : ℝ) (hr : 0<r) (hrs : r<s)
    (ha : 0<a) (hd : 0<a-b*s) :
    kleinSubdivisionBoundary (kleinSubdivisionVertices5 a b r s)=
      kleinSubdivisionBoundary (kleinSubdivisionVertices4 a b s) := by
  have hs : 0<s := hr.trans hrs
  ext z
  simp only [kleinSubdivisionBoundary,mem_iUnion,
    kleinSubdivisionEdge5_mem a b r s hr hrs ha hd,
    kleinSubdivisionEdge4_mem a b s hs ha hd]
  simp only [Fin.exists_fin_succ,kleinSubdivisionEdgeCondition5,
    Matrix.cons_val_zero,Matrix.cons_val_fin_one,
    Matrix.cons_val_succ,Fin.exists_fin_zero]
  constructor
  · rintro (⟨hi,hx,hy⟩ | ⟨hi,hx,hy⟩ | h | h | h)
    · exact Or.inl ⟨hi,hx,hy.trans hrs.le⟩
    · exact Or.inl ⟨hi,hr.le.trans hx,hy⟩
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h))
  · rintro (⟨hi,hx,hy⟩ | h | h | h)
    · by_cases hxr : z.re≤r
      · exact Or.inl ⟨hi,hx,hxr⟩
      · exact Or.inr (Or.inl ⟨hi,(le_of_not_ge hxr),hy⟩)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr h)))

/-- Nonadjacent cyclic sides are genuinely disjoint subsets of the Euclidean plane. -/
theorem kleinSubdivisionEdges5_disjoint (a b r s : ℝ) (hr : 0<r)
    (hrs : r<s) (ha : 0<a) (hd : 0<a-b*s) (i j : Fin 5) (hij : i≠j)
    (hinj : finRotate 5 i≠j) (hjni : finRotate 5 j≠i) :
    Disjoint (kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) i)
      (kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) j) := by
  apply Set.disjoint_left.mpr
  intro z hi hj
  have hh:=kleinSubdivisionVertices5_simple_edges a b r s hr hrs ha hd i j hij ⟨hi,hj⟩
  simp only [mem_inter_iff,mem_insert_iff,mem_singleton_iff] at hh
  have hinjv:=kleinSubdivisionVertices5_injective a b r s hr hrs ha hd
  rcases hh.1 with hzi | hzi <;> rcases hh.2 with hzj | hzj
  · exact hij (hinjv (hzi.symm.trans hzj))
  · exact hjni ((hinjv (hzi.symm.trans hzj)).symm)
  · exact hinj (hinjv (hzi.symm.trans hzj))
  · exact hij ((finRotate 5).injective (hinjv (hzi.symm.trans hzj)))

end LowDimensionalTopology.Geometry.Fuchsian


namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Euclidean LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces

/-- Every genuine raw vertex remains finite after the actual closed Klein inverse. -/
theorem halfTurn_closedKlein_finite (p : 𝕔𝔻) (h : ‖_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate p‖<1) :
    ‖(p : ℂ)‖<1 := by
  by_contra hn
  have he : ‖(p : ℂ)‖=1:=le_antisymm p.norm_le_one (le_of_not_gt hn)
  have hk : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate p=(p : ℂ):=_root_.LowDimensionalTopology.Geometry.Hyperbolic.kleinFormula_norm_one he
  rw [hk,he] at h
  exact (lt_irrefl (1 : ℝ)) h

theorem halfTurnRefined_raw_norm_lt (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) (i : Fin 5) : ‖kleinSubdivisionVertices5 a b r s i‖<1 := by
  fin_cases i
  · norm_num [kleinSubdivisionVertices5]
  · have hr1 : r<1:=hrs.trans hs1
    simpa [kleinSubdivisionVertices5,abs_of_pos hr] using hr1
  · simpa [kleinSubdivisionVertices5,halfTurnTrapezoidKleinVertices] using
      halfTurnTrapezoid_vertices_norm_lt a b s ha ha1 hs hs1 hd htop 1
  · simpa [kleinSubdivisionVertices5,halfTurnTrapezoidKleinVertices] using
      halfTurnTrapezoid_vertices_norm_lt a b s ha ha1 hs hs1 hd htop 2
  · simpa [kleinSubdivisionVertices5,halfTurnTrapezoidKleinVertices] using
      halfTurnTrapezoid_vertices_norm_lt a b s ha ha1 hs hs1 hd htop 3

def halfTurnRefinedDiscVertex (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) (i : Fin 5) : 𝕔𝔻:=
  _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinHomeomorph.symm (Complex.UnitClosedDisc.mk (kleinSubdivisionVertices5 a b r s i)
    (halfTurnRefined_raw_norm_lt a b r s ha ha1 hs hs1 hd htop hr hrs i).le)

theorem halfTurnRefinedDiscVertex_coordinate (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) (i : Fin 5) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate (halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs i)=
      kleinSubdivisionVertices5 a b r s i :=
  congrArg (fun z : 𝕔𝔻=>(z : ℂ)) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinHomeomorph.apply_symm_apply _)

/-- The actual five-side boundary is the unchanged true four-corner Jordan curve. -/
theorem halfTurnRefinedDiscVertex_boundary (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) :
    _root_.LowDimensionalTopology.Geometry.Polygon.discPolygonBoundary (halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs)=
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.boundary := by
  apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_injective.image_injective
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate '' (⋃i,_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonEdge _ i)=
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate '' (⋃i,_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonEdge _ i)
  rw [image_iUnion,image_iUnion]
  simp_rw [_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonEdge,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKlein_image_closedModelDiscHSegment,
    halfTurnRefinedDiscVertex_coordinate]
  change kleinSubdivisionBoundary (kleinSubdivisionVertices5 a b r s)=_
  rw [kleinSubdivisionBoundary_eq a b r s hr hrs ha hd]
  congr 1
  funext i
  change kleinSubdivisionVertices4 a b s i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate
    (halfTurnTrapezoidDiscVertex a b s ha ha1 hs hs1 hd htop i)
  rw [halfTurnTrapezoidDiscVertex_coordinate]
  rfl

/-- The literal refinement at the axis point is a genuine polygon. No Jordan,
simplicity or edge subdivision property is an input. -/
def halfTurnRefinedDiscPolygon (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon 5 where
  three_le:=by decide
  vertices:=halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs
  vertices_injective:=by
    intro i j he
    apply kleinSubdivisionVertices5_injective a b r s hr hrs ha hd
    simpa only [halfTurnRefinedDiscVertex_coordinate] using congrArg _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate he
  simple_edges:=by
    intro i j hij p hp
    have hK (i : Fin 5) (hp : p∈_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonEdge
        (halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs) i) :
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate p∈kleinSubdivisionEdge (kleinSubdivisionVertices5 a b r s) i:=by
      have hh:=mem_image_of_mem _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate hp
      rw [_root_.LowDimensionalTopology.Geometry.Polygon.discPolygonEdge,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKlein_image_closedModelDiscHSegment,
        halfTurnRefinedDiscVertex_coordinate,halfTurnRefinedDiscVertex_coordinate] at hh
      exact hh
    have h:=kleinSubdivisionVertices5_simple_edges a b r s hr hrs ha hd i j hij ⟨hK i hp.1,hK j hp.2⟩
    simp only [mem_inter_iff,mem_insert_iff,mem_singleton_iff] at h ⊢
    have transfer (k : Fin 5) (hk : _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate p=kleinSubdivisionVertices5 a b r s k) :
        p=halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs k:=by
      apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_injective
      simpa only [halfTurnRefinedDiscVertex_coordinate] using hk
    exact ⟨h.1.imp (transfer i) (transfer (finRotate 5 i)),
      h.2.imp (transfer j) (transfer (finRotate 5 j))⟩
  jordanBoundary:=by
    rw [halfTurnRefinedDiscVertex_boundary]
    exact (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.jordanBoundary

theorem halfTurnRefinedDiscPolygon_finite (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) (i : Fin 5) :
    ‖((halfTurnRefinedDiscPolygon a b r s ha ha1 hs hs1 hd htop hr hrs).vertices i : ℂ)‖<1 := by
  apply halfTurn_closedKlein_finite
  change ‖_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate (halfTurnRefinedDiscVertex a b r s ha ha1 hs hs1 hd htop hr hrs i)‖<1
  rw [halfTurnRefinedDiscVertex_coordinate]
  exact halfTurnRefined_raw_norm_lt a b r s ha ha1 hs hs1 hd htop hr hrs i

/-- Subdividing the actual side changes neither the literal bounded region nor its density area. -/
theorem halfTurnRefinedDiscPolygon_interior (a b r s : ℝ) (ha : 0<a) (ha1 : a<1)
    (hs : 0<s) (hs1 : s<1) (hd : 0<a-b*s) (htop : s^2+(b*s-a)^2<1)
    (hr : 0<r) (hrs : r<s) :
    (halfTurnRefinedDiscPolygon a b r s ha ha1 hs hs1 hd htop hr hrs).interior=
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.interior := by
  have hB : (halfTurnRefinedDiscPolygon a b r s ha ha1 hs hs1 hd htop hr hrs).complexBoundary=
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.complexBoundary:=by
    unfold _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon.complexBoundary
    rw [show (halfTurnRefinedDiscPolygon a b r s ha ha1 hs hs1 hd htop hr hrs).boundary=
      (halfTurnTrapezoidSupportData a b s ha ha1 hs hs1 hd htop).toDiscPolygon.boundary from
      halfTurnRefinedDiscVertex_boundary a b r s ha ha1 hs hs1 hd htop hr hrs]
  change (fun z : 𝔻=>(z : ℂ)) ⁻¹' (_ᶜ \ connectedComponentIn _ _) =
    (fun z : 𝔻=>(z : ℂ)) ⁻¹' (_ᶜ \ connectedComponentIn _ _)
  rw [hB]

end LowDimensionalTopology.Geometry.Fuchsian


namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology
  LowDimensionalTopology.Geometry.DiscreteGroups
  LowDimensionalTopology.Geometry.Euclidean
  LowDimensionalTopology.Geometry.Fuchsian
  LowDimensionalTopology.Geometry.Hyperbolic
  LowDimensionalTopology.Geometry.Polygon
  LowDimensionalTopology.Geometry.Surfaces
  LowDimensionalTopology.Geometry.Auxiliary.Algebra
  LowDimensionalTopology.Geometry.Auxiliary.Analysis
  LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Mobius

def halfTurnQuadKleinR (m : ℝ) : ℝ:=(m^2-1)/(m^2+1)

theorem halfTurnQuadKleinR_bounds (k m : ℝ) (hk : 1<k) (hm : 1<m) (hmk : m<k) :
    0<halfTurnQuadKleinR m ∧ halfTurnQuadKleinR m<halfTurnQuadKleinS k := by
  have hd : 0<m^2+1:=by positivity
  have hkd : 0<k^2+1:=by positivity
  constructor
  · exact div_pos (by nlinarith only [hm]) hd
  · rw [halfTurnQuadKleinR,halfTurnQuadKleinS,div_lt_div_iff₀ hd hkd]
    nlinarith only [mul_pos (sub_pos.mpr hmk) (show 0<k+m by linarith only [hk,hm])]

/-- The actual five-side source polygon, with its axis subdivision at the given
native height. Its region is unchanged from the true four-corner quadrilateral. -/
def halfTurnQuadRefined (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) : _root_.LowDimensionalTopology.Geometry.Polygon.DiscPolygon 5:=
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  let hr:=halfTurnQuadKleinR_bounds k m hk hm hmk
  halfTurnRefinedDiscPolygon (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
    (halfTurnQuadKleinR m) (halfTurnQuadKleinS k)
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 hr.1 hr.2

theorem halfTurnQuadRefined_coordinate (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) (i : Fin 5) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate ((halfTurnQuadRefined k c m hk hc hm hmk).vertices i)=
      kleinSubdivisionVertices5 (halfTurnQuadKleinA k c) (halfTurnQuadKleinB k c)
        (halfTurnQuadKleinR m) (halfTurnQuadKleinS k) i:=by
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  let hr:=halfTurnQuadKleinR_bounds k m hk hm hmk
  exact halfTurnRefinedDiscVertex_coordinate _ _ _ _
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 hr.1 hr.2 i

theorem halfTurnQuadRefined_finite (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) (i : Fin 5) :
    ‖((halfTurnQuadRefined k c m hk hc hm hmk).vertices i : ℂ)‖<1:=by
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  let hr:=halfTurnQuadKleinR_bounds k m hk hm hmk
  exact halfTurnRefinedDiscPolygon_finite _ _ _ _
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 hr.1 hr.2 i

theorem halfTurnQuadCanonical_finite (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (i : Fin 4) :
    ‖((halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.vertices i : ℂ)‖<1 := by
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  apply halfTurn_closedKlein_finite
  change ‖_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate (halfTurnTrapezoidDiscVertex _ _ _
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 i)‖<1
  rw [halfTurnTrapezoidDiscVertex_coordinate]
  exact halfTurnTrapezoid_vertices_norm_lt _ _ _
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 i

theorem halfTurnQuadRefined_interior (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) :
    (halfTurnQuadRefined k c m hk hc hm hmk).interior=
      (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.interior:=by
  let h:=halfTurnQuadKlein_parameter_bounds k c hk hc
  let hr:=halfTurnQuadKleinR_bounds k m hk hm hmk
  exact halfTurnRefinedDiscPolygon_interior _ _ _ _
    h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2 hr.1 hr.2

theorem halfTurnQuadRefined_isConvex (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) : (halfTurnQuadRefined k c m hk hc hm hmk).IsConvex := by
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.DiscHConvex _
  rw [halfTurnQuadRefined_interior]
  exact (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon_isConvex

/-- The genuine native closed polygon, including the subdivision point, is
precisely the original closed radial/circular quadrilateral. -/
theorem halfTurnQuadRefined_native_carrier (k c m : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (hm : 1<m) (hmk : m<k) (z : ℍ) :
    z∈(_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon (halfTurnQuadRefined k c m hk hc hm hmk)
      (halfTurnQuadRefined_finite k c m hk hc hm hmk)).carrier ↔
      1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*c*z.re+k := by
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier]
  change z∈closure (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc ⁻¹' _) ↔_
  rw [halfTurnQuadRefined_interior]
  have hh:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier_iff
    (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon (halfTurnQuadCanonical_finite k c hk hc) z
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier] at hh
  exact hh.trans (halfTurnQuadCanonical_native_closedCarrier k c hk hc z)

end LowDimensionalTopology.Geometry.Fuchsian


open Set
open scoped UpperHalfPlane Complex.UnitDisc
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.Euclidean LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces

theorem nativeSideCoordinates_norm_sq (z : ℍ) :
    ‖(z : ℂ)‖^2=z.re^2+z.im^2 := by
  rw [←Complex.normSq_eq_norm_sq,Complex.normSq_apply]
  simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,pow_two]

theorem nativeSideCoordinates_im_zero (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im=0 ↔ z.re=0 := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (-2*z.re)/(z.re^2+z.im^2+1)=0 ↔ _
  rw [div_eq_zero_iff]
  have hden : z.re^2+z.im^2+1≠0 := ne_of_gt (by positivity)
  simp only [hden,or_false]
  constructor <;> intro h <;> linarith only [h]

theorem nativeSideCoordinates_im_nonpos (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im≤0 ↔ 0≤z.re := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (-2*z.re)/(z.re^2+z.im^2+1)≤0 ↔ _
  rw [div_le_iff₀ (show 0<z.re^2+z.im^2+1 by positivity),zero_mul]
  constructor <;> intro h <;> linarith only [h]

/-- The literal radial Klein coordinate preserves every positive radial order. -/
theorem nativeSideCoordinates_re_le_radius (t : ℝ) (ht : 0<t) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re≤(t^2-1)/(t^2+1) ↔ ‖(z : ℂ)‖≤t := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (z.re^2+z.im^2-1)/(z.re^2+z.im^2+1)≤(t^2-1)/(t^2+1) ↔ _
  rw [div_le_div_iff₀ (show 0<z.re^2+z.im^2+1 by positivity)
    (show 0<t^2+1 by positivity)]
  have hn:=nativeSideCoordinates_norm_sq z
  constructor
  · intro hh
    have hs : ‖(z : ℂ)‖^2≤t^2 := by nlinarith only [hh,hn]
    exact (sq_le_sq₀ (norm_nonneg _) ht.le).mp hs
  · intro hh
    have hs : ‖(z : ℂ)‖^2≤t^2 := (sq_le_sq₀ (norm_nonneg _) ht.le).mpr hh
    nlinarith only [hs,hn]

theorem nativeSideCoordinates_radius_le_re (t : ℝ) (ht : 0<t) (z : ℍ) :
    (t^2-1)/(t^2+1)≤(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re ↔ t≤‖(z : ℂ)‖ := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (t^2-1)/(t^2+1)≤(z.re^2+z.im^2-1)/(z.re^2+z.im^2+1) ↔ _
  rw [div_le_div_iff₀ (show 0<t^2+1 by positivity)
    (show 0<z.re^2+z.im^2+1 by positivity)]
  have hn:=nativeSideCoordinates_norm_sq z
  constructor
  · intro hh
    have hs : t^2≤‖(z : ℂ)‖^2 := by nlinarith only [hh,hn]
    exact (sq_le_sq₀ ht.le (norm_nonneg _)).mp hs
  · intro hh
    have hs : t^2≤‖(z : ℂ)‖^2 := (sq_le_sq₀ ht.le (norm_nonneg _)).mpr hh
    nlinarith only [hs,hn]

theorem nativeSideCoordinates_re_eq_radius (t : ℝ) (ht : 0<t) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re=(t^2-1)/(t^2+1) ↔ ‖(z : ℂ)‖=t := by
  constructor
  · intro h
    exact le_antisymm ((nativeSideCoordinates_re_le_radius t ht z).mp h.le)
      ((nativeSideCoordinates_radius_le_re t ht z).mp h.ge)
  · intro h
    exact le_antisymm ((nativeSideCoordinates_re_le_radius t ht z).mpr h.le)
      ((nativeSideCoordinates_radius_le_re t ht z).mpr h.ge)

theorem nativeSideCoordinates_re_zero (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re=0 ↔ ‖(z : ℂ)‖=1 := by
  simpa only [one_pow,sub_self,zero_div] using
    nativeSideCoordinates_re_eq_radius 1 zero_lt_one z

theorem nativeSideCoordinates_re_nonneg (z : ℍ) :
    0≤(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re ↔ 1≤‖(z : ℂ)‖ := by
  simpa only [one_pow,sub_self,zero_div] using
    nativeSideCoordinates_radius_le_re 1 zero_lt_one z

theorem nativeSideCoordinates_axis_norm (z : ℍ) (hz : z.re=0) :
    ‖(z : ℂ)‖=z.im := by
  have hn:=nativeSideCoordinates_norm_sq z
  rw [hz,zero_pow (by decide),zero_add] at hn
  exact (sq_eq_sq₀ (norm_nonneg _) z.im_pos.le).mp hn

/-- The two subdivided horizontal edges are actual imaginary-axis intervals. -/
theorem nativeSideCoordinates_axis_interval (l u : ℝ) (hl : 0<l) (hu : 0<u) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im=0 ∧
      (l^2-1)/(l^2+1)≤(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re≤(u^2-1)/(u^2+1) ↔
      z.re=0 ∧ z.im∈Icc l u := by
  rw [nativeSideCoordinates_im_zero,nativeSideCoordinates_radius_le_re l hl z,
    nativeSideCoordinates_re_le_radius u hu z]
  constructor
  · rintro ⟨hz,hlo,hhi⟩
    rw [nativeSideCoordinates_axis_norm z hz] at hlo hhi
    exact ⟨hz,hlo,hhi⟩
  · rintro ⟨hz,hlo,hhi⟩
    rw [nativeSideCoordinates_axis_norm z hz]
    exact ⟨hz,hlo,hhi⟩

/-- The actual circular side equation has the exact positive-denominator residual. -/
theorem nativeSideCoordinates_circle_residual (k c : ℝ) (hc : 0<c) (z : ℍ) :
    (k+1)/(2*c)-((k-1)/(2*c)*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re-
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im)=
      (z.re^2+z.im^2-2*c*z.re+k)/(c*(z.re^2+z.im^2+1)) := by
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_explicit]
  change (k+1)/(2*c)-((k-1)/(2*c)*((z.re^2+z.im^2-1)/(z.re^2+z.im^2+1))-
    (-2*z.re)/(z.re^2+z.im^2+1))=_
  field_simp [hc.ne',ne_of_gt (show 0<z.re^2+z.im^2+1 by positivity)]
  ring

theorem nativeSideCoordinates_circle_nonneg (k c : ℝ) (hc : 0<c) (z : ℍ) :
    (k-1)/(2*c)*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re-(k+1)/(2*c)≤
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im ↔
      0≤z.re^2+z.im^2-2*c*z.re+k := by
  have he:=nativeSideCoordinates_circle_residual k c hc z
  have hpos : 0<c*(z.re^2+z.im^2+1) := mul_pos hc (by positivity)
  have hh : 0≤(k+1)/(2*c)-((k-1)/(2*c)*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re-
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im) ↔ 0≤z.re^2+z.im^2-2*c*z.re+k := by
    rw [he,le_div_iff₀ hpos,zero_mul]
  constructor
  · intro h
    exact hh.mp (by linarith only [h])
  · intro h
    have h':=hh.mpr h
    linarith only [h']

theorem nativeSideCoordinates_circle_zero (k c : ℝ) (hc : 0<c) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im=
      (k-1)/(2*c)*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re-(k+1)/(2*c) ↔
      z.re^2+z.im^2-2*c*z.re+k=0 := by
  have he:=nativeSideCoordinates_circle_residual k c hc z
  have hden : c*(z.re^2+z.im^2+1)≠0 := ne_of_gt (mul_pos hc (by positivity))
  have hh : (k+1)/(2*c)-((k-1)/(2*c)*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).re-
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z).im)=0 ↔ z.re^2+z.im^2-2*c*z.re+k=0 := by
    rw [he,div_eq_zero_iff]
    simp only [hden,or_false]
  constructor
  · intro h
    exact hh.mp (by linarith only [h])
  · intro h
    have h':=hh.mpr h
    linarith only [h']

/-- The first subdivided edge is exactly the actual axis interval from 1 to m. -/
theorem nativeSideCoordinates_edge0 (m : ℝ) (hm : 1<m) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    let r:=(m^2-1)/(m^2+1)
    K.im=0 ∧ 0≤K.re ∧ K.re≤r ↔ z.re=0 ∧ z.im∈Icc 1 m := by
  dsimp only
  simpa only [one_pow,sub_self,zero_div] using
    nativeSideCoordinates_axis_interval 1 m zero_lt_one (lt_trans zero_lt_one hm) z

/-- The second subdivided edge is exactly the actual axis interval from m to k. -/
theorem nativeSideCoordinates_edge1 (m k : ℝ) (hm : 0<m) (hk : 0<k) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    let r:=(m^2-1)/(m^2+1)
    let s:=(k^2-1)/(k^2+1)
    K.im=0 ∧ r≤K.re ∧ K.re≤ s ↔ z.re=0 ∧ z.im∈Icc m k := by
  exact nativeSideCoordinates_axis_interval m k hm hk z

/-- The outer raw vertical edge is the original radius-k semicircle cut by the
actual axis half-plane and the original side circle. -/
theorem nativeSideCoordinates_edge2 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    let a:=(k+1)/(2*c)
    let b:=(k-1)/(2*c)
    let s:=(k^2-1)/(k^2+1)
    K.re=s ∧ b*s-a≤K.im ∧ K.im≤0 ↔
      ‖(z : ℂ)‖=k ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k := by
  have hk0 : 0<k := lt_trans zero_lt_one hk
  have hc0 : 0<c := by linarith only [hk,hc]
  dsimp only
  constructor
  · rintro ⟨hK,hside,haxis⟩
    refine ⟨(nativeSideCoordinates_re_eq_radius k hk0 z).mp hK,
      (nativeSideCoordinates_im_nonpos z).mp haxis,?_⟩
    apply (nativeSideCoordinates_circle_nonneg k c hc0 z).mp
    rw [hK]
    exact hside
  · rintro ⟨hn,haxis,hside⟩
    have hK:=(nativeSideCoordinates_re_eq_radius k hk0 z).mpr hn
    refine ⟨hK,?_,(nativeSideCoordinates_im_nonpos z).mpr haxis⟩
    have hh:=(nativeSideCoordinates_circle_nonneg k c hc0 z).mpr hside
    rw [hK] at hh
    exact hh

/-- The actual sloping raw edge is exactly the original side-circle arc between
the two radial boundaries. -/
theorem nativeSideCoordinates_edge3 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    let a:=(k+1)/(2*c)
    let b:=(k-1)/(2*c)
    let s:=(k^2-1)/(k^2+1)
    K.re∈Icc 0 s ∧ K.im=b*K.re-a ↔
      1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧
        z.re^2+z.im^2-2*c*z.re+k=0 := by
  have hk0 : 0<k := lt_trans zero_lt_one hk
  have hc0 : 0<c := by linarith only [hk,hc]
  dsimp only
  constructor
  · rintro ⟨⟨hlo,hhi⟩,hside⟩
    have hpoly:=(nativeSideCoordinates_circle_zero k c hc0 z).mp hside
    have hmul : 0<2*c*z.re := by
      nlinarith only [hpoly,hk0,sq_nonneg z.re,sq_nonneg z.im]
    have hz : 0<z.re := pos_of_mul_pos_right hmul (by positivity)
    exact ⟨(nativeSideCoordinates_re_nonneg z).mp hlo,
      (nativeSideCoordinates_re_le_radius k hk0 z).mp hhi,hz.le,hpoly⟩
  · rintro ⟨hlo,hhi,_haxis,hpoly⟩
    exact ⟨⟨(nativeSideCoordinates_re_nonneg z).mpr hlo,
      (nativeSideCoordinates_re_le_radius k hk0 z).mpr hhi⟩,
      (nativeSideCoordinates_circle_zero k c hc0 z).mpr hpoly⟩

/-- The remaining raw vertical edge is exactly the original unit semicircle cut
by the actual axis half-plane and the side-circle inequality. -/
theorem nativeSideCoordinates_edge4 (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (z : ℍ) :
    let K:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z
    let a:=(k+1)/(2*c)
    K.re=0 ∧ K.im∈Icc (-a) 0 ↔
      ‖(z : ℂ)‖=1 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k := by
  have hc0 : 0<c := by linarith only [hk,hc]
  dsimp only
  constructor
  · rintro ⟨hK,hlo,hhi⟩
    refine ⟨(nativeSideCoordinates_re_zero z).mp hK,
      (nativeSideCoordinates_im_nonpos z).mp hhi,?_⟩
    apply (nativeSideCoordinates_circle_nonneg k c hc0 z).mp
    simpa only [hK,mul_zero,zero_sub] using hlo
  · rintro ⟨hn,haxis,hside⟩
    have hK:=(nativeSideCoordinates_re_zero z).mpr hn
    refine ⟨hK,?_,(nativeSideCoordinates_im_nonpos z).mpr haxis⟩
    have hh:=(nativeSideCoordinates_circle_nonneg k c hc0 z).mpr hside
    simpa only [hK,mul_zero,zero_sub] using hh

end LowDimensionalTopology.Geometry.Fuchsian


open Set Filter Topology
open scoped UpperHalfPlane MatrixGroups OnePoint ComplexConjugate
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Algebra
  LowDimensionalTopology.Geometry.Auxiliary.Analysis
  LowDimensionalTopology.Geometry.Auxiliary.Topology
  LowDimensionalTopology.Geometry.Euclidean
  LowDimensionalTopology.Geometry.Hyperbolic
  LowDimensionalTopology.Geometry.Mobius
  LowDimensionalTopology.Geometry.Polygon
  LowDimensionalTopology.Geometry.Surfaces
  LowDimensionalTopology.Geometry.DiscreteGroups
  LowDimensionalTopology.Geometry.Inversive
  LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Fuchsian
  LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace

/-- On the original unit semicircle, genuine radial scaling multiplies the
actual third-side value by the genuine radial band parameter. -/
theorem halfturn_radial_side_value_scale (w z:ℍ) (k:ℝ) (hk:0<k)
    (hwk:w.re^2+w.im^2=k) (hz:‖(z:ℂ)‖=1) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z).re^2+(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z).im^2-
      2*(w.re^2+w.im^2)/w.re*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z).re+(w.re^2+w.im^2)=
      k*(z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)) := by
  have hN:z.re^2+z.im^2=1:=by
    have he:=congrArg (fun r:ℝ=>r^2) hz
    rw [Complex.sq_norm,Complex.normSq_apply] at he
    simpa only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,one_pow,pow_two,one_mul] using he
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_re,_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_im,hwk]
  linear_combination (k^2-k)*hN

/-- The actual positive dilation pairs the entire original bottom and top
closed circular sides, with the original side-circle constraint retained. -/
theorem halfturn_radial_bottom_top_pairing (w:ℍ) (k:ℝ) (hk:0<k)
    (hwk:w.re^2+w.im^2=k) :
    (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk • z) ''
      {z:ℍ | ‖(z:ℂ)‖=1 ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)}=
      {z:ℍ | ‖(z:ℂ)‖=k ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)} := by
  let d:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk
  let p:ℍ→ℝ:=fun z=>z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)
  have hscale (z:ℍ) (hz:‖(z:ℂ)‖=1):p (d • z)=k*p z:=
    halfturn_radial_side_value_scale w z k hk hwk hz
  have hnorm (z:ℍ):‖((d • z:ℍ):ℂ)‖=k*‖(z:ℂ)‖:=by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hk]
  change (fun z:ℍ=>d • z) '' {z:ℍ | ‖(z:ℂ)‖=1 ∧ 0≤z.re ∧ 0≤p z}=
    {z:ℍ | ‖(z:ℂ)‖=k ∧ 0≤z.re ∧ 0≤p z}
  ext y
  constructor
  · rintro ⟨z,⟨hzn,hzr,hzp⟩,rfl⟩
    refine ⟨?_,?_,?_⟩
    · rw [hnorm,hzn,mul_one]
    · rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_re]
      exact mul_nonneg hk.le hzr
    · rw [hscale z hzn]
      exact mul_nonneg hk.le hzp
  · rintro ⟨hyn,hyr,hyp⟩
    let z:ℍ:=d⁻¹ • y
    have hdz:d • z=y:=smul_inv_smul d y
    have hzn:‖(z:ℂ)‖=1:=by
      have he:=hnorm z
      rw [hdz,hyn] at he
      apply mul_left_cancel₀ hk.ne'
      simpa only [mul_one] using he.symm
    refine ⟨z,⟨hzn,?_,?_⟩,hdz⟩
    · have hr:0≤k*z.re:=by rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_re k hk z,hdz];exact hyr
      exact (mul_nonneg_iff_of_pos_left hk).mp hr
    · have hp:0≤k*p z:=by rw [←hscale z hzn,hdz];exact hyp
      exact (mul_nonneg_iff_of_pos_left hk).mp hp

/-- The inverse of that same actual dilation pairs the entire original top
side back to its original bottom side. -/
theorem halfturn_radial_top_bottom_pairing (w:ℍ) (k:ℝ) (hk:0<k)
    (hwk:w.re^2+w.im^2=k) :
    (fun z:ℍ=>(_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k hk)⁻¹ • z) ''
      {z:ℍ | ‖(z:ℂ)‖=k ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)}=
      {z:ℍ | ‖(z:ℂ)‖=1 ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)} := by
  rw [←halfturn_radial_bottom_top_pairing w k hk hwk,image_image]
  simp only [inv_smul_smul,image_id']

/-- Exact physical coordinates of an axis half-turn on its original axis. -/
theorem axisHalfTurn_zero_re_coordinates (u : ℝ) (hu : 0<u) (z : ℍ)
    (hz : z.re=0) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re=0 ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im=u^2/z.im := by
  have he:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe u hu z
  rw [←Complex.ofReal_pow] at he
  have hr:=congrArg Complex.re he
  have hi:=congrArg Complex.im he
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).re=_ at hr
  change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z).im=_ at hi
  simp only [Complex.div_re,Complex.div_im,Complex.neg_re,Complex.neg_im,
    Complex.ofReal_re,Complex.ofReal_im,zero_mul,neg_zero] at hr hi
  simp only [UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,Complex.normSq_apply,hz] at hr hi
  constructor
  · simpa using hr
  · rw [hi]
    field_simp [z.im_ne_zero]
    ring

/-- The genuine axis half-turn acts as an actual involution on the entire plane. -/
theorem axisHalfTurn_action_involutive (u : ℝ) (hu : 0<u) :
    Function.Involutive (fun z : ℍ => _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z) := by
  intro z
  apply UpperHalfPlane.ext
  rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe,_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL_coe]
  field_simp [Complex.ofReal_ne_zero.mpr hu.ne',z.ne_zero]

/-- Reciprocal native heights preserve the actual interval when its endpoint
product is the actual squared half-turn height. -/
theorem axisHalfTurn_mem_axis_interval (u a b : ℝ) (hu : 0<u) (ha : 0<a)
    (hab : a≤b) (hprod : a*b=u^2) (z : ℍ)
    (hz : z∈{z : ℍ | z.re=0 ∧ z.im∈Set.Icc a b}) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z∈{z : ℍ | z.re=0 ∧ z.im∈Set.Icc a b} := by
  rcases hz with ⟨hz,hlo,hhi⟩
  obtain ⟨hre,him⟩:=axisHalfTurn_zero_re_coordinates u hu z hz
  refine ⟨hre,?_,?_⟩
  · rw [him]
    apply (le_div_iff₀ z.im_pos).mpr
    rw [←hprod]
    exact mul_le_mul_of_nonneg_left hhi ha.le
  · rw [him]
    apply (div_le_iff₀ z.im_pos).mpr
    rw [←hprod]
    have hb : 0≤b := ha.le.trans hab
    nlinarith

/-- The whole actual closed axis interval is self-paired by the original
half-turn, with the endpoint relation proved as a scalar identity. -/
theorem axisHalfTurn_axis_interval_image (u a b : ℝ) (hu : 0<u) (ha : 0<a)
    (hab : a≤b) (hprod : a*b=u^2) :
    (fun z : ℍ => _root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z) ''
      {z : ℍ | z.re=0 ∧ z.im∈Set.Icc a b}=
      {z : ℍ | z.re=0 ∧ z.im∈Set.Icc a b} := by
  apply Set.Subset.antisymm
  · rintro w ⟨z,hz,rfl⟩
    exact axisHalfTurn_mem_axis_interval u a b hu ha hab hprod z hz
  · intro z hz
    refine ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u hu • z,
      axisHalfTurn_mem_axis_interval u a b hu ha hab hprod z hz,?_⟩
    exact axisHalfTurn_action_involutive u hu z


/-- The lower actual axis side is self-paired, including its possible
single-point endpoint case when the normalized first height equals one. -/
theorem axisHalfTurn_lower_axis_side_image (u:ℝ) (hu:1≤u) :
    (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL u (lt_of_lt_of_le zero_lt_one hu) • z) ''
      {z:ℍ | z.re=0 ∧ z.im∈Icc 1 (u^2)}=
      {z:ℍ | z.re=0 ∧ z.im∈Icc 1 (u^2)} := by
  exact axisHalfTurn_axis_interval_image u 1 (u^2) (lt_of_lt_of_le zero_lt_one hu)
    zero_lt_one (one_le_pow₀ hu) (one_mul _)

/-- The upper actual axis side is self-paired by the second original
half-turn at height u*t; its endpoint product is exactly (u*t)^2. -/
theorem axisHalfTurn_upper_axis_side_image (u t:ℝ) (hu:0<u) (hut:u≤t) :
    (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL (u*t) (mul_pos hu (lt_of_lt_of_le hu hut)) • z) ''
      {z:ℍ | z.re=0 ∧ z.im∈Icc (u^2) (t^2)}=
      {z:ℍ | z.re=0 ∧ z.im∈Icc (u^2) (t^2)} := by
  apply axisHalfTurn_axis_interval_image (u*t) (u^2) (t^2)
    (mul_pos hu (lt_of_lt_of_le hu hut)) (sq_pos_of_pos hu) (pow_le_pow_left₀ hu.le hut 2)
  ring

end LowDimensionalTopology.Geometry.Fuchsian


