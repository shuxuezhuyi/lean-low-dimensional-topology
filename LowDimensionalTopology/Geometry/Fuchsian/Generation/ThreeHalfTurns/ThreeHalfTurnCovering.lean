/-- The actual finite covering degree and true quotient-area minimum rule out
a summit angle beyond the sharp three-half-turn threshold. -/
theorem halfTurn_cover_angle_bound (p q N : ℕ) (hp : 0<p) (hpq : 2*p<q)
    (hN : p≤N) (θ V : ℝ) (hθ : θ=Real.pi*p/q)
    (hV : Real.pi/21≤V) (hArea : Real.pi-2*θ=(N : ℝ)*V) :
    θ≤3*Real.pi/7 := by
  have hq : 0<q:=by omega
  have hqR : 0<(q : ℝ):=by exact_mod_cast hq
  have hθq : θ*(q : ℝ)=Real.pi*p:=by rw [hθ];field_simp
  have hθpos : 0<θ:=by rw [hθ];positivity
  by_contra hlarge
  have hlarge' : 3*Real.pi/7<θ:=lt_of_not_ge hlarge
  have hp3 : 3≤p:=by
    by_contra hsmall
    have hpc : p=1 ∨ p=2:=by omega
    rcases hpc with rfl|rfl
    · have hqr : (3 : ℝ)≤q:=by exact_mod_cast (show 3≤q by omega)
      norm_num at hθq
      nlinarith only [mul_nonneg (sub_nonneg.mpr hqr) hθpos.le,hθq,hlarge',Real.pi_pos]
    · have hqr : (5 : ℝ)≤q:=by exact_mod_cast (show 5≤q by omega)
      norm_num at hθq
      nlinarith only [mul_nonneg (sub_nonneg.mpr hqr) hθpos.le,hθq,hlarge',Real.pi_pos]
  have hN3 : (3 : ℝ)≤N:=by exact_mod_cast (le_trans hp3 hN)
  have hVpos : 0<V:=lt_of_lt_of_le (by positivity : 0<Real.pi/21) hV
  have hprod : 0≤((N : ℝ)-3)*V:=mul_nonneg (sub_nonneg.mpr hN3) hVpos.le
  nlinarith only [hprod,hArea,hV,hlarge']

/-- This is the scalar final step for the genuine small-trace case. -/
theorem halfTurn_cover_cosine_bound (p q N : ℕ) (hp : 0<p) (hpq : 2*p<q)
    (hN : p≤N) (θ V lam : ℝ) (hθ : θ=Real.pi*p/q)
    (hV : Real.pi/21≤V) (hArea : Real.pi-2*θ=(N : ℝ)*V)
    (hlam : lam=Real.cos θ) : Real.cos (3*Real.pi/7)≤lam := by
  have hbound:=halfTurn_cover_angle_bound p q N hp hpq hN θ V hθ hV hArea
  have hθ0 : 0≤θ:=by rw [hθ];positivity
  rw [hlam]
  exact Real.strictAntiOn_cos.antitoneOn ⟨hθ0,by linarith only [hbound,Real.pi_pos]⟩
    ⟨by positivity,by linarith only [Real.pi_pos]⟩ hbound

end LowDimensionalTopology.Geometry.Fuchsian


