/-- The actual half-turn about any genuine center has this literal fractional
expression; the real pole is outside the native hyperbolic plane. -/
theorem pointHalfTurnSL_fractional_coe (w z:ℍ) :
    ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z:ℍ):ℂ)=
      ((w.re:ℂ)*(z:ℂ)-((w.re^2+w.im^2:ℝ):ℂ))/((z:ℂ)-(w.re:ℂ)) := by
  rw [UpperHalfPlane.coe_specialLinearGroup_apply]
  simp only [Algebra.algebraMap_self_apply]
  change (((w.re/w.im:ℝ):ℂ)*(z:ℂ)+((-(w.re^2+w.im^2)/w.im:ℝ):ℂ))/
    ((((1/w.im:ℝ):ℂ)*(z:ℂ))+((-w.re/w.im:ℝ):ℂ))=_
  push_cast
  calc
    _=(((w.re:ℂ)*(z:ℂ)-((w.re:ℂ)^2+(w.im:ℂ)^2))/(w.im:ℂ))/
      (((z:ℂ)-(w.re:ℂ))/(w.im:ℂ)):=by congr 1 <;> ring
    _=_:=div_div_div_cancel_right₀ (Complex.ofReal_ne_zero.mpr w.im_ne_zero) _ _


/-- On the genuine third-side circle, the actual half-turn equals the literal
radial inversion. The boundary equation is the expanded original side value. -/
theorem pointHalfTurn_side_circle_coe (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0) :
    ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z:ℍ):ℂ)=((w.re^2+w.im^2:ℝ):ℂ)/conj (z:ℂ) := by
  have hrel:w.re*(z.re^2+z.im^2+w.re^2+w.im^2)=2*(w.re^2+w.im^2)*z.re:=by
    field_simp [hw.ne'] at hz
    nlinarith only [hz]
  have hd:(z:ℂ)-(w.re:ℂ)≠0:=by
    intro he
    have hi:=congrArg Complex.im he
    simp only [Complex.sub_im,Complex.ofReal_im,sub_zero,Complex.zero_im,UpperHalfPlane.coe_im] at hi
    exact z.im_ne_zero hi
  have hc:conj (z:ℂ)≠0:=by
    intro he
    apply z.ne_zero
    simpa only [Complex.conj_conj,map_zero] using congrArg (conj:ℂ→ℂ) he
  rw [pointHalfTurnSL_fractional_coe]
  apply (div_eq_div_iff hd hc).mpr
  apply Complex.ext
  · simp only [Complex.mul_re,Complex.mul_im,Complex.sub_re,Complex.sub_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.conj_re,Complex.conj_im,
      UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    nlinarith only [hrel]
  · simp only [Complex.mul_re,Complex.mul_im,Complex.sub_re,Complex.sub_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.conj_re,Complex.conj_im,
      UpperHalfPlane.coe_re,UpperHalfPlane.coe_im]
    ring

/-- The physical real and imaginary coordinates of the third-side pairing. -/
theorem pointHalfTurn_side_circle_coordinates (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re=(w.re^2+w.im^2)*z.re/Complex.normSq (z:ℂ) ∧
      (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im=(w.re^2+w.im^2)*z.im/Complex.normSq (z:ℂ) := by
  have he:=pointHalfTurn_side_circle_coe w z hw hz
  constructor
  · have hr:=congrArg Complex.re he
    change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re=_ at hr
    simpa only [Complex.div_re,Complex.ofReal_re,Complex.ofReal_im,Complex.conj_re,
      Complex.conj_im,Complex.normSq_conj,UpperHalfPlane.coe_re,zero_mul,zero_div,add_zero] using hr
  · have hi:=congrArg Complex.im he
    change (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im=_ at hi
    simpa only [Complex.div_im,Complex.ofReal_re,Complex.ofReal_im,Complex.conj_re,
      Complex.conj_im,Complex.normSq_conj,UpperHalfPlane.coe_im,zero_mul,zero_div,zero_sub,
      mul_neg,neg_neg,neg_div] using hi

/-- The actual side map reverses radial norm by the genuine squared norm of
its physical half-turn center. -/
theorem pointHalfTurn_side_circle_norm (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0) :
    ‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z:ℍ):ℂ)‖=(w.re^2+w.im^2)/‖(z:ℂ)‖ := by
  rw [pointHalfTurn_side_circle_coe w z hw hz,norm_div,Complex.norm_real,
    Real.norm_eq_abs,abs_of_nonneg (add_nonneg (sq_nonneg _) (sq_nonneg _)),Complex.norm_conj]

/-- The actual half-turn carries every point of its genuine side circle
back to that same original circle. -/
theorem pointHalfTurn_side_circle_preserved (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re^2+(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im^2-
      2*(w.re^2+w.im^2)/w.re*(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re+(w.re^2+w.im^2)=0 := by
  have he:=pointHalfTurn_side_circle_coe w z hw hz
  have hn:=congrArg Complex.normSq he
  have hns:(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re^2+(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).im^2=
      (w.re^2+w.im^2)^2/Complex.normSq (z:ℂ):=by
    rw [Complex.normSq_div,Complex.normSq_ofReal,Complex.normSq_conj] at hn
    simpa only [Complex.normSq_apply,UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,pow_two] using hn
  have hcoord:=pointHalfTurn_side_circle_coordinates w z hw hz
  have hN:0<Complex.normSq (z:ℂ):=Complex.normSq_pos.mpr z.ne_zero
  have hNdef:z.re^2+z.im^2=Complex.normSq (z:ℂ):=by
    simp only [Complex.normSq_apply,UpperHalfPlane.coe_re,UpperHalfPlane.coe_im,pow_two]
  calc
    _=(w.re^2+w.im^2)/Complex.normSq (z:ℂ)*
      (z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)):=by
      rw [hns,hcoord.1,hNdef]
      field_simp [hw.ne',hN.ne']
      ring
    _=0:=by rw [hz,mul_zero]

/-- The actual side pairing applied twice fixes every actual point on that
same genuine circle. -/
theorem pointHalfTurn_side_circle_involutive (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z)=z := by
  have hk:0<w.re^2+w.im^2:=by positivity
  apply UpperHalfPlane.ext
  rw [pointHalfTurn_side_circle_coe w (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) hw
      (pointHalfTurn_side_circle_preserved w z hw hz),
    pointHalfTurn_side_circle_coe w z hw hz,map_div₀,Complex.conj_ofReal,Complex.conj_conj]
  field_simp [Complex.ofReal_ne_zero.mpr hk.ne',z.ne_zero]
  exact div_self (Complex.ofReal_ne_zero.mpr hk.ne')

/-- On the actual paired circle, the original closed radial band and the
right half-plane are preserved by the original half-turn. -/
theorem pointHalfTurn_side_circle_band_preserved (w z:ℍ) (hw:0<w.re)
    (hz:z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0)
    (hlo:1≤‖(z:ℂ)‖) (hhi:‖(z:ℂ)‖≤w.re^2+w.im^2) (hre:0≤z.re) :
    1≤‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z:ℍ):ℂ)‖ ∧
      ‖((_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z:ℍ):ℂ)‖≤w.re^2+w.im^2 ∧ 0≤(_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z).re := by
  have hn:0<‖(z:ℂ)‖:=norm_pos_iff.mpr z.ne_zero
  have hk:0≤w.re^2+w.im^2:=add_nonneg (sq_nonneg _) (sq_nonneg _)
  have hc:=pointHalfTurn_side_circle_coordinates w z hw hz
  refine ⟨?_,?_,?_⟩
  · rw [pointHalfTurn_side_circle_norm w z hw hz]
    exact (one_le_div hn).mpr hhi
  · rw [pointHalfTurn_side_circle_norm w z hw hz]
    apply (div_le_iff₀ hn).mpr
    simpa only [mul_one] using mul_le_mul_of_nonneg_left hlo hk
  · rw [hc.1]
    exact div_nonneg (mul_nonneg hk hre) (Complex.normSq_nonneg _)

/-- The genuine third side cut out of the original closed radial strip is
self-paired as an actual point set by the actual third half-turn. -/
theorem pointHalfTurn_side_circle_closed_side_self_pairing (w:ℍ) (hw:0<w.re) :
    let S:Set ℍ:={z | 1≤‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖≤w.re^2+w.im^2 ∧ 0≤z.re ∧
      z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0}
    (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) '' S=S := by
  dsimp only
  let S:Set ℍ:={z | 1≤‖(z:ℂ)‖ ∧ ‖(z:ℂ)‖≤w.re^2+w.im^2 ∧ 0≤z.re ∧
    z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0}
  change (fun z:ℍ=>_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z) '' S=S
  have hmap (z:ℍ) (hz:z∈S):_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z∈S:=by
    obtain ⟨h0,h1,hr,hP⟩:=hz
    obtain ⟨h0',h1',hr'⟩:=pointHalfTurn_side_circle_band_preserved w z hw hP h0 h1 hr
    exact ⟨h0',h1',hr',pointHalfTurn_side_circle_preserved w z hw hP⟩
  ext z
  constructor
  · rintro ⟨v,hv,rfl⟩
    exact hmap v hv
  · intro hz
    exact ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w • z,hmap z hz,pointHalfTurn_side_circle_involutive w z hw hz.2.2.2⟩

end LowDimensionalTopology.Geometry.Fuchsian


