/-- The actual native vertices have the original literal Klein coordinates. -/
theorem halfTurnFour_native_vertex_coordinate (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (i : Fin 4) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex
