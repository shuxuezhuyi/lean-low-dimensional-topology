/-- Literal Klein coordinates of the genuine four vertices. -/
theorem halfTurnFour_vertex_coordinate (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (i : Fin 4) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate ((halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.vertices i)=
      kleinSubdivisionVertices4 ((k+1)/(2*c)) ((k-1)/(2*c)) ((k^2-1)/(k^2+1)) i := by
  have hp:=halfTurnQuadKlein_parameter_bounds k c hk hc
  exact halfTurnTrapezoidDiscVertex_coordinate _ _ _ hp.1 hp.2.1 hp.2.2.1
    hp.2.2.2.1 hp.2.2.2.2.1 hp.2.2.2.2.2 i

/-- The actual native sides have precisely the original raw segment coordinates. -/
theorem halfTurnFour_side_raw (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) (i : Fin 4) (z : ℍ) :
    z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon i ↔
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z∈kleinSubdivisionEdge
        (kleinSubdivisionVertices4 ((k+1)/(2*c)) ((k-1)/(2*c)) ((k^2-1)/(k^2+1))) i := by
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.discToClosedModel (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToDisc z)∈_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedModelDiscHSegment _ _ ↔ _
  rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_injective.mem_set_image,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKlein_image_closedModelDiscHSegment,halfTurnFour_vertex_coordinate,
    halfTurnFour_vertex_coordinate,_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion]
  rfl

/-- Four actual edges, in original cyclic order: axis, outer radius, side circle, unit radius. -/
theorem halfTurnFour_side_coordinates (k c : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (i : Fin 4) (z : ℍ) :
    z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon i ↔
      ![z.re=0 ∧ z.im∈Icc 1 k,
        ‖(z : ℂ)‖=k ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k,
        1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤k ∧ 0≤z.re ∧ z.re^2+z.im^2-2*c*z.re+k=0,
        ‖(z : ℂ)‖=1 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*c*z.re+k] i := by
  rw [halfTurnFour_side_raw]
  have hp:=halfTurnQuadKlein_parameter_bounds k c hk hc
  dsimp only [halfTurnQuadKleinA,halfTurnQuadKleinB,halfTurnQuadKleinS] at hp
  rw [kleinSubdivisionEdge4_mem _ _ _ hp.2.2.1 hp.1 hp.2.2.2.2.1]
  fin_cases i
  · simpa [Set.mem_Icc] using
      nativeSideCoordinates_axis_interval 1 k zero_lt_one (zero_lt_one.trans hk) z
  · exact nativeSideCoordinates_edge2 k c hk hc z
  · exact nativeSideCoordinates_edge3 k c hk hc z
  · exact nativeSideCoordinates_edge4 k c hk hc z

/-- The actual four source pairing maps, rather than independently supplied elements. -/
def halfTurnFour_element (t : ℝ) (ht : 1<t) (w : ℍ) : Fin 4→(ℍ≃ᵢℍ) :=
  ![_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht)),
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht))))⁻¹,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)))]

/-- Both actual half-turn maps are genuine involutions in the native isometry group. -/
theorem halfTurnFour_axis_inv (t : ℝ) (ht : 0<t) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t ht))⁻¹=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t ht) := by
  apply inv_eq_of_mul_eq_one_right
  apply IsometryEquiv.ext
  intro z
  exact axisHalfTurn_action_involutive t ht z

theorem halfTurnFour_point_inv (w : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w))⁻¹=_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w) := by
  apply inv_eq_of_mul_eq_one_right
  apply IsometryEquiv.ext
  intro z
  exact sideOpposition_point_halfturn_involutive w z

@[simp] theorem halfTurnFour_hSL_inv_apply
    (A : Matrix.SpecialLinearGroup (Fin 2) ℝ) (z : ℍ) :
    (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A)⁻¹ z=A⁻¹ • z := by
  apply (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry A).injective
  rw [IsometryEquiv.apply_inv_self]
  change z=A • (A⁻¹ • z)
  exact (smul_inv_smul A z).symm

/-- The literal index involution has the genuine element inverse relation. -/
theorem halfTurnFour_element_inverse (t : ℝ) (ht : 1<t) (w : ℍ) (i : Fin 4) :
    halfTurnFour_element t ht w ((Equiv.swap (1 : Fin 4) 3) i)=
      (halfTurnFour_element t ht w i)⁻¹ := by
  fin_cases i <;> norm_num [halfTurnFour_element,halfTurnFour_axis_inv,halfTurnFour_point_inv,Equiv.swap_apply_def]

/-- Actual original side images for the four-side boundary case. -/
theorem halfTurnFour_element_side_image (t : ℝ) (ht : 1<t) (w : ℍ) (hw : 0<w.re)
    (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) (i : Fin 4) :
    halfTurnFour_element t ht w i ''
      _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
        (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon i =
      _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
        (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon ((Equiv.swap (1 : Fin 4) 3) i) := by
  have hset (j : Fin 4) : _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide
      (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
        (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon j=
      {z : ℍ | ![z.re=0 ∧ z.im∈Icc 1 (t^2),
        ‖(z : ℂ)‖=t^2 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*(t^2/w.re)*z.re+t^2,
        1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤t^2 ∧ 0≤z.re ∧ z.re^2+z.im^2-2*(t^2/w.re)*z.re+t^2=0,
        ‖(z : ℂ)‖=1 ∧ 0≤z.re ∧ 0≤z.re^2+z.im^2-2*(t^2/w.re)*z.re+t^2] j} := by
    ext z
    exact halfTurnFour_side_coordinates _ _ _ _ j z
  rw [hset,hset]
  fin_cases i
  · simpa [halfTurnFour_element,Equiv.swap_apply_def] using axisHalfTurn_lower_axis_side_image t ht.le
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      halfturn_radial_top_bottom_pairing w (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)) hn
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      pointHalfTurn_side_circle_closed_side_self_pairing w hw
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      halfturn_radial_bottom_top_pairing w (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)) hn

/-- The boundary case carries a genuine original Poincare side pairing. -/
def halfTurnFour_pairing (t : ℝ) (ht : 1<t) (w : ℍ) (hw : 0<w.re)
    (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) :
    _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing (ℍ≃ᵢℍ) (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon
      (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
        (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon
      (halfTurnQuadCanonical_finite _ _ _ _)) where
  paired:=let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ (halfTurnQuadCanonical_finite _ _ _ _)
    (e.symm.trans (Equiv.swap (1 : Fin 4) 3)).trans e
  involutive:=by
    intro s
    let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ (halfTurnQuadCanonical_finite (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc)
    change e ((Equiv.swap (1 : Fin 4) 3) (e.symm
      (e ((Equiv.swap (1 : Fin 4) 3) (e.symm s)))))=s
    simp
  element s:=halfTurnFour_element t ht w ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _
    (halfTurnQuadCanonical_finite _ _ _ _)).symm s)
  element_paired:=by
    intro s
    change halfTurnFour_element t ht w
      ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _).symm ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _)
        ((Equiv.swap (1 : Fin 4) 3) ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _).symm s))))=_
    rw [Equiv.symm_apply_apply]
    exact halfTurnFour_element_inverse t ht w _
  side_image:=by
    intro s
    obtain ⟨i,rfl⟩:=(_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ (halfTurnQuadCanonical_finite (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc)).surjective s
    change halfTurnFour_element t ht w ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _).symm
      ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i)) '' _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide _ i=
      _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide _ ((Equiv.swap (1 : Fin 4) 3)
        ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _).symm ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i)))
    simp only [Equiv.symm_apply_apply]
    exact halfTurnFour_element_side_image t ht w hw hn hc i

@[simp] theorem halfTurnFour_pairing_element_index (t : ℝ) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) (i : Fin 4) :
    (halfTurnFour_pairing t ht w hw hn hc).element ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i)=
      halfTurnFour_element t ht w i := by
  change halfTurnFour_element t ht w ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _).symm
    ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i))=_
  rw [Equiv.symm_apply_apply]

/-- The actual radial pairing is the product of the original two half-turns. -/
theorem halfTurnFour_dilation_product (t : ℝ) (ht : 1<t) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)))=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht))*
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one) := by
  apply IsometryEquiv.ext
  intro z
  apply UpperHalfPlane.ext
  change ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) _ • z : ℍ) : ℂ)=
    ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t _ • (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 _ • z) : ℍ) : ℂ)
  rw [←mul_smul,_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurns_product_coe,_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe]
  simp

/-- The complete genuine pairing group is exactly the original three-half-turn group. -/
theorem halfTurnFour_generated (t : ℝ) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) :
    (halfTurnFour_pairing t ht w hw hn hc).Generated=Subgroup.closure
      {_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one),
       _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht)),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)} := by
  let S:=halfTurnFour_pairing t ht w hw hn hc
  let C:=Subgroup.closure {_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one),
       _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht)),_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)}
  have hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one)∈C:=Subgroup.subset_closure (by simp)
  have hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht))∈C:=Subgroup.subset_closure (by simp)
  have hH : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)∈C:=Subgroup.subset_closure (by simp)
  have hD : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)))∈C:=by
    rw [halfTurnFour_dilation_product t ht]
    exact C.mul_mem hG hF
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨s,rfl⟩
    obtain ⟨i,rfl⟩:=(_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ (halfTurnQuadCanonical_finite (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc)).surjective s
    rw [halfTurnFour_pairing_element_index]
    fin_cases i
    · exact hG
    · exact C.inv_mem hD
    · exact hH
    · exact hD
  · have hmem (i : Fin 4) : halfTurnFour_element t ht w i∈S.Generated:=by
      have hh:=(S.generator ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i)).property
      exact (halfTurnFour_pairing_element_index t ht w hw hn hc i) ▸ hh
    have hG' : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht))∈S.Generated:=hmem 0
    have hH' : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.pointHalfTurnSL w)∈S.Generated:=hmem 2
    have hD' : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)))∈S.Generated:=hmem 3
    apply (Subgroup.closure_le _).mpr
    intro g hg
    simp only [mem_insert_iff,mem_singleton_iff] at hg
    rcases hg with rfl | rfl | rfl
    · have hr : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL 1 zero_lt_one)=
          (_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.axisHalfTurnSL t (zero_lt_one.trans ht)))⁻¹*
            _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) (sq_pos_of_pos (zero_lt_one.trans ht))) := by
        rw [halfTurnFour_dilation_product t ht,inv_mul_cancel_left]
      rw [hr]
      exact S.Generated.mul_mem (S.Generated.inv_mem hG') hD'
    · exact hG'
    · exact hH'

/-- A genuine nonvertex has none of the four literal raw vertex coordinates. -/
theorem halfTurnFour_nonvertex_coordinate (k c : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (z : ℍ) (hv : z∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex
      (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon (halfTurnQuadCanonical_finite _ _ _ _)))
    (j : Fin 4) : _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z≠
      kleinSubdivisionVertices4 ((k+1)/(2*c)) ((k-1)/(2*c)) ((k^2-1)/(k^2+1)) j := by
  intro he
  apply hv
  refine ⟨j,?_⟩
  apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_injective
  calc
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex _ _ j)=
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate ((halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon.vertices j) := by
      rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate,←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion,_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate]
    _ = _ := (halfTurnFour_vertex_coordinate k c hk hc j).trans he.symm

/-- Interior points of each original side have the other actual inequalities strict. -/
theorem halfTurnFour_side_strict (k c : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (i : Fin 4) (z : ℍ)
    (hz : z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon i)
    (hv : z∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex
      (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon (halfTurnQuadCanonical_finite _ _ _ _))) :
    ![1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re^2+z.im^2-2*c*z.re+k,
      1<‖(z : ℂ)‖ ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k,
      1<‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖<k ∧ 0<z.re,
      ‖(z : ℂ)‖<k ∧ 0<z.re ∧ 0<z.re^2+z.im^2-2*c*z.re+k] i := by
  have hne:=halfTurnFour_nonvertex_coordinate k c hk hc z hv
  have hp:=halfTurnQuadKlein_parameter_bounds k c hk hc
  dsimp only [halfTurnQuadKleinA,halfTurnQuadKleinB,halfTurnQuadKleinS] at hp
  have hr:=(halfTurnFour_side_raw k c hk hc i z).mp hz
  rw [kleinSubdivisionEdge4_mem _ _ _ hp.2.2.1 hp.1 hp.2.2.2.2.1] at hr
  fin_cases i
  · obtain ⟨hzre,hlo,hhi⟩:=(halfTurnFour_side_coordinates k c hk hc 0 z).mp hz
    have hn:=nativeSideCoordinates_axis_norm z hzre
    have hnot1 : ‖(z : ℂ)‖≠1:=by
      intro he
      apply hne 0
      apply Complex.ext
      · exact (nativeSideCoordinates_re_zero z).mpr he
      · exact (nativeSideCoordinates_im_zero z).mpr hzre
    have hnotk : ‖(z : ℂ)‖≠k:=by
      intro he
      apply hne 1
      apply Complex.ext
      · exact (nativeSideCoordinates_re_eq_radius k (zero_lt_one.trans hk) z).mpr he
      · exact (nativeSideCoordinates_im_zero z).mpr hzre
    refine ⟨lt_of_le_of_ne (hn.symm ▸ hlo) hnot1.symm,
      lt_of_le_of_ne (hn.symm ▸ hhi) hnotk,?_⟩
    rw [hzre]
    nlinarith only [hk,sq_nonneg z.im]
  · exact nativeSideStrictness_edge2 k c hk hc z hr (hne 1) (hne 2)
  · exact nativeSideStrictness_edge3 k c hk hc z hr (hne 2) (hne 3)
  · exact nativeSideStrictness_edge4 k c hk hc z hr (hne 3) (hne 0)

/-- Genuine nonvertex points satisfy the original opposite-side-neighborhood axiom. -/
theorem halfTurnFour_opposite (t : ℝ) (ht : 1<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    (i : Fin 4) (x : ℍ)
    (hx : x∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
      (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon i)
    (hv : x∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex
      (halfTurnQuadCanonicalSupport (t^2) (t^2/w.re)
        (one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)) hc).toDiscPolygon
      (halfTurnQuadCanonical_finite _ _ _ _))) :
    (halfTurnFour_pairing t ht w hw hn hc).OppositeSideNeighborhoods
      ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv _ _) i) x := by
  let hk:=one_lt_pow₀ ht (by decide : (2 : ℕ)≠0)
  let Q:=(halfTurnQuadCanonicalSupport (t^2) (t^2/w.re) hk hc).toDiscPolygon
  let hf:=halfTurnQuadCanonical_finite (t^2) (t^2/w.re) hk hc
  let S:=halfTurnFour_pairing t ht w hw hn hc
  have hyv : halfTurnFour_element t ht w i x∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf):=by
    have hh:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygon_pairing_nonvertex Q hf S i hx hv
    change (halfTurnFour_pairing t ht w hw hn hc).element _ x∉_ at hh
    rw [halfTurnFour_pairing_element_index] at hh
    exact hh
  have hy : halfTurnFour_element t ht w i x∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide Q ((Equiv.swap (1 : Fin 4) 3) i):=by
    rw [←halfTurnFour_element_side_image t ht w hw hn hc i]
    exact ⟨x,hx,rfl⟩
  have hxs:=halfTurnFour_side_strict (t^2) (t^2/w.re) hk hc i x hx hv
  have hys:=halfTurnFour_side_strict (t^2) (t^2/w.re) hk hc
    ((Equiv.swap (1 : Fin 4) 3) i) (halfTurnFour_element t ht w i x) hy hyv
  let : IsIsometricSMul S.Generated ℍ:=⟨fun g=>g.val.isometry⟩
  apply (S.oppositeSideNeighborhoods_iff_interior _ x).mpr
  have hcarrier : (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).carrier=
      {z : ℍ | 1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤t^2 ∧ 0≤z.re ∧
        0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)}:=by
    ext z
    rw [_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon_carrier_iff]
    simpa only [Q,mem_ofPred_eq,hn,div_mul_eq_mul_div,mul_div_assoc] using
      halfTurnQuadCanonical_native_closedCarrier (t^2) (t^2/w.re) hk hc z
  change x∈interior ((_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).carrier ∪
    (fun z : ℍ=>S.element ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf) i) z) ⁻¹'
      (_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf).carrier)
  rw [hcarrier]
  rw [show S.element ((_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf) i)=halfTurnFour_element t ht w i from
    halfTurnFour_pairing_element_index t ht w hw hn hc i]
  fin_cases i
  · simpa [halfTurnFour_element,hn,
      div_mul_eq_mul_div,mul_div_assoc] using sideOpposition_axis_side_union_germ
        (t^2) t (zero_lt_one.trans ht) w x
        (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hxs)
        (by simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using hys)
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      sideOpposition_top_side_union_germ (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)) w x
        (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hxs)
        (by simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using hys)
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      sideOpposition_third_side_union_germ (t^2) w x hw
        (by simpa using hxs) (by simpa [halfTurnFour_element,Equiv.swap_apply_def] using hys)
  · simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using
      sideOpposition_bottom_side_union_germ (t^2) (sq_pos_of_pos (zero_lt_one.trans ht)) w x
        (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hxs)
        (by simpa [halfTurnFour_element,Equiv.swap_apply_def,hn,div_mul_eq_mul_div,mul_div_assoc] using hys)

