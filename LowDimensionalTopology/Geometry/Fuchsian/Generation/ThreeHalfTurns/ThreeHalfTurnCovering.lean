      (halfTurnQuadCanonical_finite k c hk hc) i)=
      kleinSubdivisionVertices4 ((k+1)/(2*c)) ((k-1)/(2*c)) ((k^2-1)/(k^2+1)) i := by
  unfold _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate
  rw [←_root_.LowDimensionalTopology.Geometry.Hyperbolic.closedKleinCoordinate_disc_inclusion,_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex_coordinate,
    halfTurnFour_vertex_coordinate]

/-- The actual lower summit lies on both the unit semicircle and the original third side. -/
theorem halfTurnFour_unit_summit (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
    let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q (halfTurnQuadCanonical_finite k c hk hc) 3
    ‖(z : ℂ)‖=1 ∧ z.re^2+z.im^2-2*c*z.re+k=0 := by
  let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
  let hf:=halfTurnQuadCanonical_finite k c hk hc
  let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf 3
  have hB:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide_left_mem Q hf (3 : Fin 4)
  rw [halfTurnFour_side_coordinates] at hB
  have hT:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide_right_mem Q hf (2 : Fin 4)
  change z∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide Q 2 at hT
  rw [halfTurnFour_side_coordinates] at hT
  exact ⟨hB.1,hT.2.2.2⟩

/-- Genuine radial scaling sends the lower original summit to the upper one. -/
theorem halfTurnFour_summit_dilation (k c : ℝ) (hk : 1<k) (hc : k+1<2*c)
    (w : ℍ) (_hw : 0<w.re) (hn : w.re^2+w.im^2=k) (hck : c=k/w.re) :
    let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
    let hf:=halfTurnQuadCanonical_finite k c hk hc
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (zero_lt_one.trans hk)•_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf 3=
      _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf 2 := by
  let Q:=(halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
  let hf:=halfTurnQuadCanonical_finite k c hk hc
  let z:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf 3
  let d:=_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL k (zero_lt_one.trans hk)
  have hz:=halfTurnFour_unit_summit k c hk hc
  have hnorm : ‖((d•z : ℍ) : ℂ)‖=k:=by
    rw [_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe,norm_mul,Complex.norm_real,Real.norm_eq_abs,
      abs_of_pos (zero_lt_one.trans hk),hz.1,mul_one]
  have hpoly : (d•z).re^2+(d•z).im^2-2*c*(d•z).re+k=0:=by
    have he:=halfturn_radial_side_value_scale w z k (zero_lt_one.trans hk) hn hz.1
    have hz0 : z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)=0:=by
      have hp:=hz.2
      change z.re^2+z.im^2-2*c*z.re+k=0 at hp
      simpa only [hn,hck,div_mul_eq_mul_div,mul_div_assoc] using hp
    rw [hz0,mul_zero] at he
    simpa [hn,hck,div_mul_eq_mul_div,mul_div_assoc] using he
  have hkr:=(nativeSideCoordinates_re_eq_radius k (zero_lt_one.trans hk) (d•z)).mpr hnorm
  have hki:=(nativeSideCoordinates_circle_zero k c (by linarith only [hk,hc]) (d•z)).mpr hpoly
  apply _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate_injective
  rw [halfTurnFour_native_vertex_coordinate]
  apply Complex.ext
  · simpa [kleinSubdivisionVertices4] using hkr
  · simpa [kleinSubdivisionVertices4,hkr] using hki

/-- The two genuine summit vertices are distinct points of the original polygon. -/
theorem halfTurnFour_summits_ne (k c : ℝ) (hk : 1<k) (hc : k+1<2*c) :
    _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex (halfTurnQuadCanonicalSupport k c hk hc).toDiscPolygon
