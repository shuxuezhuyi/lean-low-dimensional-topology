theorem halfTurnFivePairing_paired_index (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re)) (i : Fin 5) :
    (halfTurnFivePairing u t hu hut w hw hn hc).paired
      (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
        (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc) i)=
      _root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
        (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc) (Equiv.swap 2 4 i) := by
  dsimp only [halfTurnFivePairing,Equiv.trans_apply]
  rw [Equiv.symm_apply_apply]

/-- Every real nonvertex side point has the original opposite-side neighborhood.
The strict other inequalities are derived from the actual source polygon itself. -/
theorem halfTurnFivePairing_opposition_index (u t : ℝ) (hu : 1<u) (hut : u<t) (w : ℍ)
    (hw : 0<w.re) (hn : w.re^2+w.im^2=t^2) (hc : t^2+1<2*(t^2/w.re))
    (i : Fin 5) (x : ℍ)
    (hx : x∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc) i)
    (hv : x∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
      (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc))) :
    (halfTurnFivePairing u t hu hut w hw hn hc).OppositeSideNeighborhoods
      (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv (halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc)
        (halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc) i) x := by
  let Q:=halfTurnFiveDiscPolygon u t (t^2/w.re) hu hut hc
  let hf:=halfTurnFiveDiscPolygon_finite u t (t^2/w.re) hu hut hc
  let P:=_root_.LowDimensionalTopology.Geometry.Polygon.finiteDiscPoincarePolygon Q hf
  let S:=halfTurnFivePairing u t hu hut w hw hn hc
  let e:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSideEquiv Q hf
  let E:=halfTurnFiveElement u t (lt_trans zero_lt_one hu) (lt_trans zero_lt_one (hu.trans hut)) w
  have hE : S.element (e i)=E i:=halfTurnFivePairing_element_index u t hu hut w hw hn hc i
  have hPair : S.paired (e i)=e (Equiv.swap 2 4 i):=
    halfTurnFivePairing_paired_index u t hu hut w hw hn hc i
  have hy : E i x∈_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonSide Q (Equiv.swap 2 4 i):=by
    have him : S.element (e i) x∈(S.paired (e i)).val:=by
      rw [←S.side_image]
      exact ⟨x,hx,rfl⟩
    rw [hE,hPair] at him
    exact him
  have hvy : E i x∉range (_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygonVertex Q hf):=by
    have hh:=_root_.LowDimensionalTopology.Geometry.Polygon.finitePolygon_pairing_nonvertex Q hf S i hx hv
    rwa [hE] at hh
  let h:=halfTurnFive_band_parameters u t hu hut
  have hsx:=halfTurnQuadRefined_native_side_strict (t^2) (t^2/w.re) (u^2)
    h.1 hc h.2.1 h.2.2 i x hx hv
  have hsy:=halfTurnQuadRefined_native_side_strict (t^2) (t^2/w.re) (u^2)
    h.1 hc h.2.1 h.2.2 (Equiv.swap 2 4 i) (E i x) hy hvy
  let R : Set ℍ:={z | 1≤‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖≤t^2 ∧ 0≤z.re ∧
    0≤z.re^2+z.im^2-2*(w.re^2+w.im^2)/w.re*z.re+(w.re^2+w.im^2)}
  have hC : P.carrier=R:=by
    ext z
    simpa only [P,Q,R,halfTurnFiveDiscPolygon,mem_ofPred_eq,hn,div_mul_eq_mul_div,mul_div_assoc] using
      halfTurnQuadRefined_native_carrier (t^2) (t^2/w.re) (u^2) h.1 hc h.2.1 h.2.2 z
  let : IsIsometricSMul S.Generated ℍ:=⟨fun g=>g.val.isometry⟩
  apply (S.oppositeSideNeighborhoods_iff_interior (e i) x).mpr
  change x∈interior (P.carrier ∪ (fun z : ℍ=>S.element (e i) z) ⁻¹' P.carrier)
  rw [hE,hC]
  have hup : 0<u:=lt_trans zero_lt_one hu
  have htp : 0<t:=lt_trans zero_lt_one (hu.trans hut)
  have hkp : 0<t^2:=sq_pos_of_pos htp
  fin_cases i
  · exact sideOpposition_axis_side_union_germ (t^2) u hup w x
      (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hsx)
      (by simpa [E,halfTurnFiveElement,Equiv.swap_apply_def,hn,mul_div_assoc] using hsy)
  · exact sideOpposition_axis_side_union_germ (t^2) (u*t) (mul_pos hup htp) w x
      (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hsx)
      (by simpa [E,halfTurnFiveElement,Equiv.swap_apply_def,hn,mul_div_assoc] using hsy)
  · change x∈interior (R ∪ (fun z : ℍ=>
      ((_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry (_root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL (t^2) hkp))⁻¹ : ℍ≃ᵢℍ) z) ⁻¹' R)
    simp_rw [halfTurnNative_inverse_apply]
    exact sideOpposition_top_side_union_germ (t^2) hkp w x
      (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hsx)
      (by simpa [E,halfTurnFiveElement,Equiv.swap_apply_def,hn,mul_div_assoc,
        halfTurnNative_inverse_apply] using hsy)
  · exact sideOpposition_third_side_union_germ (t^2) w x hw
      (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hsx)
      (by simpa [E,halfTurnFiveElement,Equiv.swap_apply_def,hn,mul_div_assoc] using hsy)
  · exact sideOpposition_bottom_side_union_germ (t^2) hkp w x
      (by simpa [hn,div_mul_eq_mul_div,mul_div_assoc] using hsx)
      (by simpa [E,halfTurnFiveElement,Equiv.swap_apply_def,hn,mul_div_assoc] using hsy)

end LowDimensionalTopology.Geometry.Fuchsian


