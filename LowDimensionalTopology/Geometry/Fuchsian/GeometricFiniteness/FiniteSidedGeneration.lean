/-- The genuine side-pairing set is exactly the range of the actual side-to-element map. -/
theorem fuchsianSidePairingElements_eq_range
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} {D : Set P.domain.carrier}
    (hD : IsConvexFuchsianPolygon P D) :
    fuchsianSidePairingElements P D = Set.range (fuchsianSideElement hD) := by
  ext g
  constructor
  · rintro ⟨hg,hS⟩
    let s : FuchsianPolygonSides P D := ⟨closure D ∩ fuchsianDomainTile P D g,hS⟩
    refine ⟨s,?_⟩
    exact ((hD.existsUnique_side_element s.property).choose_spec.2 g ⟨hg,rfl⟩).symm
  · rintro ⟨s,rfl⟩
    refine ⟨(fuchsianSideElement_spec hD s).1,?_⟩
    rw [← (fuchsianSideElement_spec hD s).2]
    exact s.property

/-- A genuine finite-sided polygon gives finite generation of the original actual subgroup. -/
theorem finite_sided_fuchsianPolygon_finitelyGenerated
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} {D : Set P.domain.carrier}
    (hD : IsConvexFuchsianPolygon P D) (hFin : Finite (FuchsianPolygonSides P D)) : H.FG := by
  have : Finite (FuchsianPolygonSides P D) := hFin
  apply (Group.fg_iff_subgroup_fg H).mp
  apply Group.fg_iff.mpr
  refine ⟨fuchsianSidePairingElements P D,side_pairing_elements_generate hD,?_⟩
  rw [fuchsianSidePairingElements_eq_range hD]
  exact Set.finite_range _

/-- Every genuine element of a subgroup generated by a set uses only finitely many generators. -/
theorem group_mem_closure_finite_subset {G : Type*} [Group G] (S : Set G)
    {g : G} (hg : g ∈ Subgroup.closure S) :
    ∃ T : Set G, T.Finite ∧ T ⊆ S ∧ g ∈ Subgroup.closure T := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨{x},finite_singleton x,singleton_subset_iff.mpr hx,Subgroup.subset_closure (mem_singleton x)⟩
  | one => exact ⟨∅,finite_empty,empty_subset S,(Subgroup.closure ∅).one_mem⟩
  | mul x y _ _ hx hy =>
    obtain ⟨T,hTf,hTS,hxT⟩ := hx
    obtain ⟨U,hUf,hUS,hyU⟩ := hy
    refine ⟨T ∪ U,hTf.union hUf,union_subset hTS hUS,?_⟩
    exact (Subgroup.closure (T ∪ U)).mul_mem
      (Subgroup.closure_mono subset_union_left hxT)
      (Subgroup.closure_mono subset_union_right hyU)
  | inv x _ hx =>
    obtain ⟨T,hTf,hTS,hxT⟩ := hx
    exact ⟨T,hTf,hTS,(Subgroup.closure T).inv_mem hxT⟩

/-- Finite generation extracts a finite subset from any genuine generating set. -/
theorem finite_subset_of_group_generating_set {G : Type*} [Group G]
    (hG : Group.FG G) (S : Set G) (hS : Subgroup.closure S = ⊤) :
    ∃ T : Set G, T.Finite ∧ T ⊆ S ∧ Subgroup.closure T = ⊤ := by
  classical
  obtain ⟨F,hFgen,hF⟩ := Group.fg_iff.mp hG
  have : Finite F := hF.to_subtype
  have hex (x : F) : ∃ T : Set G, T.Finite ∧ T ⊆ S ∧ x.val ∈ Subgroup.closure T :=
    group_mem_closure_finite_subset S (hS ▸ Subgroup.mem_top x.val)
  choose T hTf hTS hxT using hex
  let U : Set G := ⋃ x : F,T x
  have hU : U.Finite := Set.finite_iUnion hTf
  have hUS : U ⊆ S := iUnion_subset hTS
  refine ⟨U,hU,hUS,?_⟩
  apply top_unique
  rw [←hFgen]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  exact Subgroup.closure_mono (subset_iUnion T ⟨x,hx⟩) (hxT ⟨x,hx⟩)

/-- For the original finitely generated group, finitely many actual side-pairing elements
of any genuine polygon already generate the whole actual group. -/
theorem finitelyGenerated_finite_sidePairing_generators
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} {D : Set P.domain.carrier}
    (hD : IsConvexFuchsianPolygon P D) (hH : H.FG) :
    ∃ T : Set H, T.Finite ∧ T ⊆ fuchsianSidePairingElements P D ∧ Subgroup.closure T = ⊤ :=
  finite_subset_of_group_generating_set ((Group.fg_iff_subgroup_fg H).mpr hH)
    (fuchsianSidePairingElements P D) (side_pairing_elements_generate hD)

/-- A true free Dirichlet center exists for every original unit-disc Fuchsian group. -/
theorem fuchsian_exists_free_dirichlet_center
    {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) : ∃ w : P.domain.carrier, IsDirichletCenter P w := by
  obtain ⟨w,hw⟩ := (P.countable_complement (fuchsianEllipticPoints_countable P)).1.nonempty
  refine ⟨w,?_⟩
  change ¬¬IsDirichletCenter P w at hw
  exact not_not.mp hw

/-- The original existence condition, on literal actual sides. -/
def HasFiniteSidedFuchsianPolygon {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) : Prop :=
  ∃ D : Set P.domain.carrier, IsConvexFuchsianPolygon P D ∧ Finite (FuchsianPolygonSides P D)

/-- The universal finite-sidedness condition. -/
def EveryFuchsianPolygonFiniteSided {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) : Prop :=
  ∀ D : Set P.domain.carrier, IsConvexFuchsianPolygon P D → Finite (FuchsianPolygonSides P D)

/-- Universal finite-sidedness gives a finite-sided polygon by choosing a free Dirichlet center. -/
theorem EveryFuchsianPolygonFiniteSided.exists
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} (h : EveryFuchsianPolygonFiniteSided P) :
    HasFiniteSidedFuchsianPolygon P := by
  obtain ⟨w,hw⟩ := fuchsian_exists_free_dirichlet_center P
  exact ⟨dirichletDomain P w,dirichletDomain_isConvexFuchsianPolygon P w hw,h _ (dirichletDomain_isConvexFuchsianPolygon P w hw)⟩

/-- implies actual finite generation, without extra elliptic exclusions. -/
theorem HasFiniteSidedFuchsianPolygon.finitelyGenerated
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} (h : HasFiniteSidedFuchsianPolygon P) : H.FG := by
  obtain ⟨D,hD,hFin⟩ := h
  exact finite_sided_fuchsianPolygon_finitelyGenerated hD hFin

/-- The original universal finite Nielsen-core area condition. -/
def HasFiniteNielsenCoreArea {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H)
    (hH : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H) : Prop :=
  ∀ D : Set P.domain.carrier, IsConvexFuchsianPolygon P D → fuchsianNielsenCoreArea P hH D < ⊤

/-- Finiteness in one genuine polygon is exactly finiteness in every genuine polygon. -/
theorem finiteNielsenCoreArea_iff_one {H : Subgroup Mobius.complexMobiusGroup}
    (P : UnitDiscFuchsianGroup H) (hH : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.IsNonElementary H)
    {D : Set P.domain.carrier} (hD : IsConvexFuchsianPolygon P D) :
    HasFiniteNielsenCoreArea P hH ↔ fuchsianNielsenCoreArea P hH D < ⊤ := by
  constructor
  · exact fun h => h D hD
  · intro h Q hQ
    rw [fuchsianNielsenCoreArea_independent P hH hQ.locallyFinite.fundamental hD.locallyFinite.fundamental]
    exact h

/-- In any genuine original polygon, finite generation is equivalent to a finite
subcollection of its actual side-pairing elements generating the whole original group. -/
theorem finitelyGenerated_iff_finite_sidePairing_generators
    {H : Subgroup Mobius.complexMobiusGroup}
    {P : UnitDiscFuchsianGroup H} {D : Set P.domain.carrier} (hD : IsConvexFuchsianPolygon P D) :
    H.FG ↔ ∃ T : Set H, T.Finite ∧ T ⊆ fuchsianSidePairingElements P D ∧
      Subgroup.closure T = ⊤ := by
  constructor
  · exact finitelyGenerated_finite_sidePairing_generators hD
  · rintro ⟨T,hT,_hTS,hgen⟩
    exact (Group.fg_iff_subgroup_fg H).mp (Group.fg_iff.mpr ⟨T,hgen,hT⟩)

end LowDimensionalTopology.Geometry.Fuchsian
