def dyadicPentagonBaseNormals : Fin 4 → ℂ :=
  ![torusCircleNormal (-1) 1, -torusCircleNormal (-2) 2,
    torusCircleNormal (-2) (-1), torusCircleNormal 1 2]

def dyadicPentagonBaseThresholds : Fin 4 → ℝ :=
  ![torusCircleThreshold (-1) 1, -torusCircleThreshold (-2) 2,
    torusCircleThreshold (-2) (-1), torusCircleThreshold 1 2]

theorem dyadicPentagonBaseQuad_klein : dyadicPentagonBaseQuad =
    torusKleinCutRegion dyadicPentagonBaseNormals dyadicPentagonBaseThresholds := by
  ext z
  constructor
  · rintro ⟨⟨h₀, h₁⟩, h₂, h₃⟩ i
    fin_cases i
    · apply (torusCircleQ_klein_pos_iff (-1) 1 z).mp
      dsimp [torusCircleQ]
      linarith
    · apply (torusCircleQ_klein_neg_iff (-2) 2 z).mp
      dsimp [torusCircleQ]
      linarith
    · exact (torusCircleQ_klein_pos_iff (-2) (-1) z).mp h₂
    · exact (torusCircleQ_klein_pos_iff 1 2 z).mp h₃
  · intro hz
    have h₀ := (torusCircleQ_klein_pos_iff (-1) 1 z).mpr (hz 0)
    have h₁ := (torusCircleQ_klein_neg_iff (-2) 2 z).mpr (hz 1)
    have h₂ := (torusCircleQ_klein_pos_iff (-2) (-1) z).mpr (hz 2)
    have h₃ := (torusCircleQ_klein_pos_iff 1 2 z).mpr (hz 3)
    refine ⟨⟨?_, ?_⟩, h₂, h₃⟩ <;> dsimp [torusCircleQ] at h₀ h₁ <;> linarith

theorem dyadicPentagonBaseQuad_hConvex : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex dyadicPentagonBaseQuad := by
  rw [dyadicPentagonBaseQuad_klein]
  exact torusKleinCutRegion_hConvex _ _

theorem dyadicPentagonBaseQuad_isConnected : IsConnected dyadicPentagonBaseQuad :=
  ⟨⟨_, dyadicPentagonBaseQuad_probe_mem⟩, dyadicPentagonBaseQuad_hConvex.isPreconnected⟩

theorem dyadicPentagonBaseQuad_closure : closure dyadicPentagonBaseQuad =
    torusKleinClosedRegion dyadicPentagonBaseNormals dyadicPentagonBaseThresholds := by
  rw [dyadicPentagonBaseQuad_klein]
  exact torusKleinCutRegion_closure _ _ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (3 / 2) (by norm_num))
    (dyadicPentagonBaseQuad_klein ▸ dyadicPentagonBaseQuad_probe_mem)

theorem dyadicPentagonBaseQuad_mem_closure_iff (z : ℍ) : z ∈ closure dyadicPentagonBaseQuad ↔
    1 ≤ Complex.normSq (z : ℂ) ∧ Complex.normSq (z : ℂ) ≤ 4 ∧
    0 ≤ torusCircleQ (-2) (-1) z ∧ 0 ≤ torusCircleQ 1 2 z := by
  rw [dyadicPentagonBaseQuad_closure]
  constructor
  · intro hz
    have h₀ := (torusCircleQ_klein_nonneg_iff (-1) 1 z).mpr (hz 0)
    have h₁ := (torusCircleQ_klein_nonpos_iff (-2) 2 z).mpr (hz 1)
    have h₂ := (torusCircleQ_klein_nonneg_iff (-2) (-1) z).mpr (hz 2)
    have h₃ := (torusCircleQ_klein_nonneg_iff 1 2 z).mpr (hz 3)
    refine ⟨?_, ?_, h₂, h₃⟩ <;> dsimp [torusCircleQ] at h₀ h₁ <;> linarith
  · rintro ⟨h₀, h₁, h₂, h₃⟩ i
    fin_cases i
    · apply (torusCircleQ_klein_nonneg_iff (-1) 1 z).mp
      dsimp [torusCircleQ]
      linarith
    · apply (torusCircleQ_klein_nonpos_iff (-2) 2 z).mp
      dsimp [torusCircleQ]
      linarith
    · exact (torusCircleQ_klein_nonneg_iff (-2) (-1) z).mp h₂
    · exact (torusCircleQ_klein_nonneg_iff 1 2 z).mp h₃

theorem dyadicPentagonPentagon_frontier_null : volume (frontier dyadicPentagonPentagon) = 0 :=
  torus_null_frontier_inter _ _ (torusVertical_gt_frontier_null 1)
    (torus_null_frontier_inter _ _ (torusVertical_lt_frontier_null 2)
      (torus_null_frontier_inter _ _ (torusCircleQ_pos_frontier_null 1 (7 / 5) (by norm_num))
        (torus_null_frontier_inter _ _ (torusCircleQ_pos_frontier_null (4 / 3) (3 / 2) (by norm_num))
          (torusCircleQ_pos_frontier_null (10 / 7) 2 (by norm_num)))))

theorem dyadicPentagonBaseQuad_frontier_null : volume (frontier dyadicPentagonBaseQuad) = 0 := by
  have hn₀ : {z : ℍ | 1 < Complex.normSq (z : ℂ)} = {z | 0 < torusCircleQ (-1) 1 z} := by
    ext z
    dsimp [torusCircleQ]
    constructor <;> intro h <;> linarith
  have hn₁ : {z : ℍ | Complex.normSq (z : ℂ) < 4} = {z | torusCircleQ (-2) 2 z < 0} := by
    ext z
    dsimp [torusCircleQ]
    constructor <;> intro h <;> linarith
  have hnull₀ : volume (frontier ({z : ℍ | 1 < Complex.normSq (z : ℂ)} : Set ℍ)) = 0 := by
    rw [hn₀]
    exact torusCircleQ_pos_frontier_null (-1) 1 (by norm_num)
  have hnull₁ : volume (frontier ({z : ℍ | Complex.normSq (z : ℂ) < 4} : Set ℍ)) = 0 := by
    rw [hn₁]
    exact torusCircleQ_neg_frontier_null (-2) 2 (by norm_num)
  exact torus_null_frontier_inter _ _
    (torus_null_frontier_inter _ _ hnull₀ hnull₁)
    (torus_null_frontier_inter _ _ (torusCircleQ_pos_frontier_null (-2) (-1) (by norm_num))
      (torusCircleQ_pos_frontier_null 1 2 (by norm_num)))

def dyadicPentagonCenter : ℍ := _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (Real.sqrt 2) (by positivity)

theorem dyadicPentagonG_den (z : ℍ) : Complex.normSq (2 * (z : ℂ) + 3) =
    4 * Complex.normSq (z : ℂ) + 12 * z.re + 9 := by
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonG_im (z : ℍ) : (dyadicPentagonG z).im =
    z.im / Complex.normSq (2 * (z : ℂ) + 3) := by
  change (((dyadicPentagonG z : ℍ) : ℂ)).im = _
  rw [dyadicPentagonG_coe, Complex.div_im]
  simp [Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonF_center : dyadicPentagonF dyadicPentagonCenter =
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (2 * Real.sqrt 2) (by positivity) := by
  apply UpperHalfPlane.ext
  rw [dyadicPentagonF_coe]
  norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.ext_iff]

theorem dyadicPentagonF_inv_center : (dyadicPentagonF⁻¹) dyadicPentagonCenter =
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (Real.sqrt 2 / 2) (by positivity) := by
  apply dyadicPentagonF.injective
  rw [IsometryEquiv.apply_inv_self]
  apply UpperHalfPlane.ext
  rw [dyadicPentagonF_coe]
  norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.ext_iff]
  ring

theorem dyadicPentagonG_center : dyadicPentagonG dyadicPentagonCenter =
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (24 / 17) (Real.sqrt 2 / 17) (by positivity) := by
  apply UpperHalfPlane.ext
  apply Complex.ext
  · change (dyadicPentagonG dyadicPentagonCenter).re = _
    rw [dyadicPentagonG_re, dyadicPentagonG_den]
    norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply,
      ← pow_two]
  · change (dyadicPentagonG dyadicPentagonCenter).im = _
    rw [dyadicPentagonG_im, dyadicPentagonG_den]
    norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply,
      ← pow_two]

theorem dyadicPentagonG_inv_center : (dyadicPentagonG⁻¹) dyadicPentagonCenter =
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (-24 / 17) (Real.sqrt 2 / 17) (by positivity) := by
  apply dyadicPentagonG.injective
  rw [IsometryEquiv.apply_inv_self]
  symm
  apply UpperHalfPlane.ext
  apply Complex.ext
  · change (dyadicPentagonG (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (-24 / 17) (Real.sqrt 2 / 17)
    _)).re = _
    rw [dyadicPentagonG_re, dyadicPentagonG_den]
    norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply,
      div_pow, ← pow_two]
  · change (dyadicPentagonG (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (-24 / 17) (Real.sqrt 2 / 17)
    _)).im = _
    rw [dyadicPentagonG_im, dyadicPentagonG_den]
    norm_num [dyadicPentagonCenter, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply,
      div_pow, ← pow_two]
    ring

theorem dyadicPentagonNativeClosedDirichlet_subset :
    nativeClosedDirichlet dyadicPentagonNativeGroup dyadicPentagonCenter ⊆ closure dyadicPentagonBaseQuad := by
  intro z hz
  have hF : dyadicPentagonF ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inl rfl)
  have hG : dyadicPentagonG ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inr rfl)
  have h₁ := hz ⟨dyadicPentagonF, hF⟩
  have h₂ := hz ⟨dyadicPentagonF⁻¹, dyadicPentagonNativeGroup.inv_mem hF⟩
  have h₃ := hz ⟨dyadicPentagonG, hG⟩
  have h₄ := hz ⟨dyadicPentagonG⁻¹, dyadicPentagonNativeGroup.inv_mem hG⟩
  change dist z dyadicPentagonCenter ≤ dist z (dyadicPentagonF dyadicPentagonCenter) at h₁
  change dist z dyadicPentagonCenter ≤ dist z ((dyadicPentagonF⁻¹) dyadicPentagonCenter) at h₂
  change dist z dyadicPentagonCenter ≤ dist z (dyadicPentagonG dyadicPentagonCenter) at h₃
  change dist z dyadicPentagonCenter ≤ dist z ((dyadicPentagonG⁻¹) dyadicPentagonCenter) at h₄
  rw [dyadicPentagonF_center, dyadicPentagonCenter, torus_metricProbe_dist_le_iff] at h₁
  rw [dyadicPentagonF_inv_center, dyadicPentagonCenter, torus_metricProbe_dist_le_iff] at h₂
  rw [dyadicPentagonG_center, dyadicPentagonCenter, torus_metricProbe_dist_le_iff] at h₃
  rw [dyadicPentagonG_inv_center, dyadicPentagonCenter, torus_metricProbe_dist_le_iff] at h₄
  norm_num at h₁ h₂ h₃ h₄
  have hs : 0 < Real.sqrt (2 : ℝ) := by positivity
  have hs3 : Real.sqrt (2 : ℝ) ^ 3 = 2 * Real.sqrt (2 : ℝ) := by
    calc
      Real.sqrt (2 : ℝ) ^ 3 = Real.sqrt (2 : ℝ) ^ 2 * Real.sqrt (2 : ℝ) := by ring
      _ = _ := by rw [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
  have ho : 0 ≤ Real.sqrt (2 : ℝ) * (4 - Complex.normSq (z : ℂ)) := by nlinarith only [h₁, hs3]
  have hi : 0 ≤ Real.sqrt (2 : ℝ) * (Complex.normSq (z : ℂ) - 1) := by nlinarith only [h₂, hs3]
  have hp : 0 ≤ Real.sqrt (2 : ℝ) * (Complex.normSq (z : ℂ) - 3 * z.re + 2) := by
    nlinarith only [h₃, hs3]
  have hn : 0 ≤ Real.sqrt (2 : ℝ) * (Complex.normSq (z : ℂ) + 3 * z.re + 2) := by
    nlinarith only [h₄, hs3]
  have ho' := (mul_nonneg_iff_of_pos_left hs).mp ho
  have hi' := (mul_nonneg_iff_of_pos_left hs).mp hi
  have hp' := (mul_nonneg_iff_of_pos_left hs).mp hp
  have hn' := (mul_nonneg_iff_of_pos_left hs).mp hn
  rw [dyadicPentagonBaseQuad_mem_closure_iff]
  refine ⟨by linarith, by linarith, ?_, ?_⟩ <;> dsimp [torusCircleQ] <;> linarith

theorem dyadicPentagonBaseQuad_closure_meetsEveryOrbit :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.MeetsEveryOrbit dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad) := by
  intro z
  obtain ⟨g, hg⟩ := nativeClosedDirichlet_meets_orbit dyadicPentagonNativeGroup
    dyadicPentagonNativeGroup_discontinuous dyadicPentagonCenter z
  exact ⟨g, dyadicPentagonNativeClosedDirichlet_subset hg⟩

theorem dyadicPentagonBaseQuad_fundamental :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain dyadicPentagonNativeGroup ℍ volume dyadicPentagonBaseQuad := by
  refine ⟨dyadicPentagonBaseQuad_isOpen, dyadicPentagonBaseQuad_isConnected, ?_, dyadicPentagonBaseQuad_frontier_null⟩
  apply exists_fundamentalSet_between _ _ subset_closure dyadicPentagonBaseQuad_closure_meetsEveryOrbit
  intro x hx y hy hxy
  obtain ⟨g, hg⟩ := (Quotient.exact hxy : MulAction.orbitRel dyadicPentagonNativeGroup ℍ x y)
  change g.val y = x at hg
  by_cases he : g.val = 1
  · rw [he] at hg
    exact hg.symm
  · exact False.elim (Set.disjoint_left.mp (dyadicPentagonBaseQuad_wandering g.val g.property he)
      ⟨y, hy, hg⟩ hx)

theorem dyadicPentagonG_lower_one_identity (z : ℍ) :
    torusCircleQ 1 (7 / 5) (dyadicPentagonG z) * Complex.normSq (2 * (z : ℂ) + 3) =
      (Complex.normSq (z : ℂ) - 1) / 5 := by
  have hd := (dyadicPentagonG_den_pos z).ne'
  rw [torusCircleQ, dyadicPentagonG_re, dyadicPentagonG_normSq]
  field_simp
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonG_lower_middle_identity (z : ℍ) :
    torusCircleQ (4 / 3) (3 / 2) (dyadicPentagonG z) * Complex.normSq (2 * (z : ℂ) + 3) =
      -z.re / 6 := by
  have hd := (dyadicPentagonG_den_pos z).ne'
  rw [torusCircleQ, dyadicPentagonG_re, dyadicPentagonG_normSq]
  field_simp
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonG_lower_two_identity (z : ℍ) :
    torusCircleQ (10 / 7) 2 (dyadicPentagonG z) * Complex.normSq (2 * (z : ℂ) + 3) =
      (4 - Complex.normSq (z : ℂ)) / 7 := by
  have hd := (dyadicPentagonG_den_pos z).ne'
  rw [torusCircleQ, dyadicPentagonG_re, dyadicPentagonG_normSq]
  field_simp
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonF_pow_re (n : ℕ) (z : ℍ) :
    ((dyadicPentagonF ^ n) z).re = (2 : ℝ) ^ n * z.re := by
  have hh := congrArg Complex.re (dyadicPentagonF_pow_coe n z)
  simpa only [← Complex.ofReal_pow, Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, sub_zero, UpperHalfPlane.coe_re] using hh

theorem dyadicPentagonF_pow_normSq (n : ℕ) (z : ℍ) :
    Complex.normSq (((dyadicPentagonF ^ n) z : ℍ) : ℂ) =
      (4 : ℝ) ^ n * Complex.normSq (z : ℂ) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change Complex.normSq ((dyadicPentagonF ((dyadicPentagonF ^ n) z) : ℍ) : ℂ) = _
    rw [dyadicPentagonF_normSq, ih, pow_succ]
    ring

theorem dyadicPentagon_dyadic_mul (n : ℕ) : (2 : ℝ) ^ n * (1 / 2 : ℝ) ^ n = 1 := by
  rw [← mul_pow]
  norm_num

theorem dyadicPentagon_strip_outside_circle (z : ℍ) (hx : 1 < z.re) (hx' : z.re < 2)
    (hq : 0 ≤ torusCircleQ 1 2 z) : z ∈ dyadicPentagonPentagon := by
  refine ⟨hx, hx', ?_, ?_, ?_⟩ <;> dsimp [torusCircleQ] at * <;> nlinarith

theorem dyadicPentagon_closed_strip_outside_circle (z : ℍ) (hx : 1 ≤ z.re) (hx' : z.re ≤ 2)
    (hq : 0 ≤ torusCircleQ 1 2 z) : z ∈ closure dyadicPentagonPentagon := by
  rw [dyadicPentagonPentagon_mem_closure_iff]
  refine ⟨hx, hx', ?_, ?_, ?_⟩ <;> dsimp [torusCircleQ] at * <;> nlinarith

theorem dyadicPentagon_closed_positive_circle_re (z : ℍ) (hq : torusCircleQ 1 2 z ≤ 0) :
    1 ≤ z.re ∧ z.re ≤ 2 := by
  have hy := sq_pos_of_pos z.im_pos
  dsimp [torusCircleQ] at hq
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hq
  constructor
  · by_contra hh
    have hp := mul_nonneg_of_nonpos_of_nonpos (by linarith : z.re - 1 ≤ 0)
      (by linarith : z.re - 2 ≤ 0)
    nlinarith
  · by_contra hh
    have hp := mul_nonneg (by linarith : 0 ≤ z.re - 1) (by linarith : 0 ≤ z.re - 2)
    nlinarith

def dyadicPentagonNegativePiece : Set ℍ := dyadicPentagonBaseQuad ∩ {z | z.re < 0}

def dyadicPentagonDyadicPiece (n : ℕ) : Set ℍ :=
  dyadicPentagonBaseQuad ∩ {z | (1 / 2 : ℝ) ^ n < z.re ∧ z.re < 2 * (1 / 2 : ℝ) ^ n}

def dyadicPentagonAssembly : Set ℍ :=
  dyadicPentagonG '' dyadicPentagonNegativePiece ∪ ⋃ n : ℕ, (dyadicPentagonF ^ n) '' dyadicPentagonDyadicPiece n

theorem dyadicPentagonG_negative_piece_subset :
    dyadicPentagonG '' dyadicPentagonNegativePiece ⊆ dyadicPentagonPentagon := by
  rintro _ ⟨z, ⟨⟨⟨hs₁, hs₂⟩, hn, _hp⟩, hx⟩, rfl⟩
  change z.re < 0 at hx
  have hd := dyadicPentagonG_den_pos z
  have he := dyadicPentagonG_side_identity z
  have hq : torusCircleQ 1 2 (dyadicPentagonG z) < 0 := by nlinarith
  have hxr := torusCircleQ_inside_re (by norm_num : (1 : ℝ) < 2) (dyadicPentagonG z) hq
  refine ⟨hxr.1, hxr.2, ?_, ?_, ?_⟩
  · have hh := dyadicPentagonG_lower_one_identity z
    nlinarith
  · have hh := dyadicPentagonG_lower_middle_identity z
    nlinarith
  · have hh := dyadicPentagonG_lower_two_identity z
    nlinarith

theorem dyadicPentagonDyadicPiece_image_subset (n : ℕ) :
    (dyadicPentagonF ^ n) '' dyadicPentagonDyadicPiece n ⊆ dyadicPentagonPentagon := by
  rintro _ ⟨z, ⟨⟨⟨hs₁, hs₂⟩, _hn, hp⟩, hx, hx'⟩, rfl⟩
  have h2n : 0 < (2 : ℝ) ^ n := by positivity
  have hmul := dyadicPentagon_dyadic_mul n
  have hb₁ := mul_lt_mul_of_pos_left hx h2n
  have hb₂ := mul_lt_mul_of_pos_left hx' h2n
  have hx₁ : 1 < ((dyadicPentagonF ^ n) z).re := by rw [dyadicPentagonF_pow_re]; nlinarith
  have hx₂ : ((dyadicPentagonF ^ n) z).re < 2 := by rw [dyadicPentagonF_pow_re]; nlinarith
  apply dyadicPentagon_strip_outside_circle _ hx₁ hx₂
  cases n with
  | zero => exact hp.le
  | succ n =>
    have hpow : 1 ≤ (4 : ℝ) ^ n := one_le_pow₀ (by norm_num)
    have hprod := mul_le_mul_of_nonneg_right hpow (by linarith : 0 ≤ Complex.normSq (z : ℂ))
    have hnorm := dyadicPentagonF_pow_normSq (n + 1) z
    rw [show (4 : ℝ) ^ (n + 1) = (4 : ℝ) ^ n * 4 from pow_succ _ _] at hnorm
    dsimp [torusCircleQ]
    nlinarith

theorem dyadicPentagonAssembly_subset : dyadicPentagonAssembly ⊆ dyadicPentagonPentagon := by
  rintro z (hz | hz)
  · exact dyadicPentagonG_negative_piece_subset hz
  · obtain ⟨n, hn⟩ := mem_iUnion.mp hz
    exact dyadicPentagonDyadicPiece_image_subset n hn

theorem dyadicPentagonNegativePiece_isOpen : IsOpen dyadicPentagonNegativePiece :=
  dyadicPentagonBaseQuad_isOpen.inter (isOpen_lt UpperHalfPlane.continuous_re continuous_const)

theorem dyadicPentagonDyadicPiece_isOpen (n : ℕ) : IsOpen (dyadicPentagonDyadicPiece n) :=
  dyadicPentagonBaseQuad_isOpen.inter ((isOpen_lt continuous_const UpperHalfPlane.continuous_re).inter
    (isOpen_lt UpperHalfPlane.continuous_re continuous_const))

theorem dyadicPentagonAssembly_isOpen : IsOpen dyadicPentagonAssembly :=
  (dyadicPentagonG.toHomeomorph.isOpenMap _ dyadicPentagonNegativePiece_isOpen).union
    (isOpen_iUnion fun n => (dyadicPentagonF ^ n).toHomeomorph.isOpenMap _ (dyadicPentagonDyadicPiece_isOpen n))

theorem dyadicPentagonG_negative_closed (z : ℍ) (hz : z ∈ closure dyadicPentagonBaseQuad)
    (hx : z.re ≤ 0) : dyadicPentagonG z ∈ closure dyadicPentagonPentagon := by
  rw [dyadicPentagonBaseQuad_mem_closure_iff] at hz
  obtain ⟨hs₁, hs₂, hn, _hp⟩ := hz
  have hd := dyadicPentagonG_den_pos z
  have he := dyadicPentagonG_side_identity z
  have hq : torusCircleQ 1 2 (dyadicPentagonG z) ≤ 0 := by nlinarith
  have hxr := dyadicPentagon_closed_positive_circle_re (dyadicPentagonG z) hq
  rw [dyadicPentagonPentagon_mem_closure_iff]
  refine ⟨hxr.1, hxr.2, ?_, ?_, ?_⟩
  · have hh := dyadicPentagonG_lower_one_identity z
    nlinarith
  · have hh := dyadicPentagonG_lower_middle_identity z
    nlinarith
  · have hh := dyadicPentagonG_lower_two_identity z
    nlinarith

theorem dyadicPentagonBaseQuad_closed_to_pentagon (z : ℍ)
    (hz : z ∈ closure dyadicPentagonBaseQuad) :
    ∃ g : dyadicPentagonNativeGroup, g • z ∈ closure dyadicPentagonPentagon := by
  by_cases hx : z.re ≤ 0
  · exact ⟨⟨dyadicPentagonG, Subgroup.subset_closure (Or.inr rfl)⟩,
      dyadicPentagonG_negative_closed z hz hx⟩
  · have hxpos : 0 < z.re := lt_of_not_ge hx
    rw [dyadicPentagonBaseQuad_mem_closure_iff] at hz
    obtain ⟨hs₁, hs₂, _hn, hp⟩ := hz
    have hx2 : z.re ≤ 2 := by
      have hy := sq_nonneg z.im
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hs₂
      nlinarith
    obtain ⟨n, hlow, hupp⟩ := exists_nat_pow_near_of_lt_one
      (by linarith : 0 < z.re / 2) (by linarith : z.re / 2 ≤ 1)
      (by norm_num : (0 : ℝ) < 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)
    refine ⟨⟨dyadicPentagonF ^ n, dyadicPentagonNativeGroup.pow_mem
      (Subgroup.subset_closure (Or.inl rfl)) n⟩, ?_⟩
    change (dyadicPentagonF ^ n) z ∈ closure dyadicPentagonPentagon
    have h2n : 0 < (2 : ℝ) ^ n := by positivity
    have hmul := dyadicPentagon_dyadic_mul n
    rw [show (1 / 2 : ℝ) ^ (n + 1) = (1 / 2 : ℝ) ^ n / 2 by rw [pow_succ]; ring] at hlow
    have hb₁ := mul_lt_mul_of_pos_left hlow h2n
    have hb₂ := mul_le_mul_of_nonneg_left hupp h2n.le
    have hx₁ : 1 ≤ ((dyadicPentagonF ^ n) z).re := by rw [dyadicPentagonF_pow_re]; nlinarith
    have hx₂ : ((dyadicPentagonF ^ n) z).re ≤ 2 := by rw [dyadicPentagonF_pow_re]; nlinarith
    apply dyadicPentagon_closed_strip_outside_circle _ hx₁ hx₂
    cases n with
    | zero => exact hp
    | succ n =>
      have hpow : 1 ≤ (4 : ℝ) ^ n := one_le_pow₀ (by norm_num)
      have hprod := mul_le_mul_of_nonneg_right hpow (by linarith : 0 ≤ Complex.normSq (z : ℂ))
      have hnorm := dyadicPentagonF_pow_normSq (n + 1) z
      rw [show (4 : ℝ) ^ (n + 1) = (4 : ℝ) ^ n * 4 from pow_succ _ _] at hnorm
      dsimp [torusCircleQ]
      nlinarith

theorem dyadicPentagonPentagon_closure_meetsEveryOrbit :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.MeetsEveryOrbit dyadicPentagonNativeGroup ℍ (closure dyadicPentagonPentagon) := by
  intro z
  obtain ⟨g, hg⟩ := dyadicPentagonBaseQuad_closure_meetsEveryOrbit z
  obtain ⟨h, hh⟩ := dyadicPentagonBaseQuad_closed_to_pentagon (g • z) hg
  exact ⟨h * g, by simpa only [mul_smul] using hh⟩

def dyadicPentagonPiece : Option ℕ → Set ℍ
  | none => dyadicPentagonNegativePiece
  | some n => dyadicPentagonDyadicPiece n

def dyadicPentagonLabel : Option ℕ → ℍ ≃ᵢ ℍ
  | none => dyadicPentagonG
  | some n => dyadicPentagonF ^ n

theorem dyadicPentagonLabel_mem (j : Option ℕ) : dyadicPentagonLabel j ∈ dyadicPentagonNativeGroup := by
  cases j with
  | none => exact Subgroup.subset_closure (Or.inr rfl)
  | some n => exact dyadicPentagonNativeGroup.pow_mem (Subgroup.subset_closure (Or.inl rfl)) n

theorem dyadicPentagonPiece_subset (j : Option ℕ) : dyadicPentagonPiece j ⊆ dyadicPentagonBaseQuad := by
  cases j <;> exact inter_subset_left

theorem dyadicPentagonPiece_unique {j k : Option ℕ} {z : ℍ}
    (hj : z ∈ dyadicPentagonPiece j) (hk : z ∈ dyadicPentagonPiece k) : j = k := by
  cases j with
  | none =>
    cases k with
    | none => rfl
    | some n =>
      have hpos : 0 < (1 / 2 : ℝ) ^ n := by positivity
      have hneg : z.re < 0 := hj.2
      have hlow : (1 / 2 : ℝ) ^ n < z.re := hk.2.1
      linarith
  | some m =>
    cases k with
    | none =>
      have hpos : 0 < (1 / 2 : ℝ) ^ m := by positivity
      have hneg : z.re < 0 := hk.2
      have hlow : (1 / 2 : ℝ) ^ m < z.re := hj.2.1
      linarith
    | some n =>
      suffices m = n by exact congrArg some this
      have hm₁ : (1 / 2 : ℝ) ^ m < z.re := hj.2.1
      have hm₂ : z.re < 2 * (1 / 2 : ℝ) ^ m := hj.2.2
      have hn₁ : (1 / 2 : ℝ) ^ n < z.re := hk.2.1
      have hn₂ : z.re < 2 * (1 / 2 : ℝ) ^ n := hk.2.2
      rcases lt_trichotomy m n with hmn | he | hnm
      · have hh := pow_le_pow_of_le_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℝ) ≤ 1) (Nat.succ_le_of_lt hmn)
        rw [pow_succ] at hh
        nlinarith
      · exact he
      · have hh := pow_le_pow_of_le_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℝ) ≤ 1) (Nat.succ_le_of_lt hnm)
        rw [pow_succ] at hh
        nlinarith

theorem dyadicPentagonAssembly_eq : dyadicPentagonAssembly =
    ⋃ j : Option ℕ, dyadicPentagonLabel j '' dyadicPentagonPiece j := by
  ext z
  constructor
  · rintro (h | h)
    · exact mem_iUnion.mpr ⟨none, h⟩
    · obtain ⟨n, hn⟩ := mem_iUnion.mp h
      exact mem_iUnion.mpr ⟨some n, hn⟩
  · intro h
    obtain ⟨j, hj⟩ := mem_iUnion.mp h
    cases j with
    | none => exact Or.inl hj
    | some n => exact Or.inr (mem_iUnion.mpr ⟨n, hj⟩)

theorem dyadicPentagonAssembly_wandering (h : ℍ ≃ᵢ ℍ) (hh : h ∈ dyadicPentagonNativeGroup)
    (hne : h ≠ 1) : Disjoint (h • dyadicPentagonAssembly) dyadicPentagonAssembly := by
  have huniq (k : ℍ ≃ᵢ ℍ) (hk : k ∈ dyadicPentagonNativeGroup) (x y : ℍ)
      (hx : x ∈ dyadicPentagonBaseQuad) (hy : y ∈ dyadicPentagonBaseQuad)
      (hxy : k x = y) : k = 1 ∧ x = y := by
    by_cases he : k = 1
    · refine ⟨he, ?_⟩
      subst k
      exact hxy
    · exact False.elim (disjoint_left.mp (dyadicPentagonBaseQuad_wandering k hk he) ⟨x, hx, hxy⟩ hy)
  apply disjoint_left.mpr
  rintro _ ⟨x, hx, rfl⟩ hy
  rw [dyadicPentagonAssembly_eq] at hx hy
  obtain ⟨j, a, ha, rfl⟩ := mem_iUnion.mp hx
  obtain ⟨k, b, hb, he⟩ := mem_iUnion.mp hy
  let l := dyadicPentagonLabel k
  let r := dyadicPentagonLabel j
  have hkl : (l⁻¹ * h * r) a = b := by
    change l.symm (h (r a)) = b
    change l b = h (r a) at he
    exact (congrArg l.symm he).symm.trans (l.symm_apply_apply b)
  have hu := huniq (l⁻¹ * h * r)
    (dyadicPentagonNativeGroup.mul_mem (dyadicPentagonNativeGroup.mul_mem
      (dyadicPentagonNativeGroup.inv_mem (dyadicPentagonLabel_mem k)) hh) (dyadicPentagonLabel_mem j))
    a b (dyadicPentagonPiece_subset j ha) (dyadicPentagonPiece_subset k hb) hkl
  have hjk : j = k := dyadicPentagonPiece_unique ha (hu.2.symm ▸ hb)
  subst k
  apply hne
  calc
    h = r * (l⁻¹ * h * r) * r⁻¹ := by change h = r * (r⁻¹ * h * r) * r⁻¹; group
    _ = 1 := by rw [hu.1]; group

theorem dyadicPentagonPentagon_inside_circle_mem_assembly (z : ℍ) (hz : z ∈ dyadicPentagonPentagon)
    (hq : torusCircleQ 1 2 z < 0) : z ∈ dyadicPentagonAssembly := by
  let w := dyadicPentagonG.symm z
  have he : dyadicPentagonG w = z := dyadicPentagonG.apply_symm_apply z
  have hd := dyadicPentagonG_den_pos w
  have h₁ := dyadicPentagonG_lower_one_identity w
  have h₂ := dyadicPentagonG_lower_middle_identity w
  have h₃ := dyadicPentagonG_lower_two_identity w
  have h₄ := dyadicPentagonG_side_identity w
  rw [he] at h₁ h₂ h₃ h₄
  have hs₁ : 1 < Complex.normSq (w : ℂ) := by nlinarith [hz.2.2.1]
  have hs₂ : Complex.normSq (w : ℂ) < 4 := by nlinarith [hz.2.2.2.2]
  have hx : w.re < 0 := by nlinarith [hz.2.2.2.1]
  have hn : 0 < torusCircleQ (-2) (-1) w := by nlinarith
  have hp : 0 < torusCircleQ 1 2 w := by dsimp [torusCircleQ]; nlinarith
  exact Or.inl ⟨w, ⟨⟨⟨hs₁, hs₂⟩, hn, hp⟩, hx⟩, he⟩

theorem dyadicPentagonPentagon_radial_band_mem_assembly (z : ℍ) (hz : z ∈ dyadicPentagonPentagon)
    (hq : 0 < torusCircleQ 1 2 z) (n : ℕ)
    (hs₁ : (4 : ℝ) ^ n < Complex.normSq (z : ℂ))
    (hs₂ : Complex.normSq (z : ℂ) < (4 : ℝ) ^ (n + 1)) : z ∈ dyadicPentagonAssembly := by
  let w := (dyadicPentagonF ^ n).symm z
  have he : (dyadicPentagonF ^ n) w = z := (dyadicPentagonF ^ n).apply_symm_apply z
  have hr := dyadicPentagonF_pow_re n w
  have hs := dyadicPentagonF_pow_normSq n w
  rw [he] at hr hs
  have hp₄ : 0 < (4 : ℝ) ^ n := by positivity
  have hp₂ : 0 < (2 : ℝ) ^ n := by positivity
  rw [show (4 : ℝ) ^ (n + 1) = (4 : ℝ) ^ n * 4 from pow_succ _ _] at hs₂
  have hw₁ : 1 < Complex.normSq (w : ℂ) := by nlinarith
  have hw₂ : Complex.normSq (w : ℂ) < 4 := by nlinarith
  have hmul := dyadicPentagon_dyadic_mul n
  have hb₁ : (1 / 2 : ℝ) ^ n < w.re := by nlinarith [hz.1]
  have hb₂ : w.re < 2 * (1 / 2 : ℝ) ^ n := by nlinarith [hz.2.1]
  have hx : 0 < w.re := by nlinarith [pow_pos (by norm_num : (0 : ℝ) < 1 / 2) n]
  have hn : 0 < torusCircleQ (-2) (-1) w := by dsimp [torusCircleQ]; nlinarith
  have hp : 0 < torusCircleQ 1 2 w := by
    cases n with
    | zero =>
      have hw : w = z := he
      simpa only [hw] using hq
    | succ n =>
      have hh : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
      rw [show (2 : ℝ) ^ (n + 1) = (2 : ℝ) ^ n * 2 from pow_succ _ _] at hr
      have hxw : w.re < 1 := by nlinarith [hz.2.1]
      dsimp [torusCircleQ]
      nlinarith
  exact Or.inr (mem_iUnion.mpr ⟨n, w, ⟨⟨⟨hw₁, hw₂⟩, hn, hp⟩, hb₁, hb₂⟩, he⟩)

def dyadicPentagonExcluded : Set ℍ := {z | torusCircleQ 1 2 z = 0} ∪
  ⋃ n : ℕ, {z | torusCircleQ (-(2 : ℝ) ^ n) ((2 : ℝ) ^ n) z = 0}

theorem dyadicPentagonExcluded_null : volume dyadicPentagonExcluded = 0 := by
  apply measure_union_null (torusCircleQ_zero_null 1 2 (by norm_num))
  apply measure_iUnion_null
  intro n
  apply torusCircleQ_zero_null
  have hh : 0 < (2 : ℝ) ^ n := by positivity
  linarith

theorem dyadicPentagonPentagon_outside_excluded_subset :
    dyadicPentagonPentagon ∩ dyadicPentagonExcludedᶜ ⊆ dyadicPentagonAssembly := by
  intro z ⟨hz, hb⟩
  have hqne : torusCircleQ 1 2 z ≠ 0 := fun he => hb (Or.inl he)
  rcases lt_or_gt_of_ne hqne with hq | hq
  · exact dyadicPentagonPentagon_inside_circle_mem_assembly z hz hq
  · have hs : 1 ≤ Complex.normSq (z : ℂ) := by
      have hy := sq_nonneg z.im
      have hx := hz.1
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im]
      nlinarith
    obtain ⟨n, hn₁, hn₂⟩ := exists_nat_pow_near hs (by norm_num : (1 : ℝ) < 4)
    apply dyadicPentagonPentagon_radial_band_mem_assembly z hz hq n _ hn₂
    apply lt_of_le_of_ne hn₁
    intro he
    apply hb
    refine Or.inr (mem_iUnion.mpr ⟨n, ?_⟩)
    have hp : ((2 : ℝ) ^ n) ^ 2 = (4 : ℝ) ^ n := by rw [← pow_mul, Nat.mul_comm, pow_mul]; norm_num
    dsimp [torusCircleQ]
    nlinarith

theorem dyadicPentagonPentagon_subset_closure_assembly : dyadicPentagonPentagon ⊆ closure dyadicPentagonAssembly := by
  let : Measure.IsOpenPosMeasure (volume : Measure ℍ) :=
    ⟨fun U hU hn => ne_of_gt (_root_.LowDimensionalTopology.Geometry.Polygon.native_open_volume_pos hU hn)⟩
  have hd : Dense dyadicPentagonExcludedᶜ :=
    (volume : Measure ℍ).dense_of_ae (measure_eq_zero_iff_ae_notMem.mp dyadicPentagonExcluded_null)
  exact (hd.open_subset_closure_inter dyadicPentagonPentagon_isOpen).trans
    (closure_mono dyadicPentagonPentagon_outside_excluded_subset)

theorem dyadicPentagonPentagon_wandering (h : ℍ ≃ᵢ ℍ) (hh : h ∈ dyadicPentagonNativeGroup)
    (hne : h ≠ 1) : Disjoint (h • dyadicPentagonPentagon) dyadicPentagonPentagon :=
  open_closure_wandering dyadicPentagonNativeGroup dyadicPentagonAssembly dyadicPentagonPentagon
    dyadicPentagonAssembly_isOpen dyadicPentagonPentagon_isOpen dyadicPentagonPentagon_subset_closure_assembly
    dyadicPentagonAssembly_wandering h hh hne

theorem dyadicPentagonPentagon_fundamental :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain dyadicPentagonNativeGroup ℍ volume dyadicPentagonPentagon := by
  refine ⟨dyadicPentagonPentagon_isOpen, dyadicPentagonPentagon_isConnected, ?_, dyadicPentagonPentagon_frontier_null⟩
  apply exists_fundamentalSet_between _ _ subset_closure dyadicPentagonPentagon_closure_meetsEveryOrbit
  intro x hx y hy hxy
  obtain ⟨g, hg⟩ := (Quotient.exact hxy : MulAction.orbitRel dyadicPentagonNativeGroup ℍ x y)
  change g.val y = x at hg
  by_cases he : g.val = 1
  · rw [he] at hg
    exact hg.symm
  · exact False.elim (Set.disjoint_left.mp (dyadicPentagonPentagon_wandering g.val g.property he)
      ⟨y, hy, hg⟩ hx)

theorem dyadicPentagonNativeGroup_original_image :
    (nativeConformalSubgroupMobiusHom dyadicPentagonNativeGroup dyadicPentagonNativeGroup_le_conformal).range =
      dyadicPentagonGroup := by
  let M := nativeConformalSubgroupMobiusHom dyadicPentagonNativeGroup dyadicPentagonNativeGroup_le_conformal
  have hF : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonFSL ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inl rfl)
  have hG : _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonGSL ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inr rfl)
  have hMF : M ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonFSL,
    hF⟩ = _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius dyadicPentagonFSL :=
    nativeConformalSubgroupMobiusHom_matrix _ _ _ _
  have hMG : M ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonGSL,
    hG⟩ = _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius dyadicPentagonGSL :=
    nativeConformalSubgroupMobiusHom_matrix _ _ _ _
  apply le_antisymm
  · rintro f ⟨g, rfl⟩
    have hi (x : ℍ ≃ᵢ ℍ) (hx : x ∈ dyadicPentagonNativeGroup) : M ⟨x, hx⟩ ∈ dyadicPentagonGroup := by
      change x ∈ Subgroup.closure _ at hx
      induction hx using Subgroup.closure_induction with
      | mem x hx =>
        rcases hx with rfl | rfl
        · change M ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonFSL,
          hF⟩ ∈ dyadicPentagonGroup
          rw [hMF]
          exact Subgroup.subset_closure (Or.inl rfl)
        · change M ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonGSL,
          hG⟩ ∈ dyadicPentagonGroup
          rw [hMG]
          exact Subgroup.subset_closure (Or.inr rfl)
      | one =>
        change M (1 : dyadicPentagonNativeGroup) ∈ dyadicPentagonGroup
        rw [map_one]
        exact dyadicPentagonGroup.one_mem
      | mul a b ha hb iha ihb =>
        change M (⟨a, ha⟩ * ⟨b, hb⟩) ∈ dyadicPentagonGroup
        rw [map_mul]
        exact dyadicPentagonGroup.mul_mem iha ihb
      | inv a ha iha =>
        change M (⟨a, ha⟩ : dyadicPentagonNativeGroup)⁻¹ ∈ dyadicPentagonGroup
        rw [map_inv]
        exact dyadicPentagonGroup.inv_mem iha
    exact hi g.val g.property
  · apply (Subgroup.closure_le _).mpr
    rintro f (rfl | rfl)
    · exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonFSL, hF⟩, hMF⟩
    · exact ⟨⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonGSL, hG⟩, hMG⟩

theorem dyadicPentagonData : HalfPlaneFuchsianGroup dyadicPentagonGroup := by
  rw [← dyadicPentagonNativeGroup_original_image]
  let : DiscreteTopology dyadicPentagonNativeGroup := dyadicPentagonNativeGroup_discrete
  exact nativeConformalSubgroup_halfPlaneData _ dyadicPentagonNativeGroup_le_conformal

def dyadicPentagonNativeOriginalEquiv : dyadicPentagonNativeGroup ≃* dyadicPentagonGroup :=
  (MonoidHom.ofInjective (nativeConformalSubgroupMobiusHom_isometry dyadicPentagonNativeGroup
    dyadicPentagonNativeGroup_le_conformal).injective).trans
    (MulEquiv.subgroupCongr dyadicPentagonNativeGroup_original_image)

theorem dyadicPentagonNativeOriginalEquiv_action (g : dyadicPentagonNativeGroup) (z : ℍ) :
    let := dyadicPentagonData.nativeAction
    dyadicPentagonNativeOriginalEquiv g • z = g.val z := by
  let := dyadicPentagonData.nativeAction
  apply _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint_injective
  rw [← dyadicPentagonData.nativeAction_boundary]
  exact nativeConformalSubgroupMobiusHom_action dyadicPentagonNativeGroup dyadicPentagonNativeGroup_le_conformal g z

theorem dyadicPentagonPentagon_original_fundamental :
    let := dyadicPentagonData.nativeAction
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain dyadicPentagonGroup ℍ volume dyadicPentagonPentagon := by
  let := dyadicPentagonData.nativeAction
  have he (g : dyadicPentagonGroup) (z : ℍ) :
      (Homeomorph.refl ℍ) (g • z) =
        dyadicPentagonNativeOriginalEquiv.symm g • (Homeomorph.refl ℍ) z := by
    change g • z = (dyadicPentagonNativeOriginalEquiv.symm g).val z
    have h := dyadicPentagonNativeOriginalEquiv_action (dyadicPentagonNativeOriginalEquiv.symm g) z
    rwa [dyadicPentagonNativeOriginalEquiv.apply_symm_apply] at h
  simpa using _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain.equivariant_preimage dyadicPentagonNativeOriginalEquiv.symm
    (Homeomorph.refl ℍ) he dyadicPentagonPentagon_fundamental

theorem dyadicPentagonPentagon_original_not_locallyFinite :
    let := dyadicPentagonData.nativeAction
    ¬ LocallyFinite (fun g : dyadicPentagonGroup => g • closure dyadicPentagonPentagon) := by
  let := dyadicPentagonData.nativeAction
  change ¬ LocallyFinite (fun g : dyadicPentagonGroup => g • closure dyadicPentagonPentagon)
  intro hlf
  apply dyadicPentagonPentagon_native_not_locallyFinite
  have he (g : dyadicPentagonNativeGroup) :
      dyadicPentagonNativeOriginalEquiv g • closure dyadicPentagonPentagon = g.val '' closure dyadicPentagonPentagon := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y, hy, (dyadicPentagonNativeOriginalEquiv_action g y).symm⟩
    · rintro ⟨y, hy, rfl⟩
      exact ⟨y, hy, dyadicPentagonNativeOriginalEquiv_action g y⟩
  have hf := dyadicPentagonNativeOriginalEquiv.toEquiv.locallyFinite_comp_iff.mpr hlf
  change LocallyFinite (fun g : dyadicPentagonNativeGroup =>
    dyadicPentagonNativeOriginalEquiv g • closure dyadicPentagonPentagon) at hf
  simpa only [he] using hf

def dyadicPentagonSideQ (j : Fin 5) (z : ℍ) : ℝ :=
  ![z.re - 1, 2 - z.re, torusCircleQ 1 (7 / 5) z,
    torusCircleQ (4 / 3) (3 / 2) z, torusCircleQ (10 / 7) 2 z] j

def dyadicPentagonSideLine : Fin 5 → _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine :=
  ![.vertical 1, .vertical 2,
    .circle ((1 + 7 / 5) / 2) ((7 / 5 - 1) / 2) (by norm_num),
    .circle ((4 / 3 + 3 / 2) / 2) ((3 / 2 - 4 / 3) / 2) (by norm_num),
    .circle ((10 / 7 + 2) / 2) ((2 - 10 / 7) / 2) (by norm_num)]

theorem dyadicPentagonSideQ_zero (j : Fin 5) :
    {z | dyadicPentagonSideQ j z = 0} = (dyadicPentagonSideLine j).carrier := by
  fin_cases j
  · ext z
    change z.re - 1 = 0 ↔ z.re = 1
    constructor <;> intro h <;> linarith
  · ext z
    change 2 - z.re = 0 ↔ z.re = 2
    constructor <;> intro h <;> linarith
  · exact torusCircleQ_zero_carrier 1 (7 / 5) (by norm_num)
  · exact torusCircleQ_zero_carrier (4 / 3) (3 / 2) (by norm_num)
  · exact torusCircleQ_zero_carrier (10 / 7) 2 (by norm_num)

def dyadicPentagonSide (j : Fin 5) : Set ℍ :=
  closure dyadicPentagonPentagon ∩ (dyadicPentagonSideLine j).carrier

theorem dyadicPentagonSide_mem_iff (j : Fin 5) (z : ℍ) :
    z ∈ dyadicPentagonSide j ↔ z ∈ closure dyadicPentagonPentagon ∧ dyadicPentagonSideQ j z = 0 := by
  rw [dyadicPentagonSide, ← dyadicPentagonSideQ_zero]
  rfl

theorem dyadicPentagonPentagon_mem_iff (z : ℍ) :
    z ∈ dyadicPentagonPentagon ↔ ∀ j, 0 < dyadicPentagonSideQ j z := by
  constructor
  · intro hz j
    fin_cases j <;> dsimp [dyadicPentagonSideQ]
    · linarith [hz.1]
    · linarith [hz.2.1]
    · exact hz.2.2.1
    · exact hz.2.2.2.1
    · exact hz.2.2.2.2
  · intro hz
    have h₀ := hz 0
    have h₁ := hz 1
    change 0 < z.re - 1 at h₀
    change 0 < 2 - z.re at h₁
    exact ⟨by linarith, by linarith, hz 2, hz 3, hz 4⟩

theorem dyadicPentagonPentagon_closure_mem_iff (z : ℍ) :
    z ∈ closure dyadicPentagonPentagon ↔ ∀ j, 0 ≤ dyadicPentagonSideQ j z := by
  rw [dyadicPentagonPentagon_mem_closure_iff]
  constructor
  · rintro ⟨h₀, h₁, h₂, h₃, h₄⟩ j
    fin_cases j <;> dsimp [dyadicPentagonSideQ]
    · linarith
    · linarith
    · exact h₂
    · exact h₃
    · exact h₄
  · intro hz
    have h₀ := hz 0
    have h₁ := hz 1
    refine ⟨?_, ?_, hz 2, hz 3, hz 4⟩
    · change 0 ≤ z.re - 1 at h₀
      linarith
    · change 0 ≤ 2 - z.re at h₁
      linarith

theorem dyadicPentagonPentagon_frontier_sides : frontier dyadicPentagonPentagon = ⋃ j, dyadicPentagonSide j := by
  classical
  ext z
  change (z ∈ closure dyadicPentagonPentagon ∧ z ∉ interior dyadicPentagonPentagon) ↔ _
  rw [dyadicPentagonPentagon_isOpen.interior_eq]
  constructor
  · rintro ⟨hz, hn⟩
    have hzero : ∃ j, dyadicPentagonSideQ j z = 0 := by
      by_contra hh
      apply hn
      rw [dyadicPentagonPentagon_mem_iff]
      intro j
      exact lt_of_le_of_ne ((dyadicPentagonPentagon_closure_mem_iff z).mp hz j)
        (fun he => hh ⟨j, he.symm⟩)
    obtain ⟨j, hj⟩ := hzero
    exact mem_iUnion.mpr ⟨j, (dyadicPentagonSide_mem_iff j z).mpr ⟨hz, hj⟩⟩
  · intro hz
    obtain ⟨j, hj⟩ := mem_iUnion.mp hz
    obtain ⟨hc, hq⟩ := (dyadicPentagonSide_mem_iff j z).mp hj
    exact ⟨hc, fun hi => (ne_of_gt ((dyadicPentagonPentagon_mem_iff z).mp hi j)) hq⟩

def dyadicPentagonSideWitness : Fin 5 → ℍ :=
  ![_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 1 1 (by norm_num), _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 2 1 (by norm_num),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (6 / 5) (1 / 5) (by norm_num), _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (17 / 12) (1 / 12) (by norm_num),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (12 / 7) (2 / 7) (by norm_num)]

def dyadicPentagonSideWitness' : Fin 5 → ℍ :=
  ![_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 1 2 (by norm_num), _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 2 2 (by norm_num),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (27 / 25) (4 / 25) (by norm_num), _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (172 / 123) (10 / 123) (by norm_num),
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (66 / 35) (8 / 35) (by norm_num)]

theorem dyadicPentagonSideWitness_mem (j : Fin 5) : dyadicPentagonSideWitness j ∈ dyadicPentagonSide j := by
  rw [dyadicPentagonSide_mem_iff, dyadicPentagonPentagon_mem_closure_iff]
  fin_cases j <;> norm_num [dyadicPentagonSideWitness, dyadicPentagonSideQ, torusCircleQ,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply]

theorem dyadicPentagonSideWitness'_mem (j : Fin 5) : dyadicPentagonSideWitness' j ∈ dyadicPentagonSide j := by
  rw [dyadicPentagonSide_mem_iff, dyadicPentagonPentagon_mem_closure_iff]
  fin_cases j <;> norm_num [dyadicPentagonSideWitness', dyadicPentagonSideQ, torusCircleQ,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply]

theorem dyadicPentagonSideWitness_ne (j : Fin 5) : dyadicPentagonSideWitness j ≠ dyadicPentagonSideWitness' j := by
  intro he
  have hr := congrArg UpperHalfPlane.re he
  have hi := congrArg UpperHalfPlane.im he
  fin_cases j
  · norm_num [dyadicPentagonSideWitness, dyadicPentagonSideWitness',
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at hi
  · norm_num [dyadicPentagonSideWitness, dyadicPentagonSideWitness',
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at hi
  · norm_num [dyadicPentagonSideWitness, dyadicPentagonSideWitness',
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at hr
  · norm_num [dyadicPentagonSideWitness, dyadicPentagonSideWitness',
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at hr
  · norm_num [dyadicPentagonSideWitness, dyadicPentagonSideWitness',
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at hr

theorem dyadicPentagonSideWitness_strict (i j : Fin 5) (hij : j ≠ i) :
    0 < dyadicPentagonSideQ j (dyadicPentagonSideWitness i) := by
  fin_cases i <;> fin_cases j <;>
    norm_num [dyadicPentagonSideWitness, dyadicPentagonSideQ, torusCircleQ,
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
      Complex.normSq_apply] at *

theorem dyadicPentagonSide_injective : Function.Injective dyadicPentagonSide := by
  intro i j he
  by_contra hij
  have hm := dyadicPentagonSideWitness_mem i
  rw [he] at hm
  have hzero := ((dyadicPentagonSide_mem_iff j _).mp hm).2
  exact (ne_of_gt (dyadicPentagonSideWitness_strict i j (Ne.symm hij))) hzero

theorem dyadicPentagonSide_geometry (j : Fin 5) :
    IsClosed (dyadicPentagonSide j) ∧ _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex (dyadicPentagonSide j) ∧
      dyadicPentagonSide j ⊆ (dyadicPentagonSideLine j).carrier ∧
      ∃ a ∈ dyadicPentagonSide j, ∃ b ∈ dyadicPentagonSide j, a ≠ b := by
  refine ⟨isClosed_closure.inter (dyadicPentagonSideLine j).isClosed_carrier,
    ?_,
    inter_subset_right, dyadicPentagonSideWitness j, dyadicPentagonSideWitness_mem j,
    dyadicPentagonSideWitness' j, dyadicPentagonSideWitness'_mem j, dyadicPentagonSideWitness_ne j⟩
  intro a ha b hb x hx
  exact ⟨dyadicPentagonPentagon_hConvex.closure a ha.1 b hb.1 hx,
    (dyadicPentagonSideLine j).hConvex a ha.2 b hb.2 hx⟩

theorem dyadicPentagonSide_zero : dyadicPentagonSide 0 = {z : ℍ | z.re = 1} := by
  ext z
  rw [dyadicPentagonSide_mem_iff, dyadicPentagonPentagon_mem_closure_iff]
  change (1 ≤ z.re ∧ z.re ≤ 2 ∧ 0 ≤ torusCircleQ 1 (7 / 5) z ∧
    0 ≤ torusCircleQ (4 / 3) (3 / 2) z ∧ 0 ≤ torusCircleQ (10 / 7) 2 z) ∧
    z.re - 1 = 0 ↔ z.re = 1
  constructor
  · rintro ⟨_, h⟩
    linarith
  · intro hx
    have hy := sq_nonneg z.im
    dsimp [torusCircleQ]
    simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, hx]
    constructor
    · refine ⟨by norm_num, by norm_num, ?_, ?_, ?_⟩ <;> nlinarith
    · norm_num

