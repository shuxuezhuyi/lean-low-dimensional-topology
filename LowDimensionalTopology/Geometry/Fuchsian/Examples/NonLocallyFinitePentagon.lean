  change (1 ≤ z.re ∧ z.re ≤ 2 ∧ 0 ≤ torusCircleQ 1 (7 / 5) z ∧
    0 ≤ torusCircleQ (4 / 3) (3 / 2) z ∧ 0 ≤ torusCircleQ (10 / 7) 2 z) ∧
    2 - z.re = 0 ↔ z.re = 2
  constructor
  · rintro ⟨_, h⟩
    linarith
  · intro hx
    have hy := sq_nonneg z.im
    dsimp [torusCircleQ]
    simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, hx]
    constructor
    · refine ⟨by norm_num, by norm_num, ?_, ?_, ?_⟩ <;> nlinarith
    · norm_num

