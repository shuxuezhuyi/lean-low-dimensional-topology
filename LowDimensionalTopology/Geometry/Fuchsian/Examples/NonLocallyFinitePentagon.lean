theorem dyadicPentagonBaseQuad_probe_mem : _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 (3 / 2) (by norm_num) ∈ dyadicPentagonBaseQuad := by
  norm_num [dyadicPentagonBaseQuad, dyadicPentagonFSector, dyadicPentagonGSector,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
    torusCircleQ, Complex.normSq_apply]

theorem dyadicPentagonNativeGroup_discrete : DiscreteTopology dyadicPentagonNativeGroup := by
  apply _root_.LowDimensionalTopology.Geometry.DiscreteGroups.discreteTopology_of_wandering_open dyadicPentagonBaseQuad dyadicPentagonBaseQuad_isOpen
    ⟨_, dyadicPentagonBaseQuad_probe_mem⟩
