theorem dyadicPentagonF_re (z : ℍ) : (dyadicPentagonF z).re = 2 * z.re := by
  change ((dyadicPentagonF z : ℍ) : ℂ).re = _
  rw [dyadicPentagonF_coe]
  simp

theorem dyadicPentagonQuadSquare_F_quot_eq (p q : closure dyadicPentagonBaseQuad)
    (hpq : p.val = dyadicPentagonF q.val) :
    Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare p) =
      Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare q) := by
  obtain ⟨hq₀, _hq₁, _hqn, _hqp⟩ :=
    (dyadicPentagonBaseQuad_mem_closure_iff q.val).mp q.property
  have hp₁ := ((dyadicPentagonBaseQuad_mem_closure_iff p.val).mp p.property).2.1
  rw [hpq, dyadicPentagonF_normSq] at hp₁
  have hqnorm : Complex.normSq (q.val : ℂ) = 1 := by linarith
  have hpnorm : Complex.normSq (p.val : ℂ) = 4 := by
    rw [hpq, dyadicPentagonF_normSq, hqnorm]
    norm_num
  have hpre : p.val.re = 2 * q.val.re := by rw [hpq, dyadicPentagonF_re]
  have hrel : PuncturedSquareSideIdent (dyadicPentagonQuadSquare q) (dyadicPentagonQuadSquare p) := by
    apply dyadicPentagonPuncturedSquare_horizontal_coords
    · change dyadicPentagonQuadU q.val = 0
      simp [dyadicPentagonQuadU, hqnorm]
    · change dyadicPentagonQuadU p.val = 1
      norm_num [dyadicPentagonQuadU, hpnorm]
    · change dyadicPentagonQuadV q.val = dyadicPentagonQuadV p.val
      dsimp [dyadicPentagonQuadV]
      rw [hqnorm, hpnorm, hpre]
      ring
  exact (Quot.sound hrel).symm

theorem dyadicPentagonQuadSquare_G_quot_eq (p q : closure dyadicPentagonBaseQuad)
    (hpq : p.val = dyadicPentagonG q.val) :
    Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare p) =
      Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare q) := by
  have hqn := ((dyadicPentagonBaseQuad_mem_closure_iff q.val).mp q.property).2.2.1
  have hpp := ((dyadicPentagonBaseQuad_mem_closure_iff p.val).mp p.property).2.2.2
  have hside := dyadicPentagonG_side_identity q.val
  rw [← hpq] at hside
  have hden := dyadicPentagonG_den_pos q.val
  have hqzero : torusCircleQ (-2) (-1) q.val = 0 := by nlinarith
  obtain ⟨hgre, _hgim, hgnorm⟩ := dyadicPentagonG_left_coordinates q.val hqzero
  have hpre : p.val.re = -q.val.re := by rw [hpq, hgre]
  have hpnorm : Complex.normSq (p.val : ℂ) = Complex.normSq (q.val : ℂ) := by
    rw [hpq, hgnorm]
  have hqnum : Complex.normSq (q.val : ℂ) + 3 * q.val.re + 2 = 0 := by
    dsimp [torusCircleQ] at hqzero
    linarith
  have hrel : PuncturedSquareSideIdent (dyadicPentagonQuadSquare q) (dyadicPentagonQuadSquare p) := by
    apply dyadicPentagonPuncturedSquare_vertical_coords
    · change dyadicPentagonQuadV q.val = 0
      dsimp [dyadicPentagonQuadV]
      rw [hqnum, zero_div]
    · change dyadicPentagonQuadV p.val = 1
      dsimp [dyadicPentagonQuadV]
      have hd : 2 * (Complex.normSq (p.val : ℂ) + 2) ≠ 0 := by
        have hn := Complex.normSq_nonneg (p.val : ℂ)
        positivity
      apply (div_eq_iff hd).mpr
      rw [hpre, hpnorm]
      linarith
    · change dyadicPentagonQuadU q.val = dyadicPentagonQuadU p.val
      simp only [dyadicPentagonQuadU, hpnorm]
  exact (Quot.sound hrel).symm

theorem dyadicPentagonQuadSquare_orbit_quot_eq (p q : closure dyadicPentagonBaseQuad)
    (h : MulAction.orbitRel dyadicPentagonNativeGroup ℍ p.val q.val) :
    Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare p) =
      Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare q) := by
  rcases dyadicPentagonBaseQuad_orbit_generator p q h with he | he | he | he | he
  · have hpq : p = q := Subtype.ext he
    rw [hpq]
  · exact dyadicPentagonQuadSquare_F_quot_eq p q he
  · apply Eq.symm
    apply dyadicPentagonQuadSquare_F_quot_eq q p
    rw [he, dyadicPentagonF.apply_symm_apply]
  · exact dyadicPentagonQuadSquare_G_quot_eq p q he
  · apply Eq.symm
    apply dyadicPentagonQuadSquare_G_quot_eq q p
    rw [he, dyadicPentagonG.apply_symm_apply]

theorem dyadicPentagonSquareQuad_normSq (p : PuncturedSquare) :
    Complex.normSq ((dyadicPentagonSquareQuad p).val : ℂ) = 1 + 3 * p.val.1.val := by
  have hy := Real.sq_sqrt (dyadicPentagonSquareHeight_pos p).le
  dsimp [dyadicPentagonSquareQuad, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.normSq_apply]
  dsimp [dyadicPentagonSquareHeight] at *
  nlinarith

theorem dyadicPentagonSquareQuad_side_orbit (p q : PuncturedSquare)
    (h : PuncturedSquareSideIdent p q) :
    MulAction.orbitRel dyadicPentagonNativeGroup ℍ
      (dyadicPentagonSquareQuad p).val (dyadicPentagonSquareQuad q).val := by
  rcases p with ⟨p, hp⟩
  rcases q with ⟨q, hq⟩
  change _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent p q at h
  cases h with
  | horizontal v =>
    let a : PuncturedSquare := ⟨(_root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalZero, v), hp⟩
    let b : PuncturedSquare := ⟨(_root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne, v), hq⟩
    have han : Complex.normSq ((dyadicPentagonSquareQuad a).val : ℂ) = 1 := by
      simpa only [a, _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalZero, mul_zero,
        add_zero] using dyadicPentagonSquareQuad_normSq a
    have hbn : Complex.normSq ((dyadicPentagonSquareQuad b).val : ℂ) = 4 := by
      convert dyadicPentagonSquareQuad_normSq b using 1
      norm_num [b, _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne]
    have hfr : (dyadicPentagonF (dyadicPentagonSquareQuad a).val).re = (dyadicPentagonSquareQuad b).val.re := by
      rw [dyadicPentagonF_re]
      change 2 * ((2 * v.val - 1) * (0 + 1)) = (2 * v.val - 1) * ((0 + 1) + 1)
      ring
    have hfn : Complex.normSq ((dyadicPentagonF (dyadicPentagonSquareQuad a).val : ℍ) : ℂ) =
        Complex.normSq ((dyadicPentagonSquareQuad b).val : ℂ) := by
      rw [dyadicPentagonF_normSq, han, hbn]
      norm_num
    have he : dyadicPentagonF (dyadicPentagonSquareQuad a).val = (dyadicPentagonSquareQuad b).val := by
      apply UpperHalfPlane.ext_re_im hfr
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hfn
      rw [hfr] at hfn
      nlinarith [(dyadicPentagonF (dyadicPentagonSquareQuad a).val).im_pos,
        (dyadicPentagonSquareQuad b).val.im_pos]
    apply (MulAction.orbitRel dyadicPentagonNativeGroup ℍ).symm
    exact ⟨⟨dyadicPentagonF, Subgroup.subset_closure (Or.inl rfl)⟩, he⟩
  | vertical u =>
    let a : PuncturedSquare := ⟨(u, _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalZero), hp⟩
    let b : PuncturedSquare := ⟨(u, _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne), hq⟩
    have han := dyadicPentagonSquareQuad_normSq a
    have hbn := dyadicPentagonSquareQuad_normSq b
    have hleft : torusCircleQ (-2) (-1) (dyadicPentagonSquareQuad a).val = 0 := by
      dsimp [torusCircleQ]
      rw [han]
      change 1 + 3 * u.val - (-2 + -1) * ((2 * 0 - 1) * (u.val + 1)) + -2 * -1 = 0
      ring
    obtain ⟨hgr, _hgi, hgn⟩ := dyadicPentagonG_left_coordinates (dyadicPentagonSquareQuad a).val hleft
    have hbr : -(dyadicPentagonSquareQuad a).val.re = (dyadicPentagonSquareQuad b).val.re := by
      change -((2 * 0 - 1) * (u.val + 1)) = (2 * (0 + 1) - 1) * (u.val + 1)
      ring
    have he : dyadicPentagonG (dyadicPentagonSquareQuad a).val = (dyadicPentagonSquareQuad b).val := by
      have hre := hgr.trans hbr
      apply UpperHalfPlane.ext_re_im hre
      have hnorm : Complex.normSq ((dyadicPentagonG (dyadicPentagonSquareQuad a).val : ℍ) : ℂ) =
          Complex.normSq ((dyadicPentagonSquareQuad b).val : ℂ) := by
        rw [hgn, han, hbn]
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hnorm
      rw [hre] at hnorm
      nlinarith [(dyadicPentagonG (dyadicPentagonSquareQuad a).val).im_pos,
        (dyadicPentagonSquareQuad b).val.im_pos]
    apply (MulAction.orbitRel dyadicPentagonNativeGroup ℍ).symm
    exact ⟨⟨dyadicPentagonG, Subgroup.subset_closure (Or.inr rfl)⟩, he⟩

def dyadicPentagonQuadSquareQuotientMap :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedOrbitQuotient dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad) →
      Quot PuncturedSquareSideIdent :=
  Quotient.lift (fun p => Quot.mk _ (dyadicPentagonQuadSquare p))
    (fun p q h => dyadicPentagonQuadSquare_orbit_quot_eq p q h)

def dyadicPentagonSquareQuadQuotientMap :
    Quot PuncturedSquareSideIdent →
      _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedOrbitQuotient dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad) :=
  Quot.lift (fun p => _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedProjection
    dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad)
    (dyadicPentagonSquareQuad p))
    (fun p q h => Quotient.sound (dyadicPentagonSquareQuad_side_orbit p q h))

/-- The actual closed native quadrilateral quotient is exactly the literal punctured-square gluing. -/
def dyadicPentagonQuadSquareOrbitHomeomorph :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedOrbitQuotient dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad) ≃ₜ
      Quot PuncturedSquareSideIdent where
  toEquiv :=
    { toFun := dyadicPentagonQuadSquareQuotientMap
      invFun := dyadicPentagonSquareQuadQuotientMap
      left_inv := by
        intro q
        induction q using Quotient.inductionOn with
        | h p =>
          change Quotient.mk _ (dyadicPentagonSquareQuad (dyadicPentagonQuadSquare p)) = Quotient.mk _ p
          rw [dyadicPentagonSquareQuad_QuadSquare]
      right_inv := by
        intro q
        induction q using Quot.inductionOn with
        | _ p =>
          change Quot.mk _ (dyadicPentagonQuadSquare (dyadicPentagonSquareQuad p)) = Quot.mk _ p
          rw [dyadicPentagonQuadSquare_SquareQuad] }
  continuous_toFun := by
    apply continuous_quot_lift
    exact continuous_quot_mk.comp dyadicPentagonQuadSquare_continuous
  continuous_invFun := by
    apply continuous_quot_lift
    exact continuous_quot_mk.comp dyadicPentagonSquareQuad_continuous

theorem dyadicPentagonQuadSquareOrbitHomeomorph_apply (p : closure dyadicPentagonBaseQuad) :
    dyadicPentagonQuadSquareOrbitHomeomorph
      (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedProjection dyadicPentagonNativeGroup ℍ
        (closure dyadicPentagonBaseQuad) p) =
        Quot.mk PuncturedSquareSideIdent (dyadicPentagonQuadSquare p) := rfl


/-- The actual quotient of the full original group is a genuine torus with one point removed. -/
def dyadicPentagonQuotientPuncturedTorusHomeomorph :
    _root_.LowDimensionalTopology.Geometry.Surfaces.MobiusDomainQuotient dyadicPentagonData.asFuchsianDisc.domain ≃ₜ PuncturedTorus :=
  dyadicPentagonOriginalOrbitHomeomorph.symm.trans
    (dyadicPentagonBaseQuad_orbitHomeomorph.symm.trans
      (dyadicPentagonQuadSquareOrbitHomeomorph.trans puncturedSquareTorusHomeomorph))

theorem dyadicPentagon_quotient_once_punctured_torus :
    Nonempty (_root_.LowDimensionalTopology.Geometry.Surfaces.MobiusDomainQuotient
      dyadicPentagonData.asFuchsianDisc.domain ≃ₜ
      {z : AddCircle (1 : ℝ) × AddCircle (1 : ℝ) // z ≠ (0, 0)}) :=
  ⟨dyadicPentagonQuotientPuncturedTorusHomeomorph⟩

/--
All assertions, for the literal original group and literal pentagon,
including its actual quotient topology and the original locally finite quadrilateral.
-/
theorem dyadicPentagon_properties_puncturedTorus_quotient_and_locallyFinite_quadrilateral :
    let := dyadicPentagonData.nativeAction
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain dyadicPentagonGroup ℍ volume dyadicPentagonPentagon ∧
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex dyadicPentagonPentagon ∧
      ¬ LocallyFinite (fun g : dyadicPentagonGroup => g • closure dyadicPentagonPentagon) ∧
      frontier dyadicPentagonPentagon = ⋃ j : Fin 5, dyadicPentagonSide j ∧
      Function.Injective dyadicPentagonSide ∧
      (∀ j : Fin 5, IsClosed (dyadicPentagonSide j) ∧ _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex
        (dyadicPentagonSide j) ∧
        dyadicPentagonSide j ⊆ (dyadicPentagonSideLine j).carrier ∧
        ∃ a ∈ dyadicPentagonSide j, ∃ b ∈ dyadicPentagonSide j, a ≠ b) ∧
      Nonempty (_root_.LowDimensionalTopology.Geometry.Surfaces.MobiusDomainQuotient
        dyadicPentagonData.asFuchsianDisc.domain ≃ₜ PuncturedTorus) ∧
      _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsFundamentalDomain dyadicPentagonGroup ℍ volume dyadicPentagonBaseQuad ∧
      LocallyFinite (fun g : dyadicPentagonGroup => g • closure dyadicPentagonBaseQuad) := by
  let := dyadicPentagonData.nativeAction
  obtain ⟨hD, hconv, hnon, hfront, hinj,
    hsides⟩ := dyadicPentagon_isFundamentalDomain_convex_not_locallyFinite_with_five_sides
  exact ⟨hD, hconv, hnon, hfront, hinj, hsides, ⟨dyadicPentagonQuotientPuncturedTorusHomeomorph⟩,
    dyadicPentagonBaseQuad_original_fundamental, dyadicPentagonBaseQuad_original_locallyFinite⟩

