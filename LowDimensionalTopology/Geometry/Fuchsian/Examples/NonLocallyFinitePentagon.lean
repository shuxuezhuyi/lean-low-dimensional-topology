    simpa only [_root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne, zero_add] using hb
  have hv' : a.val.2 = b.val.2 := Subtype.ext hv
  change _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent (a.val.1, a.val.2) (b.val.1, b.val.2)
  rw [ha', hb', ← hv']
  exact _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent.horizontal _

