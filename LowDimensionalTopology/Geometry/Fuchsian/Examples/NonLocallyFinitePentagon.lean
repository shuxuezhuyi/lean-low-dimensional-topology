/-- The native half-plane and the original invariant sphere domain have the same topology. -/
def dyadicPentagonOriginalModelHomeomorph :
    ℍ ≃ₜ dyadicPentagonData.asFuchsianDisc.domain.carrier :=
  _root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneOpenModelHomeomorph

/-- The model homeomorphism intertwines the exact two full group actions. -/
theorem dyadicPentagonOriginalModelHomeomorph_equivariant
    (g : dyadicPentagonNativeGroup) (z : ℍ) :
    dyadicPentagonOriginalModelHomeomorph (g • z) =
      dyadicPentagonNativeOriginalEquiv g • dyadicPentagonOriginalModelHomeomorph z := by
  apply Subtype.ext
  change _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint (g.val z) =
    (dyadicPentagonNativeOriginalEquiv g).val.val (_root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint
      z)
  let := dyadicPentagonData.nativeAction
  exact ((dyadicPentagonData.nativeAction_boundary (dyadicPentagonNativeOriginalEquiv g) z).trans
    (congrArg _root_.LowDimensionalTopology.Geometry.Mobius.halfPlaneBoundaryPoint
      (dyadicPentagonNativeOriginalEquiv_action g z))).symm

/-- The native orbit quotient is homeomorphic to the original full Mobius-domain quotient. -/
def dyadicPentagonOriginalOrbitHomeomorph :
    _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitQuotient dyadicPentagonNativeGroup ℍ ≃ₜ
      _root_.LowDimensionalTopology.Geometry.Surfaces.MobiusDomainQuotient dyadicPentagonData.asFuchsianDisc.domain := by
  apply Homeomorph.Quotient.congr dyadicPentagonOriginalModelHomeomorph
  intro x y
  constructor
  · rintro ⟨g, hg⟩
    change g • y = x at hg
    refine ⟨dyadicPentagonNativeOriginalEquiv g, ?_⟩
    change dyadicPentagonNativeOriginalEquiv g • dyadicPentagonOriginalModelHomeomorph y =
      dyadicPentagonOriginalModelHomeomorph x
    rw [← dyadicPentagonOriginalModelHomeomorph_equivariant, hg]
  · rintro ⟨g, hg⟩
    change g • dyadicPentagonOriginalModelHomeomorph y =
      dyadicPentagonOriginalModelHomeomorph x at hg
    refine ⟨dyadicPentagonNativeOriginalEquiv.symm g, ?_⟩
    apply dyadicPentagonOriginalModelHomeomorph.injective
    rw [dyadicPentagonOriginalModelHomeomorph_equivariant,
      dyadicPentagonNativeOriginalEquiv.apply_symm_apply, hg]

theorem dyadicPentagonOriginalOrbitHomeomorph_apply (z : ℍ) :
    dyadicPentagonOriginalOrbitHomeomorph (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection
      dyadicPentagonNativeGroup ℍ z) =
