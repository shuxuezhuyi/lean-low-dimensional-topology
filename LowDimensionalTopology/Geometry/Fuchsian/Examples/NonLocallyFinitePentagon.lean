    (ha : a.val.2.val = 0) (hb : b.val.2.val = 1)
    (hu : a.val.1.val = b.val.1.val) : PuncturedSquareSideIdent a b := by
  have ha' : a.val.2 = _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalZero := Subtype.ext ha
  have hb' : b.val.2 = _root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne := by
    apply Subtype.ext
    simpa only [_root_.LowDimensionalTopology.Geometry.Surfaces.squareIntervalOne, zero_add] using hb
