theorem dyadicPentagon_eqvGen_preserves_predicate {X : Type*} {r : X → X → Prop}
    {P : X → Prop} (hP : ∀ x y, r x y → (P x ↔ P y))
    {x y : X} (h : Relation.EqvGen r x y) : P x ↔ P y := by
  induction h with
  | rel x y h => exact hP x y h
  | refl x => exact Iff.rfl
  | symm x y h ih => exact ih.symm
  | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz

theorem dyadicPentagon_eqvGen_restrict {X : Type*} {r : X → X → Prop}
    {P : X → Prop} (hP : ∀ x y, r x y → (P x ↔ P y))
    {x y : X} (h : Relation.EqvGen r x y) :
    ∀ (hx : P x) (hy : P y),
      Relation.EqvGen (fun a b : Subtype P => r a.val b.val) ⟨x, hx⟩ ⟨y, hy⟩ := by
  induction h with
  | rel x y h =>
      intro hx hy
      exact .rel _ _ h
  | refl x =>
      intro hx hy
      exact .refl _
  | symm x y h ih =>
      intro hy hx
      exact .symm _ _ (ih hx hy)
  | trans x y z hxy hyz ihxy ihyz =>
      intro hx hz
      have hy := (dyadicPentagon_eqvGen_preserves_predicate hP hxy).mp hx
      exact .trans _ ⟨y, hy⟩ _ (ihxy hx hy) (ihyz hy hz)

noncomputable def dyadicPentagonOpenRestrictionQuotientHomeomorph
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (r : X → X → Prop) (e : Quot r ≃ₜ Y) (U : Set Y) (hU : IsOpen U) :
    Quot (fun x y : {x : X // e (Quot.mk r x) ∈ U} => r x.val y.val) ≃ₜ U := by
  let f : X → Y := fun x => e (Quot.mk r x)
  let P : X → Prop := fun x => f x ∈ U
  let g : Subtype P → U := U.restrictPreimage f
  have hf : IsQuotientMap f := e.isQuotientMap.comp isQuotientMap_quot_mk
  have hg : IsQuotientMap g := hf.restrictPreimage_isOpen hU
  have hrel : ∀ x y, r x y → f x = f y := by
    intro x y h
    exact congrArg e (Quot.sound h)
  let h : Quot (fun x y : Subtype P => r x.val y.val) → U :=
    Quot.lift g (by
      intro x y hxy
      exact Subtype.ext (hrel x.val y.val hxy))
  have hh : IsQuotientMap h :=
    isQuotientMap_quot_mk.of_comp_iff.mp hg
  have hi : Function.Injective h := by
    intro a b hab
    induction a using Quot.inductionOn with
    | _ x =>
      induction b using Quot.inductionOn with
      | _ y =>
        have hxy : Quot.mk r x.val = Quot.mk r y.val :=
          e.injective (congrArg Subtype.val hab)
        apply Quot.eqvGen_sound
        exact dyadicPentagon_eqvGen_restrict (fun a b hab => by
          change f a ∈ U ↔ f b ∈ U
          rw [hrel a b hab]) (Quot.eqvGen_exact hxy) x.property y.property
  exact (isHomeomorph_iff_isQuotientMap_injective.mpr ⟨hh, hi⟩).homeomorph h

abbrev PuncturedSquare :=
  {p : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval ×
    _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval //
    ¬((p.1.val = 0 ∨ p.1.val = 1) ∧ (p.2.val = 0 ∨ p.2.val = 1))}

abbrev PuncturedSquareSideIdent (p q : PuncturedSquare) : Prop :=
  _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent p.val q.val

abbrev PuncturedTorus :=
  {z : AddCircle (1 : ℝ) × AddCircle (1 : ℝ) // z ≠ (0, 0)}

theorem dyadicPentagon_interval_coe_eq_zero_iff (u : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval) :
    (u.val : AddCircle (1 : ℝ)) = 0 ↔ u.val = 0 ∨ u.val = 1 := by
  constructor
  · intro h
    rcases ((AddCircle.coe_eq_zero_iff (1 : ℝ)).mp h) with ⟨n, hn⟩
    have hn' : (n : ℝ) = u.val := by simpa using hn
    have hn0 : 0 ≤ n := by exact_mod_cast (hn' ▸ u.property.1)
    have hu1 : u.val ≤ 1 := by simpa only [zero_add] using u.property.2
    have hn1 : n ≤ 1 := by exact_mod_cast (hn' ▸ hu1)
    have hor : n = 0 ∨ n = 1 := by omega
    rcases hor with rfl | rfl <;> simp_all
  · rintro (h | h)
    · simp [h]
    · simp [h]

theorem dyadicPentagon_square_torus_apply (p : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval ×
  _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval) :
    _root_.LowDimensionalTopology.Geometry.Surfaces.squareTorusQuotientHomeomorph (Quot.mk
      _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent p) =
      ((p.1.val : AddCircle (1 : ℝ)), (p.2.val : AddCircle (1 : ℝ))) := rfl

theorem dyadicPentagon_square_torus_ne_zero_iff (p : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval ×
  _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval) :
    _root_.LowDimensionalTopology.Geometry.Surfaces.squareTorusQuotientHomeomorph (Quot.mk
      _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent p) ≠ (0, 0) ↔
      ¬((p.1.val = 0 ∨ p.1.val = 1) ∧ (p.2.val = 0 ∨ p.2.val = 1)) := by
  rw [dyadicPentagon_square_torus_apply]
  apply not_congr
  rw [Prod.mk.injEq]
  exact (and_congr (dyadicPentagon_interval_coe_eq_zero_iff p.1) (dyadicPentagon_interval_coe_eq_zero_iff p.2))

noncomputable def puncturedSquareTorusHomeomorph :
    Quot PuncturedSquareSideIdent ≃ₜ PuncturedTorus := by
  let U : Set (AddCircle (1 : ℝ) × AddCircle (1 : ℝ)) := {(0, 0)}ᶜ
  let P : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval × _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval → Prop :=
    fun p => _root_.LowDimensionalTopology.Geometry.Surfaces.squareTorusQuotientHomeomorph (Quot.mk
      _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent p) ∈ U
  let ep : PuncturedSquare ≃ₜ Subtype P := Homeomorph.ofEqSubtypes (by
    funext p
    exact propext (dyadicPentagon_square_torus_ne_zero_iff p).symm)
  exact (Homeomorph.Quot.congr ep (fun _ _ => Iff.rfl)).trans
    (dyadicPentagonOpenRestrictionQuotientHomeomorph _root_.LowDimensionalTopology.Geometry.Surfaces.SquareSideIdent
      _root_.LowDimensionalTopology.Geometry.Surfaces.squareTorusQuotientHomeomorph U
      (isClosed_singleton.isOpen_compl))


def dyadicPentagonSquareHeight (p : _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval ×
  _root_.LowDimensionalTopology.Geometry.Surfaces.SquareInterval) : ℝ :=
  1 + 3 * p.1.val - ((2 * p.2.val - 1) * (p.1.val + 1)) ^ 2

theorem dyadicPentagonSquareHeight_pos (p : PuncturedSquare) : 0 < dyadicPentagonSquareHeight p.val := by
  have hu₀ := p.val.1.property.1
  have hu₁ := p.val.1.property.2
  have hv₀ := p.val.2.property.1
  have hv₁ := p.val.2.property.2
  norm_num at hu₁ hv₁
  have hu := mul_nonneg hu₀ (sub_nonneg.mpr hu₁)
  have hv := mul_nonneg hv₀ (sub_nonneg.mpr hv₁)
  have ha : 1 ≤ (p.val.1.val + 1) ^ 2 := by nlinarith
  have hprod := mul_nonneg hv (sq_nonneg (p.val.1.val + 1))
  have he : dyadicPentagonSquareHeight p.val =
      p.val.1.val * (1 - p.val.1.val) +
        4 * (p.val.2.val * (1 - p.val.2.val)) * (p.val.1.val + 1) ^ 2 := by
    dsimp [dyadicPentagonSquareHeight]
    ring
  by_contra hn
  have he₀ : p.val.1.val * (1 - p.val.1.val) = 0 := by nlinarith
  have he₁ : p.val.2.val * (1 - p.val.2.val) = 0 := by nlinarith
  apply p.property
  exact ⟨(mul_eq_zero.mp he₀).imp id (fun h => by linarith),
    (mul_eq_zero.mp he₁).imp id (fun h => by linarith)⟩

def dyadicPentagonSquareQuad (p : PuncturedSquare) : closure dyadicPentagonBaseQuad :=
  ⟨_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe ((2 * p.val.2.val - 1) * (p.val.1.val + 1))
    (Real.sqrt (dyadicPentagonSquareHeight p.val)) (Real.sqrt_pos.2 (dyadicPentagonSquareHeight_pos p)), by
      rw [dyadicPentagonBaseQuad_mem_closure_iff]
      have hu₀ := p.val.1.property.1
      have hu₁ := p.val.1.property.2
      have hv₀ := p.val.2.property.1
      have hv₁ := p.val.2.property.2
      norm_num at hu₁ hv₁
      have hy := Real.sq_sqrt (dyadicPentagonSquareHeight_pos p).le
      have hx₀ := mul_nonneg hv₀ (by linarith : 0 ≤ p.val.1.val + 1)
      have hx₁ := mul_nonneg (sub_nonneg.mpr hv₁) (by linarith : 0 ≤ p.val.1.val + 1)
      dsimp [torusCircleQ, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, dyadicPentagonSquareHeight]
      dsimp [dyadicPentagonSquareHeight] at hy
      refine ⟨?_, ?_, ?_, ?_⟩ <;> nlinarith⟩

def dyadicPentagonQuadU (z : ℍ) : ℝ := (Complex.normSq (z : ℂ) - 1) / 3

def dyadicPentagonQuadV (z : ℍ) : ℝ :=
  (Complex.normSq (z : ℂ) + 3 * z.re + 2) / (2 * (Complex.normSq (z : ℂ) + 2))

theorem dyadicPentagonQuadUV_mem (z : closure dyadicPentagonBaseQuad) :
    dyadicPentagonQuadU z.val ∈ Icc (0 : ℝ) 1 ∧ dyadicPentagonQuadV z.val ∈ Icc (0 : ℝ) 1 := by
  obtain ⟨hs₀, hs₁, hn, hp⟩ := (dyadicPentagonBaseQuad_mem_closure_iff z.val).mp z.property
  have hd : 0 < 2 * (Complex.normSq (z.val : ℂ) + 2) := by positivity
  refine ⟨⟨by dsimp [dyadicPentagonQuadU]; linarith, by dsimp [dyadicPentagonQuadU]; linarith⟩, ?_⟩
  dsimp [dyadicPentagonQuadV]
  constructor
  · apply div_nonneg _ hd.le
    dsimp [torusCircleQ] at hn
    linarith
  · apply (div_le_one hd).mpr
    dsimp [torusCircleQ] at hp
    linarith

theorem dyadicPentagonQuad_square_re (z : ℍ) :
    (2 * dyadicPentagonQuadV z - 1) * (dyadicPentagonQuadU z + 1) = z.re := by
  have hd : Complex.normSq (z : ℂ) + 2 ≠ 0 := by
    have hh := Complex.normSq_nonneg (z : ℂ)
    linarith
  dsimp [dyadicPentagonQuadV, dyadicPentagonQuadU]
  field_simp [hd]
  ring

theorem dyadicPentagonQuad_square_height (z : ℍ) :
    1 + 3 * dyadicPentagonQuadU z -
      ((2 * dyadicPentagonQuadV z - 1) * (dyadicPentagonQuadU z + 1)) ^ 2 = z.im ^ 2 := by
  rw [dyadicPentagonQuad_square_re]
  dsimp [dyadicPentagonQuadU]
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im]
  ring

def dyadicPentagonQuadSquare (z : closure dyadicPentagonBaseQuad) : PuncturedSquare :=
  ⟨(⟨dyadicPentagonQuadU z.val, by simpa only [zero_add] using (dyadicPentagonQuadUV_mem z).1⟩,
    ⟨dyadicPentagonQuadV z.val, by simpa only [zero_add] using (dyadicPentagonQuadUV_mem z).2⟩), by
      intro ⟨hu, hv⟩
      have hh := dyadicPentagonQuad_square_height z.val
      have hy := sq_pos_of_pos z.val.im_pos
      rcases hu with hu | hu <;> rcases hv with hv | hv <;> dsimp at hu hv <;>
        rw [hu, hv] at hh <;> norm_num at hh <;> linarith⟩

theorem dyadicPentagonSquareQuad_QuadSquare (z : closure dyadicPentagonBaseQuad) :
    dyadicPentagonSquareQuad (dyadicPentagonQuadSquare z) = z := by
  apply Subtype.ext
  apply UpperHalfPlane.ext_re_im
  · exact dyadicPentagonQuad_square_re z.val
  · change Real.sqrt (1 + 3 * dyadicPentagonQuadU z.val -
        ((2 * dyadicPentagonQuadV z.val - 1) * (dyadicPentagonQuadU z.val + 1)) ^ 2) = z.val.im
    rw [dyadicPentagonQuad_square_height, Real.sqrt_sq z.val.im_pos.le]

theorem dyadicPentagonQuadSquare_SquareQuad (p : PuncturedSquare) :
    dyadicPentagonQuadSquare (dyadicPentagonSquareQuad p) = p := by
  have hy := Real.sq_sqrt (dyadicPentagonSquareHeight_pos p).le
  have hs : Complex.normSq ((dyadicPentagonSquareQuad p).val : ℂ) = 1 + 3 * p.val.1.val := by
    dsimp [dyadicPentagonSquareQuad, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
      Complex.normSq_apply]
    dsimp [dyadicPentagonSquareHeight] at *
    nlinarith
  apply Subtype.ext
  apply Prod.ext <;> apply Subtype.ext
  · change dyadicPentagonQuadU (dyadicPentagonSquareQuad p).val = p.val.1.val
    dsimp [dyadicPentagonQuadU]
    rw [hs]
    ring
  · change dyadicPentagonQuadV (dyadicPentagonSquareQuad p).val = p.val.2.val
    dsimp [dyadicPentagonQuadV]
    rw [hs]
    change (1 + 3 * p.val.1.val + 3 * ((2 * p.val.2.val - 1) * (p.val.1.val + 1)) + 2) /
      (2 * (1 + 3 * p.val.1.val + 2)) = p.val.2.val
    have hd : 2 * (1 + 3 * p.val.1.val + 2) ≠ 0 := by
      have hh := p.val.1.property.1
      positivity
    apply (div_eq_iff hd).mpr
    ring

theorem dyadicPentagonQuadSquare_continuous : Continuous dyadicPentagonQuadSquare := by
  apply Continuous.subtype_mk
  apply Continuous.prodMk <;> apply Continuous.subtype_mk
  · dsimp [dyadicPentagonQuadU]
    fun_prop
  · dsimp [dyadicPentagonQuadV]
    apply Continuous.div
    · fun_prop
    · fun_prop
    · intro z
      have hh := Complex.normSq_nonneg (z.val : ℂ)
      positivity

theorem dyadicPentagonSquareQuad_continuous : Continuous dyadicPentagonSquareQuad := by
  unfold dyadicPentagonSquareQuad
  apply Continuous.subtype_mk
  apply UpperHalfPlane.isEmbedding_coe.continuous_iff.mpr
  change Continuous (fun p : PuncturedSquare =>
    (⟨(2 * p.val.2.val - 1) * (p.val.1.val + 1), Real.sqrt (dyadicPentagonSquareHeight p.val)⟩ : ℂ))
  have hx : Continuous (fun p : PuncturedSquare => (2 * p.val.2.val - 1) * (p.val.1.val + 1)) := by
    fun_prop
  have hy : Continuous (fun p : PuncturedSquare => Real.sqrt (dyadicPentagonSquareHeight p.val)) := by
    dsimp [dyadicPentagonSquareHeight]
    fun_prop
  convert (Complex.continuous_ofReal.comp hx).add
    ((Complex.continuous_ofReal.comp hy).mul (continuous_const (y := Complex.I))) using 1
  ext p
  simp [Complex.ext_iff]

def dyadicPentagonQuadSquareHomeomorph : closure dyadicPentagonBaseQuad ≃ₜ PuncturedSquare where
  toFun := dyadicPentagonQuadSquare
  invFun := dyadicPentagonSquareQuad
  left_inv := dyadicPentagonSquareQuad_QuadSquare
  right_inv := dyadicPentagonQuadSquare_SquareQuad
  continuous_toFun := dyadicPentagonQuadSquare_continuous
  continuous_invFun := dyadicPentagonSquareQuad_continuous

theorem dyadicPentagonBaseQuad_distinct_open_closed (k l : ℍ ≃ᵢ ℍ)
    (hk : k ∈ dyadicPentagonNativeGroup) (hl : l ∈ dyadicPentagonNativeGroup) (hne : k ≠ l) :
    Disjoint (k '' dyadicPentagonBaseQuad) (l '' closure dyadicPentagonBaseQuad) := by
  have hn : l⁻¹ * k ≠ 1 := by
    intro he
    apply hne
    calc
      k = l * (l⁻¹ * k) := by group
      _ = l := by rw [he, mul_one]
  have hd := (dyadicPentagonBaseQuad_wandering (l⁻¹ * k)
    (dyadicPentagonNativeGroup.mul_mem (dyadicPentagonNativeGroup.inv_mem hl) hk) hn).closure_right
      ((l⁻¹ * k).toHomeomorph.isOpenMap _ dyadicPentagonBaseQuad_isOpen)
  apply disjoint_left.mpr
  rintro _ ⟨a, ha, rfl⟩ ⟨b, hb, he⟩
  apply disjoint_left.mp hd _ hb
  refine ⟨a, ha, ?_⟩
  change l.symm (k a) = b
  exact (congrArg l.symm he).symm.trans (l.symm_apply_apply b)

theorem dyadicPentagonBaseQuad_two_tiles (p : ℍ) (h k : ℍ ≃ᵢ ℍ)
    (hh : h ∈ dyadicPentagonNativeGroup) (hk : k ∈ dyadicPentagonNativeGroup)
    (hp : p ∈ interior (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad))
    (hkp : p ∈ k '' closure dyadicPentagonBaseQuad) : k = 1 ∨ k = h := by
  by_contra hn
  have hk₁ : k ≠ 1 := fun he => hn (Or.inl he)
  have hkh : k ≠ h := fun he => hn (Or.inr he)
  have hd₁ := dyadicPentagonBaseQuad_distinct_open_closed k 1 hk dyadicPentagonNativeGroup.one_mem hk₁
  have hd₂ := dyadicPentagonBaseQuad_distinct_open_closed k h hk hh hkh
  have hd : Disjoint (k '' dyadicPentagonBaseQuad)
      (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad) := by
    simpa only [IsometryEquiv.coe_one, image_id] using hd₁.union_right hd₂
  have hd' := (hd.symm.mono_left interior_subset).closure_right isOpen_interior
  apply disjoint_left.mp hd' hp
  have he : k '' closure dyadicPentagonBaseQuad = closure (k '' dyadicPentagonBaseQuad) :=
    k.toHomeomorph.image_closure _
  rwa [← he]

theorem dyadicPentagonBaseQuad_inner_strict (p : ℍ) (hs : Complex.normSq (p : ℂ) = 1) :
    0 < torusCircleQ (-2) (-1) p ∧ 0 < torusCircleQ 1 2 p := by
  have hy := sq_pos_of_pos p.im_pos
  have he := hs
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at he
  have hx₀ : -1 < p.re := by nlinarith
  have hx₁ : p.re < 1 := by nlinarith
  dsimp [torusCircleQ]
  rw [hs]
  constructor <;> nlinarith

theorem dyadicPentagonBaseQuad_inner_local (p : ℍ) (hs : Complex.normSq (p : ℂ) = 1) :
    p ∈ interior (closure dyadicPentagonBaseQuad ∪ dyadicPentagonF.symm '' closure dyadicPentagonBaseQuad) := by
  let N : Set ℍ := {z | 1 / 4 < Complex.normSq (z : ℂ) ∧ Complex.normSq (z : ℂ) < 4 ∧
    0 < torusCircleQ (-2) (-1) z ∧ 0 < torusCircleQ 1 2 z ∧
    0 < torusCircleQ (-2) (-1) (dyadicPentagonF z) ∧ 0 < torusCircleQ 1 2 (dyadicPentagonF z)}
  have hc : Continuous (fun z : ℍ => Complex.normSq (z : ℂ)) := by fun_prop
  have hN : IsOpen N := by
    dsimp only [N]
    refine (isOpen_lt continuous_const hc).inter
      ((isOpen_lt hc continuous_const).inter
      ((isOpen_lt continuous_const (torusCircleQ_continuous _ _)).inter
      ((isOpen_lt continuous_const (torusCircleQ_continuous _ _)).inter
      ((isOpen_lt continuous_const ((torusCircleQ_continuous _ _).comp dyadicPentagonF.continuous)).inter
      (isOpen_lt continuous_const ((torusCircleQ_continuous _ _).comp dyadicPentagonF.continuous))))))
  have hpN : p ∈ N := by
    obtain ⟨hn, hp⟩ := dyadicPentagonBaseQuad_inner_strict p hs
    have hr : (dyadicPentagonF p).re = 2 * p.re := by simpa using dyadicPentagonF_pow_re 1 p
    have hnorm := dyadicPentagonF_normSq p
    refine ⟨by linarith, by linarith, hn, hp, ?_, ?_⟩ <;>
      dsimp [torusCircleQ] at * <;> rw [hr] <;> nlinarith
  have hsub : N ⊆ closure dyadicPentagonBaseQuad ∪ dyadicPentagonF.symm '' closure dyadicPentagonBaseQuad := by
    intro z hz
    by_cases hs₁ : 1 ≤ Complex.normSq (z : ℂ)
    · exact Or.inl ((dyadicPentagonBaseQuad_mem_closure_iff z).mpr ⟨hs₁, hz.2.1.le, hz.2.2.1.le, hz.2.2.2.1.le⟩)
    · refine Or.inr ⟨dyadicPentagonF z, ?_, dyadicPentagonF.symm_apply_apply z⟩
      rw [dyadicPentagonBaseQuad_mem_closure_iff]
      have hnorm := dyadicPentagonF_normSq z
      exact ⟨by nlinarith [hz.1], by nlinarith, hz.2.2.2.2.1.le, hz.2.2.2.2.2.le⟩
  apply interior_mono hsub
  rwa [hN.interior_eq]

theorem dyadicPentagonBaseQuad_local_inverse (p : ℍ) (h : ℍ ≃ᵢ ℍ)
    (hp : p ∈ interior (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad)) :
    h.symm p ∈ interior (closure dyadicPentagonBaseQuad ∪ h.symm '' closure dyadicPentagonBaseQuad) := by
  have hh : h.symm p ∈ h.symm '' interior
      (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad) := ⟨p, hp, rfl⟩
  have hi : h.symm '' interior (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad) =
      interior (h.symm '' (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad)) :=
    h.symm.toHomeomorph.image_interior _
  rw [hi] at hh
  have he : h.symm '' (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad) =
      closure dyadicPentagonBaseQuad ∪ h.symm '' closure dyadicPentagonBaseQuad := by
    rw [image_union]
    have he' : h.symm '' (h '' closure dyadicPentagonBaseQuad) = closure dyadicPentagonBaseQuad :=
      by ext z; simp
    rw [he', union_comm]
  rwa [he] at hh

theorem dyadicPentagonBaseQuad_outer_local (p : ℍ) (hs : Complex.normSq (p : ℂ) = 4) :
    p ∈ interior (closure dyadicPentagonBaseQuad ∪ dyadicPentagonF '' closure dyadicPentagonBaseQuad) := by
  have hi : Complex.normSq ((dyadicPentagonF.symm p : ℍ) : ℂ) = 1 := by
    change Complex.normSq (((dyadicPentagonF⁻¹) p : ℍ) : ℂ) = 1
    rw [dyadicPentagonF_inv_normSq, hs]
    norm_num
  have hh := dyadicPentagonBaseQuad_local_inverse (dyadicPentagonF.symm p) dyadicPentagonF.symm
    (dyadicPentagonBaseQuad_inner_local (dyadicPentagonF.symm p) hi)
  simpa only [IsometryEquiv.symm_symm, dyadicPentagonF.apply_symm_apply] using hh

theorem dyadicPentagonBaseQuad_left_strict (p : ℍ) (hq : torusCircleQ (-2) (-1) p = 0) :
    1 < Complex.normSq (p : ℂ) ∧ Complex.normSq (p : ℂ) < 4 ∧ 0 < torusCircleQ 1 2 p := by
  have hy := sq_pos_of_pos p.im_pos
  have he := hq
  dsimp [torusCircleQ] at he
  simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at he
  have hx₀ : -2 < p.re := by
    by_contra hn
    have hm := mul_nonneg_of_nonpos_of_nonpos (by linarith : p.re + 1 ≤ 0)
      (by linarith : p.re + 2 ≤ 0)
    nlinarith
  have hx₁ : p.re < -1 := by
    by_contra hn
    have hm := mul_nonneg (by linarith : 0 ≤ p.re + 1) (by linarith : 0 ≤ p.re + 2)
    nlinarith
  dsimp [torusCircleQ] at hq ⊢
  exact ⟨by linarith, by linarith, by linarith⟩

theorem dyadicPentagonG_left_coordinates (p : ℍ) (hq : torusCircleQ (-2) (-1) p = 0) :
    (dyadicPentagonG p).re = -p.re ∧ (dyadicPentagonG p).im = p.im ∧
      Complex.normSq ((dyadicPentagonG p : ℍ) : ℂ) = Complex.normSq (p : ℂ) := by
  have hd : Complex.normSq (2 * (p : ℂ) + 3) = 1 := by
    rw [dyadicPentagonG_den]
    dsimp [torusCircleQ] at hq
    nlinarith
  rw [dyadicPentagonG_re, dyadicPentagonG_im, dyadicPentagonG_normSq, hd]
  dsimp [torusCircleQ] at hq
  constructor
  · nlinarith
  · exact ⟨by ring, by nlinarith⟩

theorem dyadicPentagonBaseQuad_left_local (p : ℍ) (hq : torusCircleQ (-2) (-1) p = 0) :
    p ∈ interior (closure dyadicPentagonBaseQuad ∪ dyadicPentagonG.symm '' closure dyadicPentagonBaseQuad) := by
  let N : Set ℍ := {z | 1 < Complex.normSq (z : ℂ) ∧ Complex.normSq (z : ℂ) < 4 ∧
    0 < torusCircleQ 1 2 z ∧ 1 < Complex.normSq ((dyadicPentagonG z : ℍ) : ℂ) ∧
    Complex.normSq ((dyadicPentagonG z : ℍ) : ℂ) < 4 ∧ 0 < torusCircleQ (-2) (-1) (dyadicPentagonG z)}
  have hc : Continuous (fun z : ℍ => Complex.normSq (z : ℂ)) := by fun_prop
  have hcG : Continuous (fun z : ℍ => Complex.normSq ((dyadicPentagonG z : ℍ) : ℂ)) := by fun_prop
  have hN : IsOpen N := by
    dsimp only [N]
    refine (isOpen_lt continuous_const hc).inter
      ((isOpen_lt hc continuous_const).inter
      ((isOpen_lt continuous_const (torusCircleQ_continuous _ _)).inter
      ((isOpen_lt continuous_const hcG).inter
      ((isOpen_lt hcG continuous_const).inter
      (isOpen_lt continuous_const ((torusCircleQ_continuous _ _).comp dyadicPentagonG.continuous))))))
  have hpN : p ∈ N := by
    obtain ⟨hs₀, hs₁, hp⟩ := dyadicPentagonBaseQuad_left_strict p hq
    obtain ⟨hr, _hi, hnorm⟩ := dyadicPentagonG_left_coordinates p hq
    refine ⟨hs₀, hs₁, hp, by rwa [hnorm], by rwa [hnorm], ?_⟩
    dsimp [torusCircleQ] at hp ⊢
    rw [hnorm, hr]
    nlinarith
  have hsub : N ⊆ closure dyadicPentagonBaseQuad ∪ dyadicPentagonG.symm '' closure dyadicPentagonBaseQuad := by
    intro z hz
    by_cases hq₁ : 0 ≤ torusCircleQ (-2) (-1) z
    · exact Or.inl ((dyadicPentagonBaseQuad_mem_closure_iff z).mpr ⟨hz.1.le, hz.2.1.le, hq₁, hz.2.2.1.le⟩)
    · refine Or.inr ⟨dyadicPentagonG z, ?_, dyadicPentagonG.symm_apply_apply z⟩
      rw [dyadicPentagonBaseQuad_mem_closure_iff]
      have hside := dyadicPentagonG_side_identity z
      have hd := dyadicPentagonG_den_pos z
      exact ⟨hz.2.2.2.1.le, hz.2.2.2.2.1.le, hz.2.2.2.2.2.le, by nlinarith⟩
  apply interior_mono hsub
  rwa [hN.interior_eq]

theorem dyadicPentagonBaseQuad_right_local (p : ℍ) (hq : torusCircleQ 1 2 p = 0) :
    p ∈ interior (closure dyadicPentagonBaseQuad ∪ dyadicPentagonG '' closure dyadicPentagonBaseQuad) := by
  let q := _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (-p.re) p.im p.im_pos
  have hq' : torusCircleQ (-2) (-1) q = 0 := by
    dsimp [q, torusCircleQ, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe] at *
    simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at *
    nlinarith
  have he : dyadicPentagonG q = p := by
    obtain ⟨hr, hi, _hnorm⟩ := dyadicPentagonG_left_coordinates q hq'
    apply UpperHalfPlane.ext_re_im
    · change (dyadicPentagonG q).re = -(-p.re) at hr
      simpa only [neg_neg] using hr
    · exact hi
  have hh := dyadicPentagonBaseQuad_local_inverse q dyadicPentagonG.symm
    (dyadicPentagonBaseQuad_left_local q hq')
  simpa only [IsometryEquiv.symm_symm, he] using hh

theorem dyadicPentagonBaseQuad_local_neighbor (p : ℍ) (hp : p ∈ closure dyadicPentagonBaseQuad) :
    ∃ h : ℍ ≃ᵢ ℍ, h ∈ dyadicPentagonNativeGroup ∧
      (h = 1 ∨ h = dyadicPentagonF ∨ h = dyadicPentagonF.symm ∨ h = dyadicPentagonG ∨ h = dyadicPentagonG.symm) ∧
      p ∈ interior (closure dyadicPentagonBaseQuad ∪ h '' closure dyadicPentagonBaseQuad) := by
  have hF : dyadicPentagonF ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inl rfl)
  have hG : dyadicPentagonG ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inr rfl)
  by_cases hi : p ∈ dyadicPentagonBaseQuad
  · refine ⟨1, dyadicPentagonNativeGroup.one_mem, Or.inl rfl, ?_⟩
    exact interior_mono subset_union_left (dyadicPentagonBaseQuad_isOpen.subset_interior_closure hi)
  · obtain ⟨hs₀, hs₁, hn, hpos⟩ := (dyadicPentagonBaseQuad_mem_closure_iff p).mp hp
    by_cases he₀ : Complex.normSq (p : ℂ) = 1
    · exact ⟨dyadicPentagonF.symm, dyadicPentagonNativeGroup.inv_mem hF,
        Or.inr (Or.inr (Or.inl rfl)), dyadicPentagonBaseQuad_inner_local p he₀⟩
    by_cases he₁ : Complex.normSq (p : ℂ) = 4
    · exact ⟨dyadicPentagonF, hF, Or.inr (Or.inl rfl), dyadicPentagonBaseQuad_outer_local p he₁⟩
    by_cases he₂ : torusCircleQ (-2) (-1) p = 0
    · exact ⟨dyadicPentagonG.symm, dyadicPentagonNativeGroup.inv_mem hG,
        Or.inr (Or.inr (Or.inr (Or.inr rfl))), dyadicPentagonBaseQuad_left_local p he₂⟩
    have he₃ : torusCircleQ 1 2 p = 0 := by
      by_contra hh
      apply hi
      exact ⟨⟨lt_of_le_of_ne hs₀ (Ne.symm he₀), lt_of_le_of_ne hs₁ he₁⟩,
        lt_of_le_of_ne hn (Ne.symm he₂), lt_of_le_of_ne hpos (Ne.symm hh)⟩
    exact ⟨dyadicPentagonG, hG, Or.inr (Or.inr (Or.inr (Or.inl rfl))),
      dyadicPentagonBaseQuad_right_local p he₃⟩

theorem dyadicPentagonBaseQuad_orbit_generator (p q : closure dyadicPentagonBaseQuad)
    (h : MulAction.orbitRel dyadicPentagonNativeGroup ℍ p.val q.val) :
    p.val = q.val ∨ p.val = dyadicPentagonF q.val ∨ p.val = dyadicPentagonF.symm q.val ∨
      p.val = dyadicPentagonG q.val ∨ p.val = dyadicPentagonG.symm q.val := by
  obtain ⟨k, hk⟩ := h
  change k.val q.val = p.val at hk
  obtain ⟨l, hl, hcases, hp⟩ := dyadicPentagonBaseQuad_local_neighbor p.val p.property
  have hkp : p.val ∈ k.val '' closure dyadicPentagonBaseQuad := ⟨q.val, q.property, hk⟩
  rcases dyadicPentagonBaseQuad_two_tiles p.val l k.val hl k.property hp hkp with he | he
  · refine Or.inl ?_
    rw [he] at hk
    change q.val = p.val at hk
    exact hk.symm
  · rcases hcases with rfl | rfl | rfl | rfl | rfl
    · refine Or.inl ?_
      rw [he] at hk
      change q.val = p.val at hk
      exact hk.symm
    · exact Or.inr (Or.inl (by rw [he] at hk; exact hk.symm))
    · exact Or.inr (Or.inr (Or.inl (by rw [he] at hk; exact hk.symm)))
    · exact Or.inr (Or.inr (Or.inr (Or.inl (by rw [he] at hk; exact hk.symm))))
    · exact Or.inr (Or.inr (Or.inr (Or.inr (by rw [he] at hk; exact hk.symm))))





/-- The four-sided native tile is precisely the actual closed Dirichlet tile. -/
theorem dyadicPentagonBaseQuad_closure_eq_nativeClosedDirichlet :
    closure dyadicPentagonBaseQuad =
      nativeClosedDirichlet dyadicPentagonNativeGroup dyadicPentagonCenter := by
  apply Set.Subset.antisymm ?_ dyadicPentagonNativeClosedDirichlet_subset
  apply closure_minimal ?_ (nativeClosedDirichlet_isClosed _ _)
  intro z hz
  obtain ⟨g, hg⟩ := nativeClosedDirichlet_meets_orbit dyadicPentagonNativeGroup
    dyadicPentagonNativeGroup_discontinuous dyadicPentagonCenter z
  have he : g.val = 1 := by
    by_contra hne
    have hopen : IsOpen (g.val • dyadicPentagonBaseQuad) := by
      change IsOpen (g.val '' dyadicPentagonBaseQuad)
      exact g.val.toHomeomorph.isOpenMap _ dyadicPentagonBaseQuad_isOpen
    have hdis := (dyadicPentagonBaseQuad_wandering g.val g.property hne).closure_right hopen
    exact Set.disjoint_left.mp hdis ⟨z, hz, rfl⟩
      (dyadicPentagonNativeClosedDirichlet_subset hg)
  have he' : g = 1 := Subtype.ext he
  simpa [he'] using hg

/-- Proper discontinuity makes all genuine closed Dirichlet translates locally finite. -/
theorem nativeClosedDirichlet_locallyFinite_of_discontinuous
    (H : Subgroup (ℍ ≃ᵢ ℍ)) (hH : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.IsDiscontinuous H ℍ) (w :
      ℍ) :
    LocallyFinite (fun g : H => g • nativeClosedDirichlet H w) := by
  intro x
  refine ⟨Metric.closedBall x 1, Metric.closedBall_mem_nhds x (by norm_num), ?_⟩
  have hd := (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.isDiscontinuous_iff_properlyDiscontinuousSMul
    H ℍ).mp hH
  have hf := hd.finite_disjoint_inter_image (isCompact_singleton : IsCompact ({w} : Set ℍ))
    (isCompact_closedBall x (dist x w + 2))
  apply hf.subset
  rintro g ⟨z, hzg, hzx⟩
  refine ⟨g • w, ⟨w, mem_singleton w, rfl⟩, ?_⟩
  apply Metric.mem_closedBall.mpr
  have hcomp := nativeClosedDirichlet_translate_comparison H w g 1 hzg
  rw [one_smul] at hcomp
  have hzdist := Metric.mem_closedBall.mp hzx
  calc
    dist (g • w) x ≤ dist (g • w) z + dist z x := dist_triangle _ _ _
    _ = dist z (g • w) + dist z x := by rw [dist_comm (g • w) z]
    _ ≤ (dist z x + dist x w) + dist z x :=
      by linarith [dist_triangle z x w]
    _ ≤ dist x w + 2 := by linarith

/-- The original four-sided tiling has genuine local finiteness. -/
theorem dyadicPentagonBaseQuad_native_locallyFinite :
    LocallyFinite (fun g : dyadicPentagonNativeGroup => g • closure dyadicPentagonBaseQuad) := by
  rw [dyadicPentagonBaseQuad_closure_eq_nativeClosedDirichlet]
  exact nativeClosedDirichlet_locallyFinite_of_discontinuous _
    dyadicPentagonNativeGroup_discontinuous _

/-- Local finiteness makes the native closed-tile comparison a closed map. -/
theorem dyadicPentagonBaseQuad_comparison_isClosedMap :
    IsClosedMap (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.comparisonMap dyadicPentagonNativeGroup ℍ (closure dyadicPentagonBaseQuad)) := by
  let : ContinuousConstSMul dyadicPentagonNativeGroup ℍ := ⟨fun g => g.val.continuous⟩
  intro C hC
  let S : Set ℍ := (Subtype.val : closure dyadicPentagonBaseQuad → ℍ) ''
    ((_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedProjection dyadicPentagonNativeGroup ℍ
      (closure dyadicPentagonBaseQuad)) ⁻¹' C)
  have hS : IsClosed S := isClosed_closure.isClosedEmbedding_subtypeVal.isClosedMap _
    (hC.preimage (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedProjection_continuous
      dyadicPentagonNativeGroup ℍ
      (closure dyadicPentagonBaseQuad)))
  have hScl : S ⊆ closure dyadicPentagonBaseQuad := by
    rintro _ ⟨z, _hz, rfl⟩
    exact z.property
  have hl : LocallyFinite (fun g : dyadicPentagonNativeGroup => g • S) :=
    dyadicPentagonBaseQuad_native_locallyFinite.subset (fun _ => Set.smul_set_mono hScl)
  have hc : IsClosed (⋃ g : dyadicPentagonNativeGroup, g • S) :=
    hl.isClosed_iUnion (fun g => (Homeomorph.smul g).isClosedMap S hS)
  have he : _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection dyadicPentagonNativeGroup ℍ ⁻¹'
      (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.comparisonMap dyadicPentagonNativeGroup ℍ (closure
        dyadicPentagonBaseQuad) '' C) =
        ⋃ g : dyadicPentagonNativeGroup, g • S := by
    ext x
    constructor
    · rintro ⟨q, hq, hqx⟩
      induction q using Quotient.inductionOn with
      | h z =>
        obtain ⟨g, hg⟩ :=
          (Quotient.exact hqx : MulAction.orbitRel dyadicPentagonNativeGroup ℍ z.val x)
        refine mem_iUnion.mpr ⟨g⁻¹, z.val, ⟨z, hq, rfl⟩, ?_⟩
        change g⁻¹ • z.val = x
        rw [← hg, inv_smul_smul]
    · intro hx
      obtain ⟨g, z, ⟨w, hw, hwz⟩, hgz⟩ := mem_iUnion.mp hx
      subst z
      refine ⟨_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.restrictedProjection
        dyadicPentagonNativeGroup ℍ
        (closure dyadicPentagonBaseQuad) w, hw, ?_⟩
      change _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection dyadicPentagonNativeGroup ℍ w.val =
        _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection dyadicPentagonNativeGroup ℍ x
      rw [← hgz, _root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection_smul]
  apply (isQuotientMap_quotient_mk'
    (s := MulAction.orbitRel dyadicPentagonNativeGroup ℍ)).isClosed_preimage.mp
  change IsClosed (_root_.LowDimensionalTopology.Geometry.DiscreteGroups.Action.orbitProjection
    dyadicPentagonNativeGroup ℍ ⁻¹' _)
  rw [he]
  exact hc

