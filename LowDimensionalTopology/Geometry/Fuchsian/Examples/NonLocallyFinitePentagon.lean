public import LowDimensionalTopology.Geometry.Surfaces.Topology.HandleModels

/-!
# A fundamental pentagon whose closed translates are not locally finite

Two explicit half-plane isometries generate a discrete group. A dyadic reassembly
of a fundamental quadrilateral gives a convex fundamental pentagon with five
geometric sides, but infinitely many closed translates meet one compact set.

The quadrilateral remains locally finite. Its quotient is identified first with
an opposite-side quotient of a punctured square and then with a punctured torus.
This compares two domains for the same action and retains their different
closed-tile local finiteness properties.
-/

@[expose] public section

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Filter Topology MeasureTheory
open scoped UpperHalfPlane Pointwise OnePoint

namespace LowDimensionalTopology.Geometry.Fuchsian

open LowDimensionalTopology.Geometry.Auxiliary.Algebra LowDimensionalTopology.Geometry.Auxiliary.Analysis
  LowDimensionalTopology.Geometry.Auxiliary.Topology LowDimensionalTopology.Geometry.Euclidean
  LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Mobius
  LowDimensionalTopology.Geometry.Polygon LowDimensionalTopology.Geometry.Surfaces
  LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Fuchsian LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace

/-- The first actual generator. -/
def dyadicPentagonFSL : Matrix.SpecialLinearGroup (Fin 2) ℝ := _root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL 2 (by norm_num)

/-- The second actual generator. -/
def dyadicPentagonGSL : Matrix.SpecialLinearGroup (Fin 2) ℝ :=
  ⟨!![3, 4; 2, 3], by norm_num [Matrix.det_fin_two]⟩

def dyadicPentagonF : ℍ ≃ᵢ ℍ := _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonFSL
def dyadicPentagonG : ℍ ≃ᵢ ℍ := _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry dyadicPentagonGSL

def dyadicPentagonNativeGroup : Subgroup (ℍ ≃ᵢ ℍ) :=
  Subgroup.closure ({dyadicPentagonF, dyadicPentagonG} : Set (ℍ ≃ᵢ ℍ))

/-- The complete group generated by the two source transformations. -/
def dyadicPentagonGroup : Subgroup _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup :=
  Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius dyadicPentagonFSL,
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.realSLMobius dyadicPentagonGSL} :
    Set _root_.LowDimensionalTopology.Geometry.Mobius.complexMobiusGroup)

theorem dyadicPentagonF_coe (z : ℍ) : ((dyadicPentagonF z : ℍ) : ℂ) = 2 * (z : ℂ) :=
  _root_.LowDimensionalTopology.Geometry.Hyperbolic.verticalDilationSL_coe 2 (by norm_num) z

theorem dyadicPentagonG_coe (z : ℍ) :
    ((dyadicPentagonG z : ℍ) : ℂ) = (3 * (z : ℂ) + 4) / (2 * (z : ℂ) + 3) := by
  rw [dyadicPentagonG, _root_.LowDimensionalTopology.Geometry.Hyperbolic.hSLIsometry_apply,
    UpperHalfPlane.coe_specialLinearGroup_apply]
  norm_num [dyadicPentagonGSL, Matrix.of_apply, Algebra.algebraMap_self_apply]

theorem dyadicPentagonF_pow_coe (n : ℕ) (z : ℍ) :
    (((dyadicPentagonF ^ n) z : ℍ) : ℂ) = ((2 : ℝ) ^ n : ℂ) * (z : ℂ) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ']
    change ((dyadicPentagonF ((dyadicPentagonF ^ n) z) : ℍ) : ℂ) = _
    rw [dyadicPentagonF_coe, ih, pow_succ]
    push_cast
    ring

/-- The literal five supporting inequalities of the source pentagon. -/
def dyadicPentagonPentagon : Set ℍ :=
  {z | 1 < z.re ∧ z.re < 2 ∧ 0 < torusCircleQ 1 (7 / 5) z ∧
    0 < torusCircleQ (4 / 3) (3 / 2) z ∧ 0 < torusCircleQ (10 / 7) 2 z}

def dyadicPentagonPentagonNormals : Fin 5 → ℂ :=
  ![-torusVerticalNormal 1, torusVerticalNormal 2, torusCircleNormal 1 (7 / 5),
    torusCircleNormal (4 / 3) (3 / 2), torusCircleNormal (10 / 7) 2]

def dyadicPentagonPentagonThresholds : Fin 5 → ℝ :=
  ![-1 / 2, 2 / 2, torusCircleThreshold 1 (7 / 5),
    torusCircleThreshold (4 / 3) (3 / 2), torusCircleThreshold (10 / 7) 2]

theorem dyadicPentagonPentagon_klein : dyadicPentagonPentagon =
    torusKleinCutRegion dyadicPentagonPentagonNormals dyadicPentagonPentagonThresholds := by
  ext z
  constructor
  · rintro ⟨h₁, h₂, h₃, h₄, h₅⟩ i
    fin_cases i
    · exact (torusVertical_klein_gt 1 z).mp h₁
    · exact (torusVertical_klein_lt 2 z).mp h₂
    · exact (torusCircleQ_klein_pos_iff 1 (7 / 5) z).mp h₃
    · exact (torusCircleQ_klein_pos_iff (4 / 3) (3 / 2) z).mp h₄
    · exact (torusCircleQ_klein_pos_iff (10 / 7) 2 z).mp h₅
  · intro h
    exact ⟨(torusVertical_klein_gt 1 z).mpr (h 0),
      (torusVertical_klein_lt 2 z).mpr (h 1),
      (torusCircleQ_klein_pos_iff 1 (7 / 5) z).mpr (h 2),
      (torusCircleQ_klein_pos_iff (4 / 3) (3 / 2) z).mpr (h 3),
      (torusCircleQ_klein_pos_iff (10 / 7) 2 z).mpr (h 4)⟩

theorem dyadicPentagonPentagon_isOpen : IsOpen dyadicPentagonPentagon := by
  rw [dyadicPentagonPentagon_klein]
  exact torusKleinCutRegion_isOpen _ _

theorem dyadicPentagonPentagon_hConvex : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HConvex dyadicPentagonPentagon := by
  rw [dyadicPentagonPentagon_klein]
  exact torusKleinCutRegion_hConvex _ _

theorem dyadicPentagonPentagon_probe_mem : _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (3 / 2) 1 (by norm_num) ∈ dyadicPentagonPentagon := by
  norm_num [dyadicPentagonPentagon, torusCircleQ, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
    Complex.normSq_apply]

theorem dyadicPentagonPentagon_isConnected : IsConnected dyadicPentagonPentagon :=
  ⟨⟨_, dyadicPentagonPentagon_probe_mem⟩, dyadicPentagonPentagon_hConvex.isPreconnected⟩

theorem dyadicPentagonPentagon_regular : interior (closure dyadicPentagonPentagon) = dyadicPentagonPentagon :=
  torus_hConvex_regular dyadicPentagonPentagon_hConvex dyadicPentagonPentagon_isOpen
    dyadicPentagonPentagon_isConnected.nonempty

theorem dyadicPentagonPentagon_closure : closure dyadicPentagonPentagon =
    torusKleinClosedRegion dyadicPentagonPentagonNormals dyadicPentagonPentagonThresholds := by
  rw [dyadicPentagonPentagon_klein]
  exact torusKleinCutRegion_closure _ _ (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (3 / 2) 1 (by norm_num))
    (dyadicPentagonPentagon_klein ▸ dyadicPentagonPentagon_probe_mem)

theorem dyadicPentagonPentagon_mem_closure_iff (z : ℍ) : z ∈ closure dyadicPentagonPentagon ↔
    1 ≤ z.re ∧ z.re ≤ 2 ∧ 0 ≤ torusCircleQ 1 (7 / 5) z ∧
    0 ≤ torusCircleQ (4 / 3) (3 / 2) z ∧ 0 ≤ torusCircleQ (10 / 7) 2 z := by
  rw [dyadicPentagonPentagon_closure]
  constructor
  · intro hz
    have h0 := hz 0
    have h1 := hz 1
    have h2 := (torusCircleQ_klein_nonneg_iff 1 (7 / 5) z).mpr (hz 2)
    have h3 := (torusCircleQ_klein_nonneg_iff (4 / 3) (3 / 2) z).mpr (hz 3)
    have h4 := (torusCircleQ_klein_nonneg_iff (10 / 7) 2 z).mpr (hz 4)
    have hd : 0 < Complex.normSq (z : ℂ) + 1 := by linarith [Complex.normSq_nonneg (z : ℂ)]
    have e0 := torusVertical_klein 1 z
    have e1 := torusVertical_klein 2 z
    change inner ℝ (-torusVerticalNormal 1) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate
      z) ≤ -1 / 2 at h0
    change inner ℝ (torusVerticalNormal 2) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate
      z) ≤ 2 / 2 at h1
    rw [inner_neg_left] at h0
    have hm0 := mul_nonpos_of_nonpos_of_nonneg (by linarith :
      1 / 2 - inner ℝ (torusVerticalNormal
        1) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z) ≤ 0) hd.le
    have hm1 := mul_nonneg (by linarith :
      2 / 2 - inner ℝ (torusVerticalNormal
        2) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z) ≥ 0) hd.le
    rw [e0] at hm0
    rw [e1] at hm1
    exact ⟨by linarith, by linarith, h2, h3, h4⟩
  · rintro ⟨h0, h1, h2, h3, h4⟩ i
    have hd : 0 < Complex.normSq (z : ℂ) + 1 := by linarith [Complex.normSq_nonneg (z : ℂ)]
    fin_cases i
    · change inner ℝ (-torusVerticalNormal
      1) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z) ≤ -1 / 2
      rw [inner_neg_left]
      have hh := torusVertical_klein 1 z
      have hm : (1 / 2 - inner ℝ (torusVerticalNormal 1)
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z)) *
          (Complex.normSq (z : ℂ) + 1) ≤ 0 := by rw [hh]; linarith
      by_contra hn
      have hp : 0 < 1 / 2 - inner ℝ (torusVerticalNormal 1) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z) := by
        linarith
      exact (not_lt_of_ge hm) (mul_pos hp hd)
    · change inner ℝ (torusVerticalNormal 2) (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate
      z) ≤ 2 / 2
      have hh := torusVertical_klein 2 z
      have hm : 0 ≤ (2 / 2 - inner ℝ (torusVerticalNormal 2)
        (_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneKleinCoordinate z)) *
          (Complex.normSq (z : ℂ) + 1) := by rw [hh]; linarith
      have hn := (mul_nonneg_iff_of_pos_right hd).mp hm
      linarith
    · exact (torusCircleQ_klein_nonneg_iff 1 (7 / 5) z).mp h2
    · exact (torusCircleQ_klein_nonneg_iff (4 / 3) (3 / 2) z).mp h3
    · exact (torusCircleQ_klein_nonneg_iff (10 / 7) 2 z).mp h4

theorem dyadicPentagon_vertical_one_mem_closure (t : ℝ) (ht : 0 < t) :
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 1 t ht ∈ closure dyadicPentagonPentagon := by
  rw [dyadicPentagonPentagon_mem_closure_iff]
  norm_num [_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, torusCircleQ, Complex.normSq_apply]
  exact ⟨by nlinarith [sq_nonneg t], by nlinarith [sq_nonneg t], by nlinarith [sq_nonneg t]⟩

theorem dyadicPentagonG_I : dyadicPentagonG UpperHalfPlane.I = _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (18 / 13) (1 / 13) (by norm_num) := by
  apply UpperHalfPlane.ext
  rw [dyadicPentagonG_coe]
  norm_num [UpperHalfPlane.I, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.ext_iff,
    Complex.div_re, Complex.div_im, Complex.normSq_apply]

theorem dyadicPentagonG_twoI : dyadicPentagonG (_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 0 2 (by norm_num)) =
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe (36 / 25) (2 / 25) (by norm_num) := by
  apply UpperHalfPlane.ext
  rw [dyadicPentagonG_coe]
  norm_num [_root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe, Complex.ext_iff, Complex.div_re,
    Complex.div_im, Complex.normSq_apply]

theorem dyadicPentagonF_powers_injective : Function.Injective (fun n : ℕ => dyadicPentagonF ^ n) := by
  intro m n he
  have hm : ((dyadicPentagonF ^ m) UpperHalfPlane.I).im = (2 : ℝ) ^ m := by
    have hh := congrArg Complex.im (dyadicPentagonF_pow_coe m UpperHalfPlane.I)
    simpa only [← Complex.ofReal_pow, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
      add_zero, UpperHalfPlane.coe_im, UpperHalfPlane.I_im, mul_one] using hh
  have hn : ((dyadicPentagonF ^ n) UpperHalfPlane.I).im = (2 : ℝ) ^ n := by
    have hh := congrArg Complex.im (dyadicPentagonF_pow_coe n UpperHalfPlane.I)
    simpa only [← Complex.ofReal_pow, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
      add_zero, UpperHalfPlane.coe_im, UpperHalfPlane.I_im, mul_one] using hh
  apply pow_right_injective₀ (by norm_num : (0 : ℝ) < 2) (by norm_num : (2 : ℝ) ≠ 1)
  change (2 : ℝ) ^ m = (2 : ℝ) ^ n
  rw [← hm, ← hn]
  exact congrArg (fun e : ℍ ≃ᵢ ℍ => (e UpperHalfPlane.I).im) he

theorem dyadicPentagonPentagon_native_not_locallyFinite :
    ¬ LocallyFinite (fun g : dyadicPentagonNativeGroup => g.val '' closure dyadicPentagonPentagon) := by
  classical
  have hFmem : dyadicPentagonF ∈ dyadicPentagonNativeGroup := Subgroup.subset_closure (Or.inl rfl)
  let label : ℕ → dyadicPentagonNativeGroup := fun n =>
    ⟨(dyadicPentagonF ^ n)⁻¹, dyadicPentagonNativeGroup.inv_mem (dyadicPentagonNativeGroup.pow_mem hFmem n)⟩
  have hinj : Function.Injective label := by
    intro m n he
    have hh : (dyadicPentagonF ^ m)⁻¹ = (dyadicPentagonF ^ n)⁻¹ := congrArg Subtype.val he
    exact dyadicPentagonF_powers_injective (inv_injective hh)
  let w : ℕ → ℍ := fun n => _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe ((1 / 2 : ℝ) ^ n) 1 (by norm_num)
  have hprobe : Continuous (fun t : ℝ => _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe t 1 (by norm_num)) := by
    apply UpperHalfPlane.isEmbedding_coe.continuous_iff.mpr
    change Continuous (fun t : ℝ => (⟨t, 1⟩ : ℂ))
    convert Complex.continuous_ofReal.add (continuous_const (y := Complex.I)) using 1
    ext t
    simp [Complex.ext_iff]
  have htend : Tendsto w atTop (𝓝 UpperHalfPlane.I) :=
    hprobe.continuousAt.tendsto.comp
      (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
        (by norm_num : (1 / 2 : ℝ) < 1))
  have hpoint : ∀ n, (dyadicPentagonF ^ n) (w n) ∈ closure dyadicPentagonPentagon := by
    intro n
    have hm : (2 : ℝ) ^ n * (1 / 2 : ℝ) ^ n = 1 := by rw [← mul_pow]; norm_num
    have he : (dyadicPentagonF ^ n) (w n) = _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe 1 ((2 : ℝ) ^ n) (by positivity) := by
      apply UpperHalfPlane.ext
      rw [dyadicPentagonF_pow_coe]
      apply Complex.ext
      · simpa only [← Complex.ofReal_pow, w, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
        Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
          zero_mul, sub_zero] using hm
      · simp only [← Complex.ofReal_pow, w, _root_.LowDimensionalTopology.Geometry.Hyperbolic.metricProbe,
        Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          zero_mul, add_zero, mul_one]
    rw [he]
    exact dyadicPentagon_vertical_one_mem_closure _ (by positivity)
  intro hLF
  obtain ⟨N, hN, hfin⟩ := hLF UpperHalfPlane.I
  have hevent : ∀ᶠ n in atTop,
      label n ∈ {g : dyadicPentagonNativeGroup | (g.val '' closure dyadicPentagonPentagon ∩ N).Nonempty} := by
    filter_upwards [htend hN] with n hn
    refine ⟨w n, ⟨(dyadicPentagonF ^ n) (w n), hpoint n, ?_⟩, hn⟩
    change (dyadicPentagonF ^ n).symm ((dyadicPentagonF ^ n) (w n)) = w n
    exact (dyadicPentagonF ^ n).symm_apply_apply (w n)
  have hpre : {n : ℕ | label n ∈ {g : dyadicPentagonNativeGroup |
      (g.val '' closure dyadicPentagonPentagon ∩ N).Nonempty}}.Finite := hfin.preimage hinj.injOn
  obtain ⟨M, hM⟩ := hpre.bddAbove
  obtain ⟨L, hL⟩ := Filter.eventually_atTop.mp hevent
  have hh : max L (M + 1) ≤ M := hM (hL _ (le_max_left _ _))
  omega

def dyadicPentagonFSector : Set ℍ :=
  {z | 1 < Complex.normSq (z : ℂ) ∧ Complex.normSq (z : ℂ) < 4}

def dyadicPentagonGSector : Set ℍ :=
  {z | 0 < torusCircleQ (-2) (-1) z ∧ 0 < torusCircleQ 1 2 z}

def dyadicPentagonBaseQuad : Set ℍ := dyadicPentagonFSector ∩ dyadicPentagonGSector

theorem dyadicPentagonF_normSq (z : ℍ) :
    Complex.normSq ((dyadicPentagonF z : ℍ) : ℂ) = 4 * Complex.normSq (z : ℂ) := by
  rw [dyadicPentagonF_coe, Complex.normSq_mul]
  norm_num

theorem dyadicPentagonF_inv_normSq (z : ℍ) :
    Complex.normSq (((dyadicPentagonF⁻¹) z : ℍ) : ℂ) = Complex.normSq (z : ℂ) / 4 := by
  have hh := dyadicPentagonF_normSq (dyadicPentagonF.symm z)
  rw [dyadicPentagonF.apply_symm_apply] at hh
  change Complex.normSq ((dyadicPentagonF.symm z : ℍ) : ℂ) = _
  linarith

theorem dyadicPentagonG_den_pos (z : ℍ) : 0 < Complex.normSq (2 * (z : ℂ) + 3) := by
  apply Complex.normSq_pos.mpr
  intro he
  have hi := congrArg Complex.im he
  norm_num [Complex.mul_im] at hi
  exact z.im_ne_zero hi

theorem dyadicPentagonG_re (z : ℍ) :
    (dyadicPentagonG z).re = (6 * Complex.normSq (z : ℂ) + 17 * z.re + 12) /
      Complex.normSq (2 * (z : ℂ) + 3) := by
  change (((dyadicPentagonG z : ℍ) : ℂ)).re = _
  rw [dyadicPentagonG_coe, Complex.div_re]
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonG_normSq (z : ℍ) :
    Complex.normSq ((dyadicPentagonG z : ℍ) : ℂ) =
      (9 * Complex.normSq (z : ℂ) + 24 * z.re + 16) /
        Complex.normSq (2 * (z : ℂ) + 3) := by
  rw [dyadicPentagonG_coe, Complex.normSq_div]
  congr 1
  simp [Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagonG_side_identity (z : ℍ) :
    torusCircleQ 1 2 (dyadicPentagonG z) * Complex.normSq (2 * (z : ℂ) + 3) =
      -torusCircleQ (-2) (-1) z := by
  have hd := (dyadicPentagonG_den_pos z).ne'
  rw [torusCircleQ, dyadicPentagonG_re, dyadicPentagonG_normSq]
  field_simp
  simp [torusCircleQ, Complex.normSq_apply, Complex.mul_re, Complex.mul_im]
  ring

theorem dyadicPentagon_disk_norm_bounds (x y : ℝ) (hy : 0 < y)
    (h : x ^ 2 + y ^ 2 - 3 * x + 2 ≤ 0) :
    1 < x ^ 2 + y ^ 2 ∧ x ^ 2 + y ^ 2 < 4 := by
  have hx1 : 1 < x := by
    by_contra hn
    have hp := mul_nonneg_of_nonpos_of_nonpos (by linarith : x - 1 ≤ 0)
      (by linarith : x - 2 ≤ 0)
    nlinarith [sq_pos_of_pos hy]
  have hx2 : x < 2 := by
    by_contra hn
    have hp := mul_nonneg (by linarith : 0 ≤ x - 1) (by linarith : 0 ≤ x - 2)
    nlinarith [sq_pos_of_pos hy]
  constructor <;> nlinarith [sq_nonneg y]

theorem dyadicPentagon_factor_sectors_cover : dyadicPentagonFSector ∪ dyadicPentagonGSector = univ := by
  apply eq_univ_of_forall
  intro z
  by_cases hn : 0 < torusCircleQ (-2) (-1) z
  · by_cases hp : 0 < torusCircleQ 1 2 z
    · exact Or.inr ⟨hn, hp⟩
    · apply Or.inl
      have hb := dyadicPentagon_disk_norm_bounds z.re z.im z.im_pos (by
        dsimp [torusCircleQ] at hp
        simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hp
        linarith)
      simpa only [dyadicPentagonFSector, mem_ofPred_eq, Complex.normSq_apply,
        UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, pow_two] using hb
  · apply Or.inl
    have hb := dyadicPentagon_disk_norm_bounds (-z.re) z.im z.im_pos (by
      dsimp [torusCircleQ] at hn
      simp only [Complex.normSq_apply, UpperHalfPlane.coe_re, UpperHalfPlane.coe_im] at hn
      nlinarith)
    simpa only [dyadicPentagonFSector, mem_ofPred_eq, Complex.normSq_apply,
      UpperHalfPlane.coe_re, UpperHalfPlane.coe_im, pow_two, neg_mul_neg] using hb

local instance isometryEvaluationAction {X : Type*} [MetricSpace X] : MulAction (X ≃ᵢ X) X where
  smul g x := g x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl

theorem dyadicPentagonFSector_wandering (g : ℍ ≃ᵢ ℍ) (hg : g ∈ Subgroup.zpowers dyadicPentagonF)
    (hne : g ≠ 1) : Disjoint (g • dyadicPentagonFSector) dyadicPentagonFSector := by
  apply torus_cyclic_sector_wandering dyadicPentagonF dyadicPentagonFSector
    {z | 4 < Complex.normSq (z : ℂ)} {z | 1 < Complex.normSq (z : ℂ)}
    {z | Complex.normSq (z : ℂ) < 1} {z | Complex.normSq (z : ℂ) < 4}
    (fun _ hz => hz.1) (fun z hz => by change 4 < Complex.normSq (z : ℂ) at hz; change 1 < _; linarith)
    _ (fun _ hz => hz.2)
    (fun z hz => by change Complex.normSq (z : ℂ) < 1 at hz; change _ < 4; linarith) _ _ _ g hg hne
  · intro z hz
    change 1 < Complex.normSq (z : ℂ) at hz
    change 4 < Complex.normSq ((dyadicPentagonF z : ℍ) : ℂ)
    rw [dyadicPentagonF_normSq]
    linarith
  · intro z hz
    change Complex.normSq (z : ℂ) < 4 at hz
    change Complex.normSq (((dyadicPentagonF⁻¹) z : ℍ) : ℂ) < 1
    rw [dyadicPentagonF_inv_normSq]
    linarith
  · exact Set.disjoint_left.mpr fun z hz hp => (not_lt_of_ge hp.2.le) hz
  · exact Set.disjoint_left.mpr fun z hz hp => (not_lt_of_ge hp.1.le) hz

theorem dyadicPentagonGSector_wandering (g : ℍ ≃ᵢ ℍ) (hg : g ∈ Subgroup.zpowers dyadicPentagonG)
    (hne : g ≠ 1) : Disjoint (g • dyadicPentagonGSector) dyadicPentagonGSector := by
  apply torus_cyclic_sector_wandering dyadicPentagonG dyadicPentagonGSector
    {z | torusCircleQ 1 2 z < 0} {z | 0 < torusCircleQ (-2) (-1) z}
    {z | torusCircleQ (-2) (-1) z < 0} {z | 0 < torusCircleQ 1 2 z}
    (fun _ hz => hz.1) _ _ (fun _ hz => hz.2) _ _ _ _ g hg hne
  · intro z hz
    change torusCircleQ 1 2 z < 0 at hz
    have hx := (torusCircleQ_inside_re (by norm_num : (1 : ℝ) < 2) z hz).1
    dsimp [torusCircleQ] at *
    nlinarith [Complex.normSq_nonneg (z : ℂ)]
  · intro z hz
    change 0 < torusCircleQ (-2) (-1) z at hz
    have he := dyadicPentagonG_side_identity z
    have hd := dyadicPentagonG_den_pos z
    change torusCircleQ 1 2 (dyadicPentagonG z) < 0
    nlinarith
  · intro z hz
    change torusCircleQ (-2) (-1) z < 0 at hz
    have hx := (torusCircleQ_inside_re (by norm_num : (-2 : ℝ) < -1) z hz).2
    dsimp [torusCircleQ] at *
    nlinarith [Complex.normSq_nonneg (z : ℂ)]
  · intro z hz
    change 0 < torusCircleQ 1 2 z at hz
    have he := dyadicPentagonG_side_identity (dyadicPentagonG.symm z)
    rw [dyadicPentagonG.apply_symm_apply] at he
    have hd := dyadicPentagonG_den_pos (dyadicPentagonG.symm z)
    change torusCircleQ (-2) (-1) (dyadicPentagonG.symm z) < 0
    nlinarith
  · exact Set.disjoint_left.mpr fun z hz hp => (not_lt_of_ge hp.2.le) hz
  · exact Set.disjoint_left.mpr fun z hz hp => (not_lt_of_ge hp.1.le) hz

theorem dyadicPentagonNativeGroup_le_cyclic_sup : dyadicPentagonNativeGroup ≤
    Subgroup.zpowers dyadicPentagonF ⊔ Subgroup.zpowers dyadicPentagonG := by
  apply (Subgroup.closure_le _).mpr
  rintro g (rfl | rfl)
  · exact Subgroup.mem_sup_left (Subgroup.mem_zpowers dyadicPentagonF)
  · exact Subgroup.mem_sup_right (Subgroup.mem_zpowers dyadicPentagonG)

theorem dyadicPentagonBaseQuad_wandering (g : ℍ ≃ᵢ ℍ) (hg : g ∈ dyadicPentagonNativeGroup)
    (hne : g ≠ 1) : Disjoint (g • dyadicPentagonBaseQuad) dyadicPentagonBaseQuad :=
  two_packing_domains_wandering (Subgroup.zpowers dyadicPentagonF) (Subgroup.zpowers dyadicPentagonG)
    dyadicPentagonFSector dyadicPentagonGSector dyadicPentagonFSector_wandering dyadicPentagonGSector_wandering
    dyadicPentagon_factor_sectors_cover g (dyadicPentagonNativeGroup_le_cyclic_sup hg) hne

theorem dyadicPentagonBaseQuad_isOpen : IsOpen dyadicPentagonBaseQuad :=
