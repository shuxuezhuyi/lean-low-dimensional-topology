open scoped UpperHalfPlane

/-- Each literal original triangle vertex, as a point of its actual full carrier. -/
def finiteTrianglePoincareVertex
    (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (i : Fin 3) : (finiteTrianglePoincarePolygon T).Point :=
  ⟨triangleOppositeVertex T i,(triangleBarycentric_carrier T _).mpr (by
    intro j
    rw [triangleBarycentric_opposite]
    split_ifs <;> norm_num)⟩

/-- Exactly the two actual adjacent sides are incident to an original triangle vertex. -/
theorem finiteTriangle_vertex_mem_side (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle) (i j : Fin 3) :
    (finiteTrianglePoincareVertex T i).val ∈ finiteTrianglePoincareSide T j ↔ i ≠ j := by
  rw [triangleBarycentric_side]
  constructor
  · rintro ⟨_hc,hz⟩ he
    change triangleBarycentric T (triangleOppositeVertex T i) j=0 at hz
    simp only [triangleBarycentric_opposite,he,ite_true] at hz
    exact one_ne_zero hz
  · intro hij
    refine ⟨(finiteTrianglePoincareVertex T i).property,?_⟩
    change triangleBarycentric T (triangleOppositeVertex T i) j=0
    simp [triangleBarycentric_opposite,hij]

/-- The genuine side-pairing generator is the actual original side reflection. -/
theorem finiteTriangle_generator_reflection
    (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (i : Fin 3) :
    (finiteTrianglePoincarePairing T).element (finiteTrianglePoincareSideEquiv T i)=
      _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (finiteTrianglePoincareLine T i) := by
  change _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (finiteTrianglePoincareLine T
    ((finiteTrianglePoincareSideEquiv T).symm (finiteTrianglePoincareSideEquiv T i)))=_
  rw [Equiv.symm_apply_apply]

/-- All literal triangle side maps fix every point of their original sides. -/
theorem finiteTriangle_fixed_sides (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle) :
    ∀ s : (finiteTrianglePoincarePolygon T).Side,∀ z ∈ s.val,
      (finiteTrianglePoincarePairing T).generator s • z=z := by
  intro s z hz
  exact finiteTrianglePoincareElement_fixed T s hz

/-- The actual vertex incident subgroup, embedded in the original native group,
is exactly the subgroup generated by its two original adjacent side reflections. -/
theorem finiteTriangle_vertex_incident_map
    (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (i : Fin 3) :
    ((finiteTrianglePoincarePairing T).incidentSubgroup (finiteTrianglePoincareVertex T i)).map
      (finiteTrianglePoincarePairing T).Generated.subtype=
    Subgroup.closure {g : ℍ≃ᵢℍ | ∃ j : Fin 3,j ≠ i ∧
      g=_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (finiteTrianglePoincareLine T j)} := by
  rw [_root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing.incidentSubgroup_map]
  congr 1
  ext g
  constructor
  · rintro ⟨s,hs,hg⟩
    let j := (finiteTrianglePoincareSideEquiv T).symm s
    have hj : i ≠ j := (finiteTriangle_vertex_mem_side T i j).mp (by
      rwa [finiteTrianglePoincareSideEquiv_symm])
    refine ⟨j,Ne.symm hj,?_⟩
    calc
      g=(finiteTrianglePoincarePairing T).element s := hg
      _=(finiteTrianglePoincarePairing T).element (finiteTrianglePoincareSideEquiv T j) :=
        congrArg (finiteTrianglePoincarePairing T).element
          ((finiteTrianglePoincareSideEquiv T).apply_symm_apply s).symm
      _=_ := finiteTriangle_generator_reflection T j
  · rintro ⟨j,hj,hg⟩
    refine ⟨finiteTrianglePoincareSideEquiv T j,?_,?_⟩
    · exact (finiteTriangle_vertex_mem_side T i j).mpr (Ne.symm hj)
    · exact hg.trans (finiteTriangle_generator_reflection T j).symm

/-- The whole literal original vertex class has precisely the actual incident subgroup indices. -/
theorem finiteTriangle_vertex_fiber_eq (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle) (i : Fin 3) :
    (finiteTrianglePoincarePairing T).project ⁻¹'
      {(finiteTrianglePoincarePairing T).project (1,finiteTrianglePoincareVertex T i)}=
    {b | b.2.val=(finiteTrianglePoincareVertex T i).val ∧
      b.1 ∈ (finiteTrianglePoincarePairing T).incidentSubgroup (finiteTrianglePoincareVertex T i)} :=
  _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing.project_fiber_eq_incidentSubgroup _ (finiteTriangle_fixed_sides T) _

/-- A genuinely finite native subgroup containing the two actual adjacent reflections proves
finiteness of the complete original vertex gluing class. -/
theorem finiteTriangle_vertex_fiber_finite (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle) (i : Fin 3)
    (J : Subgroup (ℍ≃ᵢℍ)) [Finite J]
    (hJ : ∀ j : Fin 3,j ≠ i → _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (finiteTrianglePoincareLine T j) ∈ J) :
    ((finiteTrianglePoincarePairing T).project ⁻¹'
      {(finiteTrianglePoincarePairing T).project (1,finiteTrianglePoincareVertex T i)}).Finite := by
  let S := finiteTrianglePoincarePairing T
  let : Finite (S.incidentSubgroup (finiteTrianglePoincareVertex T i)) :=
    S.finite_incidentSubgroup_of_finite_ambient (finiteTrianglePoincareVertex T i) J (by
      intro s hs
      let j := (finiteTrianglePoincareSideEquiv T).symm s
      have hj : i ≠ j := (finiteTriangle_vertex_mem_side T i j).mp (by
        rwa [finiteTrianglePoincareSideEquiv_symm])
      have he : S.element s=_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (finiteTrianglePoincareLine T j) := by
        calc S.element s=S.element (finiteTrianglePoincareSideEquiv T j) :=
               congrArg S.element ((finiteTrianglePoincareSideEquiv T).apply_symm_apply s).symm
             _=_ := finiteTriangle_generator_reflection T j
      rw [he]
      exact hJ j (Ne.symm hj))
  exact S.finite_project_fiber_of_finite_incidentSubgroup (finiteTriangle_fixed_sides T) _

/-- The original local star at the actual triangle vertex is its genuine incident-index ball union. -/
theorem finiteTriangle_vertex_neighborhood_eq
    (T : _root_.LowDimensionalTopology.Geometry.Hyperbolic.HTriangle)
    (i : Fin 3)
    (r : ℝ) :
    (finiteTrianglePoincarePairing T).copyNeighborhood (1,finiteTrianglePoincareVertex T i) r=
      {b | b.1 ∈ (finiteTrianglePoincarePairing T).incidentSubgroup (finiteTrianglePoincareVertex T i) ∧
        dist b.2.val (triangleOppositeVertex T i) < r} :=
  _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing.copyNeighborhood_eq_incidentSubgroup _ (finiteTriangle_fixed_sides T) _ r

end LowDimensionalTopology.Geometry.Fuchsian
