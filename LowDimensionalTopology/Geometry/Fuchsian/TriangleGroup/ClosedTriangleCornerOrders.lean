module
public import LowDimensionalTopology.Geometry.Fuchsian.TriangleGroup.ClosedTriangleStabilizers
public import LowDimensionalTopology.Geometry.Fuchsian.TriangleGroup.TwoMirrorRotations
@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set
open scoped UpperHalfPlane
namespace LowDimensionalTopology.Geometry.Fuchsian
open LowDimensionalTopology.Geometry.Auxiliary.Algebra
  LowDimensionalTopology.Geometry.Auxiliary.Analysis
  LowDimensionalTopology.Geometry.Auxiliary.Topology
  LowDimensionalTopology.Geometry.Euclidean
  LowDimensionalTopology.Geometry.Hyperbolic
  LowDimensionalTopology.Geometry.Mobius
  LowDimensionalTopology.Geometry.Polygon
  LowDimensionalTopology.Geometry.Surfaces
  LowDimensionalTopology.Geometry.DiscreteGroups
  LowDimensionalTopology.Geometry.Inversive
  LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Fuchsian
  LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace

def closedTriangleCornerRotation
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (i:Fin 3) : ℍ≃ᵢℍ:=
  _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 0))*
    _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 1))

theorem closedTriangle_vertex_incident_mirrors (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (x:(closedTrianglePoincarePolygon T).Point) (i:Fin 3)
    (hv:closedTriangleVertex T i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val) :
    {h:ℍ≃ᵢℍ|∃j:Fin 3,x.val∈T.nativeSide j ∧
      h=_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine j)}=
      {_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 0)),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 1))} := by
  ext h
  simp only [mem_ofPred_eq,mem_insert_iff,mem_singleton_iff]
  constructor
  · rintro ⟨j,hj,rfl⟩
    rcases (closedTriangleAdjacentSides_iff i j).mp ((closedTriangle_vertex_side_iff T i j x hv).mp hj) with rfl|rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl|rfl)
    · exact ⟨_,(closedTriangle_vertex_side_iff T i _ x hv).mpr
        ((closedTriangleAdjacentSides_iff i _).mpr (Or.inl rfl)),rfl⟩
    · exact ⟨_,(closedTriangle_vertex_side_iff T i _ x hv).mpr
        ((closedTriangleAdjacentSides_iff i _).mpr (Or.inr rfl)),rfl⟩

/-- The full original triangle stabilizer at a genuine finite vertex has precisely its two actual incident mirrors. -/
theorem closedTriangle_vertex_full_stabilizer (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (ha:IsIntegralTriangleAngle T.alpha) (hb:IsIntegralTriangleAngle T.beta)
    (hc:IsIntegralTriangleAngle T.gamma) (x:(closedTrianglePoincarePolygon T).Point)
    (i:Fin 3)
    (hv:closedTriangleVertex T i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val) :
    triangleReflectionGroup T ⊓ MulAction.stabilizer (ℍ≃ᵢℍ) x.val=
      Subgroup.closure ({_root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 0)),
        _root_.LowDimensionalTopology.Geometry.Hyperbolic.HalfPlaneLine.reflectionIsometry (T.nativeLine (closedTriangleAdjacentSides i 1))}:Set (ℍ≃ᵢℍ)) := by
  ext g
  change (g∈triangleReflectionGroup T ∧ g x.val=x.val) ↔ _
  rw [closedTriangle_fixed_iff_incident_mirrors T ha hb hc x g,
    closedTriangle_vertex_incident_mirrors T x i hv]

/-- The actual whole conformal stabilizer is generated by the original corner rotation. -/
theorem closedTriangle_vertex_conformal_stabilizer (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (ha:IsIntegralTriangleAngle T.alpha) (hb:IsIntegralTriangleAngle T.beta)
    (hc:IsIntegralTriangleAngle T.gamma) (x:(closedTrianglePoincarePolygon T).Point)
    (i:Fin 3)
    (hv:closedTriangleVertex T i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val) :
    triangleConformalGroup T ⊓ MulAction.stabilizer (ℍ≃ᵢℍ) x.val=
      Subgroup.zpowers (closedTriangleCornerRotation T i) := by
  rw [triangleConformalGroup,inf_right_comm,
    closedTriangle_vertex_full_stabilizer T ha hb hc x i hv,two_mirrors_conformal_subgroup]
  rfl

/-- The original corner rotation has exactly the reciprocal-angle order. -/
theorem closedTriangle_corner_rotation_order (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (x:(closedTrianglePoincarePolygon T).Point) (i:Fin 3)
    (hv:closedTriangleVertex T i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val)
    (n:ℕ) (hn:2≤n) (hθ:closedTriangleCornerAngle T i=Real.pi/(n:ℝ)) :
    orderOf (closedTriangleCornerRotation T i)=n := by
  let U:=closedTriangleCornerCycle T i
  have hUa:U.a=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val:=(closedTriangleCornerCycle_vertex T i).trans hv
  let C:=U.finiteCornerAtA x.val hUa
  have hR:C.rayAB.supportLine=T.nativeLine (closedTriangleAdjacentSides i 0):=
    C.supportAB.trans (closedTriangleCornerCycle_first_support T i)
  have hQ:C.rayAC.supportLine=T.nativeLine (closedTriangleAdjacentSides i 1):=
    C.supportAC.trans (closedTriangleCornerCycle_second_support T i)
  have hA:_root_.LowDimensionalTopology.Geometry.Hyperbolic.hInteriorAngleMeasure C.rayAB C.rayAC=Real.pi/(n:ℝ):=
    (closedTriangle_finiteCorner_angle U x.val hUa).trans ((closedTriangleCornerCycle_angle T i).trans hθ)
  have h:=native_reflection_product_order_of_angle C.rayAB C.rayAC C.proper n hn hA
  rwa [hR,hQ] at h

/-- The cardinality is computed from the actual finite stabilizer, not assigned as signature data. -/
theorem closedTriangle_vertex_conformal_stabilizer_card
    (T:_root_.LowDimensionalTopology.Geometry.Hyperbolic.ClosedHTriangle)
    (ha:IsIntegralTriangleAngle T.alpha) (hb:IsIntegralTriangleAngle T.beta)
    (hc:IsIntegralTriangleAngle T.gamma) (x:(closedTrianglePoincarePolygon T).Point)
    (i:Fin 3)
    (hv:closedTriangleVertex T i=_root_.LowDimensionalTopology.Geometry.Hyperbolic.halfPlaneToClosedModel x.val)
    (n:ℕ) (hn:2≤n) (hθ:closedTriangleCornerAngle T i=Real.pi/(n:ℝ)) :
    Nat.card ↥(triangleConformalGroup T ⊓ MulAction.stabilizer (ℍ≃ᵢℍ) x.val)=n := by
  rw [closedTriangle_vertex_conformal_stabilizer T ha hb hc x i hv,Nat.card_zpowers]
  exact closedTriangle_corner_rotation_order T x i hv n hn hθ

end LowDimensionalTopology.Geometry.Fuchsian
