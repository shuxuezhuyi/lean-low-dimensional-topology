module

public import LowDimensionalTopology.Geometry.Hyperbolic.Reflection.AnnularThreeMirrorOpenGap
public import LowDimensionalTopology.Geometry.DiscreteGroups.Action.PingPong
public import LowDimensionalTopology.Geometry.Polygon.Hyperbolic.Poincare.NativePoincarePolygons
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Tactic.FinCases

@[expose] public section
noncomputable section
open Set
open scoped UpperHalfPlane Pointwise

namespace LowDimensionalTopology.Geometry.Hyperbolic

/-- The subgroup generated by the three literal annular reflections is discrete
in the existing native half-plane isometry-group topology. -/
theorem annular_three_reflection_group_discrete (E r x : ℝ)
    (hE : 1 < E) (hr : 0 < r) (hinner : 1 + r < x) (houter : x + r < E) :
    let σ : Fin 3 → (ℍ ≃ᵢ ℍ) :=
      ![halfPlaneLineReflectionIsometry (HalfPlaneLine.circle 0 1 zero_lt_one),
        halfPlaneLineReflectionIsometry (HalfPlaneLine.circle 0 E (zero_lt_one.trans hE)),
        halfPlaneLineReflectionIsometry (HalfPlaneLine.circle x r hr)]
    DiscreteTopology (⨆ i : Fin 3, Subgroup.zpowers (σ i) : Subgroup (ℍ ≃ᵢ ℍ)) := by
  classical
  have hE0 : 0 < E := zero_lt_one.trans hE
  let σ : Fin 3 → (ℍ ≃ᵢ ℍ) :=
    ![halfPlaneLineReflectionIsometry (HalfPlaneLine.circle 0 1 zero_lt_one),
      halfPlaneLineReflectionIsometry (HalfPlaneLine.circle 0 E hE0),
      halfPlaneLineReflectionIsometry (HalfPlaneLine.circle x r hr)]
  let A : Fin 3 → Set ℍ :=
    ![{z : ℍ | ‖(z : ℂ)‖ < 1}, {z : ℍ | E < ‖(z : ℂ)‖},
      {z : ℍ | ‖(z : ℂ) - (x : ℂ)‖ < r}]
  let U := {z : ℍ | 1 < ‖(z : ℂ)‖ ∧ ‖(z : ℂ)‖ < E ∧
    r < ‖(z : ℂ) - (x : ℂ)‖}
  let H : Fin 3 → Subgroup (ℍ ≃ᵢ ℍ) := fun i => Subgroup.zpowers (σ i)
  let f : ∀ i, H i →* (ℍ ≃ᵢ ℍ) := fun i => (H i).subtype
  change DiscreteTopology (⨆ i : Fin 3, H i : Subgroup (ℍ ≃ᵢ ℍ))
  have hgeom : (Pairwise fun i j => Disjoint (A i) (A j)) ∧ IsOpen U ∧ U.Nonempty ∧
      (Pairwise fun i j => σ i '' A j ⊆ A i) ∧
      (∀ i, σ i '' U ⊆ A i) ∧ (∀ i, Disjoint (A i) U) :=
    annular_three_mirror_open_gap E r x hE hr hinner houter
  rcases hgeom with ⟨_hAdisj, hU, hUn, hcross, hstart, hgap⟩
  have hcyclic (L : HalfPlaneLine) (g : ℍ ≃ᵢ ℍ)
      (hg : g ∈ Subgroup.zpowers (halfPlaneLineReflectionIsometry L)) (hne : g ≠ 1) :
      g = halfPlaneLineReflectionIsometry L := by
    let s := halfPlaneLineReflectionIsometry L
    have hs : s ^ 2 = 1 := by
      apply IsometryEquiv.ext
      intro z
      change L.reflection (L.reflection z) = z
      exact L.reflection_involutive z
    have hfin : IsOfFinOrder s := isOfFinOrder_iff_pow_eq_one.mpr ⟨2, zero_lt_two, hs⟩
    have hle : orderOf s ≤ 2 := orderOf_le_of_pow_eq_one zero_lt_two hs
    obtain ⟨m, hm, hmg⟩ := Finset.mem_image.mp
      (hfin.mem_zpowers_iff_mem_range_orderOf.mp hg)
    have hm2 : m < 2 := (Finset.mem_range.mp hm).trans_le hle
    have hm01 : m = 0 ∨ m = 1 := by omega
    rcases hm01 with rfl | rfl
    · exact False.elim (hne (hmg.symm.trans (pow_zero s)))
    · simpa only [pow_one] using hmg.symm
  have hnonidentity (i : Fin 3) (h : H i) (hh : h ≠ 1) :
      (h : ℍ ≃ᵢ ℍ) = σ i := by
    have hne : (h : ℍ ≃ᵢ ℍ) ≠ 1 := fun he => hh (Subtype.ext he)
    have hm : (h : ℍ ≃ᵢ ℍ) ∈ Subgroup.zpowers (σ i) := h.property
    fin_cases i
    · exact hcyclic (HalfPlaneLine.circle 0 1 zero_lt_one) _ hm hne
    · exact hcyclic (HalfPlaneLine.circle 0 E hE0) _ hm hne
    · exact hcyclic (HalfPlaneLine.circle x r hr) _ hm hne
  have hpp : Pairwise fun i j => ∀ h : H i, h ≠ 1 → f i h • A j ⊆ A i := by
    intro i j hij h hh
    have he : f i h = σ i := hnonidentity i h hh
    rw [he]
    exact hcross hij
  have hstart' : ∀ i (h : H i), h ≠ 1 → f i h • U ⊆ A i := by
    intro i h hh
    have he : f i h = σ i := hnonidentity i h hh
    rw [he]
    exact hstart i
  have hrange : (Monoid.CoprodI.lift f).range = ⨆ i : Fin 3, H i := by
    rw [Monoid.CoprodI.range_eq_iSup]
    simp only [f, Subgroup.range_subtype]
  rw [← hrange]
  exact DiscreteGroups.discreteTopology_range_of_pingPong_gap
    f A U hU hUn hpp hstart' hgap

end LowDimensionalTopology.Geometry.Hyperbolic
