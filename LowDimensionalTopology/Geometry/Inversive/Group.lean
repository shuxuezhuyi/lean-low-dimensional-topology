/-!
# The reflection-generated general Möbius group

The algebraically generated subgroup of homeomorphisms is proved to consist
exactly of finite products of genuine positive-radius sphere inversions and
plane reflections with nonzero normals. In particular its use of subgroup
closure does not replace the finite-composition definition.

Translations, positive dilations, and similarity conjugacy are verified on
the whole one-point compactification. No parity or orientation criterion is
used to define the general group. Every Euclidean isometry is then expressed
as at most n+1 reflections, filtering zero-normal factors out of the linear
Cartan–Dieudonné word.
The arbitrary Euclidean isometry is not assumed surjective; its bijectivity
follows from finite dimensionality.
-/

@[expose] public section
noncomputable section
open scoped Topology RealInnerProductSpace OnePoint
open EuclideanGeometry Filter Topology Metric
namespace LowDimensionalTopology.Geometry.Inversive
variable {n : ℕ}
/-- Homeomorphisms of the fixed one-point compactification model. -/
abbrev ExtendedHomeomorph (n : ℕ) := ExtendedEuclidean n ≃ₜ ExtendedEuclidean n

/-- A genuine extended plane reflection, with nonzero normal. -/
def IsPlaneReflection (f : ExtendedHomeomorph n) : Prop :=
  ∃ a : Euclidean n, ∃ t : ℝ, ∃ ha : a ≠ 0,
    f = planeReflectionHomeomorph a t ha

/-- A positive-radius sphere reflection or a valid plane reflection. -/
def IsReflection (f : ExtendedHomeomorph n) : Prop :=
  (∃ c : Euclidean n, ∃ r : ℝ, ∃ hr : 0 < r,
    f = sphereInversionHomeomorph c r hr.ne') ∨
  (∃ a : Euclidean n, ∃ t : ℝ, ∃ ha : a ≠ 0,
    f = planeReflectionHomeomorph a t ha)

/-- Every plane reflection is one of the allowed generating reflections. -/
theorem IsPlaneReflection.isReflection {f : ExtendedHomeomorph n}
    (hf : IsPlaneReflection f) : IsReflection f := Or.inr hf

/-- Positive-radius sphere inversion is a generating reflection. -/
theorem sphereInversion_isReflection (c : Euclidean n) (r : ℝ) (hr : 0 < r) :
    IsReflection (sphereInversionHomeomorph c r hr.ne') := Or.inl ⟨c, r, hr, rfl⟩
/-- Plane reflection with nonzero normal is a generating reflection. -/
theorem planeReflection_isReflection (a : Euclidean n) (t : ℝ) (ha : a ≠ 0) :
    IsReflection (planeReflectionHomeomorph a t ha) := Or.inr ⟨a, t, ha, rfl⟩

/-- each reflection is its own inverse. -/
theorem IsReflection.inv_eq {f : ExtendedHomeomorph n} (hf : IsReflection f) : f⁻¹ = f := by
  rcases hf with ⟨c, r, hr, rfl⟩ | ⟨a, t, ha, rfl⟩
  · ext z; rfl
  · ext z; induction z using OnePoint.rec <;> rfl

/-- The inverse of a generating reflection is a generating reflection. -/
theorem IsReflection.inv {f : ExtendedHomeomorph n} (hf : IsReflection f) : IsReflection f⁻¹ := by
  rw [hf.inv_eq]; exact hf

/-- A finite product of the allowed reflections. -/
def FiniteReflectionComposition (f : ExtendedHomeomorph n) : Prop :=
  ∃ l : List (ExtendedHomeomorph n), (∀ g ∈ l, IsReflection g) ∧ l.prod = f

/-- The empty reflection word represents the identity. -/
theorem finiteReflectionComposition_one : FiniteReflectionComposition (1 : ExtendedHomeomorph n) :=
  ⟨[], by simp, by simp⟩
/-- One generating reflection is a finite reflection composition. -/
theorem IsReflection.finiteComposition {f : ExtendedHomeomorph n} (hf : IsReflection f) :
    FiniteReflectionComposition f := ⟨[f], by simpa, by simp⟩

/-- finite reflection compositions are closed under composition. -/
theorem FiniteReflectionComposition.mul {f g : ExtendedHomeomorph n}
    (hf : FiniteReflectionComposition f) (hg : FiniteReflectionComposition g) :
    FiniteReflectionComposition (f * g) := by
  obtain ⟨l, hl, rfl⟩ := hf
  obtain ⟨m, hm, rfl⟩ := hg
  exact ⟨l ++ m, by simpa only [List.mem_append, or_imp, forall_and] using ⟨hl, hm⟩,
    List.prod_append⟩

/-- inverse words are obtained by reversing and inverting factors. -/
theorem FiniteReflectionComposition.inv {f : ExtendedHomeomorph n}
    (hf : FiniteReflectionComposition f) : FiniteReflectionComposition f⁻¹ := by
  obtain ⟨l, hl, rfl⟩ := hf
  refine ⟨(l.map fun g ↦ g⁻¹).reverse, ?_, (List.prod_inv_reverse l).symm⟩
  intro g hg
  obtain ⟨h, hh, rfl⟩ := List.mem_map.mp (List.mem_reverse.mp hg)
  exact (hl h hh).inv

/-- The algebraic subgroup generated by reflections. -/
def generalMobiusGroup (n : ℕ) : Subgroup (ExtendedHomeomorph n) :=
  Subgroup.closure {f | IsReflection f}

/-- notation for the general Möbius group. -/
abbrev GM (n : ℕ) := generalMobiusGroup n

/-- Subgroup membership is equivalent to being a finite reflection word. -/
theorem mem_generalMobiusGroup_iff (f : ExtendedHomeomorph n) :
    f ∈ generalMobiusGroup n ↔ FiniteReflectionComposition f := by
  constructor
  · intro hf
    induction hf using Subgroup.closure_induction with
    | mem f hf => exact hf.finiteComposition
    | one => exact finiteReflectionComposition_one
    | mul f g hf hg ihf ihg => exact ihf.mul ihg
    | inv f hf ihf => exact ihf.inv
  · rintro ⟨l, hl, rfl⟩
    exact (generalMobiusGroup n).list_prod_mem fun g hg ↦ Subgroup.subset_closure (hl g hg)

/-- Each generating reflection belongs to the general Möbius group. -/
theorem IsReflection.mem_generalMobiusGroup {f : ExtendedHomeomorph n} (hf : IsReflection f) :
    f ∈ generalMobiusGroup n := Subgroup.subset_closure hf

/-- translation extended by fixing infinity. -/
def translationHomeomorph (a : Euclidean n) : ExtendedHomeomorph n :=
  (Homeomorph.addRight a).onePointCongr

/-- Translations fix infinity. -/
@[simp] theorem translationHomeomorph_infty (a : Euclidean n) : translationHomeomorph a ∞ = ∞ := rfl
/-- The finite action of an extended translation. -/
@[simp] theorem translationHomeomorph_coe (a x : Euclidean n) :
    translationHomeomorph a x = (x + a : ExtendedEuclidean n) := rfl

/-- A nonzero translation is the indicated pair of plane reflections. -/
theorem translationHomeomorph_eq_reflections (a : Euclidean n) (ha : a ≠ 0) :
    translationHomeomorph a =
      planeReflectionHomeomorph a (‖a‖ ^ 2 / 2) ha * planeReflectionHomeomorph a 0 ha := by
  ext z
  induction z using OnePoint.rec with
  | infty => rfl
  | coe x =>
    simp only [translationHomeomorph_coe, Homeomorph.mul_apply,
      planeReflectionHomeomorph_apply, planeReflection_coe, OnePoint.coe_eq_coe]
    change x + a = planeReflectionFinite a 0 x -
      (2 * (inner ℝ (planeReflectionFinite a 0 x) a - ‖a‖ ^ 2 / 2) / ‖a‖ ^ 2) • a
    rw [inner_planeReflectionFinite a 0 ha x]
    unfold planeReflectionFinite
    match_scalars
    · rfl
    · field_simp [norm_ne_zero_iff.mpr ha]
      ring

/-- A nonzero scalar dilation extended by fixing infinity. -/
def dilationHomeomorph (k : ℝ) (hk : k ≠ 0) : ExtendedHomeomorph n :=
  (Homeomorph.smulOfNeZero k hk : Euclidean n ≃ₜ Euclidean n).onePointCongr
/-- Dilations fix infinity. -/
@[simp] theorem dilationHomeomorph_infty (k : ℝ) (hk : k ≠ 0) :
    dilationHomeomorph (n := n) k hk ∞ = ∞ := rfl
/-- The finite action of an extended dilation. -/
@[simp] theorem dilationHomeomorph_coe (k : ℝ) (hk : k ≠ 0) (x : Euclidean n) :
    dilationHomeomorph k hk x = ((k • x : Euclidean n) : ExtendedEuclidean n) := rfl

/-- positive dilation is the indicated pair of sphere inversions. -/
theorem dilationHomeomorph_eq_reflections (k : ℝ) (hk : 0 < k) :
    dilationHomeomorph (n := n) k hk.ne' =
      sphereInversionHomeomorph 0 (Real.sqrt k) (Real.sqrt_pos.mpr hk).ne' *
        sphereInversionHomeomorph 0 1 one_ne_zero := by
  ext z
  induction z using OnePoint.rec with
  | infty => simp [Homeomorph.mul_apply, sphereInversionHomeomorph_apply]
  | coe x =>
    by_cases hx : x = 0
    · subst x; simp [Homeomorph.mul_apply, sphereInversionHomeomorph_apply]
    · simp only [Homeomorph.mul_apply, sphereInversionHomeomorph_apply]
      rw [sphereInversion_coe 0 1 hx,
        sphereInversion_coe 0 (Real.sqrt k) (by simpa using hx)]
      simp only [dilationHomeomorph_coe, OnePoint.coe_eq_coe]
      have hm := inversion_mul (0 : Euclidean n) (Real.sqrt k) 1 (inversion 0 1 x)
      simpa only [mul_one, inversion_inversion (0 : Euclidean n) one_ne_zero, AffineMap.homothety_apply,
        vsub_eq_sub, sub_zero, vadd_eq_add, add_zero, Real.sq_sqrt hk.le] using hm.symm

/-- Zero translation is the identity on the entire compactification. -/
theorem translationHomeomorph_zero (n : ℕ) :
    translationHomeomorph (0 : Euclidean n) = 1 := by
  ext z
  induction z using OnePoint.rec <;> simp

/-- Every translation is a product of two valid reflections. -/
theorem translation_two_reflections (a : Euclidean n) :
    ∃ f g : ExtendedHomeomorph n, IsReflection f ∧ IsReflection g ∧
      translationHomeomorph a = f * g := by
  by_cases ha : a = 0
  · subst a
    let f := sphereInversionHomeomorph (0 : Euclidean n) 1 one_ne_zero
    have hf : IsReflection f := sphereInversion_isReflection 0 1 zero_lt_one
    refine ⟨f, f, hf, hf, ?_⟩
    rw [translationHomeomorph_zero]
    simpa only [hf.inv_eq] using (inv_mul_cancel f).symm
  · exact ⟨_, _, planeReflection_isReflection a _ ha, planeReflection_isReflection a 0 ha,
      translationHomeomorph_eq_reflections a ha⟩

/-- Every translation is a general Möbius transformation. -/
theorem translation_mem_generalMobiusGroup (a : Euclidean n) :
    translationHomeomorph a ∈ generalMobiusGroup n := by
  obtain ⟨f, g, hf, hg, heq⟩ := translation_two_reflections a
  rw [heq]
  exact (generalMobiusGroup n).mul_mem hf.mem_generalMobiusGroup hg.mem_generalMobiusGroup

/-- Every positive dilation is a product of two valid reflections. -/
theorem dilation_two_reflections (k : ℝ) (hk : 0 < k) :
    ∃ f g : ExtendedHomeomorph n, IsReflection f ∧ IsReflection g ∧
      dilationHomeomorph k hk.ne' = f * g :=
  ⟨_, _, sphereInversion_isReflection 0 _ (Real.sqrt_pos.mpr hk),
    sphereInversion_isReflection 0 1 zero_lt_one, dilationHomeomorph_eq_reflections k hk⟩

/-- Every positive dilation is a general Möbius transformation. -/
theorem dilation_mem_generalMobiusGroup (k : ℝ) (hk : 0 < k) :
    dilationHomeomorph (n := n) k hk.ne' ∈ generalMobiusGroup n := by
  obtain ⟨f, g, hf, hg, heq⟩ := dilation_two_reflections (n := n) k hk
  rw [heq]
  exact (generalMobiusGroup n).mul_mem hf.mem_generalMobiusGroup hg.mem_generalMobiusGroup

/-- The similarity used in equation, including infinity. -/
def similarityHomeomorph (a : Euclidean n) (r : ℝ) (hr : r ≠ 0) : ExtendedHomeomorph n :=
  translationHomeomorph a * dilationHomeomorph r hr
/-- The similarity used for conjugacy fixes infinity. -/
@[simp] theorem similarityHomeomorph_infty (a : Euclidean n) (r : ℝ) (hr : r ≠ 0) :
    similarityHomeomorph a r hr ∞ = ∞ := rfl
/-- The finite affine formula for the conjugating similarity. -/
@[simp] theorem similarityHomeomorph_coe (a : Euclidean n) (r : ℝ) (hr : r ≠ 0)
    (x : Euclidean n) :
    similarityHomeomorph a r hr x = ((r • x + a : Euclidean n) : ExtendedEuclidean n) := rfl

/-- The conjugating positive similarity belongs to the general Möbius group. -/
theorem similarity_mem_generalMobiusGroup (a : Euclidean n) (r : ℝ) (hr : 0 < r) :
    similarityHomeomorph a r hr.ne' ∈ generalMobiusGroup n :=
  (generalMobiusGroup n).mul_mem (translation_mem_generalMobiusGroup a)
    (dilation_mem_generalMobiusGroup r hr)

/-- The finite identity underlying equation. -/
theorem inversion_similarity (a : Euclidean n) (r : ℝ) (hr : 0 < r)
    (x : Euclidean n) :
    inversion a r (r • x + a) = r • inversion 0 1 x + a := by
  by_cases hx : x = 0
  · subst x; simp
  · simp only [inversion, vsub_eq_sub, vadd_eq_add, dist_eq_norm, add_sub_cancel_right,
      norm_smul, Real.norm_eq_abs, abs_of_pos hr, sub_zero, smul_smul, one_div]
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    match_scalars
    · field_simp [hr.ne', hn]
    · rfl

/-- equation, on the complete one-point compactification. -/
theorem sphereInversion_similarity_conjugacy (a : Euclidean n) (r : ℝ) (hr : 0 < r) :
    sphereInversionHomeomorph a r hr.ne' =
      similarityHomeomorph a r hr.ne' * sphereInversionHomeomorph 0 1 one_ne_zero *
        (similarityHomeomorph a r hr.ne')⁻¹ := by
  apply (eq_mul_inv_iff_mul_eq).mpr
  ext z
  induction z using OnePoint.rec with
  | infty => simp [Homeomorph.mul_apply, sphereInversionHomeomorph_apply]
  | coe x =>
    simp only [Homeomorph.mul_apply, similarityHomeomorph_coe,
      sphereInversionHomeomorph_apply]
    by_cases hx : x = 0
    · subst x; simp
    · have hcenter : r • x + a ≠ a := by
        intro h
        have hzero : r • x = 0 := add_right_cancel
          (show r • x + a = 0 + a by simpa only [zero_add] using h)
        exact hx ((smul_eq_zero.mp hzero).resolve_left hr.ne')
      rw [sphereInversion_coe a r hcenter, sphereInversion_coe 0 1 hx,
        similarityHomeomorph_coe]
      exact congrArg OnePoint.some (inversion_similarity a r hr x)

/-- any two sphere inversions are conjugate inside the general Möbius group. -/
theorem sphereInversions_conjugate (a b : Euclidean n) (r s : ℝ)
    (hr : 0 < r) (hs : 0 < s) :
    ∃ f : ExtendedHomeomorph n, f ∈ generalMobiusGroup n ∧
      sphereInversionHomeomorph a r hr.ne' =
        f * sphereInversionHomeomorph b s hs.ne' * f⁻¹ := by
  refine ⟨similarityHomeomorph a r hr.ne' * (similarityHomeomorph b s hs.ne')⁻¹,
    (generalMobiusGroup n).mul_mem (similarity_mem_generalMobiusGroup a r hr)
      ((generalMobiusGroup n).inv_mem (similarity_mem_generalMobiusGroup b s hs)), ?_⟩
  rw [sphereInversion_similarity_conjugacy a r hr,
    sphereInversion_similarity_conjugacy b s hs]
  group

/-- general Möbius transformations are continuous. -/
theorem generalMobius_continuous (f : GM n) : Continuous (f : ExtendedHomeomorph n) :=
  (f : ExtendedHomeomorph n).continuous





/-- The linear hyperplane reflection used by the Cartan–Dieudonné factorization. -/
def cartanPlaneLinearIsometry (a : Euclidean n) : Euclidean n ≃ₗᵢ[ℝ] Euclidean n :=
  (ℝ ∙ a)ᗮ.reflection

/-- The Mathlib orthogonal reflection agrees with the finite plane reflection formula. -/
theorem cartanPlaneLinearIsometry_apply (a x : Euclidean n) :
    cartanPlaneLinearIsometry a x = planeReflectionFinite a 0 x := by
  rw [cartanPlaneLinearIsometry, Submodule.reflection_orthogonal_apply,
    Submodule.reflection_singleton_apply]
  unfold planeReflectionFinite
  rw [real_inner_comm a x]
  module

/-- The zero-normal auxiliary reflection is the identity and may be removed from a word. -/
theorem cartanPlaneLinearIsometry_zero :
    cartanPlaneLinearIsometry (0 : Euclidean n) = 1 := by
  ext x : 1
  rw [cartanPlaneLinearIsometry_apply]
  simp [planeReflectionFinite]

/-- Linear isometries extend multiplicatively to the same OnePoint homeomorphism model. -/
def cartanLinearExtensionHom :
    (Euclidean n ≃ₗᵢ[ℝ] Euclidean n) →*
      (ExtendedEuclidean n ≃ₜ ExtendedEuclidean n) where
  toFun φ := φ.toHomeomorph.onePointCongr
  map_one' := by
    ext z
    induction z using OnePoint.rec <;> rfl
  map_mul' φ ψ := by
    ext z
    induction z using OnePoint.rec <;> rfl

/-- A nonzero-normal linear reflection extends to the corresponding genuine plane reflection. -/
theorem cartanLinearExtension_plane (a : Euclidean n) (ha : a ≠ 0) :
    cartanLinearExtensionHom (cartanPlaneLinearIsometry a) =
      planeReflectionHomeomorph a 0 ha := by
  ext z
  induction z using OnePoint.rec with
  | infty => rfl
  | coe x =>
    change ((cartanPlaneLinearIsometry a x : Euclidean n) : ExtendedEuclidean n) = _
    rw [planeReflectionHomeomorph_apply, planeReflection_coe,
      cartanPlaneLinearIsometry_apply]

/-- Deleting zero-normal factors does not change the reflection product. -/
theorem cartan_filter_zero_prod (l : List (Euclidean n)) :
    ((l.filter fun a => a ≠ 0).map cartanPlaneLinearIsometry).prod =
      (l.map cartanPlaneLinearIsometry).prod := by
  classical
  induction l with
  | nil => rfl
  | cons a l ih =>
    by_cases ha : a = 0
    · subst a
      simpa [cartanPlaneLinearIsometry_zero] using ih
    · simpa [ha] using congrArg (fun f => cartanPlaneLinearIsometry a * f) ih

/-- The linear part: at most n valid plane reflections. -/
theorem cartanLinearExtension_reflections (φ : Euclidean n ≃ₗᵢ[ℝ] Euclidean n) :
    ∃ l : List (ExtendedEuclidean n ≃ₜ ExtendedEuclidean n),
      l.length ≤ n ∧
      (∀ f ∈ l, ∃ a : Euclidean n, ∃ ha : a ≠ 0,
        f = planeReflectionHomeomorph a 0 ha) ∧
      l.prod = φ.toHomeomorph.onePointCongr := by
  classical
  obtain ⟨l, hlen, hφ⟩ := φ.reflections_generate_dim
  let k := l.filter fun a => a ≠ 0
  refine ⟨k.map (fun a => cartanLinearExtensionHom (cartanPlaneLinearIsometry a)), ?_, ?_, ?_⟩
  · simpa [k] using (List.length_filter_le (fun a : Euclidean n => a ≠ 0) l).trans
      (show l.length ≤ n by simpa [Euclidean] using hlen)
  · intro f hf
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hf
    have hane : a ≠ 0 := by simpa using (List.mem_filter.mp ha).2
    exact ⟨a, hane, cartanLinearExtension_plane a hane⟩
  · have hm : ∀ m : List (Euclidean n),
        (m.map (fun a => cartanLinearExtensionHom (cartanPlaneLinearIsometry a))).prod =
          cartanLinearExtensionHom ((m.map cartanPlaneLinearIsometry).prod) := by
      intro m
      induction m with
      | nil => simp
      | cons a m ih => simp [ih]
    rw [hm, show (k.map cartanPlaneLinearIsometry).prod =
        (l.map cartanPlaneLinearIsometry).prod from cartan_filter_zero_prod l]
    change cartanLinearExtensionHom ((l.map fun a => (ℝ ∙ a)ᗮ.reflection).prod) = _
    rw [← hφ]
    rfl


/-- The finite plane-reflection formula bundled as a Euclidean isometry. -/
def planeReflectionFiniteIsometry (a : Euclidean n) (t : ℝ) : Euclidean n ≃ᵢ Euclidean n :=
  (cartanPlaneLinearIsometry a).toIsometryEquiv.trans
    (IsometryEquiv.addRight ((2 * t / ‖a‖ ^ 2) • a))

/-- The isometry bundle has exactly the earlier finite reflection formula. -/
theorem planeReflectionFiniteIsometry_apply (a : Euclidean n) (t : ℝ) (x : Euclidean n) :
    planeReflectionFiniteIsometry a t x = planeReflectionFinite a t x := by
  simp only [planeReflectionFiniteIsometry, IsometryEquiv.trans_apply,
    IsometryEquiv.addRight_apply, LinearIsometryEquiv.coe_toIsometryEquiv,
    cartanPlaneLinearIsometry_apply]
  unfold planeReflectionFinite
  module

/-- One valid plane reflection takes a prescribed nonzero vector to zero. -/
theorem planeReflectionFinite_halfnorm_self (a : Euclidean n) (ha : a ≠ 0) :
    planeReflectionFinite a (‖a‖ ^ 2 / 2) a = 0 := by
  unfold planeReflectionFinite
  rw [real_inner_self_eq_norm_sq]
  have hc : 2 * (‖a‖ ^ 2 - ‖a‖ ^ 2 / 2) / ‖a‖ ^ 2 = 1 := by
    field_simp [norm_ne_zero_iff.mpr ha]
    ring
  rw [hc, one_smul, sub_self]

/-- A distance-preserving self-map of finite-dimensional Euclidean space is automatically bijective. -/
def euclideanIsometryEquiv (f : Euclidean n → Euclidean n) (hf : Isometry f) :
    Euclidean n ≃ᵢ Euclidean n :=
  (hf.affineIsometryOfStrictConvexSpace.toAffineIsometryEquiv rfl).toIsometryEquiv

/-- Upgrading the Euclidean isometry adds no restriction or change to its action. -/
@[simp] theorem euclideanIsometryEquiv_apply (f : Euclidean n → Euclidean n)
    (hf : Isometry f) (x : Euclidean n) : euclideanIsometryEquiv f hf x = f x := rfl

/-- A Euclidean isometry extended to the one-point compactification. -/
def euclideanIsometryHomeomorph (f : Euclidean n → Euclidean n) (hf : Isometry f) :
    ExtendedHomeomorph n := (euclideanIsometryEquiv f hf).toHomeomorph.onePointCongr

/-- The extended Euclidean isometry fixes infinity. -/
@[simp] theorem euclideanIsometryHomeomorph_infty (f : Euclidean n → Euclidean n)
    (hf : Isometry f) : euclideanIsometryHomeomorph f hf ∞ = ∞ := rfl
/-- The extension retains the original isometry at each finite point. -/
@[simp] theorem euclideanIsometryHomeomorph_coe (f : Euclidean n → Euclidean n)
    (hf : Isometry f) (x : Euclidean n) :
    euclideanIsometryHomeomorph f hf x = (f x : ExtendedEuclidean n) := rfl

/-- A Euclidean isometry factors into at most n+1 valid plane reflections. -/
theorem isometryEquiv_reflections (f : Euclidean n ≃ᵢ Euclidean n) :
    ∃ l : List (ExtendedHomeomorph n), l.length ≤ n + 1 ∧
      (∀ g ∈ l, IsPlaneReflection g) ∧ l.prod = f.toHomeomorph.onePointCongr := by
  by_cases h0 : f 0 = 0
  · let φ := f.toRealLinearIsometryEquivOfMapZero h0
    obtain ⟨l, hlen, hplanes, hprod⟩ := cartanLinearExtension_reflections φ
    refine ⟨l, hlen.trans (Nat.le_succ n), ?_, ?_⟩
    · intro g hg
      obtain ⟨a, ha, heq⟩ := hplanes g hg
      exact ⟨a, 0, ha, heq⟩
    · rw [hprod]
      ext z
      induction z using OnePoint.rec <;> rfl
  · let a := f 0
    have ha : a ≠ 0 := h0
    let R := planeReflectionFiniteIsometry a (‖a‖ ^ 2 / 2)
    let g := f.trans R
    have hg0 : g 0 = 0 := by
      change R (f 0) = 0
      rw [planeReflectionFiniteIsometry_apply]
      exact planeReflectionFinite_halfnorm_self a ha
    let φ := g.toRealLinearIsometryEquivOfMapZero hg0
    obtain ⟨l, hlen, hplanes, hprod⟩ := cartanLinearExtension_reflections φ
    let σ := planeReflectionHomeomorph a (‖a‖ ^ 2 / 2) ha
    refine ⟨σ :: l, ?_, ?_, ?_⟩
    · simpa only [List.length_cons] using Nat.succ_le_succ hlen
    · intro h hh
      rcases List.mem_cons.mp hh with heq | hh
      · subst h; exact ⟨a, ‖a‖ ^ 2 / 2, ha, rfl⟩
      · obtain ⟨b, hb, heq⟩ := hplanes h hh
        exact ⟨b, 0, hb, heq⟩
    · rw [List.prod_cons, hprod]
      ext z
      induction z using OnePoint.rec with
      | infty => rfl
      | coe x =>
        change planeReflectionHomeomorph a (‖a‖ ^ 2 / 2) ha
          ((φ x : Euclidean n) : ExtendedEuclidean n) = (f x : ExtendedEuclidean n)
        rw [planeReflectionHomeomorph_apply, planeReflection_coe]
        apply congrArg OnePoint.some
        change planeReflectionFinite a (‖a‖ ^ 2 / 2) (R (f x)) = f x
        rw [planeReflectionFiniteIsometry_apply]
        exact planeReflectionFinite_involutive a (‖a‖ ^ 2 / 2) ha (f x)

/-- For arbitrary distance-preserving self-maps without a surjectivity hypothesis. -/
theorem euclidean_isometry_eq_reflection_product_length_le (f : Euclidean n → Euclidean n) (hf : Isometry f) :
    ∃ l : List (ExtendedHomeomorph n), l.length ≤ n + 1 ∧
      (∀ g ∈ l, IsPlaneReflection g) ∧ l.prod = euclideanIsometryHomeomorph f hf :=
  isometryEquiv_reflections (euclideanIsometryEquiv f hf)

/-- Every Euclidean isometry is a general Möbius transformation. -/
theorem euclideanIsometry_mem_generalMobiusGroup (f : Euclidean n → Euclidean n)
    (hf : Isometry f) : euclideanIsometryHomeomorph f hf ∈ generalMobiusGroup n := by
  rw [mem_generalMobiusGroup_iff]
  obtain ⟨l, _, hplanes, hprod⟩ := euclidean_isometry_eq_reflection_product_length_le f hf
  exact ⟨l, fun g hg ↦ (hplanes g hg).isReflection, hprod⟩


end LowDimensionalTopology.Geometry.Inversive
