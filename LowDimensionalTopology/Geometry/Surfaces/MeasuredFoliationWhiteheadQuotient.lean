module

public import LowDimensionalTopology.Geometry.Surfaces.SingularMeasuredFoliation
public import Mathlib.Logic.Relation

/-!
# Nondegenerate measured foliations and geometric Whitehead equivalence

Transverse measures are atomless and have full support on actual transverse
arcs. The elementary moves use ambient isotopies or a disk-supported collapse
of one embedded saddle connection. Every collapse has an actual quotient map,
a homeomorphism on the complements and the specified transverse measures.
The generated quotient makes no assertion about intersection spectra.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open Set Topology

namespace LowDimensionalTopology.Geometry.Surfaces

variable {X : Type} [TopologicalSpace X]

/-- The explicit atomless, full-support convention for transverse measures. -/
abbrev nondegenerateMeasuredFoliation (R : ClosedRiemannSurface X) :=
  {F : SingularMeasuredFoliation R // F.IsNondegenerate}

variable {R : ClosedRiemannSurface X}

/-- Local plaques and every actual transverse measure agree off the specified sets. -/
def IsMeasuredFoliationTransportOutside (F G : SingularMeasuredFoliation R)
    (c : C(X, X)) (K L : Set X) : Prop :=
  (∀ p ∉ F.atlas.singular, p ∉ K →
    ∃ e ∈ F.atlas.charts, ∃ d ∈ G.atlas.charts, ∃ W : Set X,
      IsOpen W ∧ p ∈ W ∧ W ⊆ (e.source ∩ Kᶜ) ∩ c ⁻¹' (d.source ∩ Lᶜ) ∧
        ∀ x ∈ W, ∀ y ∈ W,
          (e x).im = (e y).im ↔ (d (c x)).im = (d (c y)).im) ∧
  (∀ α : F.atlas.TransverseArc, Disjoint (Set.range α.curve) K →
    ∃ β : G.atlas.TransverseArc, ∀ t, β.curve t = c (α.curve t)) ∧
  (∀ β : G.atlas.TransverseArc, Disjoint (Set.range β.curve) L →
    ∃ α : F.atlas.TransverseArc, Disjoint (Set.range α.curve) K ∧
      ∀ t, β.curve t = c (α.curve t)) ∧
  ∀ (α : F.atlas.TransverseArc) (β : G.atlas.TransverseArc),
    Disjoint (Set.range α.curve) K → (∀ t, β.curve t = c (α.curve t)) →
      G.transverse.measure β = F.transverse.measure α

/-- A homeomorphism identifies the two singular leaf structures and their measures. -/
def IsMeasuredFoliationTransport (F G : SingularMeasuredFoliation R)
    (f : X ≃ₜ X) : Prop :=
  f '' F.atlas.singular = G.atlas.singular ∧
    IsMeasuredFoliationTransportOutside F G (⟨f, f.continuous⟩ : C(X, X)) ∅ ∅

/-- A genuine ambient isotopy, with homeomorphic slices and measured endpoint transport. -/
def MeasuredFoliationIsotopyStep (F G : SingularMeasuredFoliation R) : Prop :=
  ∃ f : X ≃ₜ X, IsMeasuredFoliationTransport F G f ∧
    ∃ H : ContinuousMap.Homotopy (ContinuousMap.id X) (⟨f, f.continuous⟩ : C(X, X)),
      ∀ t : unitInterval, IsHomeomorph (fun x => H (t, x))

/-- An actual embedded leaf segment between distinct singularities. -/
structure MeasuredFoliationSaddleConnection (F : SingularMeasuredFoliation R) where
  start : X
  finish : X
  start_ne_finish : start ≠ finish
  start_singular : start ∈ F.atlas.singular
  finish_singular : finish ∈ F.atlas.singular
  curve : Path start finish
  isEmbedding : Topology.IsEmbedding (curve : unitInterval → X)
  interior_regular : ∀ t ∈ Ioo (0 : unitInterval) 1, curve t ∉ F.atlas.singular
  locally_leafwise : ∀ t ∈ Ioo (0 : unitInterval) 1,
    ∃ e ∈ F.atlas.charts, ∃ J : Set unitInterval,
      IsOpen J ∧ t ∈ J ∧ J ⊆ Ioo 0 1 ∧
        ∀ s ∈ J, curve s ∈ e.source ∧ (e (curve s)).im = (e (curve t)).im

/-- Collapse one saddle connection inside a genuine disk, preserving all complement data. -/
def MeasuredFoliationWhiteheadCollapse (F G : SingularMeasuredFoliation R) : Prop :=
  ∃ γ : MeasuredFoliationSaddleConnection F,
    ∃ d : OpenPartialHomeomorph X ℂ, ∃ c : C(X, X), ∃ p : X,
      let K : Set X := Set.range (γ.curve : unitInterval → X)
      d.target = Metric.ball (0 : ℂ) 1 ∧ K ⊆ d.source ∧
        d.source ∩ F.atlas.singular = {γ.start, γ.finish} ∧
        (∀ x ∉ d.source, c x = x) ∧ Set.MapsTo c d.source d.source ∧
        Topology.IsQuotientMap c ∧ c ⁻¹' {p} = K ∧
        (∃ h : {x : X // x ∉ K} ≃ₜ {x : X // x ≠ p},
          ∀ x, (h x).val = c x.val) ∧
        G.atlas.singular = c '' F.atlas.singular ∧
        IsMeasuredFoliationTransportOutside F G c K {p}

/-- One of the two specified geometric moves on the same nondegenerate carrier. -/
def measuredFoliationElementaryStep
    (F G : nondegenerateMeasuredFoliation R) : Prop :=
  MeasuredFoliationIsotopyStep F.val G.val ∨
    MeasuredFoliationWhiteheadCollapse F.val G.val

/-- The equivalence generated by isotopies, collapses and their inverse expansions. -/
def measuredFoliationWhiteheadSetoid (R : ClosedRiemannSurface X) :
    Setoid (nondegenerateMeasuredFoliation R) :=
  Relation.EqvGen.setoid (measuredFoliationElementaryStep (R := R))

/-- The geometric quotient with the explicitly specified nondegeneracy convention. -/
def NondegenerateMeasuredFoliationQuotient (R : ClosedRiemannSurface X) :=
  Quotient (measuredFoliationWhiteheadSetoid R)

/-- The quotient class of the same actual foliation and transverse measures. -/
def nondegenerateMeasuredFoliationQuotientMk
    (F : nondegenerateMeasuredFoliation R) : NondegenerateMeasuredFoliationQuotient R :=
  Quotient.mk (measuredFoliationWhiteheadSetoid R) F

/-- Quotient equality means exactly a finite chain of the specified geometric moves. -/
theorem nondegenerateMeasuredFoliationQuotientMk_eq_iff
    (F G : nondegenerateMeasuredFoliation R) :
    nondegenerateMeasuredFoliationQuotientMk F = nondegenerateMeasuredFoliationQuotientMk G ↔
      Relation.EqvGen measuredFoliationElementaryStep F G := by
  constructor
  · intro h
    exact Quotient.exact h
  · intro h
    exact Quotient.sound h

/-- Each actual elementary move identifies the two actual quotient representatives. -/
theorem nondegenerateMeasuredFoliationQuotientMk_eq_of_step
    {F G : nondegenerateMeasuredFoliation R} (h : measuredFoliationElementaryStep F G) :
    nondegenerateMeasuredFoliationQuotientMk F = nondegenerateMeasuredFoliationQuotientMk G := by
  apply Quotient.sound
  exact Relation.EqvGen.rel F G h

end LowDimensionalTopology.Geometry.Surfaces
