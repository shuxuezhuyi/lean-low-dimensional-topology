public import LowDimensionalTopology.External.TauCeti.AlgebraicTopology.FundamentalGroup.Homeomorph
@[expose] public section
noncomputable section
set_option autoImplicit false
open Set Topology
namespace LowDimensionalTopology.Geometry.Surfaces.HandlePresentation

/-- When the second cover member has trivial fundamental group, all fundamental-group
classes of the union come from the first cover member. -/
theorem inclusion_surjective_of_second_subsingleton {X : Type*} [TopologicalSpace X]
    {A B : Set X} {x : X} (hxA : x ∈ A) (hxB : x ∈ B)
    (hcover : interior A ∪ interior B = univ)
    (hA : IsPathConnected A) (hB : IsPathConnected B) (hAB : IsPathConnected (A ∩ B))
    [Subsingleton (FundamentalGroup B ⟨x, hxB⟩)] :
    Function.Surjective (FundamentalGroup.map (ContinuousMap.subtypeVal A) ⟨x, hxA⟩) := by
  apply MonoidHom.range_eq_top.mp
  have h := TauCeti.FundamentalGroup.range_map_subtypeVal_sup_eq_top
    hcover hA hB hAB hxA hxB
  erw [TauCeti.FundamentalGroup.map_range_eq_bot_of_subsingleton
    (ContinuousMap.subtypeVal B), sup_bot_eq] at h
  exact h

/-- The exact disc-attachment kernel follows from van Kampen's genuine gluing theorem.
Its generators are the actual images of all loops in the overlap. -/
theorem inclusion_ker_of_second_subsingleton {X : Type*} [TopologicalSpace X]
    {A B : Set X} {x : X} (hxA : x ∈ A) (hxB : x ∈ B)
    (hcover : interior A ∪ interior B = univ)
    (hA : IsPathConnected A) (hB : IsPathConnected B) (hAB : IsPathConnected (A ∩ B))
    [Subsingleton (FundamentalGroup B ⟨x, hxB⟩)] :
    (FundamentalGroup.map (ContinuousMap.subtypeVal A) ⟨x, hxA⟩).ker =
      Subgroup.normalClosure (Set.range
        (FundamentalGroup.map (ContinuousMap.inclusion inter_subset_left)
          (⟨x, mem_inter hxA hxB⟩ : ↥(A ∩ B)))) := by
  let iA : FundamentalGroup ↥(A ∩ B) ⟨x, mem_inter hxA hxB⟩ →*
      FundamentalGroup A ⟨x, hxA⟩ :=
    FundamentalGroup.map (ContinuousMap.inclusion inter_subset_left)
      (⟨x, mem_inter hxA hxB⟩ : ↥(A ∩ B))
  let iB : FundamentalGroup ↥(A ∩ B) ⟨x, mem_inter hxA hxB⟩ →*
      FundamentalGroup B ⟨x, hxB⟩ :=
    FundamentalGroup.map (ContinuousMap.inclusion inter_subset_right)
      (⟨x, mem_inter hxA hxB⟩ : ↥(A ∩ B))
  let jA : FundamentalGroup A ⟨x, hxA⟩ →* FundamentalGroup X x :=
    FundamentalGroup.map (ContinuousMap.subtypeVal A) ⟨x, hxA⟩
  let jB : FundamentalGroup B ⟨x, hxB⟩ →* FundamentalGroup X x :=
    FundamentalGroup.map (ContinuousMap.subtypeVal B) ⟨x, hxB⟩
  let N : Subgroup (FundamentalGroup A ⟨x, hxA⟩) := Subgroup.normalClosure (Set.range iA)
  let q : FundamentalGroup A ⟨x, hxA⟩ →* FundamentalGroup A ⟨x, hxA⟩ ⧸ N :=
    QuotientGroup.mk' N
  have hcomm : jA.comp iA = jB.comp iB := by
    ext γ
    obtain ⟨γ⟩ := γ
    induction γ using Path.Homotopic.Quotient.ind with
    | mk γ => rfl
  have hN : N ≤ jA.ker := by
    let : jA.ker.Normal := MonoidHom.normal_ker jA
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨γ, rfl⟩
    change jA (iA γ) = 1
    have hi : iB γ = 1 := Subsingleton.elim _ _
    have he := DFunLike.congr_fun hcomm γ
    change jA (iA γ) = jB (iB γ) at he
    rw [he, hi, map_one]
  have hcompat : q.comp iA = (1 : FundamentalGroup B ⟨x, hxB⟩ →*
      FundamentalGroup A ⟨x, hxA⟩ ⧸ N).comp iB := by
    ext γ
    change QuotientGroup.mk (iA γ) = 1
    exact (QuotientGroup.eq_one_iff _).mpr
      (Subgroup.subset_normalClosure (Set.mem_range_self γ))
  let desc := TauCeti.vanKampenDesc hcover hA hB hAB hxA hxB q 1 hcompat
  have hdesc : desc.comp jA = q :=
    TauCeti.vanKampenDesc_comp_map_left hcover hA hB hAB hxA hxB q 1 hcompat
  apply le_antisymm ?_ hN
  intro γ hγ
  apply (QuotientGroup.eq_one_iff γ).mp
  have he := (DFunLike.congr_fun hdesc γ).symm
  change q γ = desc (jA γ) at he
  exact he.trans ((congrArg desc (MonoidHom.mem_ker.mp hγ)).trans (map_one desc))

/-- If the overlap group is generated by a single genuine loop, its entire image
normal closure is generated by that loop's image. -/
theorem normalClosure_range_eq_singleton_of_zpowers {G H : Type*} [Group G] [Group H]
    (f : G →* H) (c : G) (hc : Subgroup.zpowers c = ⊤) :
    Subgroup.normalClosure (Set.range f) = Subgroup.normalClosure ({f c} : Set H) := by
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro _ ⟨γ, rfl⟩
    have hγ : γ ∈ Subgroup.zpowers c := by rw [hc]; exact Subgroup.mem_top _
    obtain ⟨n, rfl⟩ := hγ
    rw [map_zpow]
    exact (Subgroup.normalClosure ({f c} : Set H)).zpow_mem
      (Subgroup.subset_normalClosure (Set.mem_singleton _)) n
  · apply Subgroup.normalClosure_mono
    rw [Set.singleton_subset_iff]
    exact Set.mem_range_self c

/-- A cyclic overlap with a simply connected disc yields the exact one-relator presentation
of the actual union, without postulating a presentation theorem. -/
def discCoverQuotientEquiv {X : Type*} [TopologicalSpace X]
    {A B : Set X} {x : X} (hxA : x ∈ A) (hxB : x ∈ B)
    (hcover : interior A ∪ interior B = univ)
    (hA : IsPathConnected A) (hB : IsPathConnected B) (hAB : IsPathConnected (A ∩ B))
    [Subsingleton (FundamentalGroup B ⟨x, hxB⟩)]
    (c : FundamentalGroup ↥(A ∩ B) ⟨x, mem_inter hxA hxB⟩) (hc : Subgroup.zpowers c = ⊤) :
    (FundamentalGroup A ⟨x, hxA⟩ ⧸ Subgroup.normalClosure
      (Set.singleton (FundamentalGroup.map (ContinuousMap.inclusion inter_subset_left)
        (⟨x, mem_inter hxA hxB⟩ : ↥(A ∩ B)) c) : Set (FundamentalGroup A ⟨x, hxA⟩))) ≃*
      FundamentalGroup X x :=
  QuotientGroup.liftEquiv _
    (inclusion_surjective_of_second_subsingleton hxA hxB hcover hA hB hAB)
    ((inclusion_ker_of_second_subsingleton hxA hxB hcover hA hB hAB).trans
      (normalClosure_range_eq_singleton_of_zpowers _ c hc)).symm

end LowDimensionalTopology.Geometry.Surfaces.HandlePresentation
