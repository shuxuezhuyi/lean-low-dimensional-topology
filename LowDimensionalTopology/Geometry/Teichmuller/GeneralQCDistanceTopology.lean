module

public import LowDimensionalTopology.Geometry.Teichmuller.GeneralQCDistanceAxioms
public import Mathlib.Topology.MetricSpace.Cauchy
public import Mathlib.Topology.MetricSpace.Pseudo.Constructions

/-!
# The original general QC distance topology

The full-log distance defines a named pseudometric structure whose topology
is the existing topology generated by the original distance balls. The
distance is continuous for that original topology, and the usual metric
Cauchy criterion now applies to the same original marked quotient.
Separation and completeness are subsequent assertions.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open Set Filter Topology

namespace LowDimensionalTopology.Geometry.Teichmuller.GeneralQC

universe u v

@[instance_reducible] def distancePseudoMetricData (R : Surface.{u}) :
    PseudoMetricSpace (Space.{u, v} R) where
  dist := distance
  dist_self := distance_self
  dist_comm := distance_symm
  dist_triangle := distance_triangle

/-- The distance-induced topology equals the topology already defined from
the same original full-log balls. No topology is replaced without this proof. -/
theorem distanceTopology_eq_induced (R : Surface.{u}) :
    distanceTopology.{u, v} R =
      (distancePseudoMetricData.{u, v} R).toUniformSpace.toTopologicalSpace := by
  let := distancePseudoMetricData.{u, v} R
  apply le_antisymm
  · intro s hs
    apply (@isOpen_iff_forall_mem_open (Space.{u, v} R)
      (distanceTopology.{u, v} R) s).mpr
    intro x hx
    obtain ⟨ε, hε, hsub⟩ := Metric.isOpen_iff.mp hs x hx
    refine ⟨{y | distance y x < ε}, hsub, ?_, ?_⟩
    · exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨x, ε, rfl⟩
    · change distance x x < ε
      simpa only [distance_self] using hε
  · apply TopologicalSpace.le_generateFrom_iff_subset_isOpen.mpr
    rintro s ⟨p, r, rfl⟩
    exact Metric.isOpen_ball (x := p) (ε := r)

/-- The actual original quotient has this named pseudometric, with its
pre-existing distance-ball topology definitionally preserved. -/
@[instance_reducible] def pseudoMetricSpace (R : Surface.{u}) :
    PseudoMetricSpace (Space.{u, v} R) := by
  letI := distanceTopology.{u, v} R
  exact (distancePseudoMetricData.{u, v} R).replaceTopology
    (distanceTopology_eq_induced.{u, v} R)

@[simp] theorem pseudoMetricSpace_dist (R : Surface.{u}) (p q : Space.{u, v} R) :
    @dist _ (pseudoMetricSpace.{u, v} R).toDist p q = distance p q := rfl

@[simp] theorem pseudoMetricSpace_topology (R : Surface.{u}) :
    (pseudoMetricSpace.{u, v} R).toUniformSpace.toTopologicalSpace =
      distanceTopology.{u, v} R := rfl

/-- The same original full-log distance is continuous on the product of the
original distance-ball topologies. -/
theorem distance_continuous (R : Surface.{u}) :
    letI := distanceTopology.{u, v} R
    Continuous (fun p : Space.{u, v} R × Space.{u, v} R => distance p.1 p.2) := by
  let := pseudoMetricSpace.{u, v} R
  exact continuous_dist (α := Space.{u, v} R)

/-- The named uniformity tests Cauchy sequences by the same original distance. -/
theorem cauchySeq_iff_distance (R : Surface.{u}) (p : ℕ → Space.{u, v} R) :
    letI := pseudoMetricSpace.{u, v} R
    CauchySeq p ↔ ∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, distance (p m) (p n) < ε := by
  let := pseudoMetricSpace.{u, v} R
  exact Metric.cauchySeq_iff (u := p)

end LowDimensionalTopology.Geometry.Teichmuller.GeneralQC
