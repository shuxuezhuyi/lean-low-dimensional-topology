module

public import LowDimensionalTopology.Geometry.Teichmuller.SourceMarking
public import LowDimensionalTopology.External.LiZhongQC.Ch08.S29_TeichmullerMetric
public import Mathlib.Topology.Order

/-!
# QC-marked classes with arbitrary original Riemann-surface targets

A target has its actual carrier, topology and native complex atlas. No
compactness, finite type, chosen coordinates or metric is part of the data.
The equivalence is precisely a conformal target map compatible with the
markings up to continuous homotopy. The distance is the original infimum of
logarithmic maximal dilatations over all compatible QC target transitions.

We also name the topology generated by the balls of this actual distance.
No metric separation or completeness is asserted here.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

open Set Topology
open scoped Manifold ContDiff

namespace LowDimensionalTopology.Geometry.Teichmuller.GeneralQC

open Surfaces

universe u v w

/-- A general Riemann surface with its actual topology and native atlas. -/
structure Surface where
  carrier : Type u
  [topology : TopologicalSpace carrier]
  riemann : RiemannSurface carrier

attribute [instance] Surface.topology

instance (R : Surface) : T2Space R.carrier := R.riemann.t2Space
instance (R : Surface) : ConnectedSpace R.carrier := R.riemann.connectedSpace
instance (R : Surface) : ChartedSpace ℂ R.carrier := R.riemann.toRiemannAtlas.toChartedSpace
instance (R : Surface) : IsManifold 𝓘(ℂ) ω R.carrier := R.riemann.toRiemannAtlas.isManifold

/-- Bundle the original surface without changing its carrier, topology or atlas. -/
def Surface.ofRiemannSurface {X : Type u} [TopologicalSpace X]
    (R : RiemannSurface X) : Surface.{u} where
  carrier := X
  topology := inferInstance
  riemann := R

/-- Only the original target and its actual QC marking are supplied. -/
structure Marked (R : Surface.{u}) where
  target : Surface.{v}
  marking : R.carrier ≃ₜ target.carrier
  qc : LiZhongQC.IsQCRS marking

/-- A conformal target equivalence compatible with the actual marking homotopy. -/
def Marked.Equivalent {R : Surface.{u}} (m n : Marked.{u, v} R) : Prop :=
  ∃ c : m.target.carrier ≃ₜ n.target.carrier,
    LiZhongQC.IsBiholomorphic (c : m.target.carrier → n.target.carrier) ∧
      ContinuousMap.Homotopic
        ((m.marking.trans c : R.carrier ≃ₜ n.target.carrier) :
          C(R.carrier, n.target.carrier))
        (n.marking : C(R.carrier, n.target.carrier))

/-- The conformal map in the relation is equivalently analytic in every original chart. -/
theorem marked_equivalent_iff_analytic {R : Surface.{u}} (m n : Marked.{u, v} R) :
    m.Equivalent n ↔ ∃ c : m.target.carrier ≃ₜ n.target.carrier,
      RiemannAnalyticMap m.target.riemann.toRiemannAtlas
        n.target.riemann.toRiemannAtlas c ∧
      ContinuousMap.Homotopic
        ((m.marking.trans c : R.carrier ≃ₜ n.target.carrier) :
          C(R.carrier, n.target.carrier))
        (n.marking : C(R.carrier, n.target.carrier)) := by
  simp only [Marked.Equivalent, analyticHomeomorph_iff_sourceBiholomorphic]

/-- The original marked relation is an equivalence, for open targets as well. -/
theorem marked_equivalence (R : Surface.{u}) : Equivalence (Marked.Equivalent (R := R)) := by
  refine ⟨?_, ?_, ?_⟩
  · intro m
    exact ⟨Homeomorph.refl m.target.carrier, LiZhongQC.isBiholomorphic_id,
      ContinuousMap.Homotopic.refl _⟩
  · rintro m n ⟨c, hc, hh⟩
    refine ⟨c.symm, hc.homeomorph_symm, ?_⟩
    rw [LiZhongQC.coe_homeomorph_trans] at hh ⊢
    have hcancel : (c.symm : C(n.target.carrier, m.target.carrier)).comp
        (c : C(m.target.carrier, n.target.carrier)) =
        ContinuousMap.id m.target.carrier := by
      ext x
      exact c.symm_apply_apply x
    have h := (ContinuousMap.Homotopic.refl
      (c.symm : C(n.target.carrier, m.target.carrier))).comp hh
    rw [← ContinuousMap.comp_assoc, hcancel, ContinuousMap.id_comp] at h
    exact h.symm
  · rintro m n p ⟨c, hc, hh⟩ ⟨d, hd, hk⟩
    refine ⟨c.trans d, hd.comp hc, ?_⟩
    rw [LiZhongQC.coe_homeomorph_trans] at hh hk
    rw [LiZhongQC.coe_homeomorph_trans, LiZhongQC.coe_homeomorph_trans]
    have h := (ContinuousMap.Homotopic.refl
      (d : C(n.target.carrier, p.target.carrier))).comp hh
    rw [← ContinuousMap.comp_assoc] at h
    exact h.trans hk

/-- The setoid has exactly the original conformal marked homotopy relation. -/
def markedSetoid (R : Surface.{u}) : Setoid (Marked.{u, v} R) where
  r := Marked.Equivalent
  iseqv := marked_equivalence R

/-- The actual QC-marked quotient, with no closed-target restriction. -/
def Space (R : Surface.{u}) : Type (max u (v + 1)) := Quotient (markedSetoid.{u, v} R)

/-- The class of the actual original QC-marked surface. -/
def mk {R : Surface.{u}} (m : Marked.{u, v} R) : Space.{u, v} R := Quotient.mk _ m

/-- The actual original identity marking supplies the original base point. -/
def basePoint (R : Surface.{u}) : Space.{u, u} R :=
  mk { target := R, marking := Homeomorph.refl R.carrier, qc := LiZhongQC.isQCRS_refl }

/-- All actual full logarithmic dilatations of compatible target transitions. -/
def admissibleLogDilatations {R : Surface.{u}} (p q : Space.{u, v} R) : Set ℝ :=
  {d | ∃ (m n : Marked.{u, v} R) (f : m.target.carrier ≃ₜ n.target.carrier),
    mk m = p ∧ mk n = q ∧ LiZhongQC.IsQCRS f ∧
      ContinuousMap.Homotopic
        ((m.marking.trans f : R.carrier ≃ₜ n.target.carrier) :
          C(R.carrier, n.target.carrier))
        (n.marking : C(R.carrier, n.target.carrier)) ∧
      d = Real.log (LiZhongQC.maxDilatationRS f).toReal}

/-- The original distance uses the full logarithm, with no factor one half. -/
def distance {R : Surface.{u}} (p q : Space.{u, v} R) : ℝ :=
  sInf (admissibleLogDilatations p q)

/-- There is a genuine compatible QC transition between any two actual classes. -/
theorem admissibleLogDilatations_nonempty {R : Surface.{u}} (p q : Space.{u, v} R) :
    (admissibleLogDilatations p q).Nonempty := by
  refine Quotient.inductionOn₂ p q ?_
  intro m n
  let f := m.marking.symm.trans n.marking
  have hf : LiZhongQC.IsQCRS f :=
    LiZhongQC.s28q_isQCRS_trans (LiZhongQC.s28q_isQCRS_symm m.qc) n.qc
  refine ⟨_, m, n, f, rfl, rfl, hf, ?_, rfl⟩
  have hmark : ((m.marking.trans f : R.carrier ≃ₜ n.target.carrier) :
      C(R.carrier, n.target.carrier)) = (n.marking : C(R.carrier, n.target.carrier)) := by
    ext x
    exact congrArg n.marking (m.marking.symm_apply_apply x)
  rw [hmark]

/-- Every actual comparison has nonnegative logarithmic maximal dilatation. -/
theorem admissibleLogDilatations_nonneg {R : Surface.{u}} (p q : Space.{u, v} R) :
    ∀ d ∈ admissibleLogDilatations p q, 0 ≤ d := by
  rintro d ⟨m, n, f, _, _, hf, _, rfl⟩
  exact Real.log_nonneg (LiZhongQC.s29_m_one_le_toReal hf)

/-- Thus the actual infimum has a genuine lower bound. -/
theorem admissibleLogDilatations_bddBelow {R : Surface.{u}} (p q : Space.{u, v} R) :
    BddBelow (admissibleLogDilatations p q) :=
  ⟨0, admissibleLogDilatations_nonneg p q⟩

/-- The original distance is nonnegative without any metric-separation assumption. -/
theorem distance_nonneg {R : Surface.{u}} (p q : Space.{u, v} R) : 0 ≤ distance p q :=
  Real.sInf_nonneg (admissibleLogDilatations_nonneg p q)

/-- The topology generated by the balls of this actual original distance. -/
@[instance_reducible] def distanceTopology (R : Surface.{u}) : TopologicalSpace (Space.{u, v} R) :=
  TopologicalSpace.generateFrom {s | ∃ (p : Space.{u, v} R) (r : ℝ),
    s = {q | distance q p < r}}

end LowDimensionalTopology.Geometry.Teichmuller.GeneralQC
