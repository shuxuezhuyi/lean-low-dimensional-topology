module

public import LowDimensionalTopology.Geometry.Teichmuller.SourceMarkingSurjectivity
public import LowDimensionalTopology.Geometry.Teichmuller.BookTeichmullerMetric
public import Mathlib.Topology.MetricSpace.Isometry
public import Mathlib.Topology.UniformSpace.UniformEmbedding

/-!
# The full-log QC metric on native smooth-marked classes

The actual native-to-QC equivalence pulls back the complete metric defined by
log-dilatations of marking-compatible quasiconformal homeomorphisms. The result
is explicit metric data on native classes, with the concrete handle-group
presentation supplied as a visible mathematical input.

No equality with the independently defined coefficient quotient topology is
asserted here.
-/

@[expose] public section
noncomputable section

open scoped ContDiff Manifold

namespace LowDimensionalTopology.Geometry.Teichmuller

open Surfaces

universe u

namespace TeichmullerSpace

variable {X : Type u} [TopologicalSpace X] (R : ClosedRiemannSurface X)

/-- The actual full-log QC distance between the source classes of two native
smooth markings. It uses the original marking-compatible admissible maps. -/
def fromQCDistance (p q : TeichmullerSpace.{u, u} R) : ℝ := by
  let : ChartedSpace ℂ X := R.toRiemannAtlas.toChartedSpace
  exact QCBookMetric.bookDistance (toSource R p) (toSource R q)

/-- Explicit metric data pulled back along the proved native-to-QC equivalence.
Its topology is the topology generated by this distance. -/
@[instance_reducible] def fromQCMetricSpace {g : ℕ} (hg : 1 < g) (hgenus : R.HasGenus g)
    (hPresentation : Unproved.HandleGroupPresentation g) :
    MetricSpace (TeichmullerSpace.{u, u} R) := by
  let : ChartedSpace ℂ X := R.toRiemannAtlas.toChartedSpace
  let : IsManifold 𝓘(ℂ) ω X := R.toRiemannAtlas.isManifold
  let : T2Space X := R.t2Space
  let : ConnectedSpace X := R.connectedSpace
  let : CompactSpace X := R.compactSpace
  let e := sourceEquiv R hg hgenus hPresentation
  exact MetricSpace.induced e e.injective
    (QCBookMetric.metricSpace hg (R.sourceHasGenus hgenus hPresentation))

/-- The pulled-back metric distance is the actual full-log QC candidate infimum. -/
theorem fromQCMetricSpace_dist {g : ℕ} (hg : 1 < g) (hgenus : R.HasGenus g)
    (hPresentation : Unproved.HandleGroupPresentation g)
    (p q : TeichmullerSpace.{u, u} R) :
    let : MetricSpace (TeichmullerSpace.{u, u} R) :=
      fromQCMetricSpace R hg hgenus hPresentation
    dist p q = fromQCDistance R p q := by
  rfl

/-- The distance is literally the infimum over the unchanged, genuine source
QC representatives and homotopy-compatible homeomorphisms. -/
theorem fromQCDistance_eq_admissible_inf (p q : TeichmullerSpace.{u, u} R) :
    let : ChartedSpace ℂ X := R.toRiemannAtlas.toChartedSpace
    fromQCDistance R p q =
      sInf (QCBookMetric.admissibleLogDilatations (toSource R p) (toSource R q)) := by
  rfl

/-- Completeness transports through the actual surjective isometry. The only
unproved mathematical input is the displayed canonical handle presentation. -/
theorem fromQCMetricSpace_complete {g : ℕ} (hg : 1 < g) (hgenus : R.HasGenus g)
    (hPresentation : Unproved.HandleGroupPresentation g) :
    let : MetricSpace (TeichmullerSpace.{u, u} R) :=
      fromQCMetricSpace R hg hgenus hPresentation
    CompleteSpace (TeichmullerSpace.{u, u} R) := by
  let : ChartedSpace ℂ X := R.toRiemannAtlas.toChartedSpace
  let : IsManifold 𝓘(ℂ) ω X := R.toRiemannAtlas.isManifold
  let : T2Space X := R.t2Space
  let : ConnectedSpace X := R.connectedSpace
  let : CompactSpace X := R.compactSpace
  have hX := R.sourceHasGenus hgenus hPresentation
  let e : TeichmullerSpace.{u, u} R ≃ LiZhongQC.TeichSpace X :=
    sourceEquiv R hg hgenus hPresentation
  let mB : MetricSpace (LiZhongQC.TeichSpace X) := QCBookMetric.metricSpace hg hX
  let : MetricSpace (LiZhongQC.TeichSpace X) := mB
  have : CompleteSpace (LiZhongQC.TeichSpace X) := QCBookMetric.completeSpace hg hX
  let : MetricSpace (TeichmullerSpace.{u, u} R) :=
    fromQCMetricSpace R hg hgenus hPresentation
  have he : Isometry (e : TeichmullerSpace.{u, u} R → LiZhongQC.TeichSpace X) :=
    MetricSpace.isometry_induced e e.injective
  exact (he.isUniformInducing.completeSpace_congr e.surjective).2 inferInstance

end TeichmullerSpace

end LowDimensionalTopology.Geometry.Teichmuller
