module
public import LowDimensionalTopology.Geometry.Euclidean.Reflection.FiniteRotationSectors
public import Mathlib.Analysis.Complex.Isometry
@[expose] public section
noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
open Set Topology
open scoped ComplexConjugate
namespace LowDimensionalTopology.Geometry.Euclidean

/-- A genuine real-linear planar isometry, with its reflection flag explicit. -/
def finitePlanarOrthogonalMap (u : Circle) (b : Bool) : ℂ ≃ₗᵢ[ℝ] ℂ :=
  if b then Complex.conjLIE.trans (rotation u) else rotation u

theorem finitePlanarOrthogonalMap_apply (u : Circle) (b : Bool) (z : ℂ) :
    finitePlanarOrthogonalMap u b z=(u:ℂ)*(if b then conj z else z) := by
  cases b <;> rfl

theorem finitePlanarOrthogonalMap_mul (u v : Circle) (b c : Bool) :
    finitePlanarOrthogonalMap u b*finitePlanarOrthogonalMap v c=
      finitePlanarOrthogonalMap (u*(if b then v⁻¹ else v)) (Bool.xor b c) := by
  apply LinearIsometryEquiv.ext
  intro z
  change finitePlanarOrthogonalMap u b (finitePlanarOrthogonalMap v c z)=_
  rw [finitePlanarOrthogonalMap_apply,finitePlanarOrthogonalMap_apply,finitePlanarOrthogonalMap_apply]
  have hv : conj (v:ℂ)=(v:ℂ)⁻¹ := by rw [←Circle.coe_inv_eq_conj,Circle.coe_inv]
  cases b <;> cases c <;> simp [hv,mul_assoc,map_mul]

theorem finitePlanarOrthogonalMap_one :
    finitePlanarOrthogonalMap 1 false=1 := by
  apply LinearIsometryEquiv.ext
  intro z
  simp [finitePlanarOrthogonalMap_apply]

theorem finitePlanarOrthogonalMap_inv (u : Circle) (b : Bool) :
    (finitePlanarOrthogonalMap u b)⁻¹=
      finitePlanarOrthogonalMap (if b then u else u⁻¹) b := by
  apply inv_eq_of_mul_eq_one_left
  rw [finitePlanarOrthogonalMap_mul]
  cases b <;> simpa using finitePlanarOrthogonalMap_one

/-- The actual planar subgroup generated by the two literal boundary reflections. -/
def finitePlanarDihedralGroup (n : ℕ) : Subgroup (ℂ ≃ₗᵢ[ℝ] ℂ) :=
  Subgroup.closure {finitePlanarOrthogonalMap 1 true,
    finitePlanarOrthogonalMap (finiteRotationGenerator n) true}

/-- Every actual generated word has the usual rotation-or-reflection normal form. -/
theorem finitePlanarDihedralGroup_normal_form (n : ℕ) (g : ℂ ≃ₗᵢ[ℝ] ℂ)
    (hg : g∈finitePlanarDihedralGroup n) :
    ∃k : ℤ,∃b : Bool,g=finitePlanarOrthogonalMap (finiteRotationGenerator n^k) b := by
  change g∈Subgroup.closure _ at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with rfl|rfl
    · exact ⟨0,true,by simp⟩
    · exact ⟨1,true,by simp⟩
  | one => exact ⟨0,false,by simpa using finitePlanarOrthogonalMap_one.symm⟩
  | mul a b _ _ iha ihb =>
    obtain ⟨k,c,rfl⟩:=iha
    obtain ⟨l,d,rfl⟩:=ihb
    refine ⟨k+(if c then -l else l),Bool.xor c d,?_⟩
    rw [finitePlanarOrthogonalMap_mul,zpow_add]
    cases c <;> simp
  | inv a _ iha =>
    obtain ⟨k,b,rfl⟩:=iha
    refine ⟨if b then k else -k,b,?_⟩
    rw [finitePlanarOrthogonalMap_inv]
    cases b <;> simp

/-- Genuine boundary reflections generate the actual primitive rotation. -/
theorem finitePlanarDihedralGroup_rotation_mem (n : ℕ) :
    finitePlanarOrthogonalMap (finiteRotationGenerator n) false∈finitePlanarDihedralGroup n := by
  have h0 : finitePlanarOrthogonalMap 1 true∈finitePlanarDihedralGroup n:=
    Subgroup.subset_closure (Or.inl rfl)
  have h1 : finitePlanarOrthogonalMap (finiteRotationGenerator n) true∈finitePlanarDihedralGroup n:=
    Subgroup.subset_closure (Or.inr (mem_singleton _))
  simpa only [finitePlanarOrthogonalMap_mul,ite_true,inv_one,mul_one,Bool.xor_self] using
    (finitePlanarDihedralGroup n).mul_mem h1 h0

/-- Every actual normal form belongs to the original two-reflection generated subgroup. -/
theorem finitePlanarDihedralGroup_normal_form_mem (n : ℕ) (k : ℤ) (b : Bool) :
    finitePlanarOrthogonalMap (finiteRotationGenerator n^k) b∈finitePlanarDihedralGroup n := by
  have hp : ∀ k : ℤ,finitePlanarOrthogonalMap (finiteRotationGenerator n^k) false∈
      finitePlanarDihedralGroup n := by
    intro k
    have he : finitePlanarOrthogonalMap (finiteRotationGenerator n^k) false=
        finitePlanarOrthogonalMap (finiteRotationGenerator n) false^k := by
      induction k using Int.induction_on with
      | zero => simpa using finitePlanarOrthogonalMap_one
      | succ k ih =>
        rw [zpow_add,zpow_one,zpow_add,zpow_one,←ih,finitePlanarOrthogonalMap_mul]
        rfl
      | pred k ih =>
        rw [zpow_sub,zpow_one,zpow_sub,zpow_one,←ih,finitePlanarOrthogonalMap_inv,
          finitePlanarOrthogonalMap_mul]
        rfl
    rw [he]
    exact (finitePlanarDihedralGroup n).zpow_mem (finitePlanarDihedralGroup_rotation_mem n) k
  cases b
  · exact hp k
  · have h0 : finitePlanarOrthogonalMap 1 true∈finitePlanarDihedralGroup n:=
      Subgroup.subset_closure (Or.inl rfl)
    simpa only [finitePlanarOrthogonalMap_mul,Bool.false_eq_true,ite_false,mul_one,Bool.false_xor] using
      (finitePlanarDihedralGroup n).mul_mem (hp k) h0

/-- Actual generated transformations, with no faithfulness assumption, form a finite set. -/
theorem finitePlanarDihedralGroup_finite (n : ℕ) (hn : 0<n) :
    (finitePlanarDihedralGroup n : Set (ℂ ≃ₗᵢ[ℝ] ℂ)).Finite := by
  apply (finite_range (fun p : Fin n×Bool=>finitePlanarOrthogonalMap
    (finiteRotationGenerator n^p.1.val) p.2)).subset
  intro g hg
  obtain ⟨k,b,rfl⟩:=finitePlanarDihedralGroup_normal_form n g hg
  obtain ⟨i,hi⟩:=finiteRotationGenerator_zpow_eq_fin n hn k
  exact ⟨(i,b),by simp only [hi]⟩

/-- These normal forms are genuinely distinct real-linear maps. -/
theorem finitePlanarOrthogonalMap_injective :
    Function.Injective (fun p : Circle×Bool=>finitePlanarOrthogonalMap p.1 p.2) := by
  rintro ⟨u,b⟩ ⟨v,c⟩ he
  have hu : u=v := Circle.ext (by
    simpa [finitePlanarOrthogonalMap_apply] using congrArg (fun f : ℂ ≃ₗᵢ[ℝ] ℂ=>f 1) he)
  subst v
  have hI:=congrArg (fun f : ℂ ≃ₗᵢ[ℝ] ℂ=>f Complex.I) he
  cases b <;> cases c
  · rfl
  · have hh : Complex.I= -Complex.I:=mul_left_cancel₀ u.coe_ne_zero
      (by simpa only [finitePlanarOrthogonalMap_apply,Bool.false_eq_true,ite_false,ite_true,
        Complex.conj_I] using hI)
    have hc:=congrArg Complex.im hh
    norm_num at hc
  · have hh : -Complex.I=Complex.I:=mul_left_cancel₀ u.coe_ne_zero
      (by simpa only [finitePlanarOrthogonalMap_apply,Bool.false_eq_true,ite_false,ite_true,
        Complex.conj_I] using hI)
    have hc:=congrArg Complex.im hh
    norm_num at hc
  · rfl

/-- Finite normal forms exhaust the actual original two-reflection group. -/
def finitePlanarDihedralIndexEquiv (n : ℕ) (hn : 0<n) :
    (Fin n×Bool)≃finitePlanarDihedralGroup n :=
  Equiv.ofBijective (fun p=>⟨finitePlanarOrthogonalMap (finiteRotationGenerator n^p.1.val) p.2,
    by simpa only [zpow_natCast] using finitePlanarDihedralGroup_normal_form_mem n (p.1.val:ℤ) p.2⟩) (by
    constructor
    · rintro ⟨i,b⟩ ⟨j,c⟩ he
      have hp : (finiteRotationGenerator n^i.val,b)=(finiteRotationGenerator n^j.val,c):=
        @finitePlanarOrthogonalMap_injective (finiteRotationGenerator n^i.val,b)
          (finiteRotationGenerator n^j.val,c) (congrArg Subtype.val he)
      have hij : i=j:=finiteRotationGenerator_pow_fin_injective n hn (congrArg Prod.fst hp)
      exact Prod.ext hij (congrArg (fun p : Circle×Bool=>p.2) hp)
    · intro g
      obtain ⟨k,b,hg⟩:=finitePlanarDihedralGroup_normal_form n g.val g.property
      obtain ⟨i,hi⟩:=finiteRotationGenerator_zpow_eq_fin n hn k
      refine ⟨(i,b),Subtype.ext ?_⟩
      change finitePlanarOrthogonalMap (finiteRotationGenerator n^i.val) b=g.val
      rw [hg,hi])

/-- The genuine generated subgroup has exactly twice the original rotation order. -/
theorem finitePlanarDihedralGroup_card (n : ℕ) (hn : 0<n) :
    Nat.card (finitePlanarDihedralGroup n)=2*n := by
  rw [←Nat.card_congr (finitePlanarDihedralIndexEquiv n hn),Nat.card_prod]
  simp [Nat.mul_comm]

/-- The literal reflection fixes exactly the genuine real line in its half-angle direction. -/
theorem finitePlanarOrthogonalMap_reflection_fixed_iff (v : Circle) (z : ℂ) :
    finitePlanarOrthogonalMap (v*v) true z=z ↔ ∃r : ℝ,z=(r:ℂ)*(v:ℂ) := by
  have hv : conj (v:ℂ)=(v:ℂ)⁻¹ := by rw [←Circle.coe_inv_eq_conj,Circle.coe_inv]
  constructor
  · intro he
    have he' : (v:ℂ)*(v:ℂ)*conj z=z:=by
      simpa only [finitePlanarOrthogonalMap_apply,ite_true,Circle.coe_mul] using he
    have hw : conj ((v:ℂ)⁻¹*z)=(v:ℂ)⁻¹*z := by
      rw [map_mul,map_inv₀,hv,inv_inv]
      apply mul_left_cancel₀ v.coe_ne_zero
      calc
        (v:ℂ)*((v:ℂ)*conj z)=(v:ℂ)*(v:ℂ)*conj z:=by ring
        _=z:=he'
        _=(v:ℂ)*((v:ℂ)⁻¹*z):=by simp
    obtain ⟨r,hr⟩:=Complex.conj_eq_iff_real.mp hw
    refine ⟨r,?_⟩
    calc z=(v:ℂ)*((v:ℂ)⁻¹*z):=by simp
         _=(v:ℂ)*(r:ℂ):=by rw [hr]
         _=(r:ℂ)*(v:ℂ):=mul_comm _ _
  · rintro ⟨r,rfl⟩
    change (v*v:Circle)*conj ((r:ℂ)*(v:ℂ))=(r:ℂ)*(v:ℂ)
    rw [Circle.coe_mul,map_mul,Complex.conj_ofReal,hv]
    field_simp

theorem finitePlanarOrthogonalMap_reflection_sq (u : Circle) :
    finitePlanarOrthogonalMap u true^2=1 := by
  rw [pow_two,finitePlanarOrthogonalMap_mul]
  simpa using finitePlanarOrthogonalMap_one

/-- The second boundary reflection has the correct genuine half-angle line. -/
theorem finiteRotationGenerator_half_square (n : ℕ) :
    Circle.exp (finiteRotationPeriod n/2)^2=finiteRotationGenerator n := by
  rw [pow_two,←Circle.exp_add]
  change Circle.exp (finiteRotationPeriod n/2+finiteRotationPeriod n/2)=Circle.exp (finiteRotationPeriod n)
  congr 1
  ring

theorem finitePlanarDihedral_first_fixed_iff (z : ℂ) :
    finitePlanarOrthogonalMap 1 true z=z ↔ ∃r : ℝ,z=(r:ℂ) := by
  simpa only [one_mul,Circle.coe_one,mul_one] using
    finitePlanarOrthogonalMap_reflection_fixed_iff 1 z

theorem finitePlanarDihedral_second_fixed_iff (n : ℕ) (z : ℂ) :
    finitePlanarOrthogonalMap (finiteRotationGenerator n) true z=z ↔
      ∃r : ℝ,z=(r:ℂ)*(Circle.exp (finiteRotationPeriod n/2):ℂ) := by
  have h:=finitePlanarOrthogonalMap_reflection_fixed_iff (Circle.exp (finiteRotationPeriod n/2)) z
  rwa [←pow_two,finiteRotationGenerator_half_square] at h

end LowDimensionalTopology.Geometry.Euclidean
