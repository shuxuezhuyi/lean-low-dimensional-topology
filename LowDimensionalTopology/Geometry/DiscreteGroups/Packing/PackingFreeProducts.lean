module
public import LowDimensionalTopology.Geometry.DiscreteGroups.Packing.MobiusPackings
public import Mathlib.GroupTheory.CoprodI
@[expose] public section
open Set Filter Monoid
open scoped Topology OnePoint
namespace LowDimensionalTopology.Geometry.DiscreteGroups
open LowDimensionalTopology.Geometry.DiscreteGroups LowDimensionalTopology.Geometry.DiscreteGroups.Action
  LowDimensionalTopology.Geometry.Hyperbolic LowDimensionalTopology.Geometry.Hyperbolic.QuaternionHalfSpace
  LowDimensionalTopology.Geometry.Mobius
noncomputable section

/-- The canonical map from the free product of actual geometric subgroups. -/
def mobiusPackingFreeProductLift {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup) :
    CoprodI (fun i => G i) →* Mobius.complexMobiusGroup :=
  CoprodI.lift (fun i => (G i).subtype)

/-- A reduced word sends the domain of its last factor outside the domain of its first factor. -/
theorem mobiusPacking_reduced_word {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) {i j : ι}
    (w : CoprodI.NeWord (fun i => G i) i j) :
    ∀ z ∈ D j, (mobiusPackingFreeProductLift G w.prod).val z ∉ D i := by
  induction w with
  | @singleton i g hg =>
    intro z hz hgz
    have hi := hp i g hg
    exact Set.disjoint_left.mp hi ⟨z, hz, rfl⟩ hgz
  | @append i j k l w₁ hne w₂ ih₁ ih₂ =>
    intro z hz
    have hnot := ih₂ z hz
    have hin : (mobiusPackingFreeProductLift G w₂.prod).val z ∈ D j := by
      have hm : (mobiusPackingFreeProductLift G w₂.prod).val z ∈ D j ∪ D k := by
        rw [hc j k hne]
        trivial
      exact hm.resolve_right hnot
    rw [CoprodI.NeWord.append_prod, map_mul]
    change (mobiusPackingFreeProductLift G w₁.prod).val
      ((mobiusPackingFreeProductLift G w₂.prod).val z) ∉ D i
    exact ih₁ _ hin

/-- A nonempty reduced word moves every point of the common packing set outside that set. -/
theorem mobiusPacking_word_nontrivial {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ)
    (hne : (⋂ i, D i).Nonempty) (w : CoprodI.Word (fun i => G i)) (hw : w ≠ CoprodI.Word.empty) :
    mobiusPackingFreeProductLift G w.prod ≠ 1 := by
  obtain ⟨i, j, v, rfl⟩ := CoprodI.NeWord.of_word w hw
  obtain ⟨z, hz⟩ := hne
  intro he
  have hout := mobiusPacking_reduced_word G D hp hc v z (Set.mem_iInter.mp hz j)
  change (mobiusPackingFreeProductLift G v.toWord.prod).val z ∉ D i at hout
  rw [he] at hout
  exact hout (Set.mem_iInter.mp hz i)

/-- The geometric packing base point gives injectivity without any factor-cardinality hypothesis. -/
theorem mobiusPackingFreeProductLift_injective {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) (hne : (⋂ i, D i).Nonempty) :
    Function.Injective (mobiusPackingFreeProductLift G) := by
  classical
  apply (injective_iff_map_eq_one (mobiusPackingFreeProductLift G)).mpr
  rw [(CoprodI.Word.equiv).forall_congr_left]
  intro w he
  dsimp [CoprodI.Word.equiv] at *
  by_cases hw : w = CoprodI.Word.empty
  · rw [hw, CoprodI.Word.prod_empty]
  · exact False.elim (mobiusPacking_word_nontrivial G D hp hc hne w hw he)

theorem mobiusPackingFreeProductLift_range {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup) :
    (mobiusPackingFreeProductLift G).range = ⨆ i, G i := by
  rw [mobiusPackingFreeProductLift, CoprodI.range_eq_iSup]
  congr
  funext i
  exact Subgroup.range_subtype (G i)

/-- The subgroup generated by a packing family is canonically isomorphic to its free product. -/
def mobiusPackingFreeProductEquiv {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) (hne : (⋂ i, D i).Nonempty) :
    CoprodI (fun i => G i) ≃* ↥(⨆ i, G i : Subgroup Mobius.complexMobiusGroup) := by
  let f := (mobiusPackingFreeProductLift G).codRestrict (⨆ i, G i) (fun x => by
    rw [← mobiusPackingFreeProductLift_range G]
    exact ⟨x, rfl⟩)
  apply MulEquiv.ofBijective f
  constructor
  · intro x y he
    exact mobiusPackingFreeProductLift_injective G D hp hc hne (congrArg Subtype.val he)
  · intro g
    obtain ⟨x, hx⟩ := (show g.val ∈ (mobiusPackingFreeProductLift G).range by
      rw [mobiusPackingFreeProductLift_range]; exact g.property)
    exact ⟨x, Subtype.ext hx⟩

/-- The common set satisfies the packing separation conclusion without an openness assumption. -/
theorem mobiusPacking_common_intersection {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) :
    IsMobiusPacking (⨆ i, G i) (⋂ i, D i) := by
  classical
  intro g hg
  obtain ⟨x, hx⟩ := (show g.val ∈ (mobiusPackingFreeProductLift G).range by
    rw [mobiusPackingFreeProductLift_range]; exact g.property)
  let w := CoprodI.Word.equiv x
  have hwprod : w.prod = x := (CoprodI.Word.equiv).symm_apply_apply x
  have hw : w ≠ CoprodI.Word.empty := by
    intro he
    have hxone : x = 1 := by rw [← hwprod, he, CoprodI.Word.prod_empty]
    apply hg
    apply Subtype.ext
    rw [← hx, hxone, map_one]
    rfl
  obtain ⟨i, j, v, hv⟩ := CoprodI.NeWord.of_word w hw
  have hvprod : mobiusPackingFreeProductLift G v.prod = g.val := by
    change mobiusPackingFreeProductLift G v.toWord.prod = g.val
    rw [hv, hwprod]
    exact hx
  apply Set.disjoint_left.mpr
  rintro y ⟨z, hz, rfl⟩ hy
  have hout := mobiusPacking_reduced_word G D hp hc v z (Set.mem_iInter.mp hz j)
  rw [hvprod] at hout
  exact hout (Set.mem_iInter.mp hy i)

/-- The open common set has a discontinuous saturation; openness is needed for infinite intersections. -/
theorem mobiusPacking_common_saturation_discontinuous {ι : Type*}
    (G : ι → Subgroup Mobius.complexMobiusGroup) (D : ι → Set Mobius.ExtendedComplex)
    (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) (ho : IsOpen (⋂ i, D i)) :
    IsMobiusDiscontinuousOn (⨆ i, G i) (mobiusSaturation (⨆ i, G i) (⋂ i, D i)) :=
  mobius_openPacking_saturation_discontinuous _ _ ho (mobiusPacking_common_intersection G D hp hc)

/-- A nonempty open common packing set also proves discreteness of the generated actual group. -/
theorem mobiusPacking_generated_discrete {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ)
    (hne : (⋂ i, D i).Nonempty) (ho : IsOpen (⋂ i, D i)) :
    Mobius.IsDiscreteMobiusSubgroup (⨆ i, G i) := by
  apply isMobiusDiscontinuousOn_open_discrete _ _ ho hne
  exact (mobiusPacking_common_saturation_discontinuous G D hp hc ho).mono
    (subset_mobiusSaturation _ _)

/-- With openness explicit only for the domain/discontinuity conclusion. -/
theorem packing_family_freeProduct_packing_discontinuity {ι : Type*} (G : ι → Subgroup Mobius.complexMobiusGroup)
    (D : ι → Set Mobius.ExtendedComplex) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ)
    (hne : (⋂ i, D i).Nonempty) (ho : IsOpen (⋂ i, D i)) :
    Nonempty (CoprodI (fun i => G i) ≃* ↥(⨆ i, G i : Subgroup Mobius.complexMobiusGroup)) ∧
      IsMobiusPacking (⨆ i, G i) (⋂ i, D i) ∧
      IsMobiusDiscontinuousOn (⨆ i, G i) (mobiusSaturation (⨆ i, G i) (⋂ i, D i)) :=
  ⟨⟨mobiusPackingFreeProductEquiv G D hp hc hne⟩,
    mobiusPacking_common_intersection G D hp hc,
    mobiusPacking_common_saturation_discontinuous G D hp hc ho⟩

/-- For finite packing families, openness of each domain makes the common domain open. -/
theorem finite_packing_family_freeProduct_packing_discontinuity {ι : Type*} [Finite ι]
    (G : ι → Subgroup Mobius.complexMobiusGroup) (D : ι → Set Mobius.ExtendedComplex)
    (hD : ∀ i, IsOpen (D i)) (hp : ∀ i, IsMobiusPacking (G i) (D i))
    (hc : ∀ i j, i ≠ j → D i ∪ D j = Set.univ) (hne : (⋂ i, D i).Nonempty) :
    Nonempty (CoprodI (fun i => G i) ≃* ↥(⨆ i, G i : Subgroup Mobius.complexMobiusGroup)) ∧
      IsMobiusPacking (⨆ i, G i) (⋂ i, D i) ∧
      IsMobiusDiscontinuousOn (⨆ i, G i) (mobiusSaturation (⨆ i, G i) (⋂ i, D i)) :=
  packing_family_freeProduct_packing_discontinuity G D hp hc hne (isOpen_iInter_of_finite hD)

end
end LowDimensionalTopology.Geometry.DiscreteGroups
