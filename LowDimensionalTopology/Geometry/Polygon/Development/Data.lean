module
public import Mathlib.Algebra.Group.Subgroup.Actions
public import Mathlib.Algebra.Group.Action.End
public import Mathlib.Tactic.Group
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.Algebra.Group.Action.Pointwise.Set.Basic
public import Mathlib.Logic.Relation

@[expose] public section
noncomputable section
open Set
open scoped Pointwise
namespace LowDimensionalTopology.Geometry.Polygon

universe u v

/--
Abstract set-and-sides data.

The designated nonempty interior and side union are set-theoretic data. Separate geometric
interfaces supply openness, connectedness, frontier equality, geodesic sides and the ambient
hyperbolic plane. Concrete hyperbolic statements use `NativeJordanGeodesicPolygon`.
-/
structure PoincarePolygon (X : Type u) where
  interior : Set X
  interior_nonempty : interior.Nonempty
  sides : Set (Set X)
  sides_nonempty : sides.Nonempty
  side_nonempty : ∀ s ∈ sides, s.Nonempty
  disjoint : Disjoint interior (⋃₀ sides)

namespace PoincarePolygon
variable {X : Type u} (P : _root_.LowDimensionalTopology.Geometry.Polygon.PoincarePolygon X)

/-- A side is a member of the actual given collection of side sets. -/
def Side := {s : Set X // s ∈ P.sides}

/-- The designated side union. Equality with the topological frontier requires
independent geometric hypotheses; see `frontier_eq_boundary`. -/
def boundary : Set X := ⋃₀ P.sides

/-- The designated inside together with its given sides; closure equality is not assumed. -/
def carrier : Set X := P.interior ∪ P.boundary

/-- Points of a copy are actual points of the original full polygon. -/
def Point := {x : X // x ∈ P.carrier}

theorem side_subset_boundary (s : P.Side) : s.val ⊆ P.boundary :=
  subset_sUnion_of_mem s.property

theorem interior_disjoint_side (s : P.Side) : Disjoint P.interior s.val :=
  P.disjoint.mono_right (P.side_subset_boundary s)

theorem interior_subset_carrier : P.interior ⊆ P.carrier := subset_union_left

theorem side_subset_carrier (s : P.Side) : s.val ⊆ P.carrier :=
  (P.side_subset_boundary s).trans subset_union_right

end PoincarePolygon

/-- A side-pairing involution with ambient group elements taking each side to its mate. -/
structure PoincareSidePairing {X : Type u} (Γ : Type v) [Group Γ] [MulAction Γ X]
    (P : PoincarePolygon X) where
  paired : P.Side ≃ P.Side
  involutive : Function.Involutive paired
  element : P.Side → Γ
  element_paired : ∀ s, element (paired s) = (element s)⁻¹
  side_image : ∀ s, element s • s.val = (paired s).val

namespace PoincareSidePairing
variable {X : Type u} {Γ : Type v} [Group Γ] [MulAction Γ X]
variable {P : _root_.LowDimensionalTopology.Geometry.Polygon.PoincarePolygon X} (S :
  _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing Γ P)

/-- The genuine subgroup of ambient transformations generated by the original pairing maps. -/
def Generated : Subgroup Γ := Subgroup.closure (range S.element)

/-- Each original pairing map as an element of the actual generated subgroup. -/
def generator (s : P.Side) : S.Generated :=
  ⟨S.element s,Subgroup.subset_closure (mem_range_self s)⟩

theorem generator_paired (s : P.Side) : S.generator (S.paired s) = (S.generator s)⁻¹ :=
  Subtype.ext (S.element_paired s)

theorem generator_side_image (s : P.Side) : S.generator s • s.val = (S.paired s).val :=
  S.side_image s

/-- The literal disjoint indexed copies before gluing. -/
def Copy := S.Generated × P.Point

/-- One original side identification, with its original ambient group index equation. -/
def Step (a b : S.Copy) : Prop :=
  a = b ∨ ∃ s : P.Side, a.2.val ∈ s.val ∧
    b.2.val = S.generator s • a.2.val ∧ a.1 = b.1*S.generator s

/-- The actual equivalence relation generated by the stated side identifications. -/
def gluingSetoid : Setoid S.Copy := Relation.EqvGen.setoid S.Step

/-- Poincare's development is the genuine quotient of indexed polygon copies. -/
def Development := Quotient S.gluingSetoid

/-- The quotient projection from a literal indexed copy. -/
def project (a : S.Copy) : S.Development := Quotient.mk S.gluingSetoid a

/-- Literal evaluation of an indexed polygon copy in the original ambient set. -/
def copyEvaluation (a : S.Copy) : X := a.1 • a.2.val

/-- Left multiplication changes only the original group index. -/
def translateCopy (g : S.Generated) (a : S.Copy) : S.Copy := (g*a.1,a.2)

theorem step_refl (a : S.Copy) : S.Step a a := Or.inl rfl

theorem step_symm {a b : S.Copy} (h : S.Step a b) : S.Step b a := by
  rcases h with rfl | ⟨s,hx,hy,hg⟩
  · exact Or.inl rfl
  · refine Or.inr ⟨S.paired s,?_,?_,?_⟩
    · rw [←S.generator_side_image s]
      exact ⟨a.2.val,hx,hy.symm⟩
    · rw [S.generator_paired,hy,inv_smul_smul]
    · rw [S.generator_paired,hg]
      group

theorem step_evaluation {a b : S.Copy} (h : S.Step a b) :
    S.copyEvaluation a = S.copyEvaluation b := by
  rcases h with rfl | ⟨s,_hx,hy,hg⟩
  · rfl
  · change a.1 • a.2.val = b.1 • b.2.val
    rw [hg,mul_smul,hy]

theorem step_translate (g : S.Generated) {a b : S.Copy} (h : S.Step a b) :
    S.Step (S.translateCopy g a) (S.translateCopy g b) := by
  rcases h with rfl | ⟨s,hx,hy,hg⟩
  · exact Or.inl rfl
  · refine Or.inr ⟨s,hx,hy,?_⟩
    change g*a.1 = (g*b.1)*S.generator s
    rw [hg,mul_assoc]

/-- An elementary gluing cannot move any actual interior point of a copy. -/
theorem step_interior_rigid {a b : S.Copy} (h : S.Step a b)
    (hi : a.2.val ∈ P.interior ∨ b.2.val ∈ P.interior) : a = b := by
  rcases h with he | ⟨s,hx,hy,_hg⟩
  · exact he
  · have hyS : b.2.val ∈ (S.paired s).val := by
      rw [←S.generator_side_image s]
      exact ⟨a.2.val,hx,hy.symm⟩
    rcases hi with hi | hi
    · exact False.elim (Set.disjoint_left.mp (P.interior_disjoint_side s) hi hx)
    · exact False.elim (Set.disjoint_left.mp (P.interior_disjoint_side (S.paired s)) hi hyS)

theorem gluing_evaluation {a b : S.Copy} (h : Relation.EqvGen S.Step a b) :
    S.copyEvaluation a = S.copyEvaluation b := by
  induction h with
  | rel a b h => exact S.step_evaluation h
  | refl a => rfl
  | symm a b _ ih => exact ih.symm
  | trans a b c _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem gluing_translate (g : S.Generated) {a b : S.Copy}
    (h : Relation.EqvGen S.Step a b) :
    Relation.EqvGen S.Step (S.translateCopy g a) (S.translateCopy g b) := by
  induction h with
  | rel a b h => exact Relation.EqvGen.rel _ _ (S.step_translate g h)
  | refl a => exact Relation.EqvGen.refl _
  | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans a b c _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- Equivalent copies containing an interior point have the same group label and point. -/
theorem gluing_interior_rigid {a b : S.Copy} (h : Relation.EqvGen S.Step a b)
    (hi : a.2.val ∈ P.interior ∨ b.2.val ∈ P.interior) : a = b := by
  induction h with
  | rel a b h => exact S.step_interior_rigid h hi
  | refl a => rfl
  | symm a b _ ih => exact (ih hi.symm).symm
  | trans a b c _ _ ih₁ ih₂ =>
    rcases hi with ha | hc
    · have hab := ih₁ (Or.inl ha)
      have hb : b.2.val ∈ P.interior := hab ▸ ha
      exact hab.trans (ih₂ (Or.inl hb))
    · have hbc := ih₂ (Or.inr hc)
      have hb : b.2.val ∈ P.interior := hbc.symm ▸ hc
      exact (ih₁ (Or.inr hb)).trans hbc

/-- The natural original-space map is well-defined on the genuine quotient. -/
def evaluation : S.Development → X :=
  Quotient.lift S.copyEvaluation (fun _ _ h => S.gluing_evaluation h)

@[simp] theorem evaluation_project (a : S.Copy) :
    S.evaluation (S.project a) = S.copyEvaluation a := rfl

theorem project_eq_iff (a b : S.Copy) :
    S.project a = S.project b ↔ Relation.EqvGen S.Step a b :=
  ⟨Quotient.exact,fun h => Quotient.sound (s := S.gluingSetoid) h⟩

/-- Every original generator induces its genuine left-translation action on the quotient. -/
def translate (g : S.Generated) : S.Development → S.Development :=
  Quotient.map (S.translateCopy g) (fun _ _ h => S.gluing_translate g h)

instance developmentMulAction : MulAction S.Generated S.Development where
  smul := S.translate
  one_smul q := by
    induction q using Quotient.inductionOn with
    | h a =>
      change S.project (S.translateCopy 1 a) = S.project a
      apply congrArg S.project
      exact Prod.ext (one_mul a.1) rfl
  mul_smul g h q := by
    induction q using Quotient.inductionOn with
    | h a =>
      change S.project (S.translateCopy (g*h) a) =
        S.project (S.translateCopy g (S.translateCopy h a))
      apply congrArg S.project
      exact Prod.ext (mul_assoc g h a.1) rfl

@[simp] theorem smul_project (g : S.Generated) (a : S.Copy) :
    g • S.project a = S.project (S.translateCopy g a) := rfl

/-- The natural development evaluation intertwines the actual original generated action. -/
theorem evaluation_smul (g : S.Generated) (q : S.Development) :
    S.evaluation (g • q) = g • S.evaluation q := by
  induction q using Quotient.inductionOn with
  | h a => exact mul_smul g a.1 a.2.val

/-- Interior rigidity makes the induced development action faithful, without assuming original-space tessellation. -/
instance developmentFaithfulSMul : FaithfulSMul S.Generated S.Development where
  eq_of_smul_eq_smul {g h} he := by
    obtain ⟨x,hx⟩ := P.interior_nonempty
    let p : P.Point := ⟨x,P.interior_subset_carrier hx⟩
    have hEq : S.project (g,p) = S.project (h,p) := by
      have hq := he (S.project (1,p))
      change S.project (g*1,p) = S.project (h*1,p) at hq
      simpa only [mul_one] using hq
    have hRaw := S.gluing_interior_rigid ((S.project_eq_iff _ _).mp hEq) (Or.inl hx)
    exact congrArg Prod.fst hRaw

/-- The actual group map onto development permutations is injective. -/
theorem development_permutationHom_injective :
    Function.Injective (MulAction.toPermHom S.Generated S.Development) := by
  intro g h he
  apply eq_of_smul_eq_smul (α := S.Development)
  intro q
  exact congrArg (fun e : Equiv.Perm S.Development => e q) he

/-- The actual distinguished closed copy in the glued space. -/
def closedCopy : Set S.Development := range (fun p : P.Point => S.project (1,p))

/-- The actual distinguished open-polygon copy, before any topology is required. -/
def interiorCopy : Set S.Development :=
  range (fun p : {x : X // x ∈ P.interior} =>
    S.project (1,(⟨p.val,P.interior_subset_carrier p.property⟩ : P.Point)))

/-- The literal generated translates of the original closed copy cover the entire development. -/
theorem development_closed_tiles_cover :
    (⋃ g : S.Generated, g • S.closedCopy) = univ := by
  apply Set.eq_univ_of_forall
  intro q
  induction q using Quotient.inductionOn with
  | h a =>
    refine mem_iUnion.mpr ⟨a.1,?_⟩
    refine ⟨S.project (1,a.2),⟨a.2,rfl⟩,?_⟩
    change S.project (a.1*1,a.2) = S.project a
    rw [mul_one]
    rfl

/-- Distinct generated development translates of the actual polygon interior are disjoint. -/
theorem development_interior_tiles_disjoint {g h : S.Generated} (hne : g ≠ h) :
    Disjoint (g • S.interiorCopy) (h • S.interiorCopy) := by
  apply Set.disjoint_left.mpr
  rintro q ⟨u,⟨x,rfl⟩,hgu⟩ ⟨v,⟨y,rfl⟩,hhv⟩
  have hEq := hgu.trans hhv.symm
  change S.project (g*1,_) = S.project (h*1,_) at hEq
  simp only [mul_one] at hEq
  have hRaw := S.gluing_interior_rigid ((S.project_eq_iff _ _).mp hEq) (Or.inl x.property)
  exact hne (congrArg Prod.fst hRaw)

/-- surjectivity of genuine glued evaluation is exactly coverage by original closed polygon copies. -/
theorem evaluation_surjective_iff_closed_cover :
    Function.Surjective S.evaluation ↔
      (⋃ g : S.Generated, (fun x : X => g • x) '' P.carrier) = univ := by
  constructor
  · intro hs
    apply Set.eq_univ_of_forall
    intro x
    obtain ⟨q,hq⟩ := hs x
    obtain ⟨a,rfl⟩ := Quotient.exists_rep q
    exact mem_iUnion.mpr ⟨a.1,a.2.val,a.2.property,hq⟩
  · intro hc x
    have hx : x ∈ ⋃ g : S.Generated, (fun x : X => g • x) '' P.carrier := by rw [hc]; trivial
    obtain ⟨g,y,hy,hgy⟩ := mem_iUnion.mp hx
    exact ⟨S.project (g,⟨y,hy⟩),hgy⟩

/-- injective genuine glued evaluation forces disjoint original polygon interiors. -/
theorem original_interior_tiles_disjoint_of_evaluation_injective
    (hinj : Function.Injective S.evaluation) {g h : S.Generated} (hne : g ≠ h) :
    Disjoint ((fun x : X => g • x) '' P.interior) ((fun x : X => h • x) '' P.interior) := by
  apply Set.disjoint_left.mpr
  rintro z ⟨x,hx,hgx⟩ ⟨y,hy,hhy⟩
  let p : P.Point := ⟨x,P.interior_subset_carrier hx⟩
  let q : P.Point := ⟨y,P.interior_subset_carrier hy⟩
  have he : S.evaluation (S.project (g,p)) = S.evaluation (S.project (h,q)) := hgx.trans hhy.symm
  have hRaw := S.gluing_interior_rigid ((S.project_eq_iff _ _).mp (hinj he)) (Or.inl hx)
  exact hne (congrArg Prod.fst hRaw)

end PoincareSidePairing
end LowDimensionalTopology.Geometry.Polygon
