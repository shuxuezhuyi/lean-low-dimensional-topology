module
public import LowDimensionalTopology.Geometry.Polygon.Development.PoincareFixedSideClasses
public import Mathlib.Tactic
@[expose] public section
noncomputable section
open Set
namespace LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing
universe u v
variable {X : Type u} {Γ : Type v} [Group Γ] [MulAction Γ X]
variable {P : _root_.LowDimensionalTopology.Geometry.Polygon.PoincarePolygon X} (S :
  _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing Γ P)

/-- Actual containment of original incident side sets implies containment of their actual generated subgroups. -/
theorem incidentSubgroup_mono_of_incidence (x y : P.Point)
    (hi : ∀ s : P.Side,y.val ∈ s.val → x.val ∈ s.val) :
    S.incidentSubgroup y ≤ S.incidentSubgroup x := by
  unfold incidentSubgroup
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨s,hs,rfl⟩
  exact S.generator_mem_incidentSubgroup x s (hi s hs)

/-- Membership in the original generated-group incident subgroup is exactly
membership of the literal same native transformation in the original ambient incident group. -/
theorem mem_incidentSubgroup_iff_ambient (x : P.Point) (g : S.Generated) :
    g ∈ S.incidentSubgroup x ↔
      g.val ∈ Subgroup.closure {a : Γ | ∃ s : P.Side,x.val ∈ s.val ∧ a=S.element s} := by
  rw [←S.incidentSubgroup_map x]
  constructor
  · intro hg
    exact ⟨g,hg,rfl⟩
  · rintro ⟨a,ha,he⟩
    have hEq : a=g := Subtype.ext he
    rwa [←hEq]

variable [MetricSpace X] [IsIsometricSMul S.Generated X]

/-- The actual incident subgroup preserves distance from its original fixed point. -/
theorem incidentSubgroup_dist_eq
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point)
    {g : S.Generated} (hg : g ∈ S.incidentSubgroup x) (p : X) :
    dist (g • p) x.val=dist p x.val := by
  have hx := S.incidentSubgroup_fixes hf x hg
  calc dist (g • p) x.val=dist (g • p) (g • x.val) := by rw [hx]
       _=dist p x.val := (isometry_smul X g).dist_eq p x.val

/--
A genuine local reflection chamber gives the full original local tessellation condition:
its actual incident-group images cover the native ball; closed chamber representatives
are unique; and each point fixer is generated by the actually incident sides.
None of the inputs concerns the quotient, its full fibers, or a developing chart.
-/
theorem localTessellation_of_incident_chamber
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    (x : P.Point) (r : ℝ)
    (hNear : ∀ p : P.Point,dist p.val x.val < r →
      ∀ s : P.Side,p.val ∈ s.val → x.val ∈ s.val)
    (hCover : ∀ z : X,dist z x.val < r →
      ∃ g : S.Generated,g ∈ S.incidentSubgroup x ∧
        ∃ p : P.Point,dist p.val x.val < r ∧ g • p.val=z)
    (hUnique : ∀ g : S.Generated,g ∈ S.incidentSubgroup x →
      ∀ p q : P.Point,dist p.val x.val < r → dist q.val x.val < r →
        g • p.val=q.val → p.val=q.val)
    (hFix : ∀ p : P.Point,dist p.val x.val < r →
      ∀ g : S.Generated,g ∈ S.incidentSubgroup x →
        g • p.val=p.val → g ∈ S.incidentSubgroup p) :
    S.LocalTessellation (1,x) r := by
  have hW := S.copyNeighborhood_eq_incidentSubgroup hf x r
  have hd : ∀ g : S.Generated,g ∈ S.incidentSubgroup x →
      ∀ p : X,dist (g • p) x.val=dist p x.val := by
    intro g hg p
    have hx := S.incidentSubgroup_fixes hf x hg
    calc dist (g • p) x.val=dist (g • p) (g • x.val) := by rw [hx]
         _=dist p x.val := (isometry_smul X g).dist_eq p x.val
  constructor
  · have hcenter : S.copyEvaluation (1,x)=x.val := by
      change (1 : S.Generated) • x.val=x.val
      exact one_smul _ _
    rw [hcenter]
    apply subset_antisymm
    · rintro z ⟨b,hb,rfl⟩
      rw [hW] at hb
      change dist (b.1 • b.2.val) x.val < r
      rw [hd b.1 hb.1]
      exact hb.2
    · intro z hz
      obtain ⟨g,hg,p,hp,he⟩ := hCover z hz
      refine ⟨(g,p),?_,he⟩
      rw [hW]
      exact ⟨hg,hp⟩
  · intro b hb c
    rw [hW] at hb
    constructor
    · intro he
      have hc := (S.project_eq_iff_incident_difference hf c b).mp he
      have hdc : dist c.2.val x.val < r := by rw [hc.1];exact hb.2
      have hinc := S.incidentSubgroup_mono_of_incidence x c.2 (hNear c.2 hdc)
      have hdiff : b.1⁻¹*c.1 ∈ S.incidentSubgroup x := hinc hc.2
      have hci : c.1 ∈ S.incidentSubgroup x := by
        have hm := (S.incidentSubgroup x).mul_mem hb.1 hdiff
        simpa only [mul_inv_cancel_left] using hm
      refine ⟨?_,S.gluing_evaluation ((S.project_eq_iff _ _).mp he)⟩
      rw [hW]
      exact ⟨hci,hdc⟩
    · rintro ⟨hc,he⟩
      rw [hW] at hc
      have hg : b.1⁻¹*c.1 ∈ S.incidentSubgroup x :=
        (S.incidentSubgroup x).mul_mem ((S.incidentSubgroup x).inv_mem hb.1) hc.1
      have hp : (b.1⁻¹*c.1) • c.2.val=b.2.val := by
        have hh := congrArg (fun z : X => b.1⁻¹ • z) he
        change b.1⁻¹ • (c.1 • c.2.val)=b.1⁻¹ • (b.1 • b.2.val) at hh
        simpa only [←mul_smul,inv_mul_cancel,one_smul] using hh
      have hpoint := hUnique (b.1⁻¹*c.1) hg c.2 b.2 hc.2 hb.2 hp
      have hfix : (b.1⁻¹*c.1) • c.2.val=c.2.val := hp.trans hpoint.symm
      have hlocal := hFix c.2 hc.2 (b.1⁻¹*c.1) hg hfix
      exact S.project_eq_of_incident_difference hf c b hpoint hlocal

/-- One actual incident reflection chamber radius supplies all sufficiently small original local tessellation radii. -/
theorem local_radius_of_incident_chamber
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    (x : P.Point) (r : ℝ) (hr : 0 < r)
    (hNear : ∀ p : P.Point,dist p.val x.val < r →
      ∀ s : P.Side,p.val ∈ s.val → x.val ∈ s.val)
    (hCover : ∀ z : X,dist z x.val < r →
      ∃ g : S.Generated,g ∈ S.incidentSubgroup x ∧
        ∃ p : P.Point,dist p.val x.val < r ∧ g • p.val=z)
    (hUnique : ∀ g : S.Generated,g ∈ S.incidentSubgroup x →
      ∀ p q : P.Point,dist p.val x.val < r → dist q.val x.val < r →
        g • p.val=q.val → p.val=q.val)
    (hFix : ∀ p : P.Point,dist p.val x.val < r →
      ∀ g : S.Generated,g ∈ S.incidentSubgroup x →
        g • p.val=p.val → g ∈ S.incidentSubgroup p) :
    ∃ r₀ : ℝ,0 < r₀ ∧ ∀ t : ℝ,0 < t → t ≤ r₀ → S.LocalTessellation (1,x) t := by
  refine ⟨r,hr,?_⟩
  intro t _ht htr
  apply S.localTessellation_of_incident_chamber hf x t
  · intro p hp
    exact hNear p (hp.trans_le htr)
  · intro z hz
    obtain ⟨g,hg,p,_hp,he⟩ := hCover z (hz.trans_le htr)
    refine ⟨g,hg,p,?_,he⟩
    have hd := S.incidentSubgroup_dist_eq hf x hg p.val
    rw [he] at hd
    exact hd.symm.trans_lt hz
  · intro g hg p q hp hq
    exact hUnique g hg p q (hp.trans_le htr) (hq.trans_le htr)
  · intro p hp
    exact hFix p (hp.trans_le htr)

end LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing
