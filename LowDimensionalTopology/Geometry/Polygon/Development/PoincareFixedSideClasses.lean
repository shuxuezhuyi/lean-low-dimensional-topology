module
public import LowDimensionalTopology.Geometry.Polygon.Development.PoincarePairedSideStars
public import Mathlib.Tactic
@[expose] public section
noncomputable section
open Set
namespace LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing
universe u v
variable {X : Type u} {Γ : Type v} [Group Γ] [MulAction Γ X]
variable {P : _root_.LowDimensionalTopology.Geometry.Polygon.PoincarePolygon X} (S :
  _root_.LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing Γ P)

/-- The actual subgroup generated by precisely the original sides incident to the original point. -/
def incidentSubgroup (x : P.Point) : Subgroup S.Generated :=
  Subgroup.closure {g | ∃ s : P.Side,x.val ∈ s.val ∧ g=S.generator s}

/-- Every incident original side generator belongs to the actual local subgroup. -/
theorem generator_mem_incidentSubgroup (x : P.Point) (s : P.Side) (hx : x.val ∈ s.val) :
    S.generator s ∈ S.incidentSubgroup x :=
  Subgroup.subset_closure ⟨s,hx,rfl⟩

/-- A genuine side step for pointwise fixed sides preserves the literal original polygon point. -/
theorem step_point_eq_of_fixed_sides
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    {a b : S.Copy} (h : S.Step a b) : a.2.val=b.2.val := by
  rcases h with rfl | ⟨s,hx,hy,_⟩
  · rfl
  · exact (hy.trans (hf s a.2.val hx)).symm

/-- Thus every true gluing equivalence, including all transitive steps, preserves that point. -/
theorem gluing_point_eq_of_fixed_sides
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    {a b : S.Copy} (h : Relation.EqvGen S.Step a b) : a.2.val=b.2.val := by
  induction h with
  | rel a b hab => exact S.step_point_eq_of_fixed_sides hf hab
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ iha ihb => exact iha.trans ihb

/-- The actual incident-generator candidate set is closed under every possible original side step. -/
theorem incident_copies_step_closed
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point) :
    ∀ a : S.Copy,a.2.val=x.val ∧ a.1 ∈ S.incidentSubgroup x →
      ∀ b : S.Copy,S.Step a b → b.2.val=x.val ∧ b.1 ∈ S.incidentSubgroup x := by
  intro a ha b hab
  refine ⟨(S.step_point_eq_of_fixed_sides hf hab).symm.trans ha.1,?_⟩
  rcases hab with rfl | ⟨s,hs,_hy,hg⟩
  · exact ha.2
  · have hxs : x.val ∈ s.val := ha.1 ▸ hs
    have hgen := S.generator_mem_incidentSubgroup x s hxs
    have hb : b.1=a.1*(S.generator s)⁻¹ := by rw [hg];group
    rw [hb]
    exact (S.incidentSubgroup x).mul_mem ha.2 ((S.incidentSubgroup x).inv_mem hgen)

/-- No hidden gluing representative lies outside the actual incident subgroup at a fixed-side point. -/
theorem project_fiber_subset_incidentSubgroup
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point) :
    S.project ⁻¹' {S.project (1,x)} ⊆ {b | b.2.val=x.val ∧ b.1 ∈ S.incidentSubgroup x} :=
  S.project_fiber_subset_of_step_closed _ (1,x) ⟨rfl,(S.incidentSubgroup x).one_mem⟩
    (S.incident_copies_step_closed hf x)

/-- Every word in actual incident side generators is really identified by the original gluing. -/
theorem project_incident_eq
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point)
    (g : S.Generated) (hg : g ∈ S.incidentSubgroup x) : S.project (g,x)=S.project (1,x) := by
  change g ∈ Subgroup.closure {g | ∃ s : P.Side,x.val ∈ s.val ∧ g=S.generator s} at hg
  induction hg using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨s,hxs,rfl⟩ := ha
    apply (S.project_eq_iff _ _).mpr
    apply Relation.EqvGen.rel
    exact Or.inr ⟨s,hxs,(hf s x.val hxs).symm,(one_mul _).symm⟩
  | one => rfl
  | mul a b _ha _hb iha ihb =>
    have h := congrArg (S.translate a) ihb
    change S.project (a*b,x)=S.project (a*1,x) at h
    rw [mul_one] at h
    exact h.trans iha
  | inv a _ha iha =>
    have h := congrArg (S.translate a⁻¹) iha
    change S.project (a⁻¹*a,x)=S.project (a⁻¹*1,x) at h
    simpa only [inv_mul_cancel,mul_one] using h.symm

/-- The complete original gluing class is exactly the original point indexed by its actual incident subgroup. -/
theorem project_fiber_eq_incidentSubgroup
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point) :
    S.project ⁻¹' {S.project (1,x)}={b | b.2.val=x.val ∧ b.1 ∈ S.incidentSubgroup x} := by
  apply subset_antisymm (S.project_fiber_subset_incidentSubgroup hf x)
  intro b hb
  have he : b=(b.1,x) := Prod.ext rfl (Subtype.ext hb.1)
  rw [he]
  exact S.project_incident_eq hf x b.1 hb.2

/-- The whole actual gluing class is finite whenever the actual incident subgroup is finite. -/
theorem finite_project_fiber_of_finite_incidentSubgroup
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point)
    [Finite (S.incidentSubgroup x)] : (S.project ⁻¹' {S.project (1,x)}).Finite := by
  apply (Set.finite_range (fun g : S.incidentSubgroup x => (((g : S.Generated),x) : S.Copy))).subset
  intro b hb
  have hh := S.project_fiber_subset_incidentSubgroup hf x hb
  refine ⟨⟨b.1,hh.2⟩,?_⟩
  exact Prod.ext rfl (Subtype.ext hh.1.symm)

/-- Actual incident-generator differences, rather than an assumed gluing equality,
identify arbitrary indexed copies of the same original point. -/
theorem project_eq_of_incident_difference
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    (a b : S.Copy) (hx : a.2.val=b.2.val)
    (hg : b.1⁻¹*a.1 ∈ S.incidentSubgroup a.2) : S.project a=S.project b := by
  have h := congrArg (S.translate b.1) (S.project_incident_eq hf a.2 (b.1⁻¹*a.1) hg)
  change S.project (b.1*(b.1⁻¹*a.1),a.2)=S.project (b.1*1,a.2) at h
  rw [mul_inv_cancel_left,mul_one] at h
  have hb : (b.1,a.2)=b := Prod.ext rfl (Subtype.ext hx)
  rw [hb] at h
  exact h

/-- Conversely the actual original gluing determines precisely the incident-generator difference. -/
theorem project_eq_iff_incident_difference
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z)
    (a b : S.Copy) : S.project a=S.project b ↔
      a.2.val=b.2.val ∧ b.1⁻¹*a.1 ∈ S.incidentSubgroup a.2 := by
  constructor
  · intro he
    have hx := S.gluing_point_eq_of_fixed_sides hf ((S.project_eq_iff _ _).mp he)
    refine ⟨hx,?_⟩
    have h := congrArg (S.translate b.1⁻¹) he
    change S.project (b.1⁻¹*a.1,a.2)=S.project (b.1⁻¹*b.1,b.2) at h
    rw [inv_mul_cancel] at h
    have hb : ((1,b.2) : S.Copy)=(1,a.2) := Prod.ext rfl (Subtype.ext hx.symm)
    have h' : S.project (b.1⁻¹*a.1,a.2)=S.project (1,a.2) :=
      h.trans (congrArg S.project hb)
    exact (S.project_fiber_subset_incidentSubgroup hf a.2 h').2
  · rintro ⟨hx,hg⟩
    exact S.project_eq_of_incident_difference hf a b hx hg

/-- Every element of the actual incident subgroup fixes its original point. -/
theorem incidentSubgroup_fixes
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point)
    {g : S.Generated} (hg : g ∈ S.incidentSubgroup x) : g • x.val=x.val := by
  change g ∈ Subgroup.closure {g | ∃ s : P.Side,x.val ∈ s.val ∧ g=S.generator s} at hg
  induction hg using Subgroup.closure_induction with
  | mem a ha =>
    obtain ⟨s,hxs,rfl⟩ := ha
    exact hf s x.val hxs
  | one => exact one_smul _ _
  | mul a b _ha _hb iha ihb => rw [mul_smul,ihb,iha]
  | inv a _ha iha =>
    have h := congrArg (fun z : X => a⁻¹ • z) iha
    simpa only [inv_smul_smul] using h.symm

/-- The incident subgroup embedded into the original ambient group is exactly
its original incident side generators' subgroup, with no abstract replacement group. -/
theorem incidentSubgroup_map (x : P.Point) :
    (S.incidentSubgroup x).map S.Generated.subtype=
      Subgroup.closure {g : Γ | ∃ s : P.Side,x.val ∈ s.val ∧ g=S.element s} := by
  unfold incidentSubgroup
  rw [MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨a,⟨s,hs,rfl⟩,rfl⟩
    exact ⟨s,hs,rfl⟩
  · rintro ⟨s,hs,rfl⟩
    exact ⟨S.generator s,⟨s,hs,rfl⟩,rfl⟩

/-- A finite actual ambient subgroup containing the incident side maps proves finiteness
of the original generated-group incident subgroup. -/
theorem finite_incidentSubgroup_of_finite_ambient (x : P.Point) (J : Subgroup Γ) [Finite J]
    (hJ : ∀ s : P.Side,x.val ∈ s.val → S.element s ∈ J) : Finite (S.incidentSubgroup x) := by
  have hle : (S.incidentSubgroup x).map S.Generated.subtype ≤ J := by
    rw [S.incidentSubgroup_map x]
    apply (Subgroup.closure_le J).mpr
    rintro g ⟨s,hs,rfl⟩
    exact hJ s hs
  let f : S.incidentSubgroup x → J := fun g => ⟨g.val.val,hle ⟨g.val,g.property,rfl⟩⟩
  apply Finite.of_injective f
  intro a b hab
  exact Subtype.ext (Subtype.ext (congrArg (fun q : J => (q : Γ)) hab))

variable [MetricSpace X]

/-- At pointwise fixed sides the true original star is the ball in every actual incident indexed copy. -/
theorem copyNeighborhood_eq_incidentSubgroup
    (hf : ∀ s : P.Side,∀ z ∈ s.val,S.generator s • z=z) (x : P.Point) (r : ℝ) :
    S.copyNeighborhood (1,x) r={b | b.1 ∈ S.incidentSubgroup x ∧ dist b.2.val x.val < r} := by
  ext b
  constructor
  · rintro ⟨c,hc,hg,hd⟩
    have hh := S.project_fiber_subset_incidentSubgroup hf x hc
    exact ⟨hg ▸ hh.2,by rwa [hh.1] at hd⟩
  · rintro ⟨hg,hd⟩
    exact ⟨(b.1,x),S.project_incident_eq hf x b.1 hg,rfl,hd⟩

end LowDimensionalTopology.Geometry.Polygon.PoincareSidePairing
